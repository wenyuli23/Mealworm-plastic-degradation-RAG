      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"GC/MS instrument is a biochemical measure used to analyze the composition of PE-MPs."</data>
      <data key="d2">chunk-aa33fb34ba06610c290cdfd8a5b4e916</data>
    </node>
