      <data key="d0">"ENZYME"</data>
      <data key="d1">"SOD is an antioxidant enzyme that is involved in protecting the mealworm larvae from oxidative stress caused by the biodegradation of PE."</data>
      <data key="d2">chunk-e32e296ef016e2403df45f75eedee219</data>
    </node>
