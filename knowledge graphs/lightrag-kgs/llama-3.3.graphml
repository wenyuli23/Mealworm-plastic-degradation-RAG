      <data key="d2">chunk-939800f545beed77f5a7d1c026c250fb</data>
    </node>
    <node id="&quot;UDP&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"UDP is a metabolite involved in the synthesis of nucleotide sugars."</data>
      <data key="d2">chunk-939800f545beed77f5a7d1c026c250fb</data>
    </node>
    <node id="&quot;URIDINE 5-DIPHOSPHATE&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Uridine 5-diphosphate is a metabolite involved in the synthesis of nucleotide sugars."</data>
      <data key="d2">chunk-939800f545beed77f5a7d1c026c250fb</data>
    </node>
    <node id="&quot;N-ACETYL GALACTOSAMINE&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"N-acetyl galactosamine is a metabolite involved in the synthesis of glycosphospholipids."</data>
      <data key="d2">chunk-939800f545beed77f5a7d1c026c250fb</data>
    </node>
