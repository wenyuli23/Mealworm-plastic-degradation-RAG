      <data key="d1">"L-Phenylalanine is an amino acid used as an internal standard in the study."</data>
      <data key="d2">chunk-394b3365ffb36d05dca2ef06bf74e462</data>
    </node>
    <node id="&quot;SWEET POTATO&quot;">
      <data key="d0">"NUTRIENT"</data>
      <data key="d1">"Sweet Potato is a food source used in the study to evaluate the impact of plastic on insect metabolism."</data>
      <data key="d2">chunk-394b3365ffb36d05dca2ef06bf74e462</data>
    </node>
