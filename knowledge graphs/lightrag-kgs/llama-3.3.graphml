    <node id="&quot;GRAM-POSITIVE BACTERIUM&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"Gram-positive bacterium is a type of bacteria that has a thick peptidoglycan cell wall, and includes species such as Bacillus."</data>
      <data key="d2">chunk-2665d67f816d2da20a065d708c370210</data>
    </node>
    <node id="&quot;GRAM-NEGATIVE BACTERIUM&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"Gram-negative bacterium is a type of bacteria that has a thin peptidoglycan cell wall, and includes species such as Pantoea and Erwinia."</data>
      <data key="d2">chunk-2665d67f816d2da20a065d708c370210</data>
