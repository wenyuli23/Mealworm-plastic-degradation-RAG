      <data key="d2">chunk-998b63e5349034d477c2087c139669ed</data>
    </node>
    <node id="&quot;EQUATION (4)&quot;">
      <data key="d0">"MATHEMATICAL CONCEPT"</data>
      <data key="d1">"Equation (4) is a mathematical equation that describes the increase in structure volume."</data>
      <data key="d2">chunk-998b63e5349034d477c2087c139669ed</data>
    </node>
    <node id="&quot;EQUATION (1)&quot;">
      <data key="d0">"MATHEMATICAL CONCEPT"</data>
      <data key="d1">"Equation (1) is a mathematical equation that is used to derive the change in volumetric length caused by a decrease in reserves density."</data>
      <data key="d2">chunk-998b63e5349034d477c2087c139669ed</data>
    </node>
    <node id="&quot;EQUATION (11)&quot;">
      <data key="d0">"MATHEMATICAL CONCEPT"</data>
      <data key="d1">"Equation (11) is a mathematical equation that is used to derive the change in volumetric length caused by a decrease in reserves density."</data>
      <data key="d2">chunk-998b63e5349034d477c2087c139669ed</data>
    </node>
    <node id="&quot;EQUATION (14)&quot;">
      <data key="d0">"MATHEMATICAL CONCEPT"</data>
      <data key="d1">"Equation (14) is a mathematical equation that is used to derive the change in volumetric length caused by a decrease in reserves density."</data>
      <data key="d2">chunk-998b63e5349034d477c2087c139669ed</data>
    </node>
    <node id="&quot;EQUATION (18)&quot;">
      <data key="d0">"MATHEMATICAL CONCEPT"</data>
      <data key="d1">"Equation (18) is a mathematical equation that describes the criterion for larvae to survive."</data>
