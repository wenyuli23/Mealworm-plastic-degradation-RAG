      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Biorefinery is a concept that refers to the process of converting biomass into valuable products, including biodegradable bioplastics."</data>
      <data key="d2">chunk-9a882603f777986db9d8fc65cea91dce</data>
    </node>
