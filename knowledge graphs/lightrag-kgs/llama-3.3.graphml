      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Agilent Infinity Flex II UHPLC is a machine used in the study for measuring central carbon metabolism metabolites."</data>
      <data key="d2">chunk-394b3365ffb36d05dca2ef06bf74e462</data>
    </node>
