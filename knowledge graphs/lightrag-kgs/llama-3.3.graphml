    <node id="&quot;MICROBIAL SOLUTIONS&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"Microbial solutions refer to the use of microorganisms to solve environmental problems, including plastic pollution."</data>
