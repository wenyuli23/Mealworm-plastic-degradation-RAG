      <data key="d1">"4-aminobenzoic acid is a metabolite involved in plastic degradation activity."</data>
      <data key="d2">chunk-939800f545beed77f5a7d1c026c250fb</data>
    </node>
    <node id="&quot;HOMOCYSTEINE&quot;">
      <data key="d0">"METABOLITE"</data>
