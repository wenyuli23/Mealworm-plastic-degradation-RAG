      <data key="d0">"BACTERIUM"</data>
      <data key="d1">"Acinetobacter NyZ450 is a bacterium that cooperates with Bacillus spp. NyZ451 for the biodegradation of a PE mulching film."</data>
      <data key="d2">chunk-0817d79fa27f2f5b078e09086250c6e0</data>
    </node>
