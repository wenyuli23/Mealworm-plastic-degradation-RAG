    </node>
    <node id="&quot;COLONY COUNTING&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Colony counting is a method used to quantify the growth of bacteria, such as Acinetobacter sp. strain NyZ450 and Bacillus sp. strain NyZ451."</data>
      <data key="d2">chunk-af682f78e3e8970d7d70b027a8f79116</data>
    </node>
    <node id="&quot;GROWTH CURVE&quot;">
