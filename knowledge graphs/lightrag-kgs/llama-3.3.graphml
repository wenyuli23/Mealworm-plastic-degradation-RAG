      <data key="d2">chunk-939800f545beed77f5a7d1c026c250fb</data>
    </node>
    <node id="&quot;PROLINE&quot;">
      <data key="d0">"AMINO ACID"</data>
      <data key="d1">"Proline is an amino acid involved in several metabolic pathways."</data>
      <data key="d2">chunk-939800f545beed77f5a7d1c026c250fb</data>
    </node>
    <node id="&quot;BUTANOATE&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Butanoate is a metabolite involved in several metabolic pathways."</data>
      <data key="d2">chunk-939800f545beed77f5a7d1c026c250fb</data>
    </node>
    <node id="&quot;4-AMINOBUTANOATE&quot;">
