      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"The Inverse Simpson Index is a measure used to assess the diversity of the microbial community in the mealworms' gut."</data>
      <data key="d2">chunk-17b1e554820493d86eb8bc96ba8bef37</data>
    </node>
