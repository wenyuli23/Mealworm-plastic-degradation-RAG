      <data key="d1">"Expanded Foam Polyethylene, or Exp PE, is a type of plastic used in the study to evaluate its impact on insect metabolism."</data>
      <data key="d2">chunk-394b3365ffb36d05dca2ef06bf74e462</data>
    </node>
