      <data key="d2">chunk-e819d53f76bcab4b74eba714efd32163</data>
    </node>
    <node id="&quot;EXPERIMENTAL GROUP&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"The experimental group is a set of mealworms that are given supplements, such as oatmeal and vitamins, to study their effect on survival and growth."</data>
      <data key="d2">chunk-5740f0973ff804cae61f6fc12f3e3753</data>
