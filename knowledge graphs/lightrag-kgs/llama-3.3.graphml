      <data key="d1">"The mass loss rate is a measure of the amount of PS that is broken down by mealworms over time."</data>
      <data key="d2">chunk-5740f0973ff804cae61f6fc12f3e3753</data>
    </node>
    <node id="&quot;CONNAT ET AL.&quot;">
