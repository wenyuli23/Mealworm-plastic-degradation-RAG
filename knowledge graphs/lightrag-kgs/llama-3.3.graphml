      <data key="d2">chunk-939800f545beed77f5a7d1c026c250fb</data>
    </node>
    <node id="&quot;MARINE MICROBIOTA&quot;">
      <data key="d0">"MICROORGANISMS"</data>
      <data key="d1">"Marine microbiota are microorganisms that have been studied for their response to oxidative stress."&lt;SEP&gt;"Marine microbiota is affected by oxidative stress caused by plastics, resulting in upregulated stress response pathways."</data>
      <data key="d2">chunk-ae2c294948460ef392ceeec82d5e81f8&lt;SEP&gt;chunk-939800f545beed77f5a7d1c026c250fb</data>
