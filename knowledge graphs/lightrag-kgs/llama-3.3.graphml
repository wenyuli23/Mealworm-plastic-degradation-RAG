      <data key="d2">chunk-f71fddc259d51158d5c79f38bf41523f</data>
    </node>
    <node id="&quot;RESERVE DYNAMICS&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"Reserve dynamics refer to the changes in energy reserves, such as lipids and carbohydrates, in insects."</data>
      <data key="d2">chunk-91831340731171413dc4c412a325e034</data>
    </node>
    <node id="&quot;FOOD SHORTAGE&quot;">
      <data key="d0">"PHYSIOLOGICAL RESPONSE"</data>
      <data key="d1">"Food shortage affects the survival of larvae, such as T. molitor, and their energy reserves."</data>
      <data key="d2">chunk-91831340731171413dc4c412a325e034</data>
    </node>
    <node id="&quot;ORGANS&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
