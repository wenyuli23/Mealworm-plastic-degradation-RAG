  <data key="d0">Bran-fed control group</data>
  <data key="d1">category</data>
  <data key="d2">The bran-fed control group was used as a baseline in the experiment, where larvae were fed natural wheat bran.</data>
  <data key="d3">chunk-9d7500fe4985cb2b885f9eb244ed3c2e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756384995</data>
</node>
<node id="Wax insects">
  <data key="d0">Wax insects</data>
  <data key="d1">category</data>
  <data key="d2">Wax insects were reported in 2014 by Dr. Yang to feed on and degrade low density polyethylene (LDPE).</data>
  <data key="d3">chunk-9d7500fe4985cb2b885f9eb244ed3c2e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756384997</data>
</node>
<node id="Dr. Yang">
  <data key="d0">Dr. Yang</data>
  <data key="d1">person</data>
  <data key="d2">Dr. Yang first reported in 2014 that wax insects could feed on and degrade LDPE foam plastics and isolated two PE-degrading bacterial strains from the larval gut.</data>
  <data key="d3">chunk-9d7500fe4985cb2b885f9eb244ed3c2e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756384997</data>
</node>
<node id="Ingestion preference">
  <data key="d0">Ingestion preference</data>
  <data key="d1">category</data>
  <data key="d2">Ingestion preference refers to the tendency of Tenebrio molitor larvae to consume different types of polymerized foam plastics.</data>
  <data key="d3">chunk-9d7500fe4985cb2b885f9eb244ed3c2e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756384998</data>
</node>
<node id="Larval growth">
  <data key="d0">Larval growth</data>
  <data key="d1">category</data>
  <data key="d2">Larval growth refers to the changes in size and weight of Tenebrio molitor larvae under different diets.</data>
  <data key="d3">chunk-9d7500fe4985cb2b885f9eb244ed3c2e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756384998</data>
</node>
<node id="Gut fungi">
  <data key="d0">Gut fungi</data>
  <data key="d1">category</data>
  <data key="d2">Gut fungi are fungal communities in the larvae gut that shifted depending on the type of plastic diet.</data>
  <data key="d3">chunk-9d7500fe4985cb2b885f9eb244ed3c2e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756384999</data>
</node>
<node id="Plastic polymerization types">
  <data key="d0">Plastic polymerization types</data>
  <data key="d1">category</data>
  <data key="d2">Plastic polymerization types refer to the structural differences in plastics such as PP, PU, EVA, PS, and LDPE, which influenced larval survival and microbiome composition.</data>
  <data key="d3">chunk-9d7500fe4985cb2b885f9eb244ed3c2e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756384999</data>
</node>
