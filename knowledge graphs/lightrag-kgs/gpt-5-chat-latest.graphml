  <data key="d0">1H NMR Analysis</data>
  <data key="d1">event</data>
  <data key="d2">1H NMR analysis was conducted on frass extracts to identify new peaks associated with chemical transformations in polystyrene residues within the larval gut.</data>
  <data key="d3">chunk-edd352a71a8bc6e66ece9484f8b59118</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373099</data>
