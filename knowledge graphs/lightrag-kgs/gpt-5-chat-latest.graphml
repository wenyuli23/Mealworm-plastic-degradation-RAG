<node id="NPs (Nanoplastics)">
  <data key="d0">NPs (Nanoplastics)</data>
  <data key="d1">category</data>
  <data key="d2">NPs refer to nanosized plastic particles that result from biofragmentation of microplastics but were not detected in mealworm frass due to rapid biodegradation.</data>
  <data key="d3">chunk-d47e7fe379fcd6b17740bc4d953cd3b1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756387103</data>
