  <data key="d1">person</data>
  <data key="d2">Rojas-Jiménez and Hernández are cited researchers who reported fungal taxa isolated from Tenebrionidae beetles including T. molitor.</data>
  <data key="d3">chunk-32f340b7166025be3c56178a94ae480d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756382402</data>
