  <data key="d0">Plastic Degradation Microbial Community</data>
  <data key="d1">category</data>
  <data key="d2">A microbial community formed on PS film surfaces, studied for its ability to degrade plastic.</data>
  <data key="d3">chunk-eda80cb027c8107defa00011d491b002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756375033</data>
