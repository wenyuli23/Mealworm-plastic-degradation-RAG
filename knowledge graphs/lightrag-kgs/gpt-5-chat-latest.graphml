  <data key="d1">category</data>
  <data key="d2">Prooxidant additives are used to enhance biodegradation of polyethylene films.</data>
  <data key="d3">chunk-ca3745cb01a4209e2eae28914dde3b52</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756383298</data>
</node>
<node id="Uloma sp. Larvae">
  <data key="d0">Uloma sp. Larvae</data>
  <data key="d1">organization</data>
  <data key="d2">Uloma sp. larvae are honey bee pests studied for their ability to biodegrade polyethylene and complete their life cycle on polyethylene-fed diets.</data>
  <data key="d3">chunk-ca3745cb01a4209e2eae28914dde3b52</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756383298</data>
