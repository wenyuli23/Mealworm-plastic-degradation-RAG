  <data key="d5">1756386812</data>
</node>
<node id="Hierarchical Cluster Analysis">
  <data key="d0">Hierarchical Cluster Analysis</data>
  <data key="d1">category</data>
  <data key="d2">Hierarchical cluster analysis was used to study gut bacterial communities in bran- or plastics-fed superworms and yellow mealworms.&lt;SEP&gt;Hierarchical cluster analysis was used to analyze the predominant populations of the mealworm gut microbiome under alternating feeding patterns.</data>
  <data key="d3">chunk-64e35cb810117768309e5f4db5d7e6b8&lt;SEP&gt;chunk-df045e015825dac8935c9c6d8a402cda</data>
