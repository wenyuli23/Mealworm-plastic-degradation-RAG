  <data key="d0">Blue Mussel (Mytilus edulis L)</data>
  <data key="d1">category</data>
  <data key="d2">The blue mussel is an aquatic organism in which internalization of polyethylene microplastics has been observed.</data>
  <data key="d3">chunk-84a8f1c256b1141b6bd2b404e817dfb7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756387072</data>
