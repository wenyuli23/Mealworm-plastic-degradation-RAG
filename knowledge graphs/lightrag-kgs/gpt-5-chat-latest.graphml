  <data key="d4">unknown_source</data>
  <data key="d5">1756374556</data>
</node>
<node id="Air Pollution">
  <data key="d0">Air Pollution</data>
  <data key="d1">category</data>
  <data key="d2">Air pollution results from the incineration of plastic wastes, releasing harmful pollutants such as VOCs, PAHs, dioxins, and heavy metals.&lt;SEP&gt;Air pollution is mentioned as one of the major environmental issues alongside microplastic, water, and soil pollution.</data>
  <data key="d3">chunk-918d0788c95399a6714bd40c688594de&lt;SEP&gt;chunk-1b0664a95aeeb896dcab096b098c3b54</data>
