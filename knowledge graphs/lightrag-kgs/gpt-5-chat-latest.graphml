  <data key="d0">Plesiophthalmus davidiis larvae</data>
  <data key="d1">category</data>
  <data key="d2">Plesiophthalmus davidiis larvae are studied for their gut microbial flora that enables biodegradation of polystyrene.</data>
  <data key="d3">chunk-7232abef4870641de7945afeb6a4bf93</data>
