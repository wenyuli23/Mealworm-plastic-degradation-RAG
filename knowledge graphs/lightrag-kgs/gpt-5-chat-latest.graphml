  <data key="d1">event</data>
  <data key="d2">Nitrogen isotopic analysis is an experimental method used to provide evidence of nitrogen assimilation in mealworms.</data>
  <data key="d3">chunk-813b71242f366f10218c10631cd7dee8</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756385963</data>
