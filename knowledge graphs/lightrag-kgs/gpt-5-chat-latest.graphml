<node id="RNA-Seq">
  <data key="d0">RNA-Seq</data>
  <data key="d1">organization</data>
  <data key="d2">RNA-Seq is the sequencing method used to analyze differential gene expression (DEGs) in mealworms fed on plastics and bran.</data>
  <data key="d3">chunk-f38f2f3673b813b3a817c014229c9565</data>
  <data key="d4">unknown_source</data>
