  <data key="d5">1756380188</data>
</node>
<node id="Flagellar assembly">
  <data key="d0">Flagellar assembly</data>
  <data key="d1">organization</data>
  <data key="d2">Flagellar assembly is a pathway enriched in PP-fed microbiota, aiding bacterial motility and colonization.</data>
  <data key="d3">chunk-0817d79fa27f2f5b078e09086250c6e0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756378171</data>
</node>
<node id="Nitrogen metabolism pathway (KO00910)">
  <data key="d0">Nitrogen metabolism pathway (KO00910)</data>
  <data key="d1">organization</data>
  <data key="d2">The nitrogen metabolism pathway (KO00910) was enriched in PP-fed groups, indicating nitrogen fixation by intestinal bacteria.</data>
