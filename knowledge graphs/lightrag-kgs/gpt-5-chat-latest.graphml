  <data key="d0">Larvae of the greater wax moth</data>
  <data key="d1">category</data>
  <data key="d2">Larvae of the greater wax moth were studied for their potential to degrade polyethylene, with mixed results across different studies.</data>
  <data key="d3">chunk-b08485bef3ee3db21e59e159ad4c3e20</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756375868</data>
