  <data key="d0">Limited extent depolymerization (LD) pattern</data>
  <data key="d1">category</data>
  <data key="d2">LD pattern refers to a biodegradation process where polymers with high molecular weight degrade slowly or accumulate, showing limited depolymerization.</data>
  <data key="d3">chunk-1679027e80b766e0469f7323db15b497</data>
  <data key="d4">unknown_source</data>
