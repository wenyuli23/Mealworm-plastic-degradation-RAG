<node id="Plastic-degrading gut bacteria">
  <data key="d0">Plastic-degrading gut bacteria</data>
  <data key="d1">category</data>
  <data key="d2">Plastic-degrading gut bacteria are microorganisms enriched and characterized using LCFBM medium.</data>
