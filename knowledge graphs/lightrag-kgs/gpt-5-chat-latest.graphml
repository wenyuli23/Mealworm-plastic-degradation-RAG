</node>
<node id="Selenomonadales">
  <data key="d0">Selenomonadales</data>
  <data key="d1">category</data>
  <data key="d2">Selenomonadales is a bacterial order with a mean abundance of 3.0%, highest in the CEL group.&lt;SEP&gt;An order of bacteria uniquely increased in CEL diet.</data>
  <data key="d3">chunk-f0e30f29e9016acae216566f53e60cea&lt;SEP&gt;chunk-84297b844ec01d2f58756b669806fd62</data>
  <data key="d4">unknown_source</data>
