  <data key="d1">category</data>
  <data key="d2">A proposed method of resource recovery using PLA waste as feedstock for insect biomass production with Tenebrio molitor larvae.</data>
  <data key="d3">chunk-22ae90a77be18cbac99e5441d47ce2d7</data>
