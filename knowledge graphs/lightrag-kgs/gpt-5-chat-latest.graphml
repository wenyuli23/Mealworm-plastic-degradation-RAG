</node>
<node id="Quorum sensing">
  <data key="d0">Quorum sensing</data>
  <data key="d1">organization</data>
  <data key="d2">Quorum sensing is a chemotaxis-related pathway enriched in PP-fed microbiota, enabling coordination among gut microbes during PP degradation.</data>
  <data key="d3">chunk-0817d79fa27f2f5b078e09086250c6e0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756378171</data>
</node>
<node id="Bacterial chemotaxis">
  <data key="d0">Bacterial chemotaxis</data>
  <data key="d1">category</data>
  <data key="d2">Bacterial chemotaxis is a pathway enriched in PP-fed microbiota, supporting bacterial motility and colonization.&lt;SEP&gt;Bacterial chemotaxis is described as a process linked to the two-component system in gut flora during PE degradation.</data>
  <data key="d3">chunk-0817d79fa27f2f5b078e09086250c6e0&lt;SEP&gt;chunk-5b30daa90b5c91314e1d65e87f191166</data>
