  <data key="d4">unknown_source</data>
  <data key="d5">1756377806</data>
</node>
<node id="Huang et al., 2012">
  <data key="d0">Huang et al., 2012</data>
  <data key="d1">person</data>
  <data key="d2">Huang et al. are cited authors who reported that the intestinal microbiota of mealworm larvae can degrade cellulose.</data>
