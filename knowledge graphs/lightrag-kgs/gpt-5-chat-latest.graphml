  <data key="d0">Rahnella</data>
  <data key="d1">organization</data>
  <data key="d2">Rahnella is a genus of bacteria identified in the gut of mealworms.</data>
  <data key="d3">chunk-32f340b7166025be3c56178a94ae480d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756382398</data>
</node>
<node id="Cronobacter">
  <data key="d0">Cronobacter</data>
  <data key="d1">organization</data>
  <data key="d2">Cronobacter is a genus of bacteria identified in the gut of mealworms.&lt;SEP&gt;Cronobacter is a bacterial genus identified in the gut microbiota of polystyrene-fed Alphitobius diaperinus.&lt;SEP&gt;Cronobacter is a Gram-negative bacterial genus found to be significantly over-represented in PS samples.&lt;SEP&gt;Cronobacter is a bacterial genus found to be significantly more abundant in PS samples and possibly associated with polystyrene degradation.&lt;SEP&gt;Cronobacter is a Gram-negative bacterium known to create biofilms on plastic surfaces, though not recorded as involved in plastic breakdown.</data>
  <data key="d3">chunk-d9095195e9cf06b9887c03abde6284d8&lt;SEP&gt;chunk-a1070f8c33eb8afcfcffac95df9012d3&lt;SEP&gt;chunk-001e8f54368c9a236f702fd09cddf4a8&lt;SEP&gt;chunk-9b4b45d826a6a7956015e680f5fb8ee6&lt;SEP&gt;chunk-32f340b7166025be3c56178a94ae480d</data>
