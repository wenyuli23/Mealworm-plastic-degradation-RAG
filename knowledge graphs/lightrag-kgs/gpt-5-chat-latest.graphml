</edge>
<edge source="Mealworm larvae" target="Physiological responses">
  <data key="d6">9.0</data>
  <data key="d7">Mealworm larvae exhibit physiological responses when fed polyethylene microplastics.</data>
  <data key="d8">biological effect,physiological change</data>
  <data key="d9">chunk-4f7d44b3f99233bb4389ceea0cd62617</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1756370916</data>
</edge>
<edge source="Mealworm larvae" target="PLA (Polylactic Acid)">
  <data key="d6">8.0</data>
  <data key="d7">Mealworm larvae were previously tested with PLA, a bio-based degradable plastic, showing higher consumption rates than with PE.</data>
  <data key="d8">bio-based plastic,plastic degradation</data>
  <data key="d9">chunk-f54f1dd7372cfa3dc5f348864eed2261</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1756370934</data>
</edge>
<edge source="Mealworm larvae" target="Wheat bran">
  <data key="d6">10.0</data>
  <data key="d7">Wheat bran was used as a co-diet with plastics, increasing the consumption rate of plastics by mealworm larvae.</data>
  <data key="d8">diet enhancement,plastic consumption</data>
  <data key="d9">chunk-f54f1dd7372cfa3dc5f348864eed2261</data>
  <data key="d10">unknown_source</data>
