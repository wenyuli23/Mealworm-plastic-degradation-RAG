<node id="PS Plate">
  <data key="d0">PS Plate</data>
  <data key="d1">category</data>
  <data key="d2">Polystyrene (PS) plates of known weight were used as a food source to test ingestion and degradation by T. molitor larvae and adults.</data>
  <data key="d3">chunk-39c4ff9e5812f88117b37503a70b0479</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756377444</data>
