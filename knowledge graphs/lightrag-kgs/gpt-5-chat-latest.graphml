<node id="Virgin PET">
  <data key="d0">Virgin PET</data>
  <data key="d1">category</data>
  <data key="d2">Virgin PET refers to untreated PET polymer used as a baseline for isotopic comparison in biodegradation analysis.&lt;SEP&gt;Virgin PET refers to untreated PET polymers before biodegradation, used as a baseline for comparison in the study.</data>
  <data key="d3">chunk-e24cc3865ed97850c3f25795ff514e8d&lt;SEP&gt;chunk-a88f3ed3eec20cee61421cc094dde89f</data>
