<node id="Soxhlet extractor">
  <data key="d0">Soxhlet extractor</data>
  <data key="d1">category</data>
  <data key="d2">Soxhlet extractor was used with tetrahydrofuran (THF) to extract plastic fragments from frass.</data>
  <data key="d3">chunk-9dfcb3f2424bd027b5888293a0d01d3c</data>
  <data key="d4">unknown_source</data>
