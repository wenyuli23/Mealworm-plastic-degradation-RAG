  <data key="d0">Figure 17</data>
  <data key="d1">event</data>
  <data key="d2">Figure 17 presents FTIR analysis results of LDPE beads, showing differences between control and PM S1 treated samples.</data>
  <data key="d3">chunk-262bed73e929944e03b9f72769b8196c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756371421</data>
</node>
