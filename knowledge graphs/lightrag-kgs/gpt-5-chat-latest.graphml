<node id="Bray-Curtis Dissimilarity Index">
  <data key="d0">Bray-Curtis Dissimilarity Index</data>
  <data key="d1">category</data>
  <data key="d2">The Bray-Curtis dissimilarity index is used to quantify differences in gut microbiome community structure in T. molitor larvae under different diets.</data>
