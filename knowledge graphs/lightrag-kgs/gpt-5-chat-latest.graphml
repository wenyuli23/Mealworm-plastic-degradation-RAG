  <data key="d0">Tricarboxylic acid (TCA) cycle</data>
  <data key="d1">category</data>
  <data key="d2">The tricarboxylic acid (TCA) cycle is a metabolic pathway where intermediate compounds from styrene degradation are introduced, leading to CO2 and H2O.</data>
  <data key="d3">chunk-3815960770483b9c0a1579ca8442e3a6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373553</data>
</node>
<node id="Styrene oxide isomerase (SOI)">
  <data key="d0">Styrene oxide isomerase (SOI)</data>
  <data key="d1">category</data>
  <data key="d2">Styrene oxide isomerase (SOI) is an enzyme that converts styrene oxide to phenylacetaldehyde.</data>
  <data key="d3">chunk-3815960770483b9c0a1579ca8442e3a6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373553</data>
</node>
<node id="Cytosolic SMOs">
  <data key="d0">Cytosolic SMOs</data>
  <data key="d1">category</data>
  <data key="d2">Cytosolic SMOs are enzymes contrasted with membrane-bound SOIs in terms of localization.</data>
  <data key="d3">chunk-3815960770483b9c0a1579ca8442e3a6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373553</data>
</node>
<node id="Phenylacetaldehyde">
  <data key="d0">Phenylacetaldehyde</data>
  <data key="d1">category</data>
  <data key="d2">Phenylacetaldehyde is a compound formed from styrene oxide by SOI and later converted to phenylacetic acid.</data>
  <data key="d3">chunk-3815960770483b9c0a1579ca8442e3a6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373553</data>
</node>
<node id="Phenylacetic acid">
  <data key="d0">Phenylacetic acid</data>
  <data key="d1">category</data>
  <data key="d2">Phenylacetic acid is a compound formed from phenylacetaldehyde by phenylacetaldehyde dehydrogenase (PAD).&lt;SEP&gt;Phenylacetic acid was negatively correlated with the first PCA axis and associated with PE-reg and PE-oxo diets.</data>
  <data key="d3">chunk-3815960770483b9c0a1579ca8442e3a6&lt;SEP&gt;chunk-6f65bf081bdd3c6718fa0310993bfc0d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756377843</data>
</node>
<node id="Phenylacetaldehyde dehydrogenase (PAD)">
  <data key="d0">Phenylacetaldehyde dehydrogenase (PAD)</data>
  <data key="d1">category</data>
  <data key="d2">Phenylacetaldehyde dehydrogenase (PAD) is an enzyme that converts phenylacetaldehyde to phenylacetic acid.</data>
  <data key="d3">chunk-3815960770483b9c0a1579ca8442e3a6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373554</data>
</node>
<node id="Phenylethanol">
  <data key="d0">Phenylethanol</data>
  <data key="d1">category</data>
  <data key="d2">Phenylethanol is a compound in equilibrium with phenylacetaldehyde, formed by the action of phenylacetaldehyde reductase (PAR).</data>
  <data key="d3">chunk-3815960770483b9c0a1579ca8442e3a6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373554</data>
</node>
<node id="Phenylacetaldehyde reductase (PAR)">
  <data key="d0">Phenylacetaldehyde reductase (PAR)</data>
  <data key="d1">category</data>
  <data key="d2">Phenylacetaldehyde reductase (PAR) is an enzyme that catalyzes the equilibrium between phenylethanol and phenylacetaldehyde.</data>
  <data key="d3">chunk-3815960770483b9c0a1579ca8442e3a6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373554</data>
</node>
<node id="Styrene oxide reductase (SOR)">
  <data key="d0">Styrene oxide reductase (SOR)</data>
  <data key="d1">category</data>
  <data key="d2">Styrene oxide reductase (SOR) is an enzyme involved in the formation of phenylethanol and phenylacetaldehyde.</data>
  <data key="d3">chunk-3815960770483b9c0a1579ca8442e3a6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373554</data>
</node>
<node id="Epoxide hydrolase (EH)">
