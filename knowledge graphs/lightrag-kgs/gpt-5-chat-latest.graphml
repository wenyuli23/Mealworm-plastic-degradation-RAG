  <data key="d0">Agglomerative Hierarchical Clustering</data>
  <data key="d1">category</data>
  <data key="d2">Agglomerative Hierarchical Clustering was used to analyze similarities in insect development across feed types.&lt;SEP&gt;Agglomerative Hierarchical Clustering was used to analyze dissimilarities between Tenebrio molitor diets based on biometry, microbiome, gene counts, fatty acids, and metabolism.</data>
  <data key="d3">chunk-1ead6f17ad517015b638608c5bfe6852&lt;SEP&gt;chunk-02f21478b87845df31740b3dab37d197</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756377824</data>
</node>
