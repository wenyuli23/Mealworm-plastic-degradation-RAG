  <data key="d4">unknown_source</data>
  <data key="d5">1756381980</data>
</node>
<node id="O-H stretching vibration">
  <data key="d0">O-H stretching vibration</data>
  <data key="d1">category</data>
  <data key="d2">O-H stretching vibration is a molecular vibration observed in microbial-treated PS films, associated with alcohols and phenols.</data>
  <data key="d3">chunk-9859524b7a6851b786570d2a704e34f3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756381980</data>
