  <data key="d1">event</data>
  <data key="d2">Day 21 observation refers to the survival rate comparison of Z. atratus larvae fed PP foam only versus unfed larvae.</data>
  <data key="d3">chunk-cd3092744be0c66dad5833977dedd913</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756385271</data>
</node>
<node id="Day 35 Observation">
  <data key="d0">Day 35 Observation</data>
  <data key="d1">event</data>
  <data key="d2">Day 35 observation refers to the survival rate comparison of Z. atratus larvae fed PP foam only versus unfed larvae, showing significantly lower survival.</data>
  <data key="d3">chunk-cd3092744be0c66dad5833977dedd913</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756385271</data>
</node>
<node id="Mature Larvae">
  <data key="d0">Mature Larvae</data>
  <data key="d1">category</data>
  <data key="d2">Mature larvae, with an average weight of around 630 mg per larva, showed strong cannibalistic behavior under nutritional limitation.</data>
  <data key="d3">chunk-cd3092744be0c66dad5833977dedd913</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756385271</data>
