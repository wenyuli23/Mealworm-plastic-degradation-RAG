  <data key="d0">Adipose Triglyceride Lipase (AGTL)</data>
  <data key="d1">organization</data>
  <data key="d2">AGTL is an enzyme responsible for hydrolyzing TAG into free fatty acids and glycerol.</data>
  <data key="d3">chunk-2e4030ea35bee29093c1a8f19bc90774</data>
  <data key="d4">unknown_source</data>
