</node>
<node id="Freshwater amphipod">
  <data key="d0">Freshwater amphipod</data>
  <data key="d1">organization</data>
  <data key="d2">Freshwater amphipods are macroinvertebrates with poor plastic-degrading ability, leading to biofragmentation of ingested plastics into nanoparticles.</data>
  <data key="d3">chunk-d47e7fe379fcd6b17740bc4d953cd3b1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756387102</data>
