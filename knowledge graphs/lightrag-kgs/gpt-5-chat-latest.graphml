<node id="Arrese and Soulages (2010)">
  <data key="d0">Arrese and Soulages (2010)</data>
  <data key="d1">person</data>
  <data key="d2">Arrese and Soulages are cited authors who reported that glycerol is a synthesis precursor of triacylglycerols (TAG) and phospholipids.</data>
  <data key="d3">chunk-2e4030ea35bee29093c1a8f19bc90774</data>
  <data key="d4">unknown_source</data>
