<node id="Phospholipids">
  <data key="d0">Phospholipids</data>
  <data key="d1">category</data>
  <data key="d2">Phospholipids are molecules synthesized from glycerol, important for cellular membranes and energy storage.</data>
  <data key="d3">chunk-2e4030ea35bee29093c1a8f19bc90774</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756377124</data>
