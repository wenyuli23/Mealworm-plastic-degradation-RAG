  <data key="d0">Physical Body Length (L_w)</data>
  <data key="d1">category</data>
  <data key="d2">Physical body length (L_w) is a measured variable representing the physical body length of the organism.</data>
  <data key="d3">chunk-355ef52836a4c27f1290730187a78818</data>
  <data key="d4">unknown_source</data>
