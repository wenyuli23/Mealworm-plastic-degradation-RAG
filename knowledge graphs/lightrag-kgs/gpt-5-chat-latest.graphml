  <data key="d4">unknown_source</data>
  <data key="d5">1756380144</data>
</node>
<node id="Absorption">
  <data key="d0">Absorption</data>
  <data key="d1">category</data>
  <data key="d2">Absorption is a gut function in insects, allowing nutrients and energy to be taken up during plastic degradation.</data>
