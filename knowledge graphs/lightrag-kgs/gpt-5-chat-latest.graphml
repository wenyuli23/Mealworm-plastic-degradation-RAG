  <data key="d4">unknown_source</data>
  <data key="d5">1756377614</data>
</node>
<node id="Red Ceramics">
  <data key="d0">Red Ceramics</data>
  <data key="d1">category</data>
  <data key="d2">Red ceramics, including bricks and hollow wall elements, are construction materials that can be recycled into lightweight aggregate for new concrete.</data>
