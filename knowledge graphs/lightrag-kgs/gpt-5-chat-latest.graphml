<node id="Lightweight Aggregate">
  <data key="d0">Lightweight Aggregate</data>
  <data key="d1">category</data>
  <data key="d2">Lightweight aggregate is a recycled material produced from crushed red ceramics, used in the production of new concrete.</data>
