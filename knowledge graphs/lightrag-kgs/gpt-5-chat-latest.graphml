  <data key="d0">Itoh et al., 1997a</data>
  <data key="d1">person</data>
  <data key="d2">Itoh et al., 1997a is cited as a study reference related to Corynebacterium and SOI localization.</data>
  <data key="d3">chunk-3815960770483b9c0a1579ca8442e3a6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373550</data>
</node>
<node id="Expanded PS (EPS) foam packaging">
  <data key="d0">Expanded PS (EPS) foam packaging</data>
  <data key="d1">category</data>
  <data key="d2">Expanded PS (EPS) foam packaging is a test material with a density of 0.014 g/cm³, used in the biodegradation experiments.&lt;SEP&gt;Expanded PS (EPS) foam packaging is a type of polystyrene material used in the biodegradation experiments.&lt;SEP&gt;Expanded PS (EPS) foam packaging with density 0.014 g/cm3 was purchased from a local market store and used in the experiments.</data>
  <data key="d3">chunk-30c4244cae75095bda7fb526c3d0c9d9&lt;SEP&gt;chunk-84f576487c8d473c1524eb1141730a12&lt;SEP&gt;chunk-3815960770483b9c0a1579ca8442e3a6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756377104</data>
</node>
<node id="H2O">
  <data key="d0">H2O</data>
  <data key="d1">category</data>
  <data key="d2">H2O (water) is described as essential for supporting bacterial growth, microbiome activity, oxygen supply, and larvae health in biodegradation processes.&lt;SEP&gt;H2O (water) is a mineralization product of plastic biodegradation.</data>
  <data key="d3">chunk-3815960770483b9c0a1579ca8442e3a6&lt;SEP&gt;chunk-7cbedc06292e5cf07fbca1958d8587e6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756386477</data>
</node>
<node id="Oligomers">
  <data key="d0">Oligomers</data>
  <data key="d1">category</data>
  <data key="d2">Oligomers are degradation products of styrene and polystyrene, metabolized by microorganisms or excreted in insect frass.&lt;SEP&gt;Oligomers are short-chain molecules derived from polystyrene that are susceptible to biodegradation.&lt;SEP&gt;Oligomers are products of enzymatic degradation of PS in insects, indicating breakdown of the polymer.</data>
  <data key="d3">chunk-e4443da1fe36ec7133cd5add18d1957a&lt;SEP&gt;chunk-3815960770483b9c0a1579ca8442e3a6&lt;SEP&gt;chunk-2ddf4b13293dd3d8d0887af10fc52c98</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756382570</data>
</node>
<node id="Monomers">
  <data key="d0">Monomers</data>
  <data key="d1">category</data>
  <data key="d2">Monomers are degradation products of styrene and polystyrene, metabolized by microorganisms or excreted in insect frass.</data>
  <data key="d3">chunk-3815960770483b9c0a1579ca8442e3a6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373551</data>
</node>
<node id="Aerobic degradation">
  <data key="d0">Aerobic degradation</data>
  <data key="d1">category</data>
  <data key="d2">Aerobic degradation is a metabolic pathway of styrene involving oxygen, leading to breakdown into CO2 and H2O.</data>
  <data key="d3">chunk-3815960770483b9c0a1579ca8442e3a6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373552</data>
</node>
<node id="Anaerobic degradation">
  <data key="d0">Anaerobic degradation</data>
  <data key="d1">category</data>
  <data key="d2">Anaerobic degradation is a metabolic pathway of styrene without oxygen, leading to breakdown into CO2 and H2O.</data>
  <data key="d3">chunk-3815960770483b9c0a1579ca8442e3a6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373552</data>
</node>
<node id="Insects' frass">
  <data key="d0">Insects' frass</data>
  <data key="d1">category</data>
  <data key="d2">Insects' frass is the excreted material from larvae, containing small amounts of monomers and oligomers after biodegradation.</data>
  <data key="d3">chunk-3815960770483b9c0a1579ca8442e3a6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373552</data>
</node>
