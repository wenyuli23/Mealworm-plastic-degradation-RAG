<node id="Enterobacter asburiae">
  <data key="d0">Enterobacter asburiae</data>
  <data key="d1">organization</data>
  <data key="d2">A bacterial species identified among isolates, capable of degrading polyethylene and associated with plastic-eating waxworms.&lt;SEP&gt;Enterobacter asburiae is a bacterial species identified in insect guts with plastic-degrading ability.&lt;SEP&gt;Enterobacter asburiae is a bacterial species related to Enterobacter muelleri through taxonomic synonymy.</data>
  <data key="d3">chunk-53d382cbd1392dbcf9530428c2eb8584&lt;SEP&gt;chunk-eda80cb027c8107defa00011d491b002&lt;SEP&gt;chunk-d4af956dbe737dee68ab6b9834fe2fcc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756385721</data>
</node>
<node id="Stenotrophomonas maltophilia">
  <data key="d0">Stenotrophomonas maltophilia</data>
  <data key="d1">organization</data>
  <data key="d2">A bacterial species identified among isolates, capable of cyclic hydrocarbon degradation, with enhanced biodegradation in the presence of surfactants.</data>
  <data key="d3">chunk-eda80cb027c8107defa00011d491b002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756375034</data>
</node>
<node id="Mealworm Gut">
  <data key="d0">Mealworm Gut</data>
  <data key="d1">category</data>
  <data key="d2">The gut of mealworms, a biological environment where PS degradation occurs naturally.&lt;SEP&gt;The mealworm gut, consisting of foregut, midgut, and hindgut, was dissected and studied for microbial diversity and biodegradation abilities.&lt;SEP&gt;The gut of mealworms where depolymerization and digestion of polystyrene occur, producing fecula.&lt;SEP&gt;The mealworm gut is the biological site where EPS biodegradation occurs, involving bacteria and enzymatic processes.&lt;SEP&gt;The mealworm gut is studied for its role in polystyrene (PS) biodegradation and mineralization.&lt;SEP&gt;The mealworm gut was the source of nanoplastic-degrading bacteria used in protease enzyme testing.</data>
  <data key="d3">chunk-10004ab6a85cecf4effb74c306df57cf&lt;SEP&gt;chunk-262d7fa1c8f2581943a41cf4897fa253&lt;SEP&gt;chunk-eda80cb027c8107defa00011d491b002&lt;SEP&gt;chunk-96c2e7d253d2108b0ed94be7f2dc7466&lt;SEP&gt;chunk-15323ef47e29f2927f95274e49f4e5bf&lt;SEP&gt;chunk-069f8447676509ffdd0028e9c05fb9ab</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756381127</data>
</node>
<node id="Waxworms (P. interpunctella)">
  <data key="d0">Waxworms (P. interpunctella)</data>
  <data key="d1">geo</data>
  <data key="d2">The gut of waxworms, from which Enterobacter asburiae was isolated and shown to degrade polyethylene.</data>
  <data key="d3">chunk-eda80cb027c8107defa00011d491b002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756375035</data>
</node>
<node id="Carbon-Rich Media">
  <data key="d0">Carbon-Rich Media</data>
  <data key="d1">category</data>
  <data key="d2">Growth medium used to culture bacterial colonies before transferring them to carbon-free media with PS films.</data>
  <data key="d3">chunk-eda80cb027c8107defa00011d491b002</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756375035</data>
</node>
<node id="PS Gut Supernatant">
  <data key="d0">PS Gut Supernatant</data>
  <data key="d1">category</data>
  <data key="d2">A supplement derived from the gut of PS-degrading organisms, added to cultures to enhance biodegradation.</data>
  <data key="d3">chunk-eda80cb027c8107defa00011d491b002</data>
