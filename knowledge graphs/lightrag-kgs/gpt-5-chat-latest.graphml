<node id="Greater Waxmoth Larvae (Galleria mellonella L.)">
  <data key="d0">Greater Waxmoth Larvae (Galleria mellonella L.)</data>
  <data key="d1">organization</data>
  <data key="d2">Greater waxmoth larvae are studied for biodegradation of polyethylene and polypropylene and the effect of diet supplementation on their gut microbiome.</data>
  <data key="d3">chunk-ca3745cb01a4209e2eae28914dde3b52</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756383299</data>
</node>
<node id="Plastic Material Debris">
  <data key="d0">Plastic Material Debris</data>
  <data key="d1">category</data>
  <data key="d2">Plastic material debris is studied for environmental degradation trends based on physical properties and molecular structure.</data>
  <data key="d3">chunk-ca3745cb01a4209e2eae28914dde3b52</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756383299</data>
