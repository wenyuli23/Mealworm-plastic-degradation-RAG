  <data key="d5">1756387425</data>
</node>
<node id="Intestinal Inflammation">
  <data key="d0">Intestinal Inflammation</data>
  <data key="d1">category</data>
  <data key="d2">Intestinal inflammation is a condition caused by imbalanced gut microbiota or mechanical stimulation from microplastics, leading to immune activation.</data>
  <data key="d3">chunk-d8c6850a83a1c6efd4f1a3a37a0a8181</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756380144</data>
</node>
<node id="Immunity">
  <data key="d0">Immunity</data>
  <data key="d1">category</data>
  <data key="d2">Immunity refers to the gut’s role as a defense mechanism against exogenous substances and its involvement in immune responses during plastic degradation.</data>
  <data key="d3">chunk-d8c6850a83a1c6efd4f1a3a37a0a8181</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756380144</data>
</node>
<node id="Digestion">
  <data key="d0">Digestion</data>
  <data key="d1">category</data>
  <data key="d2">Digestion is a gut function in insects, essential for breaking down ingested plastics and nutrients.</data>
