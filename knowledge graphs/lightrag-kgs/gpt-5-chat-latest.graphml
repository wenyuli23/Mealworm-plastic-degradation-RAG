<node id="DEB model">
  <data key="d0">DEB model</data>
  <data key="d1">category</data>
  <data key="d2">The DEB (Dynamic Energy Budget) model is used to describe organism survival, growth, and reproduction based on energy allocation.&lt;SEP&gt;The DEB (Dynamic Energy Budget) model is used to analyze growth, reproduction, and toxic effects in T. molitor larvae.&lt;SEP&gt;The DEB (Dynamic Energy Budget) model is used to analyze changes in the development of T. molitor larvae based on reserve dynamics.</data>
  <data key="d3">chunk-e819d53f76bcab4b74eba714efd32163&lt;SEP&gt;chunk-998b63e5349034d477c2087c139669ed&lt;SEP&gt;chunk-91831340731171413dc4c412a325e034</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756388212</data>
</node>
<node id="PS mass loss experiment">
  <data key="d0">PS mass loss experiment</data>
  <data key="d1">event</data>
  <data key="d2">An experiment measuring the mass loss of polystyrene (PS) chips over 20, 30, 40, and 50 days with larvae present.</data>
  <data key="d3">chunk-998b63e5349034d477c2087c139669ed</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756388213</data>
</node>
