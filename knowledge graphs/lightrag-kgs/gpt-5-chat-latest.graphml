<node id="Wilson, 1971">
  <data key="d0">Wilson, 1971</data>
  <data key="d1">person</data>
  <data key="d2">Wilson, 1971 suggested that larval-to-adult jaw structure changes may explain why adult T. molitor cannot consume PS.</data>
  <data key="d3">chunk-5318125e74217718b470b7721d1d6365</data>
  <data key="d4">unknown_source</data>
