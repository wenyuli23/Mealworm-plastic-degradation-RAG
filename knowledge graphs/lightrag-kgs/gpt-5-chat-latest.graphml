  <data key="d0">Thiol peroxidase (tpx)</data>
  <data key="d1">organization</data>
  <data key="d2">Thiol peroxidase (tpx) is one of the degradative enzymes identified in Enterobacter hormaechei LG3.</data>
  <data key="d3">chunk-a7cbc8be34e0de8aebc6fd547bacc627</data>
