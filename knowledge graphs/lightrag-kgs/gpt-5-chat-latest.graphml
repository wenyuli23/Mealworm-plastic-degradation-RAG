  <data key="d0">Enterobacter absuriae YTI</data>
  <data key="d1">organization</data>
  <data key="d2">Enterobacter absuriae YTI is a PE-degrading bacterial strain isolated from the gut of Indian mealmoth larvae, mentioned as related to Enterobacteriaceae family.</data>
  <data key="d3">chunk-17b1e554820493d86eb8bc96ba8bef37</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756381390</data>
</node>
<node id="Indian Mealmoth">
