  <data key="d4">unknown_source</data>
  <data key="d5">1756373547</data>
</node>
<node id="Protein Content">
  <data key="d0">Protein Content</data>
  <data key="d1">category</data>
  <data key="d2">Protein content in insect biomass varied depending on diet, being higher in Diet 3 and reduced in Diets 1 and 2.</data>
  <data key="d3">chunk-6e415042ae4079ee5fe96c7105eb534c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373548</data>
</node>
<node id="NIAS (Non-intentionally added substances)">
  <data key="d0">NIAS (Non-intentionally added substances)</data>
  <data key="d1">category</data>
  <data key="d2">NIAS are degradation compounds observed in different amounts depending on diet, with lower levels in Diet 2.</data>
  <data key="d3">chunk-6e415042ae4079ee5fe96c7105eb534c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373548</data>
</node>
<node id="Degradation Compounds">
  <data key="d0">Degradation Compounds</data>
  <data key="d1">category</data>
  <data key="d2">Degradation compounds are byproducts of PS biodegradation, observed in varying amounts across diets.</data>
  <data key="d3">chunk-6e415042ae4079ee5fe96c7105eb534c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373548</data>
</node>
