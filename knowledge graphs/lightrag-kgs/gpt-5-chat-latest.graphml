  <data key="d0">Broad extent depolymerization (BD) pattern</data>
  <data key="d1">category</data>
  <data key="d2">BD pattern refers to a biodegradation process where polymers with low or medium molecular weight undergo significant depolymerization.</data>
  <data key="d3">chunk-1679027e80b766e0469f7323db15b497</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379698</data>
