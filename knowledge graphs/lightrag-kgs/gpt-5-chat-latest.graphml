<node id="Resource Utilization Efficiency">
  <data key="d0">Resource Utilization Efficiency</data>
  <data key="d1">category</data>
  <data key="d2">Resource utilization efficiency refers to how effectively microbial communities use available resources, which increased under PE diet conditions.</data>
  <data key="d3">chunk-6ac1b1db6ffab6f4cfea7a525785a2fc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756380174</data>
