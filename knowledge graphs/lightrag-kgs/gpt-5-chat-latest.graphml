  <data key="d1">category</data>
  <data key="d2">Antarctic krill are organisms that fragment ingested polyethylene microplastics into smaller particles, including nanoplastics.</data>
  <data key="d3">chunk-84a8f1c256b1141b6bd2b404e817dfb7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756387072</data>
</node>
