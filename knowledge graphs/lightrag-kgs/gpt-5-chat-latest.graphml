<node id="Deterministic Ecological Processes">
  <data key="d0">Deterministic Ecological Processes</data>
  <data key="d1">category</data>
  <data key="d2">Deterministic ecological processes influenced 68% of microbial community assembly, driven by diet and species.</data>
  <data key="d3">chunk-6ac1b1db6ffab6f4cfea7a525785a2fc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756380175</data>
</node>
<node id="Stochastic Ecological Processes">
  <data key="d0">Stochastic Ecological Processes</data>
  <data key="d1">category</data>
  <data key="d2">Stochastic ecological processes influenced microbial community assembly, including weak selection, dispersal, diversification, and drift.</data>
