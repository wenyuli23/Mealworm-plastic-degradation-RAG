  <data key="d5">1756376874</data>
</node>
<node id="Soils">
  <data key="d0">Soils</data>
  <data key="d1">geo</data>
  <data key="d2">Soils were used as microbial communities in biodegradation studies of polystyrene.&lt;SEP&gt;Soils were used as environmental microbial sources in biodegradation tests of plastics.&lt;SEP&gt;Soils are one of the environmental sources from which microorganisms capable of degrading PE have been isolated.</data>
  <data key="d3">chunk-a1006283f24aba2aa605f9e719f36cf9&lt;SEP&gt;chunk-9aa972c0f1c2838103f61cd8ae101a8f&lt;SEP&gt;chunk-7432cb0d6c74fd2dd80b065fbad26b4b</data>
