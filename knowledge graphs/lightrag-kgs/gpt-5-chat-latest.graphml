  <data key="d0">Pseudomonas M7</data>
  <data key="d1">organization</data>
  <data key="d2">A bacterial strain identified and deposited in NCBI with accession number PP126566.</data>
  <data key="d3">chunk-01bf9080cbf55e62c0b26d0e054bd1fa</data>
