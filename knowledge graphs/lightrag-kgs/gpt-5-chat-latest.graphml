<node id="Oxygen Functional Groups">
  <data key="d0">Oxygen Functional Groups</data>
  <data key="d1">category</data>
  <data key="d2">Oxygen functional groups such as carbonyl, hydroxyl, and carboxylic acid groups were incorporated into PS polymers during biodegradation, indicating oxidation and depolymerization.</data>
  <data key="d3">chunk-e340b8704554cdc28486ac37e78ab0fa</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756384009</data>
</node>
