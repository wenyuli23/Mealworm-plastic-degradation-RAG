  <data key="d0">Polyolefin</data>
  <data key="d1">category</data>
  <data key="d2">Polyolefin is a type of plastic purchased from specialty stores and used as an experimental feedstock in the study.</data>
  <data key="d3">chunk-444b8acd02a76616457012e1ac0db23b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756384999</data>
