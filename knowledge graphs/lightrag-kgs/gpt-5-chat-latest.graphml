  <data key="d0">Low-crystallinity PET</data>
  <data key="d1">category</data>
  <data key="d2">Low-crystallinity PET (1.90%) was used in microbial degradation studies with Ideonella sakaiensis 201-F6.</data>
  <data key="d3">chunk-a88f3ed3eec20cee61421cc094dde89f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379731</data>
</node>
<node id="CFUs">
  <data key="d0">CFUs</data>
  <data key="d1">category</data>
  <data key="d2">Colony-forming units (CFUs) were used to measure microbial populations in larvae gut samples, showing suppression after antibiotic treatment.</data>
  <data key="d3">chunk-a88f3ed3eec20cee61421cc094dde89f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379731</data>
</node>
<node id="CEUs">
  <data key="d0">CEUs</data>
  <data key="d1">category</data>
  <data key="d2">CEUs were measured in the non-treatment control group, indicating higher microbial presence compared to antibiotic-treated larvae.</data>
  <data key="d3">chunk-a88f3ed3eec20cee61421cc094dde89f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379731</data>
</node>
<node id="GPC analyses">
  <data key="d0">GPC analyses</data>
  <data key="d1">category</data>
  <data key="d2">Gel permeation chromatography (GPC) analyses were used to measure PET depolymerization in larvae under antibiotic and non-antibiotic conditions.&lt;SEP&gt;GPC analyses refer to gel permeation chromatography used to study PP biodegradation and depolymerization patterns in larvae.</data>
  <data key="d3">chunk-2efbc0287662aa64684e4db6a131c3de&lt;SEP&gt;chunk-a88f3ed3eec20cee61421cc094dde89f</data>
