<node id="PS foam waste">
  <data key="d0">PS foam waste</data>
  <data key="d1">category</data>
  <data key="d2">PS foam waste refers to polystyrene foam used as feed for mealworms, shown to be non-lethal but negatively affecting growth and reproduction.</data>
  <data key="d3">chunk-32f340b7166025be3c56178a94ae480d</data>
  <data key="d4">unknown_source</data>
