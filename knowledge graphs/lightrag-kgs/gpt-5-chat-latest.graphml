<node id="Triacylglycerols (TAG)">
  <data key="d0">Triacylglycerols (TAG)</data>
  <data key="d1">category</data>
  <data key="d2">TAG are molecules used by organisms to store energy, synthesized from glycerol and hydrolyzed into fatty acids and glycerol.</data>
  <data key="d3">chunk-2e4030ea35bee29093c1a8f19bc90774</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756377124</data>
