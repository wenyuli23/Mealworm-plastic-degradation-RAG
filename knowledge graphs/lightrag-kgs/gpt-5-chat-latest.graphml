<node id="Sample 1">
  <data key="d0">Sample 1</data>
  <data key="d1">category</data>
  <data key="d2">Sample 1 refers to one of the Klebsiella oxytoca colonies, described as round, cream, shiny, and the smallest among the isolates.&lt;SEP&gt;Sample 1 is one of the Klebsiella oxytoca strains tested for alkB gene amplification but showed no amplification.&lt;SEP&gt;Sample 1 did not show a band of amplification for the alkB gene.</data>
  <data key="d3">chunk-5b74e88d1f94354055e078b38af6a180&lt;SEP&gt;chunk-0cdc0cc71ed5e76f044e4db50f81ad2f&lt;SEP&gt;chunk-51daa29515cc5a431055291627bcb199</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756372031</data>
</node>
<node id="Sample 2">
  <data key="d0">Sample 2</data>
  <data key="d1">category</data>
  <data key="d2">Sample 2 refers to one of the Klebsiella oxytoca colonies, described as white, elongated, and larger than Sample 1.&lt;SEP&gt;Sample 2 is one of the Klebsiella oxytoca strains tested for alkB gene amplification but showed no amplification.&lt;SEP&gt;Sample 2 did not show a band of amplification for the alkB gene.</data>
  <data key="d3">chunk-5b74e88d1f94354055e078b38af6a180&lt;SEP&gt;chunk-0cdc0cc71ed5e76f044e4db50f81ad2f&lt;SEP&gt;chunk-51daa29515cc5a431055291627bcb199</data>
