  <data key="d1">category</data>
  <data key="d2">Epoxide hydrolase (EH) is an enzyme that hydrolyzes styrene oxide to phenylethanol-1,2-diol.</data>
  <data key="d3">chunk-3815960770483b9c0a1579ca8442e3a6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373554</data>
</node>
