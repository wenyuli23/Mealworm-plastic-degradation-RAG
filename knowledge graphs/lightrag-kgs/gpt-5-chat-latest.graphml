<node id="Treatment Groups">
  <data key="d0">Treatment Groups</data>
  <data key="d1">category</data>
  <data key="d2">The treatment groups consisted of T. molitor larvae fed with polystyrene (PS) plates to evaluate ingestion and degradation.</data>
