  <data key="d1">category</data>
  <data key="d2">Dispersal limitation accounted for 6% of microbial community assembly, as identified in the study.</data>
  <data key="d3">chunk-6ac1b1db6ffab6f4cfea7a525785a2fc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756380176</data>
