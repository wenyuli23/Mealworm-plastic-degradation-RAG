  <data key="d0">Residual PET</data>
  <data key="d1">category</data>
  <data key="d2">Residual PET refers to the portion of PET remaining in larval frass after biodegradation, which showed isotopic enrichment and mass reduction.&lt;SEP&gt;Residual PET refers to the remaining PET polymers after being consumed and partially degraded by T. molitor larvae.</data>
  <data key="d3">chunk-69679184959639a1ff81c7392cd5cef5&lt;SEP&gt;chunk-a88f3ed3eec20cee61421cc094dde89f</data>
