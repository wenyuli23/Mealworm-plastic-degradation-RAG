  <data key="d1">category</data>
  <data key="d2">Isopods are soil invertebrates tested for their ability to degrade polystyrene, but no biodegradation was observed.</data>
  <data key="d3">chunk-f7fa795762aa89809d8221dc9dda92fa</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756376864</data>
</node>
