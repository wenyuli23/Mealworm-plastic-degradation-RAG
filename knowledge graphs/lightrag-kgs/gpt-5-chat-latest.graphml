  <data key="d0">Pupal stage</data>
  <data key="d1">category</data>
  <data key="d2">The pupal stage is the developmental stage of the lesser waxworm where it forms cocoons and transitions into moths.</data>
  <data key="d3">chunk-5af82472112cbc9e76b1fd1ac6e8c54e</data>
  <data key="d4">unknown_source</data>
