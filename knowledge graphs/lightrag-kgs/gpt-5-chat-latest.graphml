  <data key="d0">3-Vinylcatechol</data>
  <data key="d1">category</data>
  <data key="d2">3-Vinylcatechol is a metabolic intermediate formed during styrene biodegradation, subject to cleavage by VC12O or VC23O.&lt;SEP&gt;3-Vinylcatechol is a compound that undergoes meta-cleavage breakdown by vinylcatechol dioxygenases.</data>
  <data key="d3">chunk-3815960770483b9c0a1579ca8442e3a6&lt;SEP&gt;chunk-6e415042ae4079ee5fe96c7105eb534c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373549</data>
</node>
