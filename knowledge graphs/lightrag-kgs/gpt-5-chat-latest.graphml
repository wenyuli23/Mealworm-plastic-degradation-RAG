</node>
<node id="Plastic-Degrading Microorganisms">
  <data key="d0">Plastic-Degrading Microorganisms</data>
  <data key="d1">category</data>
  <data key="d2">Plastic-degrading microorganisms are microbial species capable of breaking down plastic polymers, often found in insect gut microbiomes.</data>
  <data key="d3">chunk-07aae06c64778453da4bda48f5347de5</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756375007</data>
