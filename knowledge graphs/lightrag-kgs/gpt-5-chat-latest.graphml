<node id="1,2 DCB (1,2-Dichlorobenzene)">
  <data key="d0">1,2 DCB (1,2-Dichlorobenzene)</data>
  <data key="d1">category</data>
  <data key="d2">1,2 DCB is a solvent used to extract LDPE and PP from frass.</data>
