  <data key="d0">Photochemical dissolution of buoyant microplastics</data>
  <data key="d1">event</data>
  <data key="d2">A process studied in 2020, focusing on the conversion of buoyant microplastics into dissolved organic carbon and its microbial impacts.</data>
  <data key="d3">chunk-5a7768b61a3d166f2cd01d4e87ac88cd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756383576</data>
</node>
