<node id="PS Samples">
  <data key="d0">PS Samples</data>
  <data key="d1">category</data>
  <data key="d2">PS (polystyrene) samples are the material subjected to degradation experiments with strain YT2 and R. ruber C208, showing weight and molecular weight loss.&lt;SEP&gt;PS samples are one of the experimental groups analyzed for bacterial and fungal diversity, showing distinct microbial compositions compared to CT samples.</data>
  <data key="d3">chunk-a1070f8c33eb8afcfcffac95df9012d3&lt;SEP&gt;chunk-8e38968f22c4cd9bef3f1562e4ca47e1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756384777</data>
</node>
<node id="GC">
  <data key="d0">GC</data>
  <data key="d1">organization</data>
  <data key="d2">GC (Gas Chromatography) was used to analyze extracts from cultures inoculated with strain YT2 and controls after 60 days.&lt;SEP&gt;GC (gas chromatography) was used to measure ethylene production in acetylene reduction assays.</data>
  <data key="d3">chunk-e37da2fbe64f85c50c36da45006f4c23&lt;SEP&gt;chunk-8e38968f22c4cd9bef3f1562e4ca47e1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756385977</data>
</node>
<node id="GC/MS">
  <data key="d0">GC/MS</data>
  <data key="d1">category</data>
  <data key="d2">GC/MS (Gas Chromatography-Mass Spectrometry) was used to analyze water-soluble products from PS pieces in the presence and absence of strain YT2.</data>
  <data key="d3">chunk-8e38968f22c4cd9bef3f1562e4ca47e1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756380711</data>
</node>
