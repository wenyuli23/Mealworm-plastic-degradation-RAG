<node id="Starving Superworms">
  <data key="d0">Starving Superworms</data>
  <data key="d1">category</data>
  <data key="d2">Starving superworms are used as a control group in experiments to measure endogenous respiration and compare CO₂ production against Styrofoam-eating superworms.</data>
  <data key="d3">chunk-497648a1cf8e41fac896250ae1eebbb1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756376207</data>
</node>
<node id="Styrofoam-eating Superworms">
  <data key="d0">Styrofoam-eating Superworms</data>
  <data key="d1">category</data>
  <data key="d2">Styrofoam-eating superworms are experimental groups of superworms that consume Styrofoam, producing higher CO₂ levels compared to starving superworms.</data>
  <data key="d3">chunk-497648a1cf8e41fac896250ae1eebbb1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756376207</data>
</node>
<node id="Antibiotic Suppression Assay">
  <data key="d0">Antibiotic Suppression Assay</data>
  <data key="d1">event</data>
  <data key="d2">The antibiotic suppression assay was conducted to test whether gut microbiota contributes to polystyrene degradation in superworms.</data>
  <data key="d3">chunk-497648a1cf8e41fac896250ae1eebbb1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756376208</data>
</node>
<node id="Metagenomics Sequencing">
  <data key="d0">Metagenomics Sequencing</data>
  <data key="d1">event</data>
  <data key="d2">Metagenomics sequencing-based functional annotations were suggested as a method to study gut microbiota and identify enzymes for polystyrene degradation.</data>
  <data key="d3">chunk-497648a1cf8e41fac896250ae1eebbb1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756376209</data>
</node>
<node id="High-throughput Functional Screening">
  <data key="d0">High-throughput Functional Screening</data>
  <data key="d1">event</data>
  <data key="d2">High-throughput functional screening for enzymatic activity was proposed to identify novel enzymes for polystyrene degradation from insect gut microbiota.</data>
  <data key="d3">chunk-497648a1cf8e41fac896250ae1eebbb1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756376209</data>
</node>
<node id="Plastic-degrading Insects">
  <data key="d0">Plastic-degrading Insects</data>
  <data key="d1">category</data>
  <data key="d2">Plastic-degrading insects include species such as superworms, mealworms, and waxworms that can consume and degrade plastics like polystyrene.</data>
  <data key="d3">chunk-497648a1cf8e41fac896250ae1eebbb1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756376209</data>
</node>
<node id="Mandibulate Mouthpart">
  <data key="d0">Mandibulate Mouthpart</data>
  <data key="d1">category</data>
  <data key="d2">The mandibulate mouthpart is a physical feature shared by mealworms and superworms that enables them to chew and eat plastic.</data>
  <data key="d3">chunk-497648a1cf8e41fac896250ae1eebbb1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756376209</data>
</node>
<node id="Novel Enzymes for PS Degradation">
  <data key="d0">Novel Enzymes for PS Degradation</data>
  <data key="d1">category</data>
  <data key="d2">Novel enzymes for polystyrene degradation may be identified from the gut microbiota of plastic-eating insects and used as biocatalysts for biodegradation and recycling.</data>
  <data key="d3">chunk-497648a1cf8e41fac896250ae1eebbb1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756376209</data>
</node>
