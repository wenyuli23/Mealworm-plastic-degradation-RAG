  <data key="d0">CFBAI Plate</data>
  <data key="d1">organization</data>
  <data key="d2">CFBAI plate was used as a medium for coating the bacterial consortium and covering with sterilized PE mulching films for biofilm formation experiments.</data>
  <data key="d3">chunk-eaffdadca6e8a3e9721b2dcb031b93f7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756375684</data>
