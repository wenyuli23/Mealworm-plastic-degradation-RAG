  <data key="d0">Glucose Equivalent</data>
  <data key="d1">category</data>
  <data key="d2">Glucose equivalent was tested alongside supernatant doses to determine if respiration increases were due to external carbon sources.</data>
  <data key="d3">chunk-668212da3bf356132cadb63df6ce09b6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756375025</data>
