  <data key="d0">Plastic-Degrading Bacterium</data>
  <data key="d1">category</data>
  <data key="d2">A plastic-degrading bacterium is a microbial organism isolated during studies of insect gut microbiomes that contributes to plastic degradation.</data>
  <data key="d3">chunk-07aae06c64778453da4bda48f5347de5</data>
  <data key="d4">unknown_source</data>
