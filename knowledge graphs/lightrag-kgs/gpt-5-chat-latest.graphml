  <data key="d0">Volumetric Body Length (L_V)</data>
  <data key="d1">category</data>
  <data key="d2">Volumetric body length (L_V) is a measured variable representing the volumetric length of the organism.</data>
  <data key="d3">chunk-355ef52836a4c27f1290730187a78818</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756388208</data>
</node>
