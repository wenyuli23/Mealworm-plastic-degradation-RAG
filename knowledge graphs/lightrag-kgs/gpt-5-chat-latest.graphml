<node id="PE microplastics (MPs)">
  <data key="d0">PE microplastics (MPs)</data>
  <data key="d1">category</data>
  <data key="d2">Polyethylene microplastics are small plastic particles generated during biodegradation, which can cause biological toxicity in organisms.</data>
  <data key="d3">chunk-d8c6850a83a1c6efd4f1a3a37a0a8181</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756380143</data>
</node>
<node id="Plastic Degradation Intermediates">
  <data key="d0">Plastic Degradation Intermediates</data>
  <data key="d1">category</data>
  <data key="d2">Plastic degradation intermediates are metabolic byproducts generated when larvae ingest and digest plastics such as HDPE, LLDPE, and LDPE.</data>
  <data key="d3">chunk-d8c6850a83a1c6efd4f1a3a37a0a8181</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756380144</data>
</node>
<node id="Inflammatory Responses">
  <data key="d0">Inflammatory Responses</data>
  <data key="d1">category</data>
  <data key="d2">Inflammatory responses are biological reactions triggered in organisms, including Tenebrio larvae, mice, and zebrafish, due to exposure to microplastics.&lt;SEP&gt;Inflammatory responses are physiological effects caused by ingestion of microplastics in organisms without plastic-degrading capacities.</data>
  <data key="d3">chunk-1536c14bdcd58ae9dabf3a49f6724cd8&lt;SEP&gt;chunk-d8c6850a83a1c6efd4f1a3a37a0a8181</data>
