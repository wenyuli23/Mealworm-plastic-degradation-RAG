  <data key="d0">Biodegradation of polystyrene</data>
  <data key="d1">event</data>
  <data key="d2">The process studied in which insects such as superworms and mealworms degrade and mineralize polystyrene.</data>
  <data key="d3">chunk-4304c39ef3427872131caf77e7cdb438</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756376190</data>
