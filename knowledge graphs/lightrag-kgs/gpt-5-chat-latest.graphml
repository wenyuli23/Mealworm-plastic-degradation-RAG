<node id="Mealworms (Tenebrio molitor Linnaeus larvae)">
  <data key="d0">Mealworms (Tenebrio molitor Linnaeus larvae)</data>
  <data key="d1">category</data>
  <data key="d2">Mealworms are the larvae of Tenebrio molitor Linnaeus. They are capable of chewing and eating Styrofoam, degrading it in their gut within 24 hours, and converting it into CO2, fecula, and biomass.</data>
  <data key="d3">chunk-f7fa795762aa89809d8221dc9dda92fa</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756376864</data>
</node>
