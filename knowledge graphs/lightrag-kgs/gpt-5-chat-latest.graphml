<node id="Tea Leaves">
  <data key="d0">Tea Leaves</data>
  <data key="d1">category</data>
  <data key="d2">Used Chinese tea leaves were employed as a positive control medium for grafting Hylocereus undatus cacti, based on prior reports of plant growth benefits.&lt;SEP&gt;Tea leaves were used as a comparison medium for growing cacti against worm frass.</data>
  <data key="d3">chunk-12ceb4368e146509caa737d9534ce3c2&lt;SEP&gt;chunk-671dc96f9c648fdc6d21397c515d171d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756374057</data>
