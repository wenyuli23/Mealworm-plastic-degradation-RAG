  <data key="d0">2-vinyl-cis,cis-muconic acid</data>
  <data key="d1">category</data>
  <data key="d2">2-vinyl-cis,cis-muconic acid is a product of 3-vinylcatechol breakdown by VC12O.</data>
  <data key="d3">chunk-6e415042ae4079ee5fe96c7105eb534c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373549</data>
</node>
<node id="2-hydroxy-6-ox compounds">
  <data key="d0">2-hydroxy-6-ox compounds</data>
  <data key="d1">category</data>
  <data key="d2">2-hydroxy-6-ox compounds are products of 3-vinylcatechol breakdown by VC23O.</data>
  <data key="d3">chunk-6e415042ae4079ee5fe96c7105eb534c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373549</data>
</node>
<node id="Styrene Oxide">
  <data key="d0">Styrene Oxide</data>
  <data key="d1">category</data>
  <data key="d2">Styrene oxide is an intermediate compound formed during styrene biodegradation by SMO.</data>
  <data key="d3">chunk-6e415042ae4079ee5fe96c7105eb534c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373549</data>
</node>
<node id="Styrene cis-glycol">
  <data key="d0">Styrene cis-glycol</data>
  <data key="d1">category</data>
  <data key="d2">Styrene cis-glycol is a compound formed when SDO introduces oxygen atoms into styrene.</data>
  <data key="d3">chunk-6e415042ae4079ee5fe96c7105eb534c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373549</data>
</node>
<node id="Insects/Larvae">
  <data key="d0">Insects/Larvae</data>
  <data key="d1">category</data>
  <data key="d2">Insects or larvae are the experimental organisms fed with different diets, showing variations in survival, growth, protein content, and microbiome composition.</data>
  <data key="d3">chunk-6e415042ae4079ee5fe96c7105eb534c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373549</data>
</node>
<node id="Hydration (H2O)">
  <data key="d0">Hydration (H2O)</data>
  <data key="d1">category</data>
  <data key="d2">Hydration refers to the presence of water in the diet, which improved insect survival, PS consumption, and microbiome health in Diet 2.</data>
  <data key="d3">chunk-6e415042ae4079ee5fe96c7105eb534c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373549</data>
</node>
<node id="Intestinal Homeostasis">
  <data key="d0">Intestinal Homeostasis</data>
  <data key="d1">category</data>
  <data key="d2">Intestinal homeostasis refers to the balance of gut function, influenced by SCFAs and microbiome activity.</data>
  <data key="d3">chunk-6e415042ae4079ee5fe96c7105eb534c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373550</data>
</node>
<node id="Nutritional Stress">
  <data key="d0">Nutritional Stress</data>
  <data key="d1">category</data>
  <data key="d2">Nutritional stress refers to the physiological condition of insects adapting to different diet compositions, influencing survival and metabolism.&lt;SEP&gt;Nutritional stress refers to the physiological strain on insects caused by PS in their diets, affecting mineral balance and metabolism.</data>
  <data key="d3">chunk-5a708f09b97ac93da05bd1d20bdfe174&lt;SEP&gt;chunk-6e415042ae4079ee5fe96c7105eb534c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756382598</data>
</node>
<node id="Corynebacterium">
  <data key="d0">Corynebacterium</data>
  <data key="d1">organization</data>
  <data key="d2">Corynebacterium is mentioned as a microbial genus where styrene oxide isomerase (SOI) enzymes are membrane-bound.&lt;SEP&gt;Corynebacterium is part of Actinobacteria found in T. obscurus larvae, associated with nitrogen metabolism.</data>
  <data key="d3">chunk-3815960770483b9c0a1579ca8442e3a6&lt;SEP&gt;chunk-2e1faf524e6fabeb512a07b13f37e51e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756380181</data>
</node>
