<node id="Pan and Hussain (2012)">
  <data key="d0">Pan and Hussain (2012)</data>
  <data key="d1">person</data>
  <data key="d2">Pan and Hussain are cited authors who reported that TAG can be hydrolyzed in the intestine to free fatty acids and glycerol by enzymes.</data>
  <data key="d3">chunk-2e4030ea35bee29093c1a8f19bc90774</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756377124</data>
</node>
<node id="Zechner et al. (2005)">
  <data key="d0">Zechner et al. (2005)</data>
  <data key="d1">person</data>
  <data key="d2">Zechner et al. are cited authors who reported that TAG can be hydrolyzed by adipose triglyceride lipase (AGTL).</data>
  <data key="d3">chunk-2e4030ea35bee29093c1a8f19bc90774</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756377124</data>
