  <data key="d0">Wang and Zhang, 2015</data>
  <data key="d1">person</data>
  <data key="d2">Wang and Zhang are cited researchers who identified at least a dozen genera of bacteria from the gut of mealworms.</data>
  <data key="d3">chunk-32f340b7166025be3c56178a94ae480d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756382402</data>
</node>
<node id="Jung et al., 2014">
  <data key="d0">Jung et al., 2014</data>
  <data key="d1">person</data>
  <data key="d2">Jung and colleagues are cited researchers who reported that Spiroplasma species did not cause harmful effects on T. molitor larvae.</data>
  <data key="d3">chunk-32f340b7166025be3c56178a94ae480d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756382402</data>
</node>
<node id="Genta et al., 2006">
  <data key="d0">Genta et al., 2006</data>
  <data key="d1">person</data>
  <data key="d2">Genta and colleagues are cited researchers who suggested that the non-lethal effect of styrene foam in mealworms is due to detoxifying roles of gut microbiota.</data>
  <data key="d3">chunk-32f340b7166025be3c56178a94ae480d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756382402</data>
