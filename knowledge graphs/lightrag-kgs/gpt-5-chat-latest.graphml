  <data key="d4">unknown_source</data>
  <data key="d5">1756379757</data>
</node>
<node id="Energy reservation">
  <data key="d0">Energy reservation</data>
  <data key="d1">category</data>
  <data key="d2">A biological process linked to lipid metabolism in PET-fed larvae, associated with dietary restrictions.</data>
  <data key="d3">chunk-d5f4bda412174e8b173f180d9b4311ae</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379757</data>
</node>
<node id="Oxidative stress response">
  <data key="d0">Oxidative stress response</data>
  <data key="d1">category</data>
  <data key="d2">A biological response observed in PET-fed larvae, potentially linked to PET microplastic ingestion.</data>
  <data key="d3">chunk-d5f4bda412174e8b173f180d9b4311ae</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379758</data>
</node>
<node id="Differential metabolite heatmap">
  <data key="d0">Differential metabolite heatmap</data>
  <data key="d1">category</data>
  <data key="d2">A visualization method used to compare metabolite abundance between PET-fed and control groups.</data>
  <data key="d3">chunk-d5f4bda412174e8b173f180d9b4311ae</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379758</data>
</node>
<node id="Agar-fed control group">
  <data key="d0">Agar-fed control group</data>
  <data key="d1">category</data>
  <data key="d2">The control group of larvae fed with agar, used for comparison with PET-fed groups.</data>
  <data key="d3">chunk-d5f4bda412174e8b173f180d9b4311ae</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379758</data>
</node>
<node id="PET Biodegradation">
  <data key="d0">PET Biodegradation</data>
  <data key="d1">event</data>
  <data key="d2">PET biodegradation refers to the process studied in T. molitor larvae, involving enzymatic hydrolysis and microbial activity that break down PET into intermediates and metabolites.</data>
  <data key="d3">chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379759</data>
</node>
<node id="Benzoic Acid">
  <data key="d0">Benzoic Acid</data>
  <data key="d1">category</data>
  <data key="d2">Benzoic acid is identified as a PET-degrading intermediate metabolite found in PET-fed larvae.</data>
  <data key="d3">chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379759</data>
</node>
<node id="Protocatechuic Acid">
  <data key="d0">Protocatechuic Acid</data>
  <data key="d1">category</data>
  <data key="d2">Protocatechuic acid is a metabolite produced during PET degradation, derived from terephthalic acid.</data>
  <data key="d3">chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379759</data>
</node>
<node id="Catechol">
  <data key="d0">Catechol</data>
  <data key="d1">category</data>
  <data key="d2">Catechol is a metabolite further derived from protocatechuic acid during PET degradation.</data>
  <data key="d3">chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379759</data>
</node>
<node id="Bis (2-hydroxy ethyl) terephthalate (BHET)">
  <data key="d0">Bis (2-hydroxy ethyl) terephthalate (BHET)</data>
  <data key="d1">category</data>
  <data key="d2">BHET is a hydrolyzed product of PET degradation identified in the larvae.</data>
  <data key="d3">chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379759</data>
</node>
<node id="Mono (2-hydroxy ethyl) terephthalate (MHET)">
  <data key="d0">Mono (2-hydroxy ethyl) terephthalate (MHET)</data>
  <data key="d1">category</data>
  <data key="d2">MHET is a hydrolyzed product of PET degradation that can be metabolized into ethylene glycol and terephthalic acid.</data>
  <data key="d3">chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379759</data>
</node>
<node id="Terephthalic Acid (TPA)">
  <data key="d0">Terephthalic Acid (TPA)</data>
  <data key="d1">category</data>
  <data key="d2">Terephthalic acid is a PET degradation product that can be metabolized into protocatechuic acid.</data>
  <data key="d3">chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379760</data>
</node>
<node id="Ethylene Glycol (EG)">
  <data key="d0">Ethylene Glycol (EG)</data>
  <data key="d1">category</data>
  <data key="d2">Ethylene glycol is a PET degradation product derived from MHET metabolism.</data>
  <data key="d3">chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379760</data>
</node>
<node id="Glycerophospholipid Metabolism">
  <data key="d0">Glycerophospholipid Metabolism</data>
  <data key="d1">category</data>
  <data key="d2">Glycerophospholipid metabolism is the most enriched KEGG pathway in PET-fed larvae, linked to cell membrane function and mitochondrial activity.&lt;SEP&gt;This pathway, linked to membrane composition and repair, is observed in PS-H fed mealworms.</data>
  <data key="d3">chunk-b19ac5bdc755bb8e9deb8e317ce365dd&lt;SEP&gt;chunk-2ee6535da22915c7094098e016b19d80</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756387692</data>
</node>
<node id="Aromatic/Polycyclic-Aromatic Hydrocarbon Degradation">
  <data key="d0">Aromatic/Polycyclic-Aromatic Hydrocarbon Degradation</data>
  <data key="d1">category</data>
  <data key="d2">This KEGG pathway is enriched in PET-fed larvae, supporting the breakdown of aromatic intermediates from PET degradation.</data>
  <data key="d3">chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379760</data>
</node>
<node id="Benzoate Degradation">
  <data key="d0">Benzoate Degradation</data>
  <data key="d1">category</data>
  <data key="d2">Benzoate degradation is a KEGG pathway enriched in PET-fed larvae, linked to PET biodegradation intermediates.</data>
  <data key="d3">chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379760</data>
</node>
<node id="Ethylbenzene Degradation">
  <data key="d0">Ethylbenzene Degradation</data>
  <data key="d1">category</data>
  <data key="d2">Ethylbenzene degradation is a KEGG pathway enriched in PET-fed larvae, associated with PET biodegradation.</data>
  <data key="d3">chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379761</data>
</node>
<node id="Ether Lipid Metabolism">
  <data key="d0">Ether Lipid Metabolism</data>
  <data key="d1">category</data>
  <data key="d2">Ether lipid metabolism is a KEGG pathway enriched in PET-fed larvae, related to PET degradation intermediates.</data>
  <data key="d3">chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379761</data>
</node>
<node id="Nitrogen-Fixating Bacteria">
  <data key="d0">Nitrogen-Fixating Bacteria</data>
  <data key="d1">organization</data>
  <data key="d2">Nitrogen-fixating bacteria in the gut of T. molitor larvae convert atmospheric nitrogen (N2) into amino acids to support enzyme synthesis and PET digestion.</data>
  <data key="d3">chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379761</data>
</node>
<node id="Oxidative Stress Response">
  <data key="d0">Oxidative Stress Response</data>
  <data key="d1">category</data>
  <data key="d2">Oxidative stress response is a biological reaction observed in T. molitor larvae during PET degradation, linked to lipid homeostasis and mitochondrial function.</data>
  <data key="d3">chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379761</data>
</node>
<node id="Cell Membranes">
  <data key="d0">Cell Membranes</data>
  <data key="d1">category</data>
  <data key="d2">Cell membranes are biological structures whose optimal physical properties and functions are maintained through glycerophospholipid metabolism during PET degradation.</data>
  <data key="d3">chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379762</data>
</node>
<node id="Mitochondrial Functions">
  <data key="d0">Mitochondrial Functions</data>
  <data key="d1">category</data>
  <data key="d2">Mitochondrial functions in the gut microbiome are correlated with glycerophospholipid metabolism during PET degradation.</data>
  <data key="d3">chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379762</data>
</node>
<node id="Foregut">
  <data key="d0">Foregut</data>
  <data key="d1">category</data>
  <data key="d2">The foregut is the initial digestive region in T. molitor larvae where PET fragments are ingested with air and digestive fluids.</data>
  <data key="d3">chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379762</data>
</node>
<node id="Midgut">
  <data key="d0">Midgut</data>
  <data key="d1">category</data>
  <data key="d2">The midgut is the digestive region in T. molitor larvae where PET fragments are depolymerized by enzymes and gut microbes.</data>
  <data key="d3">chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379762</data>
</node>
<node id="Extracellular Enzymes">
  <data key="d0">Extracellular Enzymes</data>
  <data key="d1">category</data>
  <data key="d2">Extracellular enzymes secreted by the host and microbiota in T. molitor larvae contribute to PET depolymerization.&lt;SEP&gt;Unique extracellular enzymes are suggested as another possible factor in the plastic-degrading ability of Achroia grisella larvae.</data>
  <data key="d3">chunk-af5eb6a8326b4977801e2f7694a2c750&lt;SEP&gt;chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756382983</data>
</node>
<node id="Hydroxylases">
  <data key="d0">Hydroxylases</data>
  <data key="d1">category</data>
  <data key="d2">Hydroxylases are enzymes that act on ester bonds in PET, supporting hydrolysis and degradation.</data>
  <data key="d3">chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379762</data>
</node>
<node id="Air (O2 and N2)">
  <data key="d0">Air (O2 and N2)</data>
  <data key="d1">category</data>
  <data key="d2">Air, specifically oxygen (O2) and nitrogen (N2), is ingested with PET fragments into the foregut of T. molitor larvae.</data>
  <data key="d3">chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379762</data>
</node>
<node id="Plesiothalmus davidis">
  <data key="d0">Plesiothalmus davidis</data>
  <data key="d1">category</data>
  <data key="d2">Plesiothalmus davidis is a darkling beetle species hypothesized to have similar PET biodegradation mechanisms as T. molitor.</data>
  <data key="d3">chunk-411368ddb6a73777c1dd4c683bd389c0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756379763</data>
</node>
<node id="Uloma">
  <data key="d0">Uloma</data>
  <data key="d1">organization</data>
  <data key="d2">Uloma is a darkling beetle genus hypothesized to have similar PET biodegradation mechanisms as T. molitor.&lt;SEP&gt;Uloma refers to a genus of larvae mentioned as capable of HDPE biodegradation.</data>
  <data key="d3">chunk-411368ddb6a73777c1dd4c683bd389c0&lt;SEP&gt;chunk-f5a94048d4a1499a73a50e74a59245e6</data>
