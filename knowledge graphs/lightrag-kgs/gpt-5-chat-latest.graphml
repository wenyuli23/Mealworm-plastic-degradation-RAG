<node id="Residual Microplastics">
  <data key="d0">Residual Microplastics</data>
  <data key="d1">category</data>
  <data key="d2">Residual microplastics are undigested plastic particles found in frass after mealworms ingest and partially biodegrade plastics such as PE, PS, and PVC.</data>
  <data key="d3">chunk-17052974ec1c317689bf07f0684f130f</data>
