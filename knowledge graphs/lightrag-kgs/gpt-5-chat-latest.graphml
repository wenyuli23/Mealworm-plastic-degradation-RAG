<node id="Ethylene glycol">
  <data key="d0">Ethylene glycol</data>
  <data key="d1">category</data>
  <data key="d2">Ethylene glycol is a valuable chemical that researchers aimed to produce by converting polyethylene.&lt;SEP&gt;Ethylene glycol is a valuable chemical that was hypothesized to result from polyethylene degradation, though its detection was disputed.</data>
  <data key="d3">chunk-b08485bef3ee3db21e59e159ad4c3e20&lt;SEP&gt;chunk-ff933f404b1e6da13d6c1319bc7432c7</data>
