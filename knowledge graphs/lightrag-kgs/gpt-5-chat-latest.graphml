  <data key="d4">unknown_source</data>
  <data key="d5">1756381149</data>
</node>
<node id="Polystyrene Film">
  <data key="d0">Polystyrene Film</data>
  <data key="d1">category</data>
  <data key="d2">Polystyrene film is a form of polystyrene that shows slower biodegradation compared to nanoplastystyrene.&lt;SEP&gt;Polystyrene film is a plastic material whose morphological properties were altered by Achromobacter xylosidoxans OR859752.&lt;SEP&gt;Polystyrene film provided by GoodFellow was an additive-free styrene polymer with a thickness of 0.05 mm.&lt;SEP&gt;Polystyrene film was dissolved in chloroform to prepare EPS solution for experiments.&lt;SEP&gt;Polystyrene film was used as a substrate to test bacterial attachment and degradation under experimental conditions.&lt;SEP&gt;Polystyrene film is the material tested for bacterial adhesion and biodegradation.&lt;SEP&gt;Polystyrene film is the plastic substrate used in experiments to test bacterial degradation and adhesion.</data>
  <data key="d3">chunk-a32ea55d79e87933e26b4165db47b1fc&lt;SEP&gt;chunk-aa64e5cd2c08637934509262e56ab363&lt;SEP&gt;chunk-7c1bb645805a7158e2e18e95313565f4&lt;SEP&gt;chunk-07a91e5cf8b623163be09e14d1f4978e&lt;SEP&gt;chunk-10f59d5d10f08e8107f36bff5a4c93ae&lt;SEP&gt;chunk-c9578db0f9ed0398705827be5d4ee450&lt;SEP&gt;chunk-2961e2aad708e7b78a585260097b4d2e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756386800</data>
</node>
