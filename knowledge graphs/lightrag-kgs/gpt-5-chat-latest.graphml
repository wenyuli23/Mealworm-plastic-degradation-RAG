</node>
<node id="PU-fed Groups">
  <data key="d0">PU-fed Groups</data>
  <data key="d1">category</data>
  <data key="d2">PU-fed groups are experimental groups of worms fed with polyurethane foam.</data>
  <data key="d3">chunk-df045e015825dac8935c9c6d8a402cda</data>
  <data key="d4">unknown_source</data>
