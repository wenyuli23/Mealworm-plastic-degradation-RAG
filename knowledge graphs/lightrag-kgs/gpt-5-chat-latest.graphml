  <data key="d2">Laser light scattering is a method used to explore residual plastic particles in the frass of mealworms after biodegradation.</data>
  <data key="d3">chunk-fe381daaa91bbff20758798e5baf82b5</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756387404</data>
