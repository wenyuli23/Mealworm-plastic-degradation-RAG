  <data key="d0">Yi-Xin Huo</data>
  <data key="d1">person</data>
  <data key="d2">Yi-Xin Huo is one of the authors of the study describing Mixta tenebrionis sp. nov.</data>
  <data key="d3">chunk-706b5d3a2fa68c3f52b58132d05b7165</data>
