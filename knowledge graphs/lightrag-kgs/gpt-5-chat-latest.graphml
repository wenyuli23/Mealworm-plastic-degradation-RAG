  <data key="d0">Phenylethanol-1,2-diol</data>
  <data key="d1">category</data>
  <data key="d2">Phenylethanol-1,2-diol is a compound formed by the hydrolysis of styrene oxide by epoxide hydrolase (EH).</data>
  <data key="d3">chunk-3815960770483b9c0a1579ca8442e3a6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756373554</data>
</node>
<node id="Mandelic acid">
  <data key="d0">Mandelic acid</data>
  <data key="d1">category</data>
  <data key="d2">Mandelic acid is a compound formed by oxidation of phenylethanol-1,2-diol by a dehydrogenase.</data>
  <data key="d3">chunk-3815960770483b9c0a1579ca8442e3a6</data>
  <data key="d4">unknown_source</data>
