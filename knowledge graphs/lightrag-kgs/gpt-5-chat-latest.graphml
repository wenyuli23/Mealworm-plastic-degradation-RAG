<node id="RQH-250 Climate Chamber">
  <data key="d0">RQH-250 Climate Chamber</data>
  <data key="d1">organization</data>
  <data key="d2">RQH-250 is a climate chamber located in Shanghai, China, used to rear mealworms under controlled conditions for Styrofoam-feeding tests.</data>
  <data key="d3">chunk-086890e8567c60d8cfa7c03b0cc61f9a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756376875</data>
</node>
<node id="Oats">
  <data key="d0">Oats</data>
  <data key="d1">category</data>
  <data key="d2">Oats are one of the conventional foods on which mealworms can be reared.&lt;SEP&gt;Oats were used as an edible bedding substrate in experiments testing EPS consumption by mealworms.&lt;SEP&gt;Oats were used both as food and as bedding material in the habitats.&lt;SEP&gt;Oats were used as a control diet for mealworms in the experiment.&lt;SEP&gt;Oats were used as a dietary supplement in experiments with EPS to study feeding behavior of larvae.&lt;SEP&gt;Oats were used as part of the feeding conditions in combination with PS and vitamins in the experiments.</data>
  <data key="d3">chunk-d3235cc6102d988875f1dda974a56038&lt;SEP&gt;chunk-ed48dc66abf9c27721101b1adac15e7a&lt;SEP&gt;chunk-e557113f1cfd2472fa9c51d1cdc3069a&lt;SEP&gt;chunk-f71fddc259d51158d5c79f38bf41523f&lt;SEP&gt;chunk-c11c77665793ac79aecfb19a89dd1f52&lt;SEP&gt;chunk-c1d76ad321e1c68d5f139cdb94d5bf42&lt;SEP&gt;chunk-086890e8567c60d8cfa7c03b0cc61f9a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756388228</data>
</node>
<node id="Grain">
  <data key="d0">Grain</data>
  <data key="d1">category</data>
  <data key="d2">Grain is a conventional food source for rearing mealworms.</data>
  <data key="d3">chunk-086890e8567c60d8cfa7c03b0cc61f9a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756376876</data>
</node>
<node id="Carrots">
  <data key="d0">Carrots</data>
  <data key="d1">category</data>
  <data key="d2">Carrots are a food item that can be used to rear mealworms.&lt;SEP&gt;Carrots were used as part of the diet for Tenebrio molitor larvae in one experimental group.&lt;SEP&gt;Carrots were used as part of the diet for mealworms in both control and experimental groups.&lt;SEP&gt;Carrots were suggested as a possible supplemental nutrient for future EPS consumption studies.&lt;SEP&gt;Carrots were used as the control feedstock for Alphitobius diaperinus in the experiment.</data>
  <data key="d3">chunk-56af57b5211422531c03b0cbcfded1b2&lt;SEP&gt;chunk-568e2e90ce0d3bbb4e21079f4252f5de&lt;SEP&gt;chunk-3b2f11b2dff6f9e39c409f2bbd26c9d9&lt;SEP&gt;chunk-220952ca1d34f3ffef65c5d71e22015e&lt;SEP&gt;chunk-086890e8567c60d8cfa7c03b0cc61f9a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756384767</data>
</node>
