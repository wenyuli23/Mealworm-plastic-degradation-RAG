  <data key="d5">1756374564</data>
</node>
<node id="Enterobacter cloacae DG-6 (ATCC 35929)">
  <data key="d0">Enterobacter cloacae DG-6 (ATCC 35929)</data>
  <data key="d1">category</data>
  <data key="d2">Enterobacter cloacae DG-6 is a bacterial strain capable of converting styrene to CO2 and other compounds under anaerobic conditions.</data>
  <data key="d3">chunk-7432cb0d6c74fd2dd80b065fbad26b4b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756374564</data>
</node>
<node id="Guillet et al.">
  <data key="d0">Guillet et al.</data>
  <data key="d1">person</data>
  <data key="d2">Guillet et al. conducted studies in 1974 on biodegradation of photodegraded polystyrene copolymers.</data>
  <data key="d3">chunk-7432cb0d6c74fd2dd80b065fbad26b4b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756374564</data>
</node>
<node id="Kaplan et al.">
  <data key="d0">Kaplan et al.</data>
  <data key="d1">person</data>
  <data key="d2">Kaplan et al. investigated PS biodegradation capabilities of fungi, soil invertebrates, and microbial communities.&lt;SEP&gt;Kaplan and colleagues studied fungi in axenic cultures and mixed microbial communities for PS degradation, reporting limited removal.</data>
  <data key="d3">chunk-7432cb0d6c74fd2dd80b065fbad26b4b&lt;SEP&gt;chunk-df4c8c66bfbbfc37ed842f53d2b8796c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756374565</data>
</node>
<node id="Sielicki et al.">
  <data key="d0">Sielicki et al.</data>
  <data key="d1">person</data>
  <data key="d2">Sielicki et al. studied biodegradation of radiolabeled polystyrene in soil and liquid enrichment cultures.&lt;SEP&gt;Sielicki and colleagues reported microbial cultures from soil and liquid enrichment that degraded PS with 1.5%-3.0% removal over 4 months.</data>
  <data key="d3">chunk-7432cb0d6c74fd2dd80b065fbad26b4b&lt;SEP&gt;chunk-df4c8c66bfbbfc37ed842f53d2b8796c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756374565</data>
</node>
<node id="Mor and Sivan">
  <data key="d0">Mor and Sivan</data>
  <data key="d1">person</data>
  <data key="d2">Mor and Sivan reported the isolation of Rhodococcus ruber strain C208, capable of degrading PS.</data>
  <data key="d3">chunk-7432cb0d6c74fd2dd80b065fbad26b4b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756374565</data>
</node>
<node id="Rhodococcus ruber strain C208">
  <data key="d0">Rhodococcus ruber strain C208</data>
  <data key="d1">category</data>
  <data key="d2">Rhodococcus ruber strain C208 is a biofilm-producing actinomycete capable of degrading polystyrene.</data>
  <data key="d3">chunk-7432cb0d6c74fd2dd80b065fbad26b4b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756374565</data>
</node>
