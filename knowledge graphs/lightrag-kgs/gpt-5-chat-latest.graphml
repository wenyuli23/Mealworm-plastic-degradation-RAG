<node id="3-(4,5-dimethylthiazol-2-yl)-2,5-diphenyltetrazolium bromide (MTT)">
  <data key="d0">3-(4,5-dimethylthiazol-2-yl)-2,5-diphenyltetrazolium bromide (MTT)</data>
