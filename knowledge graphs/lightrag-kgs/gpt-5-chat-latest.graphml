  <data key="d1">event</data>
  <data key="d2">The temperature test was conducted to determine the optimal temperature for PM S1 growth, ranging from 26°C to 34°C.</data>
  <data key="d3">chunk-2fd075a78abe1dca64ddea928d3f94b7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756371418</data>
</node>
<node id="Elemental Analysis">
  <data key="d0">Elemental Analysis</data>
  <data key="d1">category</data>
  <data key="d2">Elemental analysis was performed to measure the percentage of carbon and hydrogen loss in LDPE, HDPE, and PS after degradation by PM S1.&lt;SEP&gt;Elemental analysis was used to determine the N ratio (40:1:7.7:47.3:3.4) in the study.</data>
  <data key="d3">chunk-2fd075a78abe1dca64ddea928d3f94b7&lt;SEP&gt;chunk-f267b48449a40d614a2f325799752dea</data>
  <data key="d4">unknown_source</data>
