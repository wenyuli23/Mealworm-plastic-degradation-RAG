<node id="Uloma sp. larvae">
  <data key="d0">Uloma sp. larvae</data>
  <data key="d1">category</data>
  <data key="d2">Uloma sp. larvae, a honey bee pest, are studied for their ability to biodegrade polystyrene and complete their life cycle on a polystyrene diet.</data>
  <data key="d3">chunk-7232abef4870641de7945afeb6a4bf93</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756378208</data>
