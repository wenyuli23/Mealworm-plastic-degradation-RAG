  <data key="d0">Styrofoam polystyrene chips</data>
  <data key="d1">category</data>
  <data key="d2">Styrofoam polystyrene chips were used in the experiment, removed from rearing boxes, cleaned, weighed, and returned.</data>
  <data key="d3">chunk-998b63e5349034d477c2087c139669ed</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1756388213</data>
</node>
