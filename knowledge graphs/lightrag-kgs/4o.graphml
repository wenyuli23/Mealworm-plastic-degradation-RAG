    <node id="&quot;ANTIBIOTIC&quot;">
      <data key="d0">"ANTIBIOTIC"</data>
      <data key="d1">"A substance used to suppress gut bacteria, resulting in the largest inhibition halo seen in the study."&lt;SEP&gt;"A substance used to treat mealworms in the experiment to assess its effects on nitrogen-fixing activity."&lt;SEP&gt;"Antibiotics are substances that can suppress gut microbes, affecting the biodegradation efficiency of certain plastics in T. molitor larvae."&lt;SEP&gt;"Antibiotics are used to study their effect on the gut microbiota of larvae, impacting the digestion and depolymerization of feedstocks like PS."&lt;SEP&gt;"Substances used to treat infections, which in this context were shown to influence the gut microbiome's activity."</data>
      <data key="d2">chunk-79c11bccb4ef9bd152bdae9b5c2c5c8c&lt;SEP&gt;chunk-4b12451ba2a22e6f74c543f982a0a7b3&lt;SEP&gt;chunk-d99a98d885ec6495c4dc902866c4ab9f&lt;SEP&gt;chunk-c6f28f1c36076d1f249dbc4cd67b16f1&lt;SEP&gt;chunk-c84ac252cb9ce906354bda2ad1113aba</data>
    </node>
    <node id="&quot;IMMUNE RESPONSES&quot;">
      <data key="d0">"IMMUNE RESPONSE"</data>
      <data key="d1">"Host responses that may produce proteins inhibiting or being toxic to the gut microbiome."</data>
      <data key="d2">chunk-d99a98d885ec6495c4dc902866c4ab9f</data>
    </node>
    <node id="&quot;GENEIOUS ASSEMBLER&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"The Geneious Assembler is a component of Geneious Prime used for de novo assembly of genetic sequences with standard settings."</data>
      <data key="d2">chunk-d99a98d885ec6495c4dc902866c4ab9f</data>
    </node>
    <node id="&quot;BUFFERED NUTRIENT MEDIUM&quot;">
      <data key="d0">"NUTRITIONAL COMPONENT"</data>
      <data key="d1">"A component in the Biolog MT2 microplates that supports bacterial growth without a carbon source."</data>
      <data key="d2">chunk-d99a98d885ec6495c4dc902866c4ab9f</data>
    </node>
    <node id="&quot;OPTICAL DENSITY (OD595)&quot;">
      <data key="d0">"METABOLIC MEASURE"</data>
      <data key="d1">"Optical density at 595 nm is a measure of the concentration of bacteria in a suspension."</data>
      <data key="d2">chunk-d99a98d885ec6495c4dc902866c4ab9f</data>
    </node>
    <node id="&quot;SERUM BOTTLES&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Containers used to capture and measure the headspace CO2 produced by microbial respiration."&lt;SEP&gt;"Laboratory containers used for growing microbial cultures under controlled conditions for biodegradation studies."&lt;SEP&gt;"Serum Bottles are containers used to incubate cultures in respiration assays to measure CO2 production."</data>
      <data key="d2">chunk-eba752cb179633f5dd054ee7c9ee2cba&lt;SEP&gt;chunk-d99a98d885ec6495c4dc902866c4ab9f&lt;SEP&gt;chunk-668212da3bf356132cadb63df6ce09b6</data>
    </node>
    <node id="&quot;ALTECH CTR 1 COLUMN&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"A component of the gas chromatograph used for separating gas samples during analysis."</data>
      <data key="d2">chunk-d99a98d885ec6495c4dc902866c4ab9f</data>
    </node>
    <node id="&quot;THERMAL CONDUCTIVITY DETECTOR&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"A detector connected to a gas chromatograph for measuring the thermal conductivity of different gases."</data>
      <data key="d2">chunk-d99a98d885ec6495c4dc902866c4ab9f</data>
    </node>
    <node id="&quot;CHROMPERFECT&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Software used to determine and quantify CO2 concentration in gas samples."</data>
      <data key="d2">chunk-d99a98d885ec6495c4dc902866c4ab9f</data>
    </node>
    <node id="&quot;CONTACT ANGLE&quot;">
      <data key="d0">"PHYSICAL PROPERTY"</data>
      <data key="d1">"Also known as wetting angle, it measures the wettability of a solid by a liquid, with higher values observed for PSr and EPS."&lt;SEP&gt;"The angle formed by a liquid at the boundary where it interfaces with a solid surface, measuring surface wetting."</data>
      <data key="d2">chunk-a11793261251544a542146bc9bf0c5dd&lt;SEP&gt;chunk-d99a98d885ec6495c4dc902866c4ab9f</data>
    </node>
    <node id="&quot;DROPIMAGE PRO SOFTWARE&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Software used for analyzing and quantifying contact angles in contact angle analysis."</data>
      <data key="d2">chunk-d99a98d885ec6495c4dc902866c4ab9f</data>
    </node>
    <node id="&quot;ANOVA TEST&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"A statistical test used to compare mean differences in respiration activity and contact angles across experimental conditions."&lt;SEP&gt;"Anova Test, or Analysis of Variance, is used to determine significant differences in mean weight and other parameters among treatment groups."</data>
      <data key="d2">chunk-d6a80044bea074bdbcb68f489aa8af0f&lt;SEP&gt;chunk-d99a98d885ec6495c4dc902866c4ab9f</data>
    </node>
    <node id="&quot;SHAPIRO–WILK TEST&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"A statistical test used to assess the normality of data before conducting further analysis."</data>
      <data key="d2">chunk-d99a98d885ec6495c4dc902866c4ab9f</data>
    </node>
    <node id="&quot;GUT SUPERNATANT&quot;">
      <data key="d0">"BIOLOGICAL MARKER"</data>
      <data key="d1">"A liquid extract from the gut, used to supplement cultures in order to assess microbial respiration on different diets."</data>
      <data key="d2">chunk-d99a98d885ec6495c4dc902866c4ab9f</data>
    </node>
    <node id="&quot;MOLECULAR WEIGHT FRACTIONATION&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"The process of separating compounds in the supernatant by molecular weight for further analysis."</data>
      <data key="d2">chunk-d99a98d885ec6495c4dc902866c4ab9f</data>
    </node>
    <node id="&quot;PS DEGRADATION&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"PS Degradation refers to the breakdown of polystyrene by biological processes, such as those mediated by mealworm gut microbiomes."&lt;SEP&gt;"PS degradation refers to the process through which superworms and their gut microbiota depolymerize and mineralize polystyrene (PS) plastic."&lt;SEP&gt;"The degradation of polystyrene facilitated by specific fungi within the gut microbiome of yellow mealworms."&lt;SEP&gt;"PS degradation refers to the breakdown of polystyrene, a related polymer, which acts as a comparative reference for LDPE degradation."</data>
      <data key="d2">chunk-497648a1cf8e41fac896250ae1eebbb1&lt;SEP&gt;chunk-668212da3bf356132cadb63df6ce09b6&lt;SEP&gt;chunk-22d348f5320f96e129128362b6e0407c&lt;SEP&gt;chunk-a3f07da33b55bf8a25fe06beee23e90e</data>
    </node>
    <node id="&quot;RESPIRATION&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Respiration in this context refers to the metabolic process of producing energy from organic compounds, measured here by CO2 production during PS degradation."</data>
      <data key="d2">chunk-668212da3bf356132cadb63df6ce09b6</data>
    </node>
    <node id="&quot;EMULSIFYING AGENTS&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"Emulsifying Agents are substances that help mix and stabilize immiscible components, theorized here to promote plastic degradation."</data>
      <data key="d2">chunk-668212da3bf356132cadb63df6ce09b6</data>
    </node>
    <node id="&quot;MOLECULAR WEIGHT FRACTIONS&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"Molecular Weight Fractions refer to portions of the supernatant divided based on molecular weight, used to analyze respiration enhancement effects."</data>
      <data key="d2">chunk-668212da3bf356132cadb63df6ce09b6</data>
    </node>
    <node id="&quot;MEALWORM GUT&quot;">
      <data key="d0">"ECOLOGICAL CONCEPT"</data>
      <data key="d1">"The Mealworm Gut is the digestive tract of mealworms, serving as a habitat for microorganisms that facilitate PS degradation."&lt;SEP&gt;"The digestive tract of mealworms, where microbiomes contribute to biodegradation processes."&lt;SEP&gt;"The mealworm gut is the digestive system of the mealworm, where the depolymerization and degradation of polystyrene occurs, resulting in fecula."&lt;SEP&gt;"The digestive system of mealworms where enzymatic activity and microbial interactions facilitate polymer breakdown."&lt;SEP&gt;"The gut of mealworms is used as a source of DNA for extraction and sequencing."&lt;SEP&gt;"The mealworm gut is where the biodegradation of EPS occurs, with observable changes in the fecula indicating breakdown of polystyrene."&lt;SEP&gt;"The digestive system of mealworms where degradation of plastics occurs."&lt;SEP&gt;"The mealworm gut is an environment that hosts microorganisms capable of degrading synthetic polymers like polystyrene, serving as a source for isolating strains like LG3."</data>
      <data key="d2">chunk-a4c43611ebe237c15c5f9201a9f8dbee&lt;SEP&gt;chunk-668212da3bf356132cadb63df6ce09b6&lt;SEP&gt;chunk-069f8447676509ffdd0028e9c05fb9ab&lt;SEP&gt;chunk-15323ef47e29f2927f95274e49f4e5bf&lt;SEP&gt;chunk-d2c62bcfb28547d6b2336f142d27a326&lt;SEP&gt;chunk-d80979bb7e58b10bb558705b5d96fa99&lt;SEP&gt;chunk-ada834fc8d4bea41c0ce1770d6f57e4b&lt;SEP&gt;chunk-7a8b07ee5dc7a7af59a93d03311efe60</data>
    </node>
    <node id="&quot;CARBON-FREE MEDIA&quot;">
      <data key="d0">"NUTRITIONAL COMPONENT"</data>
      <data key="d1">"Carbon-free Media is a type of substrate used in experiments to culture the gut microbiome without additional carbon sources."&lt;SEP&gt;"Carbon-free media is a type of culture medium devoid of carbon sources, used to study microbial metabolism of specific additives like polystyrene."&lt;SEP&gt;"Carbon-free media used in the experiments ensures that bacteria rely on PS films as their sole carbon source for growth and biodegradation."</data>
      <data key="d2">chunk-eba752cb179633f5dd054ee7c9ee2cba&lt;SEP&gt;chunk-eda80cb027c8107defa00011d491b002&lt;SEP&gt;chunk-668212da3bf356132cadb63df6ce09b6</data>
    </node>
    <node id="&quot;CONTACT ANGLE ANALYSIS&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"A method measuring the wetting property of a surface, indicating changes in surface chemistry after biodegradation."&lt;SEP&gt;"Contact Angle Analysis is a technique to determine the hydrophobicity of the supernatant fractions from mealworm diets."&lt;SEP&gt;"Contact angle analysis is a method used to assess the hydrophobicity of supernatant fractions, indicating their emulsifying properties."</data>
      <data key="d2">chunk-902ed6a67c601276c5dbf43c35dd824f&lt;SEP&gt;chunk-668212da3bf356132cadb63df6ce09b6&lt;SEP&gt;chunk-eba752cb179633f5dd054ee7c9ee2cba</data>
    </node>
    <node id="&quot;ANTIBIOTIC-TREATED MEALWORMS&quot;">
      <data key="d0">"MICROORGANISMS"</data>
      <data key="d1">"Antibiotic-treated Mealworms are mealworms that have been exposed to antibiotics to study changes in microbiome activity."&lt;SEP&gt;"Antibiotic-treated mealworms have their gut microbiota affected, resulting in reduced nitrogen-fixing capability and fitness."&lt;SEP&gt;"Mealworms that have been treated with antibiotics, showing decreased nitrogen-fixing abilities and specific δ15N values."</data>
      <data key="d2">chunk-2bf827d2b1d02488e17469a22da9e252&lt;SEP&gt;chunk-77817419b966e501f1106866cbea7350&lt;SEP&gt;chunk-668212da3bf356132cadb63df6ce09b6</data>
    </node>
    <node id="&quot;MICROBIAL RESPIRATION&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"A process by which microorganisms consume organic compounds, enhanced by factors secreted by the gut microbiome."&lt;SEP&gt;"Microbial respiration is the process of microorganisms breaking down substances, resulting in the production of CO2, as studied in the context of PS and PS supernatant."</data>
      <data key="d2">chunk-902ed6a67c601276c5dbf43c35dd824f&lt;SEP&gt;chunk-7a8b07ee5dc7a7af59a93d03311efe60</data>
    </node>
    <node id="&quot;PS SUPERNATANT&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"PS supernatant is a liquid extract from mealworm diets involving PS, used in studies to understand its effect on microbial respiration and plastic degradation."</data>
      <data key="d2">chunk-902ed6a67c601276c5dbf43c35dd824f</data>
    </node>
    <node id="&quot;EMULSIFYING AGENT&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"Substances that stabilize an emulsion, crucial in increasing the bioavailability of PS for biodegradation."&lt;SEP&gt;"The emulsifying agent is a substance thought to be produced by mealworms and their gut microbiome, aiding in the bioavailability and degradation of hydrophobic substances like plastics."</data>
      <data key="d2">chunk-902ed6a67c601276c5dbf43c35dd824f&lt;SEP&gt;chunk-7a8b07ee5dc7a7af59a93d03311efe60</data>
    </node>
    <node id="&quot;TWEEN-80&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Tween-80 is a known surfactant used as a comparison in the study to understand the emulsification and wetting behavior in mealworm gut environments."</data>
      <data key="d2">chunk-902ed6a67c601276c5dbf43c35dd824f</data>
    </node>
    <node id="&quot;SUPERNATANT FRACTIONS&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Supernatant fractions are the different liquid extracts from mealworm diets used to study their impact on microbial respiration and plastic degradation."</data>
      <data key="d2">chunk-902ed6a67c601276c5dbf43c35dd824f</data>
    </node>
    <node id="&quot;AQUEOUS MEDIA&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"Aqueous media refers to the water-based environment used in the experiments studying the interaction of microplastics with mealworm secretions."</data>
      <data key="d2">chunk-902ed6a67c601276c5dbf43c35dd824f</data>
    </node>
    <node id="&quot;IN VITRO&quot;">
      <data key="d0">"SCIENTIFIC CONCEPT"</data>
      <data key="d1">"In vitro refers to experiments conducted outside of living organisms, such as the ex situ studies of PS degradation using mealworm microbiome."</data>
      <data key="d2">chunk-902ed6a67c601276c5dbf43c35dd824f</data>
    </node>
    <node id="&quot;EX SITU MICROBIAL CULTURES&quot;">
      <data key="d0">"MICROORGANISMS"</data>
      <data key="d1">"Ex situ microbial cultures are lab-based microbial environments used to study the effect of different factors on PS biodegradation."</data>
      <data key="d2">chunk-902ed6a67c601276c5dbf43c35dd824f</data>
    </node>
    <node id="&quot;EX SITU MICROBIAL GROWTH&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"A laboratory process utilized to enhance the degradation of polystyrene by cultivating the mealworm gut microbiome outside its natural environment, using specific media setups."</data>
      <data key="d2">chunk-eba752cb179633f5dd054ee7c9ee2cba</data>
    </node>
    <node id="&quot;MICROBIAL SECRETED FACTORS&quot;">
      <data key="d0">"BIOLOGICAL MARKER"</data>
      <data key="d1">"Factors produced by the gut microbiome that facilitate enhanced microbial respiration and plastic degradation, particularly observed in fractions with &lt;30 kDa molecular weight."</data>
      <data key="d2">chunk-eba752cb179633f5dd054ee7c9ee2cba</data>
    </node>
    <node id="&quot;MEALWORM-PRODUCED EMULSIFYING AGENT&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"A substance produced by mealworms, within the 30-100 kDa fraction, that aids in the emulsification and biodegradation of polystyrene."</data>
      <data key="d2">chunk-eba752cb179633f5dd054ee7c9ee2cba</data>
    </node>
    <node id="&quot;CARBON DIOXIDE (\(\MATHRM{CO}_{2}\)) PRODUCTION&quot;">
      <data key="d0">"METABOLIC MEASURE"</data>
      <data key="d1">"The production of CO2 is a metabolic measure indicating respiration and biodegradation activity during microbial breakdown of the plastic product, polystyrene."</data>
      <data key="d2">chunk-eba752cb179633f5dd054ee7c9ee2cba</data>
    </node>
    <node id="&quot;30-100 KDA FRACTION&quot;">
      <data key="d0">"BIOLOGICAL MARKER"</data>
      <data key="d1">"A fraction of the supernatant between 30-100 kDa containing potential extracellular factors or metabolites influencing microbe behavior."</data>
      <data key="d2">chunk-eba752cb179633f5dd054ee7c9ee2cba</data>
    </node>
    <node id="&quot;&lt;30 KDA FRACTION&quot;">
      <data key="d0">"BIOLOGICAL MARKER"</data>
      <data key="d1">"A supernatant fraction less than 30 kDa in size likely containing microbial secreted factors enhancing PS degradation."</data>
      <data key="d2">chunk-eba752cb179633f5dd054ee7c9ee2cba</data>
    </node>
    <node id="&quot;&gt;100 KDA FRACTION&quot;">
      <data key="d0">"BIOLOGICAL MARKER"</data>
      <data key="d1">"A fraction larger than 100 kDa potentially containing inhibitory factors affecting microbial biodegradation of PS."</data>
      <data key="d2">chunk-eba752cb179633f5dd054ee7c9ee2cba</data>
    </node>
    <node id="&quot;FRACTIONATION PROCESS&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"A process used to separate substances based on size, helping isolate different molecular weight fractions for study."</data>
      <data key="d2">chunk-eba752cb179633f5dd054ee7c9ee2cba</data>
    </node>
    <node id="&quot;ANTIBIOTIC-TREATED SUPERNATANT&quot;">
      <data key="d0">"NUTRITIONAL COMPONENT"</data>
      <data key="d1">"Supernatant treated with antibiotics to assess the individual effects of microbial and non-microbial factors."</data>
      <data key="d2">chunk-eba752cb179633f5dd054ee7c9ee2cba</data>
    </node>
    <node id="&quot;STABLE BIOFILM&quot;">
      <data key="d0">"PHYSICAL CHARACTERISTIC"</data>
      <data key="d1">"A dense aggregation of microorganisms forming on surfaces, crucial for enhanced biodegradation observed in enriched cultures."</data>
      <data key="d2">chunk-eba752cb179633f5dd054ee7c9ee2cba</data>
    </node>
    <node id="&quot;MIXED COMMUNITY ENRICHMENT&quot;">
      <data key="d0">"MICROORGANISMS"</data>
      <data key="d1">"A culture method developed by mixing different strains for selecting efficient PS-degrading microorganisms."</data>
      <data key="d2">chunk-eba752cb179633f5dd054ee7c9ee2cba</data>
    </node>
    <node id="&quot;PLASTIC DEGRADATION MICROBIAL COMMUNITY&quot;">
      <data key="d0">"MICROORGANISMS"</data>
      <data key="d1">"The microbial community involved in plastic degradation consists of various bacterial species that can form a biofilm on PS film surfaces, enabling biodegradation."</data>
      <data key="d2">chunk-eda80cb027c8107defa00011d491b002</data>
    </node>
    <node id="&quot;ENTEROBACTER ASBURIAE&quot;">
      <data key="d0">"BACTERIUM"</data>
      <data key="d1">"Enterobacter asburiae is a bacterium identified within insect guts, contributing to the degradation of plastics."&lt;SEP&gt;"Enterobacter asburiae is capable of degrading polyethylene and is isolated from the gut microbiome of plastic-eating waxworms."</data>
      <data key="d2">chunk-eda80cb027c8107defa00011d491b002&lt;SEP&gt;chunk-53d382cbd1392dbcf9530428c2eb8584</data>
    </node>
    <node id="&quot;STENOTROPHOMONAS MALTOPHILIA&quot;">
      <data key="d0">"BACTERIUM"</data>
      <data key="d1">"Stenotrophomonas maltophilia is capable of cyclic hydrocarbon degradation, with enhanced biodegradation rates in the presence of surfactants."</data>
      <data key="d2">chunk-eda80cb027c8107defa00011d491b002</data>
    </node>
    <node id="&quot;CARBON-RICH MEDIA&quot;">
      <data key="d0">"NUTRITIONAL COMPONENT"</data>
      <data key="d1">"Carbon-rich media used for culturing bacteria provides the essential nutrients for microbial growth before being transitioned to carbon-free conditions."</data>
      <data key="d2">chunk-eda80cb027c8107defa00011d491b002</data>
    </node>
    <node id="&quot;PLASTIC-BIODEGRADING ENZYMES&quot;">
      <data key="d0">"ENZYME"</data>
      <data key="d1">"Enzymes involved in plastic biodegradation facilitate the breakdown of polymeric materials, and are of interest for research on enhancing PS degradation."</data>
      <data key="d2">chunk-eda80cb027c8107defa00011d491b002</data>
    </node>
    <node id="&quot;BIOSURFACTANT&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"An emulsifying agent that increases the bioavailability of hydrocarbons, aiding in PS biodegradation."&lt;SEP&gt;"Biosurfactants are surface-active substances produced by microbes, like Pseudomonas aeruginosa, that enhance the breakdown of hydrocarbons and plastics."</data>
      <data key="d2">chunk-eda80cb027c8107defa00011d491b002&lt;SEP&gt;chunk-7a8b07ee5dc7a7af59a93d03311efe60</data>
    </node>
    <node id="&quot;XENOBIOTICS&quot;">
      <data key="d0">"TOXIN"</data>
      <data key="d1">"Chemical substances not naturally found in an organism's environment, which can be broken down by certain bacteria."&lt;SEP&gt;"Chemical substances that are foreign to the biological system, often metabolized by cytochrome P450 during degradation."&lt;SEP&gt;"Synthetic compounds not naturally found in organisms, often targeted for biodegradation by microorganisms."&lt;SEP&gt;"Xenobiotics are foreign chemical substances present in an organism that are metabolized by specific enzymes and proteins in Tenebrio molitor."</data>
      <data key="d2">chunk-53d382cbd1392dbcf9530428c2eb8584&lt;SEP&gt;chunk-7a8b07ee5dc7a7af59a93d03311efe60&lt;SEP&gt;chunk-ca86254d65e47c4049e193cf2098b964&lt;SEP&gt;chunk-0f2fd4b2e978e6745e0dde602114a826</data>
    </node>
    <node id="&quot;PLASTIC RESPIRATION&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Process involving the breakdown and biodegradation of plastic materials by microbial activity."</data>
      <data key="d2">chunk-7a8b07ee5dc7a7af59a93d03311efe60</data>
    </node>
    <node id="&quot;EX SITU CULTIVATION&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Cultivating microorganisms outside their natural habitat to enhance PS biodegradation."</data>
      <data key="d2">chunk-7a8b07ee5dc7a7af59a93d03311efe60</data>
    </node>
    <node id="&quot;INSECT GUT-DERIVED ENRICHMENTS&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"Use of microbiome components derived from insect guts to facilitate microbial systems for biodegradation."</data>
      <data key="d2">chunk-7a8b07ee5dc7a7af59a93d03311efe60</data>
    </node>
    <node id="&quot;BIODEGRADATION AGENTS&quot;">
      <data key="d0">"BIOMARKER"</data>
      <data key="d1">"Agents produced by hosts and microbiomes that promote the breakdown of plastics in a biodegradation process."</data>
      <data key="d2">chunk-7a8b07ee5dc7a7af59a93d03311efe60</data>
    </node>
    <node id="&quot;CRAIG S. CRIDDLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"A corresponding author from Stanford University involved in the research on PS biodegradation."&lt;SEP&gt;"Professor at Stanford University who provided suggestions for the manuscript."&lt;SEP&gt;"Professor Craig S. Criddle from Stanford University contributed support and suggestions during the study."</data>
      <data key="d2">chunk-cf54b3c2c01c935a178261a31b8ed897&lt;SEP&gt;chunk-7a8b07ee5dc7a7af59a93d03311efe60&lt;SEP&gt;chunk-7106a16c81492914e4ba58e248689714</data>
    </node>
    <node id="&quot;NATIONAL SCIENCE FOUNDATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Organization providing financial support for the research on enhancing plastic biodegradation."</data>
