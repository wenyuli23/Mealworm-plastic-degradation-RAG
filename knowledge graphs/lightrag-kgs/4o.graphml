      <data key="d2">chunk-d290a6a81802d3048c35d2a2fb1252c4</data>
    </node>
    <node id="&quot;GO:0082333 PEPTIDASE ACTIVITY&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
