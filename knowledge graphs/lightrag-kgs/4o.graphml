      <data key="d2">chunk-81552b76a273b31cc2bd9ed21ed7a919</data>
    </node>
    <node id="&quot;NAOH (SODIUM HYDROXIDE)&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"NaOH is used in CO2 trapping systems to remove CO2 from the experimental setup atmosphere."</data>
      <data key="d2">chunk-81552b76a273b31cc2bd9ed21ed7a919</data>
    </node>
    <node id="&quot;LIPID&quot;">
      <data key="d0">"BIOMARKER"</data>
      <data key="d1">"Lipids are extracted from mealworms using chloroform for analysis."&lt;SEP&gt;"Lipids are indicative of nutritional and metabolic changes in T. molitor when fed with various polystyrene forms."</data>
      <data key="d2">chunk-06a44b308af148551c5b7feef324d88b&lt;SEP&gt;chunk-56c8b21b1eaba7633b49cea16714ddc1</data>
    </node>
