      <data key="d1">"Erwinia tracheiphila is a species of bacterium included under the LMG 2906 group characterized by HQ accession numbers."</data>
      <data key="d2">chunk-014b72d0a2657cbc89c4dee5f2b32bba</data>
    </node>
    <node id="&quot;COLONY PIGMENTATION&quot;">
