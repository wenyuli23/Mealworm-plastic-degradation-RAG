      <data key="d2">chunk-9b693d867918f89c9b28997fe94fc830</data>
    </node>
    <node id="&quot;CRUDE PROTEINS&quot;">
      <data key="d0">"NUTRIENT"</data>
      <data key="d1">"Crude proteins represent the amount of protein found in the larvae, with their levels measured to understand nutrient concentration."</data>
      <data key="d2">chunk-9b693d867918f89c9b28997fe94fc830</data>
    </node>
    <node id="&quot;BENZO-QUINONES&quot;">
      <data key="d0">"METABOLITE"</data>
