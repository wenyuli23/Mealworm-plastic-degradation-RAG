      <data key="d2">chunk-ae2c294948460ef392ceeec82d5e81f8</data>
    </node>
    <node id="&quot;STARCH AND SUCROSE METABOLISM&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Processes by which starch and sucrose are broken down into simpler sugars for energy production."&lt;SEP&gt;"Starch and sucrose metabolism pathways are upregulated in mealworms, demonstrating elevated sugar phosphates and nucleotide sugars."</data>
      <data key="d2">chunk-2ee6535da22915c7094098e016b19d80&lt;SEP&gt;chunk-ae2c294948460ef392ceeec82d5e81f8</data>
    </node>
    <node id="&quot;PENTOSE PHOSPHATE PATHWAY (PPP)&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
