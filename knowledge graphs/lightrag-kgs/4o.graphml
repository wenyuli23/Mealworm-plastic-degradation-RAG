      <data key="d2">chunk-b04ae62930e9961f964284418f1848b3</data>
    </node>
    <node id="&quot;SIZE DISTRIBUTION&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"Refers to the range of sizes of plastic particles present in the frass sample."&lt;SEP&gt;"Size distribution analysis was conducted to understand how microplastic particles changed during biodegradation in mealworms."</data>
      <data key="d2">chunk-b04ae62930e9961f964284418f1848b3&lt;SEP&gt;chunk-17052974ec1c317689bf07f0684f130f</data>
    </node>
    <node id="&quot;6-WEEK EXPERIMENT&quot;">
