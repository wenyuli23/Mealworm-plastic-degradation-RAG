      <data key="d2">chunk-cb1740bb657b0f90c48ee5e6d75945ce</data>
    </node>
    <node id="&quot;MATHWORKS INC.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"MathWorks Inc. is the developer of MATLAB, used for calibrating the kinetic parameters in the study's model."</data>
      <data key="d2">chunk-cb1740bb657b0f90c48ee5e6d75945ce</data>
    </node>
    <node id="&quot;IBM&quot;">
