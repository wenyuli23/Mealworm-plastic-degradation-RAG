      <data key="d2">chunk-9b4b45d826a6a7956015e680f5fb8ee6</data>
      <data key="d1">"Bacteroidetes is well-represented in control samples but not in polystyrene samples, suggesting environmental or functional differences."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
