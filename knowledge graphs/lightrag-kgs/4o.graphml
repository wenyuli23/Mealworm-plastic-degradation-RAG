      <data key="d1">"Ring opening is a chemical reaction where an aromatic ring structure is cleaved to form linear or non-cyclic compounds."</data>
      <data key="d2">chunk-5e8cdca8afb1d7153fba5e3c11b1f669</data>
    </node>
    <node id="&quot;CU²⁺&quot;">
