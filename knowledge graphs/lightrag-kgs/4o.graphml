      <data key="d2">chunk-7c810740a381d4d9e829e28c01e62564</data>
    </node>
    <node id="&quot;GRAVIMETRIC APPROACH&quot;">
      <data key="d0">"SCIENTIFIC METHOD"</data>
      <data key="d1">"A quantitative analysis method used to perform mass balance in biodegradation experiments, particularly for measuring PS degradation."</data>
      <data key="d2">chunk-7c810740a381d4d9e829e28c01e62564</data>
    </node>
    <node id="&quot;EXPERIMENTAL CONTAINERS&quot;">
      <data key="d0">"PHYSICAL FEATURE"</data>
      <data key="d1">"Containers used to house mealworm larvae during the experiment, keeping constant humidity for measuring mass balance."</data>
      <data key="d2">chunk-7c810740a381d4d9e829e28c01e62564</data>
    </node>
    <node id="\(\MATHRM{CHCL}_3\)">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"Chloroform, a solvent used to extract lipophilic fractions from organisms."</data>
      <data key="d2">chunk-57edc76f6646a41c4845d94baa519950</data>
    </node>
    <node id="&quot;LARVAE GUT INTESTINE TISSUE&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"The tissue content analyzed to determine organic compounds accumulated during PS consumption."</data>
      <data key="d2">chunk-57edc76f6646a41c4845d94baa519950</data>
    </node>
    <node id="&quot;IRGAFOS 168&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"An antioxidant additive found in food contact materials, which degrades into 2,4-DTBP."</data>
      <data key="d2">chunk-57edc76f6646a41c4845d94baa519950</data>
    </node>
    <node id="&quot;2,4-DTBP&quot;">
      <data key="d0">"TOXIN"</data>
      <data key="d1">"A compound resulting from the degradation of Irgafos 168 detected in PS degradation products."&lt;SEP&gt;"An abbreviation for 2,4-di-tert butylphenol, a toxic metabolite associated with the assimilation of polystyrene and exhibiting harmful effects."</data>
      <data key="d2">chunk-cbf098ec253f99187f3c98d5d0589f7d&lt;SEP&gt;chunk-57edc76f6646a41c4845d94baa519950</data>
    </node>
    <node id="&quot;MONOMER&quot;">
      <data key="d0">"CHEMICAL CONCEPT"</data>
      <data key="d1">"A molecule that can join with others to form polymers, observed in the biodegradation of PS."</data>
      <data key="d2">chunk-57edc76f6646a41c4845d94baa519950</data>
    </node>
    <node id="&quot;ESTERS&quot;">
      <data key="d0">"CHEMICAL BOND"</data>
      <data key="d1">"Chemical compounds possibly lost during lyophilisation, affecting volatile compound recovery."</data>
      <data key="d2">chunk-57edc76f6646a41c4845d94baa519950</data>
    </node>
    <node id="&quot;1,1-DIPHENYL-ETHYLENE&quot;">
      <data key="d0">"CHEMICAL COMPOUND"</data>
      <data key="d1">"A compound identified as part of the PS degradation process."</data>
      <data key="d2">chunk-57edc76f6646a41c4845d94baa519950</data>
    </node>
    <node id="&quot;1A-PHENYL-4E-(1-PHENYLETHYL)-1,2,3,4-TETRAHYDRONAPHTHALENE (1A-TETRALIN)&quot;">
      <data key="d0">"CHEMICAL COMPOUND"</data>
      <data key="d1">"A compound detected in frass, related to PS degradation."</data>
      <data key="d2">chunk-57edc76f6646a41c4845d94baa519950</data>
    </node>
    <node id="&quot;1E-PHENYL-4E-(1-PHENYLETHYL)-1,2,3,4-TETRAHYDRONAPHTHALENE (1E-TETRALIN)&quot;">
      <data key="d0">"CHEMICAL COMPOUND"</data>
      <data key="d1">"Another PS degradation product identified in frass."</data>
      <data key="d2">chunk-57edc76f6646a41c4845d94baa519950</data>
    </node>
    <node id="&quot;CHOLESTEROL&quot;">
      <data key="d0">"LIPID"</data>
      <data key="d1">"Cholesterol is a major lipid whose presence was significantly affected by diet, increasing particularly in Diets 2 and 3."&lt;SEP&gt;"Detected in higher amounts when bran:PS was increased, indicating nutritional component changes."</data>
      <data key="d2">chunk-57edc76f6646a41c4845d94baa519950&lt;SEP&gt;chunk-2e4030ea35bee29093c1a8f19bc90774</data>
    </node>
    <node id="&quot;GC-TOF-MS ANALYSIS&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"The analytical process used to identify and quantify chemical compounds in the experiments."</data>
      <data key="d2">chunk-57edc76f6646a41c4845d94baa519950</data>
    </node>
    <node id="&quot;HEXADECANOIC ACID&quot;">
      <data key="d0">"FATTY ACID"</data>
      <data key="d1">"Commonly found in both PS and CS-fed larvae suggesting similar metabolic pathways irrespective of feedstock."&lt;SEP&gt;"Hexadecanoic Acid is a type of fatty acid that is shown to decrease in concentration compared to the control in the study of diets."&lt;SEP&gt;"Hexadecanoic acid is a metabolic intermediate detected in the gut of all the larvae species studied for PS degradation."</data>
      <data key="d2">chunk-a52fc2936b4d2a771dbc2d6a37eeb710&lt;SEP&gt;chunk-2e4030ea35bee29093c1a8f19bc90774&lt;SEP&gt;chunk-e155a60beeedb5736450fdc1ffa4699e</data>
    </node>
    <node id="&quot;OCTADECANOIC ACID&quot;">
      <data key="d0">"FATTY ACID"</data>
      <data key="d1">"Commonly known as Stearic acid, used as an emulsifier."&lt;SEP&gt;"Octadecanoic Acid is a type of fatty acid for which decreased levels were observed across all diet comparisons."&lt;SEP&gt;"Octadecanoic acid is another long-chain fatty acid identified in the byproducts of PS biodegradation."</data>
      <data key="d2">chunk-a52fc2936b4d2a771dbc2d6a37eeb710&lt;SEP&gt;chunk-2e4030ea35bee29093c1a8f19bc90774&lt;SEP&gt;chunk-939f85d52d9301668deab282264e5fd9</data>
    </node>
    <node id="&quot;TETRADECANOIC ACID&quot;">
      <data key="d0">"FATTY ACID"</data>
      <data key="d1">"A fatty acid found in the frass or intestinal samples of CS-fed larvae."&lt;SEP&gt;"Tetradecanoic Acid is another fatty acid that was found to have decreased levels under the dietary conditions compared to the control."</data>
      <data key="d2">chunk-2e4030ea35bee29093c1a8f19bc90774&lt;SEP&gt;chunk-e155a60beeedb5736450fdc1ffa4699e</data>
    </node>
    <node id="&quot;OLEAMIDE&quot;">
      <data key="d0">"AMIDE"</data>
      <data key="d1">"Oleamide is a fatty amide observed among the metabolites being studied in relation to diet effects."</data>
      <data key="d2">chunk-2e4030ea35bee29093c1a8f19bc90774</data>
    </node>
    <node id="&quot;TETRADECANAMIDE&quot;">
      <data key="d0">"AMIDE"</data>
      <data key="d1">"Tetradecanamide is an amide whose levels were also monitored for changes across diets, found to decrease."</data>
      <data key="d2">chunk-2e4030ea35bee29093c1a8f19bc90774</data>
    </node>
    <node id="&quot;HEXADECANAMIDE&quot;">
      <data key="d0">"AMIDE"</data>
      <data key="d1">"An amide observed in the study, pointing to metabolic transformations within the larvae."&lt;SEP&gt;"Hexadecanamide is an amide that demonstrated an increase across the diet comparisons, suggesting metabolic alterations."</data>
      <data key="d2">chunk-2e4030ea35bee29093c1a8f19bc90774&lt;SEP&gt;chunk-f141d484320c21ec01b892a9b7d56486</data>
    </node>
    <node id="&quot;PRIMARY AMIDES&quot;">
      <data key="d0">"CHEMICAL COMPOUND"</data>
      <data key="d1">"Primary amides are compounds that increased due to Diet 1, indicating changes in metabolite profile due to dietary factors."</data>
      <data key="d2">chunk-2e4030ea35bee29093c1a8f19bc90774</data>
    </node>
    <node id="&quot;GLYCEROL&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Glycerol is a metabolite that may indicate metabolic stress in mealworms and is a precursor for triacylglycerols and phospholipids."&lt;SEP&gt;"Glycerol is a simple polyol compound, often a byproduct of the metabolism of fats and found in various biological processes."</data>
      <data key="d2">chunk-2ddf4b13293dd3d8d0887af10fc52c98&lt;SEP&gt;chunk-2e4030ea35bee29093c1a8f19bc90774</data>
    </node>
    <node id="&quot;TRIACYLGLYCEROLS (TAG)&quot;">
      <data key="d0">"LIPID"</data>
      <data key="d1">"Triacylglycerols are significant lipids involved in energy storage, formed by glycerol and fatty acids, and hydrolyzed under stress conditions."</data>
      <data key="d2">chunk-2e4030ea35bee29093c1a8f19bc90774</data>
    </node>
    <node id="&quot;ADIPOSE TRIGLYCERIDE LIPASE (AGTL)&quot;">
      <data key="d0">"ENZYME"</data>
      <data key="d1">"AGTL is an enzyme responsible for hydrolyzing triacylglycerols into free fatty acids and glycerol within the intestine."</data>
      <data key="d2">chunk-2e4030ea35bee29093c1a8f19bc90774</data>
    </node>
    <node id="&quot;MANNOSE&quot;">
      <data key="d0">"NUTRIENT"</data>
      <data key="d1">"Mannose is a monosaccharide involved in protein glycosylation, whose levels decreased significantly across the diets studied."&lt;SEP&gt;"Mannose is an important monosaccharide involved in protein glycosylation in mammals. It is considered a non-efficient cellular energy source and plays a role in N-linked glycosylation, a post-translational modification of proteins."</data>
      <data key="d2">chunk-7d616d4c3c3199d53c1ae93ebcf3589d&lt;SEP&gt;chunk-2e4030ea35bee29093c1a8f19bc90774</data>
    </node>
    <node id="&quot;PROTEIN GLYCOSYLATION&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Protein Glycosylation is a post-translational modification of proteins, playing a central role in cellular functions and affected by mannose levels."</data>
      <data key="d2">chunk-2e4030ea35bee29093c1a8f19bc90774</data>
    </node>
    <node id="&quot;9-OCTADECANAMIDE, (Z)&quot;">
      <data key="d0">"AMIDE"</data>
      <data key="d1">"9-Octadecanamide, (Z) is a chemical compound measured in the study, showing a decrease across all diet comparisons."</data>
      <data key="d2">chunk-2e4030ea35bee29093c1a8f19bc90774</data>
    </node>
    <node id="&quot;26-NOR-5-CHOLESTEN-3.BETA.-OL-25-ONE&quot;">
      <data key="d0">"LIPID"</data>
      <data key="d1">"26-Nor-5-cholesten-3.beta.-ol-25-one is a lipid whose levels decrease in response to dietary interventions."</data>
      <data key="d2">chunk-2e4030ea35bee29093c1a8f19bc90774</data>
    </node>
    <node id="&quot;CHOLEST-5-EN-3-OL (3.BETA.-)&quot;">
      <data key="d0">"LIPID"</data>
      <data key="d1">"A cholesterol derivative involved in the characterization of lipid fractions in larvae."&lt;SEP&gt;"Cholest-5-en-3-ol (3.beta.-) is a form of cholesterol that increases across all diet comparisons."</data>
      <data key="d2">chunk-2e4030ea35bee29093c1a8f19bc90774&lt;SEP&gt;chunk-f141d484320c21ec01b892a9b7d56486</data>
    </node>
    <node id="&quot;CHOLEST-5-EN-3-OL, (3.ALPHA.)&quot;">
      <data key="d0">"LIPID"</data>
      <data key="d1">"Cholest-5-en-3-ol, (3.alpha.) is a variety of cholesterol that decreases in all diet situations examined."</data>
      <data key="d2">chunk-2e4030ea35bee29093c1a8f19bc90774</data>
    </node>
    <node id="&quot;CHOLESTA-3,5-DIENE&quot;">
      <data key="d0">"LIPID"</data>
      <data key="d1">"Cholesta-3,5-diene is a cholesterol derivative that shows a general decrease across the different dietary conditions."</data>
      <data key="d2">chunk-2e4030ea35bee29093c1a8f19bc90774</data>
    </node>
    <node id="&quot;HEXADECANOIC ACID, 2-HYDROXY-1-(HYDROXYMETHYL)ETHYL ESTER&quot;">
      <data key="d0">"FATTY ACID"</data>
      <data key="d1">"A complex ester produced, likely due to chemical and enzymatic interactions in the gut."&lt;SEP&gt;"This ester of hexadecanoic acid shows an increase in concentration in response to diets compared to the control."</data>
      <data key="d2">chunk-2e4030ea35bee29093c1a8f19bc90774&lt;SEP&gt;chunk-f141d484320c21ec01b892a9b7d56486</data>
    </node>
    <node id="&quot;HEXADECANOIC ACID, BUTYL ESTER&quot;">
      <data key="d0">"FATTY ACID"</data>
      <data key="d1">"Hexadecanoic acid, butyl ester is a compound that demonstrates decreased levels in dietary comparisons."</data>
      <data key="d2">chunk-2e4030ea35bee29093c1a8f19bc90774</data>
    </node>
    <node id="&quot;HEXANEDIOIC ACID, MONO(2-ETHYLHEXYL)ESTER&quot;">
      <data key="d0">"FATTY ACID"</data>
      <data key="d1">"This ester compound shows a decrease when comparing the dietary interventions to the control."</data>
      <data key="d2">chunk-2e4030ea35bee29093c1a8f19bc90774</data>
    </node>
    <node id="&quot;N-PENTADECANOIC ACID, METHYL ESTER&quot;">
      <data key="d0">"FATTY ACID"</data>
      <data key="d1">"A methyl ester of pentadecanoic acid, which is found to decrease in all diet comparisons."</data>
      <data key="d2">chunk-2e4030ea35bee29093c1a8f19bc90774</data>
    </node>
    <node id="&quot;OCTADECANOIC ACID, METHYL ESTER&quot;">
      <data key="d0">"FATTY ACID"</data>
      <data key="d1">"Methyl ester of octadecanoic acid, a recurring compound indicating fatty acid metabolism."&lt;SEP&gt;"Octadecanoic acid, methyl ester also decreases in concentration in reaction to all diet conditions."</data>
