      <data key="d1">"A mineral in TMlp at a concentration of 27.97, important for iron metabolism and neurological function."</data>
      <data key="d2">chunk-fb1c38c1c6dc6fea84d8f51b9f706cd2</data>
    </node>
    <node id="&quot;MANGANESE (MN)&quot;">
      <data key="d0">"MINERAL"</data>
      <data key="d1">"A mineral present in TMlp at a concentration of 24.64, essential for bone formation and metabolic activity."</data>
      <data key="d2">chunk-fb1c38c1c6dc6fea84d8f51b9f706cd2</data>
    </node>
