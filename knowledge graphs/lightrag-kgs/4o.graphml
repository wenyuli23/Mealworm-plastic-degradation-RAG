      <data key="d1">"Fatty acids are derivatives extracted from mealworms and analyzed to study their composition and transformation."</data>
      <data key="d2">chunk-56c8b21b1eaba7633b49cea16714ddc1</data>
    </node>
    <node id="&quot;METHYLATED DERIVATIVES&quot;">
      <data key="d0">"PRODUCT"</data>
