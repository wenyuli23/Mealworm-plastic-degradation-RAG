      <data key="d2">chunk-d5238515b2316265fb5cb6c6295c54e8</data>
    </node>
    <node id="&quot;ETHYLENE GLYCOL (EG)&quot;">
      <data key="d0">"COMPOUND"</data>
      <data key="d1">"A product of PET metabolism that can be oxidized by gut microbes into glyoxylate through glycolaldehyde and glycolate."</data>
      <data key="d2">chunk-d5238515b2316265fb5cb6c6295c54e8</data>
    </node>
    <node id="&quot;TEREPHTHALIC ACID&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"A breakdown product of PET hydrolysis, often used in the synthesis of plastics and as a part of the recycling process."&lt;SEP&gt;"An intermediate organic acid formed during PET degradation, which is further metabolized to protocatechuic acid by dioxygenase."&lt;SEP&gt;"Terephthalic Acid is a hydrolysis product of PET that is metabolized into protocatechuic acid during degradation."</data>
      <data key="d2">chunk-81610bdb5fdb95d9a333b42668532b9f&lt;SEP&gt;chunk-d5238515b2316265fb5cb6c6295c54e8&lt;SEP&gt;chunk-b19ac5bdc755bb8e9deb8e317ce365dd</data>
    </node>
