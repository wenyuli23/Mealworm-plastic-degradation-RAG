      <data key="d2">chunk-490fdb90ad8a65d35f3c2cd42a8c4c8e</data>
    </node>
    <node id="&quot;\(M_{W}\), \(M_{P}\), \(M_{S}\)&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"These represent molecular weights observed during GPC analysis, which change as plastics are depolymerized."</data>
      <data key="d2">chunk-490fdb90ad8a65d35f3c2cd42a8c4c8e</data>
    </node>
    <node id="&quot;INTESTINAL MICROBIAL CONSORTIUM&quot;">
      <data key="d0">"MICROORGANISMS"</data>
