      <data key="d2">chunk-98d4ea946a931acf7e5a8292c30ea4c7&lt;SEP&gt;chunk-9b693d867918f89c9b28997fe94fc830</data>
    </node>
    <node id="&quot;CRUDE FATS&quot;">
      <data key="d0">"NUTRIENT"</data>
