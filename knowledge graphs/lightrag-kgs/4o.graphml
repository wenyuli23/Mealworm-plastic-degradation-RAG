      <data key="d2">chunk-158317f8eba5f6198135df044d385935</data>
    </node>
    <node id="&quot;METATRANSCRIPTOMICS&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Metatranscriptomics involves analyzing transcriptomes from microbial communities to understand the expression of genes."</data>
      <data key="d2">chunk-158317f8eba5f6198135df044d385935</data>
    </node>
    <node id="&quot;XYLOSE&quot;">
      <data key="d0">"NUTRIENT"</data>
      <data key="d1">"Xylose is a sugar derived from hemicellulose degradation, entering metabolic pathways for energy."</data>
      <data key="d2">chunk-158317f8eba5f6198135df044d385935</data>
    </node>
    <node id="&quot;OCTADECENOIC ACID&quot;">
      <data key="d0">"FATTY ACID"</data>
      <data key="d1">"Octadecenoic Acid is a long-chain fatty acid detected as an intermediate in PS/CS degradation pathways."</data>
      <data key="d2">chunk-158317f8eba5f6198135df044d385935</data>
    </node>
    <node id="&quot;HEXADECENOIC ACID&quot;">
      <data key="d0">"FATTY ACID"</data>
      <data key="d1">"Hexadecenoic Acid is another fatty acid found as an intermediate in the degradation pathways of PS and CS."</data>
      <data key="d2">chunk-158317f8eba5f6198135df044d385935</data>
    </node>
    <node id="&quot;Β-OXIDATION PROCESS&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"The β-oxidation process is a metabolic pathway involving the breakdown of fatty acids to acetyl-CoA, which occurs in the mitochondria."</data>
      <data key="d2">chunk-5e8cdca8afb1d7153fba5e3c11b1f669</data>
    </node>
    <node id="&quot;60S RIBOSOMAL PROTEIN 27A (TML27A)&quot;">
