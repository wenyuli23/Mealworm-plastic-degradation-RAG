      <data key="d0">"BACTERIUM"</data>
      <data key="d1">"A strain of Klebsiella oxytoca identified using NBRC-specific primers under PCR conditions."&lt;SEP&gt;"Klebsiella oxytoca NBRC 102593 is a specific strain confirmed in the study, isolated from the gut of T. molitor."&lt;SEP&gt;"Klebsiella oxytoca NBRC 102593 is a bacterial strain identified from isolate number 5 in Tenebrio molitor's gut."&lt;SEP&gt;"Klebsiella oxytoca NBRC 102593 is a gram-negative bacterium found in the gut of Tenebrio molitor, indicated as involved in degrading polystyrene."&lt;SEP&gt;"Klebsiella oxytoca NBRC 102593 is a strain of the bacterium found in the mealworm's gut used for polystyrene degradation studies."&lt;SEP&gt;"Klebsiella oxytoca NBRC 102593 is one of the bacterial strains isolated from T. molitor, contributing to polystyrene biodegradation."</data>
      <data key="d2">chunk-f488d8d4434d57d1a775a22333caa04b&lt;SEP&gt;chunk-568e2e90ce0d3bbb4e21079f4252f5de&lt;SEP&gt;chunk-220952ca1d34f3ffef65c5d71e22015e&lt;SEP&gt;chunk-652bf0615ec39fba0cedd113ec87a78a&lt;SEP&gt;chunk-33649582d350bc1da7dbca1a65092127&lt;SEP&gt;chunk-d8b79a6f4c112b0b62ada6756140e3e0</data>
    </node>
