      <data key="d1">"Attenuated Total Reflection-Fourier Transform Infrared Spectroscopy is used to analyze the material characteristics of polystyrene."</data>
      <data key="d2">chunk-30c4244cae75095bda7fb526c3d0c9d9</data>
    </node>
    <node id="&quot;METHOXIME HYDROCHLORIDE&quot;">
      <data key="d0">"CHEMICAL"</data>
      <data key="d1">"Methoxime Hydrochloride is a chemical compound used in various experimental analyses."</data>
      <data key="d2">chunk-30c4244cae75095bda7fb526c3d0c9d9</data>
    </node>
    <node id="&quot;CHLOROFORM (CHCL3)&quot;">
      <data key="d0">"CHEMICAL"</data>
      <data key="d1">"Chloroform is a solvent used in the extraction process for GC-based metabolomics."</data>
      <data key="d2">chunk-30c4244cae75095bda7fb526c3d0c9d9</data>
    </node>
    <node id="&quot;PYRIDINE&quot;">
      <data key="d0">"CHEMICAL"</data>
      <data key="d1">"Pyridine is an organic solvent used in the laboratory analysis."</data>
      <data key="d2">chunk-30c4244cae75095bda7fb526c3d0c9d9</data>
    </node>
    <node id="&quot;METHANOL (MEOH) LC-MS GRADE&quot;">
      <data key="d0">"CHEMICAL"</data>
      <data key="d1">"Methanol LC-MS grade is used for high precision in mass spectrometry analysis."</data>
      <data key="d2">chunk-30c4244cae75095bda7fb526c3d0c9d9</data>
    </node>
    <node id="&quot;2-PROPANOL (ISOH) LC-MS GRADE&quot;">
      <data key="d0">"CHEMICAL"</data>
      <data key="d1">"2-Propanol is a grade of isopropyl alcohol used as a solvent for mass spectrometry."</data>
      <data key="d2">chunk-30c4244cae75095bda7fb526c3d0c9d9</data>
    </node>
    <node id="&quot;ULTRAPURE WATER (18.2 MΩ)&quot;">
      <data key="d0">"CHEMICAL"</data>
      <data key="d1">"Ultrapure water is used in the preparation of stock solutions for analytical procedures."</data>
      <data key="d2">chunk-30c4244cae75095bda7fb526c3d0c9d9</data>
    </node>
    <node id="&quot;POLYTETRAFLUOROETHYLENE (PTFE) FILTERS&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"PTFE filters are used to filter samples before analysis, ensuring purity and accuracy."</data>
      <data key="d2">chunk-30c4244cae75095bda7fb526c3d0c9d9</data>
    </node>
    <node id="&quot;MYRISTIC ACID-D27&quot;">
      <data key="d0">"FATTY ACID"</data>
      <data key="d1">"Myristic acid-d27 is a deuterated form of myristic acid used as an internal standard in biological extracts."</data>
      <data key="d2">chunk-5134944e002326fa5ca136c470d99e2e</data>
    </node>
    <node id="&quot;CHCL3&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"CHCl3, also known as chloroform, is used as a solvent in the extraction and preparation of samples for analysis."</data>
      <data key="d2">chunk-5134944e002326fa5ca136c470d99e2e</data>
    </node>
    <node id="&quot;GUT INTESTINE TISSUE&quot;">
      <data key="d0">"PHYSICAL FEATURE"</data>
      <data key="d1">"Gut intestine tissue refers to the biological material removed from larvae for homogenization and extraction in the study."</data>
      <data key="d2">chunk-5134944e002326fa5ca136c470d99e2e</data>
    </node>
    <node id="&quot;GC-MS METABOLOMICS ANALYTICAL METHOD&quot;">
      <data key="d0">"CHEMICAL REACTION"</data>
      <data key="d1">"A method involving gas chromatography-mass spectrometry used to analyze metabolites in a biological sample."</data>
      <data key="d2">chunk-5134944e002326fa5ca136c470d99e2e</data>
    </node>
    <node id="&quot;DERIVATIZATION&quot;">
      <data key="d0">"CHEMICAL REACTION"</data>
      <data key="d1">"Derivatization is a chemical modification process applied to samples before gas chromatography to improve volatility and detectability."</data>
      <data key="d2">chunk-5134944e002326fa5ca136c470d99e2e</data>
    </node>
    <node id="&quot;METHOXYAMINE HYDROCHLORIDE&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"Methoxyamine Hydrochloride is used in derivatization to protect ketones and aldehydes by forming methoxyamino groups."</data>
      <data key="d2">chunk-5134944e002326fa5ca136c470d99e2e</data>
    </node>
    <node id="&quot;N-METHYL-N-TRIMETHYLSILYL TRIFLUOROACETAMIDE (MSTFA/1% TMCS)&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"MSTFA/1% TMCS is used in derivatization to silylate the samples, enhancing analysis by gas chromatography."</data>
      <data key="d2">chunk-5134944e002326fa5ca136c470d99e2e</data>
    </node>
    <node id="&quot;GC-TOF-MS SYSTEM&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"The GC-ToF-MS system is a gas chromatography coupled with time-of-flight mass spectrometer used for detailed analysis of samples."&lt;SEP&gt;"The gas chromatography time-of-flight mass spectrometry system utilized for separating and analyzing metabolites in the study."</data>
      <data key="d2">chunk-5134944e002326fa5ca136c470d99e2e</data>
    </node>
    <node id="&quot;AGILENT TECHNOLOGIES 7890B&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"A model of gas chromatography system used in metabolomics analysis, coupled with a mass spectrometer for comprehensive sample analysis."</data>
      <data key="d2">chunk-5134944e002326fa5ca136c470d99e2e</data>
    </node>
    <node id="&quot;AGILENT TECHNOLOGIES 7200 ACCURATE-MASS Q-TOF MASS SPECTROMETER&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"A mass spectrometer model used in conjunction with gas chromatography for accurate mass analysis of metabolites."&lt;SEP&gt;"This mass spectrometer is coupled with the gas chromatography system for accurate mass analysis of metabolites in experiments."</data>
      <data key="d2">chunk-7c810740a381d4d9e829e28c01e62564&lt;SEP&gt;chunk-5134944e002326fa5ca136c470d99e2e</data>
    </node>
    <node id="&quot;FIEHN GC/MS METABOLOMICS METHOD&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"A metabolomics method involving derivatization to study the chemical composition of biological samples using gas chromatography."</data>
      <data key="d2">chunk-5134944e002326fa5ca136c470d99e2e</data>
    </node>
    <node id="&quot;ELLIPTICAL SHAKER&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"An elliptical shaker is a device used to thoroughly mix or agitate samples, enhancing extraction effectiveness."</data>
      <data key="d2">chunk-5134944e002326fa5ca136c470d99e2e</data>
    </node>
    <node id="&quot;PTFE SYRINGE FILTER 0.22 ΜM&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"A PTFE syringe filter with a 0.22 μm pore size is used to filter samples before injection into the GC-TOF-MS system."</data>
      <data key="d2">chunk-5134944e002326fa5ca136c470d99e2e</data>
    </node>
    <node id="&quot;PS-OLIGOMERS&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Polystyrene oligomers resulting from the breakdown of polystyrene, analyzed in the study for biodegradation."</data>
      <data key="d2">chunk-5134944e002326fa5ca136c470d99e2e</data>
    </node>
    <node id="&quot;FRASS EXTRACT&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"Frass extract is derived from insect waste and analyzed for its chemical composition after derivatization."</data>
      <data key="d2">chunk-5134944e002326fa5ca136c470d99e2e</data>
    </node>
    <node id="&quot;MASS SPECTRAL ANALYSIS&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Mass spectral analysis involves examining the mass-to-charge ratio of ions to identify compounds in samples."</data>
      <data key="d2">chunk-5134944e002326fa5ca136c470d99e2e</data>
    </node>
    <node id="&quot;SEPARATION OF METABOLITES&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"The process of chromatography is used to separate metabolites based on their chemical properties."</data>
      <data key="d2">chunk-5134944e002326fa5ca136c470d99e2e</data>
    </node>
    <node id="&quot;ION SOURCE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"The ion source is a component of the mass spectrometer that generates ions from the sample for mass analysis."</data>
      <data key="d2">chunk-5134944e002326fa5ca136c470d99e2e</data>
    </node>
    <node id="&quot;DIET 1 (LOW PS:BRAN)&quot;">
      <data key="d0">"DIET"</data>
      <data key="d1">"Diet 1 consists of a low ratio of PS to bran given to mealworm larvae, used to assess the biodegradation efficiency and growth performance of the larvae."</data>
      <data key="d2">chunk-7c810740a381d4d9e829e28c01e62564</data>
    </node>
    <node id="&quot;DIET 2 (HIGH PS:BRAN, WATER INCLUDED)&quot;">
      <data key="d0">"DIET"</data>
      <data key="d1">"Diet 2 consists of a high ratio of PS to bran with water included, provided to assess its effect on PS consumption and the growth performance of mealworm larvae."</data>
      <data key="d2">chunk-7c810740a381d4d9e829e28c01e62564</data>
    </node>
    <node id="&quot;DIET 3 (PS/BARLEY 20:1)&quot;">
      <data key="d0">"DIET"</data>
      <data key="d1">"Diet 3 consists of a specific ratio of PS to barley used to evaluate differences in consumption rates and biodegradation efficiency."</data>
      <data key="d2">chunk-7c810740a381d4d9e829e28c01e62564</data>
    </node>
    <node id="&quot;MASSHUNTER SOFTWARE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Masshunter Software by Agilent Technologies is used to process mass spectrometry data, integrating compound identification and sample classification."</data>
      <data key="d2">chunk-7c810740a381d4d9e829e28c01e62564</data>
    </node>
    <node id="&quot;AGILENT TECHNOLOGIES 7890B GAS CHROMATOGRAPHY SYSTEM&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Agilent Technologies 7890B Gas Chromatography System is used for injecting and separating metabolites on an HP-5MS capillary column during experiments."</data>
      <data key="d2">chunk-7c810740a381d4d9e829e28c01e62564</data>
    </node>
    <node id="&quot;HP-5MS CAPILLARY COLUMN&quot;">
      <data key="d0">"PHYSICAL FEATURE"</data>
      <data key="d1">"This capillary column is used for separating metabolites; it is coated with polyimide and supports the gas chromatography process."</data>
      <data key="d2">chunk-7c810740a381d4d9e829e28c01e62564</data>
    </node>
    <node id="&quot;ION SOURCE TEMPERATURE&quot;">
      <data key="d0">"PHYSICAL PROPERTY"</data>
      <data key="d1">"A specific temperature setting of 230 °C used in the mass spectrometer to facilitate mass spectral analysis."</data>
      <data key="d2">chunk-7c810740a381d4d9e829e28c01e62564</data>
    </node>
    <node id="&quot;MASSHUNTER PROFESSIONAL (MPP) V.15.0&quot;">
      <data key="d0">"TECHNOLOGY"</data>
