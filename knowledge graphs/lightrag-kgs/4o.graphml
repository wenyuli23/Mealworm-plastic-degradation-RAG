      <data key="d2">chunk-af5eb6a8326b4977801e2f7694a2c750</data>
    </node>
    <node id="&quot;WAXCOMB (WC)&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"A natural product made by bees and used in comparison to polyethylene in studies of biodegradation by Achroia grisella."&lt;SEP&gt;"Waxcomb is used as a positive control and co-feed to examine the degradation of polyethylene by lesser waxworms in the study."</data>
      <data key="d2">chunk-b25215becbc007a60f24b86a2d6aaf26&lt;SEP&gt;chunk-af5eb6a8326b4977801e2f7694a2c750</data>
