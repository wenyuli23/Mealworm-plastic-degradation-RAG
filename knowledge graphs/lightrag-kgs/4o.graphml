      <data key="d2">chunk-1ead6f17ad517015b638608c5bfe6852</data>
    </node>
    <node id="&quot;ARACHIDIC ACID&quot;">
      <data key="d0">"FATTY ACID"</data>
      <data key="d1">"Arachidic acid contributes to the fatty acid profile of insects, with higher levels in the OAT diet group compared to others."</data>
      <data key="d2">chunk-1ead6f17ad517015b638608c5bfe6852</data>
    </node>
    <node id="&quot;MYRISTOLEIC ACID&quot;">
      <data key="d0">"FATTY ACID"</data>
