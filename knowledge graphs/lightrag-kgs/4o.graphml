      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Used for proton nuclear magnetic resonance in the analysis of plastic degradation."</data>
      <data key="d2">chunk-aa33fb34ba06610c290cdfd8a5b4e916</data>
    </node>
