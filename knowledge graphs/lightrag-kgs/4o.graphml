      <data key="d2">chunk-086890e8567c60d8cfa7c03b0cc61f9a</data>
    </node>
    <node id="&quot;CLIMATE CHAMBER&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"A climate chamber is used to keep environmental conditions steady for mealworm survival tests."</data>
      <data key="d2">chunk-086890e8567c60d8cfa7c03b0cc61f9a</data>
    </node>
    <node id="&quot;OATS, WHEAT BRAN, GRAIN&quot;">
      <data key="d0">"NUTRITIONAL COMPONENT"</data>
