      <data key="d2">chunk-00a6288e1109e01eac1ce7ecb35f2eda</data>
    </node>
    <node id="&quot;EDIBLE INSECTS&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Edible insects are viewed as a sustainable food resource with future prospects for enhancing food security."&lt;SEP&gt;"Edible insects represent a sustainable food source, expected to gain popularity as sources of protein and nutrients."&lt;SEP&gt;"Edible insects such as Tenebrio molitor, Alphitobius diaperinus, and Hermetia illucens are studied for their protein content and nutritional value."</data>
