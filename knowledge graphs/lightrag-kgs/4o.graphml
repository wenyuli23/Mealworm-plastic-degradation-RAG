      <data key="d2">chunk-5af82472112cbc9e76b1fd1ac6e8c54e</data>
    </node>
    <node id="&quot;DNA SEQUENCING&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"DNA sequencing is applied to confirm the genetic identity of the lesser waxworms through analysis of their genetic material."</data>
      <data key="d2">chunk-5af82472112cbc9e76b1fd1ac6e8c54e</data>
    </node>
    <node id="&quot;WAXWORM CONTROL (WC)&quot;">
