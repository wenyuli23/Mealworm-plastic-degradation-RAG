      <data key="d0">"GENE"</data>
      <data key="d1">"Genes involved in breaking down lignin and plastic, classified into AA or CE family, crucial for metabolic pathways in PS-/CS-fed larvae."</data>
      <data key="d2">chunk-ca86254d65e47c4049e193cf2098b964</data>
    </node>
    <node id="&quot;GH/CE FAMILIES&quot;">
      <data key="d0">"GENETIC CONCEPT"</data>
      <data key="d1">"GH/CE families are groups of genes and enzymes specifically associated with the degradation of hemicellulose and cellulose."</data>
      <data key="d2">chunk-ca86254d65e47c4049e193cf2098b964</data>
    </node>
    <node id="&quot;BACTERIAL SPECIES&quot;">
      <data key="d0">"MICROORGANISMS"</data>
      <data key="d1">"Various bacterial species identified as sources of enzymes involved in degradation processes in PS-/CS-fed larvae, analyzed using 16S rRNA and metatranscriptomics."</data>
      <data key="d2">chunk-ca86254d65e47c4049e193cf2098b964</data>
    </node>
    <node id="&quot;PS AND CS DIETS&quot;">
      <data key="d0">"DIET"</data>
      <data key="d1">"PS (polystyrene) and CS (cellulose) diets fed to larvae, influencing gene expression and metabolic pathways."</data>
      <data key="d2">chunk-ca86254d65e47c4049e193cf2098b964</data>
    </node>
