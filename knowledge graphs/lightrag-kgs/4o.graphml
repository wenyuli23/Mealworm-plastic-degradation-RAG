      <data key="d1">"\(^{1}H\)-NMR is used to characterize changes in the end group of egested polymers."</data>
      <data key="d2">chunk-0a3e42eecd3967a9e53cfadc926363ee</data>
    </node>
    <node id="&quot;HONGQIAO INSECT BREEDING PLANT&quot;">
