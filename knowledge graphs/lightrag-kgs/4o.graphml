      <data key="d2">chunk-81f09d7c1a5d91a7a0b4766ca0e47f56</data>
    </node>
    <node id="&quot;METATRANSCRIPTOMIC ANALYSIS&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
