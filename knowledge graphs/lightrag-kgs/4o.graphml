      <data key="d2">chunk-aa33fb34ba06610c290cdfd8a5b4e916</data>
    </node>
    <node id="&quot;SINOPHARM CHEMICAL REAGENT CO., LTD.&quot;">
      <data key="d0">"ORGANIZATION"</data>
