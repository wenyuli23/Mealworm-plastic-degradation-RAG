    </node>
    <node id="&quot;ENVIRONMENTAL CONTAMINANTS&quot;">
      <data key="d0">"TOXIN"</data>
      <data key="d1">"Environmental contaminants are harmful substances present in the environment that may affect insect development and breeding."</data>
