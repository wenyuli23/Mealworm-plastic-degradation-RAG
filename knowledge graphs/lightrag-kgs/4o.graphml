      <data key="d2">chunk-5740f0973ff804cae61f6fc12f3e3753</data>
    </node>
    <node id="&quot;SHAPE COEFFICIENT&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"The shape coefficient is a value that quantifies the growth pattern of mealworms, which remained constant, indicating isomorphic growth."</data>
      <data key="d2">chunk-5740f0973ff804cae61f6fc12f3e3753</data>
    </node>
    <node id="&quot;MASS LOSS OF PS&quot;">
