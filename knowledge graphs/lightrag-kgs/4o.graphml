    <node id="&quot;PYROLYZER-GAS CHROMATOGRAPHY MASS SPECTROMETRY&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Pyrolyzer-gas chromatography mass spectrometry (Py-GCMS) is a method used to quantify plastic components in solid residues by breaking them down and analyzing their mass spectra."</data>
      <data key="d2">chunk-cb1740bb657b0f90c48ee5e6d75945ce</data>
    </node>
    <node id="&quot;BIODEGRADATION RATE CONSTANT&quot;">
      <data key="d0">"METABOLIC MEASURE"</data>
