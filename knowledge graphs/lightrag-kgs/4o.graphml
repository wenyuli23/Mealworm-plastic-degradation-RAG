      <data key="d2">chunk-eaf1f7b81bc271c665d7776cc3114a92</data>
    </node>
    <node id="&quot;CARBOXYL ESTERASE&quot;">
      <data key="d0">"ENZYME"</data>
      <data key="d1">"Carboxyl esterase is a CAZyme involved in breaking down complex carbon molecules in PS- and CS-fed larvae."</data>
      <data key="d2">chunk-eaf1f7b81bc271c665d7776cc3114a92</data>
    </node>
    <node id="&quot;ENDO-BETA-1,3(4)-GLUCANASE&quot;">
      <data key="d0">"ENZYME"</data>
      <data key="d1">"Endo-beta-1,3(4)-glucanase is an enzyme within CAZymes involved in lignin breakdown in plastic-fed mealworms."</data>
      <data key="d2">chunk-eaf1f7b81bc271c665d7776cc3114a92</data>
    </node>
    <node id="&quot;ACETYL XYLAN ESTERASE&quot;">
      <data key="d0">"ENZYME"</data>
      <data key="d1">"Acetyl xylan esterase is a CAZyme enzyme linked to the degradation of lignocellulose in PS- and CS-fed groups."&lt;SEP&gt;"Acetyl xylan esterase is an enzyme classified as CE1; EC 3.1.1.72, involved in breaking down hemicellulose polysaccharides in PS-/CS-fed larval groups."</data>
      <data key="d2">chunk-eaf1f7b81bc271c665d7776cc3114a92&lt;SEP&gt;chunk-ca86254d65e47c4049e193cf2098b964</data>
    </node>
    <node id="&quot;FERULOYL ESTERASE&quot;">
      <data key="d0">"ENZYME"</data>
      <data key="d1">"Feruloyl esterase is part of CAZymes that degrades complex carbon structures related to lignin and plastic degradation."&lt;SEP&gt;"Feruloyl esterase, under CE1; EC 3.1.1.73, plays a role in breaking ester bonds in the hemicellulose of lignocellulose in PS-/CS-fed larval groups."</data>
      <data key="d2">chunk-eaf1f7b81bc271c665d7776cc3114a92&lt;SEP&gt;chunk-ca86254d65e47c4049e193cf2098b964</data>
    </node>
    <node id="&quot;CS-FED GROUP&quot;">
