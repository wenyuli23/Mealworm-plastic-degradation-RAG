      <data key="d2">chunk-b04ae62930e9961f964284418f1848b3</data>
    </node>
    <node id="&quot;VIENNA PEE DEE BELEMNITE (VPDB)&quot;">
      <data key="d0">"ISOTOPE STANDARD"</data>
      <data key="d1">"An international standard for carbon isotopes used in stable isotope analysis."</data>
      <data key="d2">chunk-b04ae62930e9961f964284418f1848b3</data>
    </node>
    <node id="&quot;Δ13C&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"Delta 13C notation is used to express isotopic ratio differences in parts per thousand."</data>
      <data key="d2">chunk-b04ae62930e9961f964284418f1848b3</data>
    </node>
    <node id="&quot;MEALWORM LARVAL INTESTINES&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
