      <data key="d2">chunk-b04ae62930e9961f964284418f1848b3</data>
    </node>
    <node id="&quot;SUBMICROPLASTICS&quot;">
      <data key="d0">"PHYSICAL CHARACTERISTIC"</data>
      <data key="d1">"Plastic particles ranging from 100 nanometers to 10 micrometers."</data>
      <data key="d2">chunk-b04ae62930e9961f964284418f1848b3</data>
    </node>
    <node id="&quot;FRASS SAMPLE&quot;">
      <data key="d0">"ECOLOGICAL CONCEPT"</data>
