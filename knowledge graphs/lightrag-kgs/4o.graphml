      <data key="d2">chunk-d76cb64e0aa4e4039b70799a0df8943d</data>
    </node>
    <node id="&quot;DETERMINISTIC PROCESSES&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"Deterministic processes drive the structured patterns of microbial community assembly, contrasting stochastic processes."</data>
      <data key="d2">chunk-d76cb64e0aa4e4039b70799a0df8943d</data>
    </node>
