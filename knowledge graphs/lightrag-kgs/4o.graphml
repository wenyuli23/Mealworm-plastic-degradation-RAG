      <data key="d2">chunk-ae2c294948460ef392ceeec82d5e81f8</data>
    </node>
    <node id="&quot;Β-NICOTINAMIDE ADENINE NUCLEOTIDE (Β-NAD)&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"β-NAD is a cofactor whose synthesis is elevated in mealworms via purine metabolism."</data>
      <data key="d2">chunk-ae2c294948460ef392ceeec82d5e81f8</data>
    </node>
    <node id="&quot;FLAVIN ADENINE NUCLEOTIDE (FAD)&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"FAD is a cofactor whose synthesis is increased in mealworms through elevated purine metabolism."</data>
      <data key="d2">chunk-ae2c294948460ef392ceeec82d5e81f8</data>
    </node>
    <node id="&quot;3-DEHYDROSHIKIMATE&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"3-dehydroshikimate is a metabolite indicating altered metabolism and cofactor accumulation in mealworms."</data>
      <data key="d2">chunk-ae2c294948460ef392ceeec82d5e81f8</data>
    </node>
    <node id="&quot;PLASTIC WEIGHT LOSS&quot;">
      <data key="d0">"PHYSICAL CHARACTERISTIC"</data>
