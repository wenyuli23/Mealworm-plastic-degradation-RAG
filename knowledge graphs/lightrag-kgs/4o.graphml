      <data key="d0">"NUTRITIONAL COMPONENT"</data>
      <data key="d1">"Sodium Chloride or NaCl is used in Blood Agar to maintain osmotic balance."</data>
      <data key="d2">chunk-88659f9848d30be72c37a99b551a9a0a</data>
    </node>
    <node id="&quot;SHEEP BLOOD&quot;">
