      <data key="d2">chunk-d8c6850a83a1c6efd4f1a3a37a0a8181</data>
    </node>
    <node id="&quot;PE MICROPLASTICS (MPS)&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Small fragments of polyethylene plastic resulting from degradation or manufacturing, studied for their impact on biological systems."</data>
      <data key="d2">chunk-d8c6850a83a1c6efd4f1a3a37a0a8181</data>
    </node>
