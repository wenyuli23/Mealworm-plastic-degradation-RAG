      <data key="d2">chunk-f5613b129e38cb777855c04f228fe7e9</data>
    </node>
    <node id="&quot;ECO-FRIENDLY WASTE MANAGEMENT&quot;">
      <data key="d0">"ECOLOGICAL CONCEPT"</data>
      <data key="d1">"Eco-Friendly Waste Management refers to sustainable disposal practices aimed at reducing plastic pollution, explored through biodegradation methods such as those in this study."</data>
      <data key="d2">chunk-f5613b129e38cb777855c04f228fe7e9</data>
    </node>
