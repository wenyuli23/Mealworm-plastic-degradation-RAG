      <data key="d2">chunk-5f99668e767a56e2e64ece791653b952</data>
      <data key="d1">"Aspergillus oryzae is the source of a biodegradable plastic-degrading enzyme."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
