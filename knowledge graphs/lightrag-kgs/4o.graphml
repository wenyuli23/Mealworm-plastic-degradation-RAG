      <data key="d0">"MICROORGANISMS"</data>
      <data key="d1">"Kocuria rosea MTCC 1532 is a bacterial strain known for its ability to biodegrade malachite green, a synthetic dye."</data>
      <data key="d2">chunk-767a2e5a2bde762f9c1b3dbbf7746d09</data>
    </node>
    <node id="&quot;ASPERGILLUS SPP.&quot;">
