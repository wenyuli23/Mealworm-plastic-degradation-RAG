      <data key="d2">chunk-9b4b45d826a6a7956015e680f5fb8ee6</data>
      <data key="d1">"Basidiomycota is more frequently found in polystyrene samples than control samples."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
