    <node id="&quot;DIGESTIVE BIOFRAGMENTATION MODEL&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"A model developed to predict and understand the fragmentation process of plastics as they are biodegraded in the digestive system of mealworms."&lt;SEP&gt;"A model used to estimate the time required for the removal of plastic particles ingested by organisms."&lt;SEP&gt;"Digestive biofragmentation model is a model developed to simulate the size reduction of plastic particles during gut digestion."&lt;SEP&gt;"The Digestive biofragmentation model simulates the size-reduction of plastic particles ingested by mealworms, predicting their size-frequency distribution and removal efficiency."</data>
      <data key="d2">chunk-d0881f766e34a5d97ee711cd2edd793f&lt;SEP&gt;chunk-84a8f1c256b1141b6bd2b404e817dfb7&lt;SEP&gt;chunk-d47e7fe379fcd6b17740bc4d953cd3b1&lt;SEP&gt;chunk-cb1740bb657b0f90c48ee5e6d75945ce</data>
    </node>
    <node id="&quot;Δ13C SIGNATURE&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"A measure used to verify the biodegradation of polymers by observing changes in the carbon isotope ratios within residual plastics."</data>
      <data key="d2">chunk-84a8f1c256b1141b6bd2b404e817dfb7</data>
    </node>
    <node id="&quot;PYROLYZER-GAS CHROMATOGRAPHY MASS SPECTROMETRY (PY-GCMS)&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Pyrolyzer-gas chromatography mass spectrometry (Py-GCMS) is an analytical technique used to study the chemical composition of plastic residues and detect microplastics generated during biodegradation."&lt;SEP&gt;"Pyrolyzer-gas chromatography mass spectrometry is an analytical technique used to analyze the chemical makeup of samples by thermally decomposing them."</data>
      <data key="d2">chunk-aa3bd7c611ad935dba56fd3d7300cbc3&lt;SEP&gt;chunk-84a8f1c256b1141b6bd2b404e817dfb7</data>
    </node>
    <node id="&quot;LASER LIGHT SCATTERING SIZER&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"A device used to detect particle sizes, such as microplastics and nanoplastics, though it has limitations in detecting particles smaller than 10 nm."&lt;SEP&gt;"A tool utilized to measure particle size distribution, applied in detecting nanosized plastic particles."&lt;SEP&gt;"An instrument used to measure the size distribution of plastic particles in frass samples."&lt;SEP&gt;"Laser light scattering sizer is a tool used to determine the size distribution of plastic particles."</data>
      <data key="d2">chunk-b04ae62930e9961f964284418f1848b3&lt;SEP&gt;chunk-d0881f766e34a5d97ee711cd2edd793f&lt;SEP&gt;chunk-84a8f1c256b1141b6bd2b404e817dfb7&lt;SEP&gt;chunk-d47e7fe379fcd6b17740bc4d953cd3b1</data>
    </node>
