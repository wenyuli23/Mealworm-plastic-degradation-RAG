      <data key="d2">chunk-5e8cdca8afb1d7153fba5e3c11b1f669</data>
    </node>
    <node id="&quot;AROMATIC MONOMERS&quot;">
      <data key="d0">"CHEMICAL COMPOUND"</data>
      <data key="d1">"Aromatic monomers are compounds containing a stable ring-like structure, generated during the degradation of lignocellulose."</data>
      <data key="d2">chunk-5e8cdca8afb1d7153fba5e3c11b1f669</data>
    </node>
    <node id="&quot;RING OPENING&quot;">
