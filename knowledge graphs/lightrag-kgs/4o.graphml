      <data key="d2">chunk-53dd546535ef4247004faab1fa475889</data>
    </node>
    <node id="&quot;CAMBRIDGE ISOTOPE LABORATORIES, INC.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cambridge Isotope Laboratories, Inc. provides high-quality isotope-labeled compounds like chloroform-D for spectroscopic analysis."&lt;SEP&gt;"The company providing high purity chloroform-D for use in NMR analysis of frass samples."</data>
      <data key="d2">chunk-53dd546535ef4247004faab1fa475889&lt;SEP&gt;chunk-d7f79551ab9793788cd662ab66bca5ed</data>
