      <data key="d2">chunk-cd90c8f9754a78aabdbd7053e1adf90b</data>
    </node>
    <node id="&quot;SUBUNIT OF POLYMER BACKBONE&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"Subunit of polymer backbone refers to the basic repeating units in a polymer that are affected during depolymerization."</data>
