    <node id="&quot;ANTIOXIDANT ENZYME&quot;">
      <data key="d0">"ENZYME"</data>
      <data key="d1">"Antioxidant enzymes are involved in reducing oxidative stress by decomposing reactive oxygen species. They are crucial for maintaining cellular health and are analyzed in this study."</data>
      <data key="d2">chunk-9fb491e686c96e54f8ea43a9f1ba97eb</data>
    </node>
    <node id="&quot;ZEBRAFISH LARVAE&quot;">
