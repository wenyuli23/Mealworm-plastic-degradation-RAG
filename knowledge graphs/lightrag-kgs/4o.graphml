      <data key="d2">chunk-490fdb90ad8a65d35f3c2cd42a8c4c8e</data>
    </node>
    <node id="&quot;\(C_{W}\) VALUE&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"The \(C_{w}\) value represents the fraction of soluble organic components and salts in the frass, indicating digestion efficiency."</data>
      <data key="d2">chunk-490fdb90ad8a65d35f3c2cd42a8c4c8e</data>
    </node>
    <node id="&quot;\(C_{E}\) VALUE&quot;">
