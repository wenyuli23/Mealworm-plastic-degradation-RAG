      <data key="d2">chunk-9f2303f3680e9313daac77bb7e27e7da</data>
    </node>
    <node id="&quot;COXL SEQUENCES&quot;">
      <data key="d0">"GENETIC CONCEPT"</data>
      <data key="d1">"Coxl sequences are used in genomic analysis and interspecies variation studies."&lt;SEP&gt;"Genetic sequences used for identifying and comparing interspecies similarities, especially in genomic analysis using BLAST search."</data>
      <data key="d2">chunk-9f2303f3680e9313daac77bb7e27e7da&lt;SEP&gt;chunk-af5eb6a8326b4977801e2f7694a2c750</data>
