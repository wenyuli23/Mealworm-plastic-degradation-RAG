      <data key="d2">chunk-bfe58fb1bbaa5c35e9c6c837d0b1050f&lt;SEP&gt;chunk-639bb2429f20c4fe3994c4a0d15f3295</data>
    </node>
    <node id="&quot;LIGNIN-DEGRADATION&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
