      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"X-ray photoelectron spectroscopy used to analyze surface composition changes in polyether-PU foam."</data>
      <data key="d2">chunk-ae42540a18795e5e2ad9054b7a0edfc3</data>
