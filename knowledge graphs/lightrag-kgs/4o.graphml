      <data key="d2">chunk-476e13b69587aa4e81395e2fd00a9d5a</data>
      <data key="d1">"Proteobacteria is the dominant phylum in the guts of yellow mealworms fed with PU and EVA, indicating a strong association with these diets."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;PU-FED GROUPS&quot;">
      <data key="d2">chunk-476e13b69587aa4e81395e2fd00a9d5a</data>
      <data key="d1">"Enterobacteriaceae is strongly correlated with PU foam degradation, highlighted by its significant abundance in PU-fed groups."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;PP-FED GROUPS&quot;">
      <data key="d2">chunk-476e13b69587aa4e81395e2fd00a9d5a</data>
      <data key="d1">"The significant increase of Enterobacteriaceae in PP-fed groups suggests its role in PP degradation."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
