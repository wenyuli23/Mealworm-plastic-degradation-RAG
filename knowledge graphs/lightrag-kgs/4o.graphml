      <data key="d1">"Nucleotide metabolism is affected by oxidative stress and plays a role in cellular responses in marine and zebrafish microbiota."</data>
      <data key="d2">chunk-ae2c294948460ef392ceeec82d5e81f8</data>
    </node>
    <node id="&quot;MARINE MICROBIOTA&quot;">
      <data key="d0">"MICROORGANISMS"</data>
      <data key="d1">"Marine microbiota are communities of microorganisms in marine environments affected by oxidative stress from plastics."</data>
      <data key="d2">chunk-ae2c294948460ef392ceeec82d5e81f8</data>
    </node>
    <node id="&quot;ZEBRAFISH MICROBIOTA&quot;">
      <data key="d0">"MICROORGANISMS"</data>
