      <data key="d2">chunk-81610bdb5fdb95d9a333b42668532b9f</data>
    </node>
    <node id="&quot;CARBOXYLESTERASE FROM THERMOBIFIDA FUSCA KWS&quot;">
      <data key="d0">"ENZYME"</data>
      <data key="d1">"Carboxylesterase is an enzyme involved in the hydrolysis of cyclic poly(ethylene terephthalate) trimers."</data>
      <data key="d2">chunk-81610bdb5fdb95d9a333b42668532b9f</data>
    </node>
    <node id="&quot;METAGENOMIC AND BIOCHEMICAL APPROACH&quot;">
