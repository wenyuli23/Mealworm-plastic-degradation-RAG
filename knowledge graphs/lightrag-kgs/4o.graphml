      <data key="d0">"NUTRIENT"</data>
      <data key="d1">"Table sucrose is used as a food additive in experiments, given its common role as an insect attractant, to study its effect on PS consumption by worms."</data>
      <data key="d2">chunk-671dc96f9c648fdc6d21397c515d171d</data>
    </node>
    <node id="&quot;WORM CARCASSES&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
