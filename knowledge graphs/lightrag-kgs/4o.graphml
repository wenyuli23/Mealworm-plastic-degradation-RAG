      <data key="d2">chunk-81f09d7c1a5d91a7a0b4766ca0e47f56</data>
    </node>
    <node id="&quot;PREVOTELLA&quot;">
      <data key="d0">"GENUS"</data>
      <data key="d1">"Prevotella is a genus exhibiting higher abundance in both PS and CS-fed larvae compared to CK-fed larvae."&lt;SEP&gt;"Prevotella is a genus of bacteria showing variation in relative abundance across different diet treatments in mealworms."</data>
      <data key="d2">chunk-64e35cb810117768309e5f4db5d7e6b8&lt;SEP&gt;chunk-81f09d7c1a5d91a7a0b4766ca0e47f56</data>
    </node>
    <node id="&quot;METATRANSCRIPTOMIC SEQUENCING&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Metatranscriptomic sequencing is used to determine metabolically active bacteria and the mechanism of plastic and lignocellulose degradation in mealworms."</data>
      <data key="d2">chunk-eaf1f7b81bc271c665d7776cc3114a92</data>
    </node>
    <node id="&quot;HALOBACTERIUM&quot;">
      <data key="d0">"GENUS"</data>
      <data key="d1">"Halobacterium is a genus that exhibited high abundance in PS and CS-fed larvae, known for its plastic and lignocellulose degradation capabilities."</data>
      <data key="d2">chunk-eaf1f7b81bc271c665d7776cc3114a92</data>
    </node>
    <node id="&quot;DESULFUROBACTERIUM&quot;">
      <data key="d0">"GENUS"</data>
      <data key="d1">"Desulfurobacterium is a genus found at high levels in PS and CS-fed larvae, associated with plastic and lignocellulose breakdown."</data>
      <data key="d2">chunk-eaf1f7b81bc271c665d7776cc3114a92</data>
    </node>
    <node id="&quot;DEGS (DIFFERENTIALLY EXPRESSED GENES)&quot;">
      <data key="d0">"GENE"</data>
      <data key="d1">"DEGs represent genes with significant expression changes in response to feeding on PS and CS, highlighting metabolic adjustments."</data>
      <data key="d2">chunk-eaf1f7b81bc271c665d7776cc3114a92</data>
    </node>
    <node id="&quot;ALCOHOL DEHYDROGENASE (ADH)&quot;">
      <data key="d0">"ENZYME"</data>
      <data key="d1">"Alcohol dehydrogenase (ADH) is an enzyme found in the DEGs of PS- and CS-fed groups, involved in metabolic processes."</data>
      <data key="d2">chunk-eaf1f7b81bc271c665d7776cc3114a92</data>
    </node>
    <node id="&quot;CYTOCHROME P450 (CYP)&quot;">
      <data key="d0">"ENZYME"</data>
      <data key="d1">"Cytochrome P450 (CYP) refers to enzymes, part of the DEGs, that participate in xenobiotic metabolism."</data>
      <data key="d2">chunk-eaf1f7b81bc271c665d7776cc3114a92</data>
    </node>
    <node id="&quot;ALKYLGLYCEROL MONOOXYGENASE (AGMO)&quot;">
      <data key="d0">"ENZYME"</data>
      <data key="d1">"Alkylglycerol monooxygenase (AGMO) is an enzyme included in the DEGs associated with metabolic processes in PS- and CS-fed groups."</data>
      <data key="d2">chunk-eaf1f7b81bc271c665d7776cc3114a92</data>
    </node>
    <node id="&quot;ALDEHYDE DEHYDROGENASE (ALDH)&quot;">
      <data key="d0">"ENZYME"</data>
      <data key="d1">"Aldehyde dehydrogenase (ALDH) is an enzyme present in DEGs of PS- and CS-fed groups involved in various metabolic pathways."</data>
      <data key="d2">chunk-eaf1f7b81bc271c665d7776cc3114a92</data>
    </node>
    <node id="&quot;PEROXIDASE (PO)&quot;">
      <data key="d0">"ENZYME"</data>
      <data key="d1">"Peroxidase (PO) is an enzyme in DEGs that participates in oxidative metabolic pathways in PS- and CS-fed mealworms."</data>
      <data key="d2">chunk-eaf1f7b81bc271c665d7776cc3114a92</data>
    </node>
    <node id="&quot;LONG-CHAIN-FATTY-ACID-COA LIGASE (ACSL)&quot;">
      <data key="d0">"ENZYME"</data>
      <data key="d1">"Long-chain-fatty-acid-CoA ligase (ACSL) is an enzyme associated with fatty acid metabolism in PS- and CS-fed larval groups."</data>
      <data key="d2">chunk-eaf1f7b81bc271c665d7776cc3114a92</data>
    </node>
    <node id="&quot;CAZYMES&quot;">
      <data key="d0">"ENZYME"</data>
      <data key="d1">"CAZymes refer to a group of enzymes, including laccase and carboxyl esterase, involved in lignocellulose and plastic degradation."</data>
      <data key="d2">chunk-eaf1f7b81bc271c665d7776cc3114a92</data>
    </node>
    <node id="&quot;LACCASE-LIKE MULTICOPPER OXIDASE&quot;">
      <data key="d0">"ENZYME"</data>
