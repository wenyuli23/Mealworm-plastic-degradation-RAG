    </node>
    <node id="&quot;\(C_{O}\) VALUE&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"The \(C_{o}\) value represents the content of residual polymers extracted by organic solvents from frass, reflecting degradation progress."</data>
      <data key="d2">chunk-490fdb90ad8a65d35f3c2cd42a8c4c8e</data>
    </node>
    <node id="&quot;1,2,4-TCB (1,2,4-TRICHLOROBENZENE)&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
