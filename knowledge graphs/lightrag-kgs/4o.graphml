      <data key="d2">chunk-7c810740a381d4d9e829e28c01e62564</data>
    </node>
    <node id="&quot;SIMCA 16.0.2 SOFTWARE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Software used for performing Principal Component Analysis to understand discrimination between feeding strategies."</data>
      <data key="d2">chunk-7c810740a381d4d9e829e28c01e62564</data>
    </node>
    <node id="&quot;FRASS FRACTIONS&quot;">
