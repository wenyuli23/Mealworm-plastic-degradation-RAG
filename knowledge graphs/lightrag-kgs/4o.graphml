      <data key="d2">chunk-1b673e7590aa1d03b7721694ed73cd74</data>
    </node>
    <node id="&quot;CHLORAMPHENICOL&quot;">
      <data key="d0">"ANTIBIOTIC"</data>
      <data key="d1">"An antibiotic used as part of the gut bacteria suppression experiments."&lt;SEP&gt;"An antibiotic used to suppress bacterial activity in the gastrointestinal environment for experimental purposes."&lt;SEP&gt;"An antibiotic used in inhibition tests to gauge its effectiveness on gut bacteria in larvae."</data>
      <data key="d2">chunk-e5a7fb8d6a76ecfbfc810f952bfba090&lt;SEP&gt;chunk-1b673e7590aa1d03b7721694ed73cd74&lt;SEP&gt;chunk-3ab754d1dc0a02ee3f869d2b082a710e</data>
    </node>
