      <data key="d2">chunk-d76cb64e0aa4e4039b70799a0df8943d</data>
    </node>
    <node id="&quot;TRIPLE-LAYER PLASTIC BAGS&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Designed to reduce permeability and prevent insect-caused losses in stored agricultural products like maize."</data>
      <data key="d2">chunk-d76cb64e0aa4e4039b70799a0df8943d</data>
    </node>
    <node id="&quot;DELFTIA TSURUHATENSIS&quot;">
      <data key="d0">"BACTERIUM"</data>
