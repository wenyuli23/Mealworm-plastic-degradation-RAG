      <data key="d0">"ANTIBIOTIC"</data>
      <data key="d1">"A broad-spectrum antibiotic utilized in testing to control gut microbiome activity."&lt;SEP&gt;"An antibiotic class included in the mixture for the inhibition of gut bacteria."&lt;SEP&gt;"An antibiotic used in both the description and suppression studies."&lt;SEP&gt;"An antibiotic used in tests to observe its effects on gut bacteria from T. molitor larvae."</data>
      <data key="d2">chunk-e5a7fb8d6a76ecfbfc810f952bfba090&lt;SEP&gt;chunk-1b673e7590aa1d03b7721694ed73cd74&lt;SEP&gt;chunk-3ab754d1dc0a02ee3f869d2b082a710e</data>
    </node>
