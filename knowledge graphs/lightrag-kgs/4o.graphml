      <data key="d2">chunk-014b72d0a2657cbc89c4dee5f2b32bba</data>
    </node>
    <node id="&quot;TEMPERATURE RANGE&quot;">
      <data key="d0">"PHYSICAL CHARACTERISTIC"</data>
