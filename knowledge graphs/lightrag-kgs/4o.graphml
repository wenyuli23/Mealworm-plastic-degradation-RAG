      <data key="d2">chunk-5f99668e767a56e2e64ece791653b952</data>
    </node>
    <node id="&quot;FOLD CHANGE&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"Fold change is a measure of the change in gene expression, often used in the analysis of RNA-seq data."</data>
      <data key="d2">chunk-5f99668e767a56e2e64ece791653b952</data>
    </node>
    <node id="&quot;DISPERSION&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"Dispersion refers to the variability in gene expression data, important for identifying differential expression."</data>
      <data key="d2">chunk-5f99668e767a56e2e64ece791653b952</data>
    </node>
    <node id="&quot;SCIENTIFIC JOURNAL ARTICLES&quot;">
