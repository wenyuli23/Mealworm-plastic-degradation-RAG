      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"The percentage of weight loss experienced by HDPE film after being consumed by yellow mealworms for one month."</data>
      <data key="d2">chunk-70bab3579af07d0f99a5f948a90fe1e1</data>
    </node>
    <node id="&quot;SURVIVAL RATE OF MEALWORMS&quot;">
      <data key="d0">"BIOLOGICAL MEASURE"</data>
