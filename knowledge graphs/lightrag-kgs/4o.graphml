      <data key="d2">chunk-37f447b9d6a8b38f80be0854c9c294af</data>
      <data key="d1">"Cockroach gut bacteria produce organic acids during the digestion process, affecting nutrient absorption and gut health."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
