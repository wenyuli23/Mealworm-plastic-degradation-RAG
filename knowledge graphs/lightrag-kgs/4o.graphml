    <node id="&quot;TENEBRIO MOLITOR MEALWORMS&quot;">
      <data key="d0">"MICROORGANISM"</data>
      <data key="d1">"Tenebrio molitor mealworms are the larval form of the yellow mealworm beetle, recognized for their potential to consume and degrade plastic materials such as polystyrene."</data>
      <data key="d2">chunk-d8b79a6f4c112b0b62ada6756140e3e0</data>
    </node>
    <node id="&quot;POLYCARBONATE (PC)&quot;">
      <data key="d0">"PRODUCT"</data>
