      <data key="d2">chunk-ca86254d65e47c4049e193cf2098b964</data>
    </node>
    <node id="&quot;ADVANCED GLYCATION END-PRODUCTS (AGES)&quot;">
      <data key="d0">"METABOLITE"</data>
