      <data key="d1">"Signal transduction functions regulate communication between cells involved in plastic degradation."</data>
      <data key="d2">chunk-b759b81206d0e33e320f2d61e540ae47</data>
    </node>
    <node id="&quot;CARBOHYDRATE TRANSPORT&quot;">
      <data key="d0">"BIOLOGICAL FUNCTION"</data>
      <data key="d1">"Carbohydrate transport facilitates metabolism-related functions necessary for synergistic PP degradation."</data>
      <data key="d2">chunk-b759b81206d0e33e320f2d61e540ae47</data>
    </node>
    <node id="&quot;IN VITRO BIODEGRADATION&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"In vitro biodegradation involves studying plastic degradation outside living organisms, typically less efficient than in vivo methods."</data>
      <data key="d2">chunk-b759b81206d0e33e320f2d61e540ae47</data>
    </node>
    <node id="&quot;IN VIVO BIODEGRADATION&quot;">
      <data key="d0">"PROCESS"</data>
