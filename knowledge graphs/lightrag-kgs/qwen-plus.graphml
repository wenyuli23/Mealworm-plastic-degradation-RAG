      <data key="d1">"This fellowship program provided financial support for the research conducted on polyethylene biodegradation."</data>
      <data key="d2">chunk-b9bd8cf0d5102bbca724e0773be0eeae</data>
    </node>
    <node id="&quot;UNIVERSITY GRANTS COMMISSION&quot;">
