      <data key="d2">chunk-81610bdb5fdb95d9a333b42668532b9f</data>
    </node>
    <node id="&quot;BIOCHEMICAL APPROACH&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
