      <data key="d2">chunk-38e212e8bab88c4d7b6d63a157e27c00</data>
    </node>
    <node id="&quot;MOUNTAIN VIEW, CALIFORNIA, USA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mountain View, California, USA is the location of the Petco Animal Supplies store where mealworms were purchased."</data>
      <data key="d2">chunk-38e212e8bab88c4d7b6d63a157e27c00</data>
    </node>
    <node id="&quot;NEWPORT NEWS, VA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Newport News, VA is the location of Exotic Nutrition, the supplier of wheat bran."</data>
      <data key="d2">chunk-38e212e8bab88c4d7b6d63a157e27c00</data>
    </node>
    <node id="&quot;GENERAL NUTRITION CORPORATION&quot;">
      <data key="d0">"COMPANY"</data>
      <data key="d1">"General Nutrition Corporation is a supplier of soy protein used as a dietary supplement for mealworms."</data>
      <data key="d2">chunk-38e212e8bab88c4d7b6d63a157e27c00</data>
    </node>
    <node id="&quot;STEVENSON ET AL.&quot;">
      <data key="d0">"RESEARCHER"</data>
      <data key="d1">"Stevenson et al. conducted studies on mealworms using bran as their source of nutrition."</data>
      <data key="d2">chunk-38e212e8bab88c4d7b6d63a157e27c00</data>
    </node>
    <node id="&quot;GERHARDT AND LINDGREN&quot;">
      <data key="d0">"RESEARCHER"</data>
      <data key="d1">"Gerhardt and Lindgren studied beetle families, laying groundwork for later research on plastic-eating behavior."</data>
      <data key="d2">chunk-38e212e8bab88c4d7b6d63a157e27c00</data>
    </node>
    <node id="&quot;NEWTON&quot;">
      <data key="d0">"RESEARCHER"</data>
      <data key="d1">"Newton's work on the Tenebrionidae family helped establish earlier understanding of these beetles."</data>
      <data key="d2">chunk-38e212e8bab88c4d7b6d63a157e27c00</data>
    </node>
    <node id="&quot;CHONG-GUAN CHEN&quot;">
      <data key="d0">"RESEARCHER"</data>
      <data key="d1">"Chong-Guan Chen reported mealworms eating XPS food containers, contributing to early evidence of plastic consumption."</data>
      <data key="d2">chunk-38e212e8bab88c4d7b6d63a157e27c00</data>
    </node>
    <node id="&quot;I-CHING TSENG&quot;">
      <data key="d0">"RESEARCHER"</data>
      <data key="d1">"I-Ching Tseng reported EPS consumption by mealworms and isolated two PS-degrading bacterial strains from their gut."</data>
      <data key="d2">chunk-38e212e8bab88c4d7b6d63a157e27c00</data>
    </node>
    <node id="&quot;BURKART&quot;">
      <data key="d0">"RESEARCHER"</data>
      <data key="d1">"Burkart documented reports of EPS consumption by mealworms and isolation of PS-degrading bacteria."</data>
      <data key="d2">chunk-38e212e8bab88c4d7b6d63a157e27c00</data>
    </node>
    <node id="&quot;$^{1}$H NUCLEAR MAGNETIC RESONANCE ($^{1}$H NMR)&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"$^{1}$H NMR is a spectroscopic technique used to analyze changes in the chemical structure of egested polystyrene residues in frass."</data>
      <data key="d2">chunk-53dd546535ef4247004faab1fa475889</data>
    </node>
    <node id="&quot;THF-EXTRACTABLE FRACTION&quot;">
      <data key="d0">"METABOLIC MEASURE"</data>
      <data key="d1">"The THF-extractable fraction represents the portion of polystyrene that can be dissolved in tetrahydrofuran, indicating residual PS content in frass."</data>
      <data key="d2">chunk-53dd546535ef4247004faab1fa475889</data>
    </node>
    <node id="&quot;GEL PERMEATION CHROMATOGRAPHY SYSTEM&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"A system comprising GPC components, such as the Viscotek GPCmax VE 2001, used for analyzing molecular weight distributions."</data>
      <data key="d2">chunk-53dd546535ef4247004faab1fa475889</data>
    </node>
    <node id="&quot;STRAIN CA MEALWORMS&quot;">
      <data key="d0">"MICROORGANISMS"</data>
      <data key="d1">"A specific strain of mealworms used in experiments, demonstrating high survival rates and PS degradation capabilities."</data>
      <data key="d2">chunk-0638e0fe93dc27e678672a164e6088c2</data>
    </node>
    <node id="&quot;STAINLESS-STEEL SIEVE MAT&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"A sieve mat dividing the incubator into two floors, allowing eggs to fall through to the lower floor."</data>
      <data key="d2">chunk-0638e0fe93dc27e678672a164e6088c2</data>
    </node>
    <node id="&quot;MATING&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"The biological process by which male and female beetles reproduce, leading to the production of fertilized eggs."</data>
      <data key="d2">chunk-0638e0fe93dc27e678672a164e6088c2</data>
    </node>
    <node id="&quot;FERTILIZED EGGS&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"Eggs laid by female beetles that have been fertilized and will hatch into juveniles."</data>
      <data key="d2">chunk-0638e0fe93dc27e678672a164e6088c2</data>
    </node>
    <node id="&quot;JUVENILES&quot;">
      <data key="d0">"LIFE STAGE"</data>
      <data key="d1">"The larval stage of beetles, raised on PS-bran feed until they grow large enough for transfer."</data>
      <data key="d2">chunk-0638e0fe93dc27e678672a164e6088c2</data>
    </node>
    <node id="&quot;PARTIAL CORRELATION TEST&quot;">
      <data key="d0">"STATISTICAL PROCESS"</data>
      <data key="d1">"A statistical test used to determine the relationship between variables while controlling for other variables."</data>
      <data key="d2">chunk-0638e0fe93dc27e678672a164e6088c2</data>
    </node>
    <node id="&quot;REDUNDANCY ANALYSIS (RDA)&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"A multivariate statistical technique used to identify relationships between environmental variables and species composition."&lt;SEP&gt;"Redundancy Analysis (RDA) is a statistical method used to determine the contribution of various factors like density and molecular weight on PS consumption."&lt;SEP&gt;"RDA is a statistical method used to identify relationships between aging indexes and microbial communities."&lt;SEP&gt;"RDA is a statistical technique used to analyze relationships between environmental variables and species composition."&lt;SEP&gt;"Redundancy analysis is a statistical method used to verify the correlation between aged microplastics and microbial community changes in Tenebrio molitor larvae."</data>
      <data key="d2">chunk-0638e0fe93dc27e678672a164e6088c2&lt;SEP&gt;chunk-582f48080aab075de76c9c590558639f&lt;SEP&gt;chunk-7367fc6115c08ae427a6e9e91eaa1de3&lt;SEP&gt;chunk-5fb9111bd088e1990cde867c6d85cf28&lt;SEP&gt;chunk-e3fe22bd6c91507d8d1e60d24886e0eb</data>
    </node>
    <node id="&quot;VARIATION PARTITIONING ANALYSIS (VPA)&quot;">
      <data key="d0">"STATISTICAL PROCESS"</data>
      <data key="d1">"A technique based on partial RDA used to partition the variation explained by different sets of variables."&lt;SEP&gt;"Variation Partitioning Analysis (VPA) is another statistical method that partitions the explained variance among different factors affecting PS consumption."</data>
      <data key="d2">chunk-0638e0fe93dc27e678672a164e6088c2&lt;SEP&gt;chunk-5fb9111bd088e1990cde867c6d85cf28</data>
    </node>
    <node id="&quot;R SOFTWARE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Statistical software used for data analysis, employing packages such as 'stats', 'ggm', and 'vegan' for various analyses."</data>
      <data key="d2">chunk-0638e0fe93dc27e678672a164e6088c2</data>
    </node>
    <node id="&quot;Z VALUES&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"Standardized values obtained by scaling data, ensuring comparability across different units in statistical analyses."</data>
      <data key="d2">chunk-0638e0fe93dc27e678672a164e6088c2</data>
    </node>
    <node id="&quot;B:PS RATIOS&quot;">
      <data key="d0">"NUTRITIONAL COMPONENT"</data>
      <data key="d1">"The ratio of bran to polystyrene in the mealworm diet, impacting survival and degradation rates."</data>
      <data key="d2">chunk-0638e0fe93dc27e678672a164e6088c2</data>
    </node>
    <node id="&quot;PS CHARACTERISTICS&quot;">
      <data key="d0">"PHYSICAL PROPERTY"</data>
      <data key="d1">"Properties of polystyrene, such as molecular weight and structure, influencing its degradation by mealworms."</data>
      <data key="d2">chunk-0638e0fe93dc27e678672a164e6088c2</data>
    </node>
    <node id="&quot;UNDIGESTED EXOSKELETONS&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Residues of mealworm exoskeletons found in frass, indicating incomplete digestion."</data>
      <data key="d2">chunk-0638e0fe93dc27e678672a164e6088c2</data>
    </node>
    <node id="&quot;B:PS RATIO&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"B:PS Ratio refers to the ratio of Bran to Polystyrene in the feed, impacting PS consumption and degradation."&lt;SEP&gt;"The bran-to-polystyrene ratio affects the digestion and transformation of PS in mealworms."</data>
      <data key="d2">chunk-cc6b858a4eb57553f5b1ae041e1c7160&lt;SEP&gt;chunk-dc7f923e7edaa7bcfa79c0f7a9896e00</data>
    </node>
    <node id="&quot;GPC SPECTRA&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"GPC Spectra provides data on molecular weight distribution of PS residues extracted from frass."&lt;SEP&gt;"GPC spectra measure molecular weight distribution (MWD) of PS residues to indicate degradation levels."</data>
      <data key="d2">chunk-cc6b858a4eb57553f5b1ae041e1c7160&lt;SEP&gt;chunk-dc7f923e7edaa7bcfa79c0f7a9896e00</data>
    </node>
    <node id="&quot;POLYSTYRENE (PS) FEEDSTOCK&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Polystyrene feedstock is the initial material used in experiments to assess degradation by mealworms."</data>
      <data key="d2">chunk-dc7f923e7edaa7bcfa79c0f7a9896e00</data>
    </node>
    <node id="&quot;THF EXTRACTS&quot;">
      <data key="d0">"CHEMICAL REACTION"</data>
      <data key="d1">"THF (tetrahydrofuran) extracts are used to analyze changes in molecular weight of residual plastics in frass from mealworms."&lt;SEP&gt;"THF extracts refer to residues of PS from frass samples analyzed using tetrahydrofuran as a solvent."</data>
      <data key="d2">chunk-dc7f923e7edaa7bcfa79c0f7a9896e00&lt;SEP&gt;chunk-6e05bc34fccfca5e177064daf8346866</data>
    </node>
    <node id="&quot;OPTIMAL CONDITION&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"Optimal Condition refers to the combination of temperature and B:PS ratio that maximizes PS degradation efficiency."</data>
      <data key="d2">chunk-dc7f923e7edaa7bcfa79c0f7a9896e00</data>
    </node>
    <node id="&quot;20°C&quot;">
      <data key="d0">"PHYSICAL PROPERTY"</data>
      <data key="d1">"20°C is one of the temperatures tested for its effect on PS consumption rates and survival rates."</data>
      <data key="d2">chunk-dc7f923e7edaa7bcfa79c0f7a9896e00</data>
    </node>
    <node id="&quot;30°C&quot;">
      <data key="d0">"PHYSICAL PROPERTY"</data>
      <data key="d1">"30°C is one of the temperatures tested for its effect on PS consumption rates and survival rates."</data>
      <data key="d2">chunk-dc7f923e7edaa7bcfa79c0f7a9896e00</data>
    </node>
    <node id="&quot;PS FRASS RESIDUES&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"PS frass residues are the waste materials excreted by mealworms after consuming polystyrene, which undergo chemical changes during biodegradation."</data>
      <data key="d2">chunk-cc6b858a4eb57553f5b1ae041e1c7160</data>
    </node>
    <node id="&quot;CARBONYL GROUP (C=O)&quot;">
      <data key="d0">"FUNCTIONAL GROUP"</data>
      <data key="d1">"Carbonyl groups are functional groups detected in FTIR spectra, indicating oxidation and modification of PS during biodegradation."</data>
      <data key="d2">chunk-cc6b858a4eb57553f5b1ae041e1c7160</data>
    </node>
    <node id="&quot;HYDROXYL GROUP (-OH)&quot;">
      <data key="d0">"FUNCTIONAL GROUP"</data>
      <data key="d1">"Hydroxyl groups are detected in FTIR and NMR spectra, suggesting hydrophilic modifications to PS residues."</data>
      <data key="d2">chunk-cc6b858a4eb57553f5b1ae041e1c7160</data>
    </node>
    <node id="&quot;EPS INSULATION MATERIAL&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Expanded polystyrene insulation material is one of the PS waste materials consumed by mealworms."</data>
      <data key="d2">chunk-cc6b858a4eb57553f5b1ae041e1c7160</data>
    </node>
    <node id="&quot;SR VALUES&quot;">
      <data key="d0">"BIOLOGICAL MEASURE"</data>
      <data key="d1">"SR values represent survival rates of mealworms consuming different PS waste materials over a 32-day period."</data>
      <data key="d2">chunk-cc6b858a4eb57553f5b1ae041e1c7160</data>
    </node>
    <node id="&quot;SPECIFIC CONSUMPTION RATES&quot;">
      <data key="d0">"METABOLIC MEASURE"</data>
      <data key="d1">"Specific consumption rates measure the amount of PS material consumed by mealworms per unit time."</data>
      <data key="d2">chunk-cc6b858a4eb57553f5b1ae041e1c7160</data>
    </node>
    <node id="&quot;PEARSON CORRELATION TEST&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Pearson correlation test measures the strength and direction of linear relationships between variables such as PS density and consumption rates."</data>
      <data key="d2">chunk-5fb9111bd088e1990cde867c6d85cf28</data>
    </node>
    <node id="&quot;OXYGENASE-MEDIATED ATTACK&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Oxygenase-mediated attack refers to the enzymatic process hypothesized to initiate the degradation of polystyrene within the mealworm gut."</data>
      <data key="d2">chunk-6e05bc34fccfca5e177064daf8346866</data>
    </node>
    <node id="&quot;INSECT PHYSIOLOGY&quot;">
