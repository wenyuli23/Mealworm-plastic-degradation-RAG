      <data key="d2">chunk-9b4b45d826a6a7956015e680f5fb8ee6</data>
      <data key="d1">"An unknown type of esterase produced by Pseudomonas and Bacillus is associated with high impact polystyrene degradation."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;MICROBIAL SPECIES&quot;">
      <data key="d2">chunk-9b4b45d826a6a7956015e680f5fb8ee6</data>
      <data key="d1">"Polystyrene-fed insects harbor microbial species potentially involved in plastic degradation."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;MICROBIAL CHAIN&quot;">
      <data key="d2">chunk-d9095195e9cf06b9887c03abde6284d8</data>
