      <data key="d2">chunk-6ac1b1db6ffab6f4cfea7a525785a2fc</data>
    </node>
    <node id="&quot;ΒNTI&quot;">
      <data key="d0">"MEASURE"</data>
      <data key="d1">"Beta nearest taxon index (βNTI) quantifies the degree of selection or drift in microbial community assembly."</data>
