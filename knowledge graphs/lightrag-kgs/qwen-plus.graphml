      <data key="d2">chunk-4304c39ef3427872131caf77e7cdb438</data>
      <data key="d1">"TG-FTIR spectroscopy identifies the formation of low molecular-weight products during polystyrene degradation."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
