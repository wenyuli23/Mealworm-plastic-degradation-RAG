      <data key="d2">chunk-a221e0c62ecd5a2502ec0a4473ab0999</data>
    </node>
    <node id="&quot;PARENTAL AGE&quot;">
      <data key="d0">"LIFE STAGE"</data>
      <data key="d1">"Parental age can influence the reproductive success and offspring quality in mealworm populations."</data>
      <data key="d2">chunk-a221e0c62ecd5a2502ec0a4473ab0999</data>
    </node>
    <node id="&quot;FOOD QUALITY&quot;">
