      <data key="d2">chunk-12ceb4368e146509caa737d9534ce3c2</data>
    </node>
    <node id="&quot;SHORT CHAIN ALKANES&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Short chain alkanes are metabolites detected in smaller peaks during the GC-MS analysis of PS-fed worm frass."</data>
      <data key="d2">chunk-12ceb4368e146509caa737d9534ce3c2</data>
    </node>
    <node id="&quot;ALCOHOLS&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Alcohols are compounds produced during the late stages of polystyrene degradation."&lt;SEP&gt;"Alcohols are metabolites detected in smaller peaks during the GC-MS analysis of PS-fed worm frass."</data>
      <data key="d2">chunk-12ceb4368e146509caa737d9534ce3c2&lt;SEP&gt;chunk-b9fcb421212175a148a0a1858582cfb2</data>
    </node>
