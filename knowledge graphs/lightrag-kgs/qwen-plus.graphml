      <data key="d1">"The North-East Pacific Ocean is a region where polystyrene degradation and styrene analogues have been studied."</data>
      <data key="d2">chunk-33f35f87c2ff7792eb41bdd8debdb5f0</data>
    </node>
    <node id="&quot;HAWAII&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hawaii is a location where polystyrene degradation and styrene analogues have been investigated."</data>
      <data key="d2">chunk-33f35f87c2ff7792eb41bdd8debdb5f0</data>
    </node>
