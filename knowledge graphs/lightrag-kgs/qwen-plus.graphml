    </node>
    <node id="&quot;PS EMULSION&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"The PS emulsion is prepared by dissolving PS foams in dichloromethane, mixing with sarkosyl NL, sonicating, adding distilled water, stirring, and evaporating dichloromethane."</data>
      <data key="d2">chunk-fdb13eda4d3cf5385a0a8284c7e213b0</data>
    </node>
    <node id="&quot;ULTRASONIC HOMOGENIZER&quot;">
