      <data key="d2">chunk-e557113f1cfd2472fa9c51d1cdc3069a&lt;SEP&gt;chunk-237dcdbb783e27ec19d2ebc6b854b744</data>
    </node>
    <node id="&quot;EXPANDED POLYSTYRENE STYROFOAM (EPS)&quot;">
      <data key="d0">"METABOLITE"</data>
