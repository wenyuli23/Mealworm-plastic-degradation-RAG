      <data key="d2">chunk-6ce341034979daadf1f9dc7037397d1b</data>
    </node>
    <node id="&quot;BEHAVIOUR&quot;">
      <data key="d0">"BIOLOGICAL RESPONSE"</data>
      <data key="d1">"The actions or reactions of insects, which may be altered by exposure to plastics."</data>
      <data key="d2">chunk-6ce341034979daadf1f9dc7037397d1b</data>
    </node>
