      <data key="d1">"Mutualistic microbe–microbe interactions describe cooperative relationships between different microbes that enhance their ability to degrade complex substrates."</data>
      <data key="d2">chunk-5c4652e08c4ac6887914d0deebe761b3</data>
    </node>
