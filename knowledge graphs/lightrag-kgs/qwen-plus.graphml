      <data key="d0">"PHYSICAL CHARACTERISTIC"</data>
      <data key="d1">"Severe loss of body mass observed in lignocellulose-fed larvae at the last measurement."</data>
      <data key="d2">chunk-1ead6f17ad517015b638608c5bfe6852</data>
    </node>
    <node id="&quot;ADULTS&quot;">
      <data key="d0">"MICROORGANISMS"</data>
      <data key="d1">"Adults represent the mature stage of insect development, including species like Tenebrio molitor and Tenebrio obscurus."&lt;SEP&gt;"The final developmental stage of insects, indicating successful completion of metamorphosis."</data>
      <data key="d2">chunk-1ead6f17ad517015b638608c5bfe6852&lt;SEP&gt;chunk-d908d878ed4e7fc36f3af71a5be7f2ad</data>
    </node>
