      <data key="d2">chunk-b8b7b5a840af17cee78d71347e532d51</data>
    </node>
    <node id="&quot;POLYMER DEPOLYMERIZATION&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Polymer depolymerization describes the breakdown of long-chain polystyrene molecules into lower molecular weight products within the guts of superworms."</data>
      <data key="d2">chunk-be41a05c5e519995f6622e2258511b70</data>
    </node>
