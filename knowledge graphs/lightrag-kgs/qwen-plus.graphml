      <data key="d2">chunk-3815960770483b9c0a1579ca8442e3a6</data>
    </node>
    <node id="&quot;2-HYDROXY-6-OXOOCTA-2,4,7-TRIENOIC ACID&quot;">
      <data key="d0">"METABOLITE"</data>
