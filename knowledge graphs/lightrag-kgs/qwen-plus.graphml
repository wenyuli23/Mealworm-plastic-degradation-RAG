      <data key="d2">chunk-5b30daa90b5c91314e1d65e87f191166</data>
    </node>
    <node id="&quot;DENITRIFICATION&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"A microbial process that converts nitrate and nitrite to gaseous nitrogen compounds, completing the nitrogen cycle."</data>
      <data key="d2">chunk-5b30daa90b5c91314e1d65e87f191166</data>
    </node>
    <node id="&quot;AROMATIC COMPOUND DEGRADATION&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"The breakdown of aromatic compounds by microorganisms, often associated with carbon metabolism."</data>
      <data key="d2">chunk-5b30daa90b5c91314e1d65e87f191166</data>
    </node>
    <node id="&quot;CHITINOLYSIS&quot;">
