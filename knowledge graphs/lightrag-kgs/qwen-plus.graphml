      <data key="d2">chunk-1d40b7debb6497167fa1aec874ebce45</data>
    </node>
    <node id="&quot;GLUTAMATE DECARBOXYLASE&quot;">
      <data key="d0">"ENZYME"</data>
      <data key="d1">"Glutamate decarboxylase is an enzyme involved in the enzymatic production of Gama-aminobutyric acid."</data>
      <data key="d2">chunk-1d40b7debb6497167fa1aec874ebce45</data>
    </node>
    <node id="&quot;GAMA-AMINOBUTYRIC ACID&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Gama-aminobutyric acid is a metabolite produced enzymatically."</data>
