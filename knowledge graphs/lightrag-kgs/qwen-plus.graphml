      <data key="d0">"SPECIES"</data>
      <data key="d1">"Wax moth G. mellonella is an insect species whose gut contains Aspergillus, known for PE plastic degradation."</data>
      <data key="d2">chunk-dbb6f13dbe3de759712fa3a0c9780470</data>
    </node>
