      <data key="d1">"An enzyme up-regulated in PET-fed larvae, involved in the metabolism of ethylene glycol."</data>
      <data key="d2">chunk-d5238515b2316265fb5cb6c6295c54e8</data>
    </node>
    <node id="&quot;MCPS&quot;">
      <data key="d0">"PROTEIN"</data>
      <data key="d1">"Methyl-accepting chemotaxis proteins (MCPs) enable bacteria to sense and move towards aromatic compounds."</data>
      <data key="d2">chunk-d5238515b2316265fb5cb6c6295c54e8</data>
    </node>
    <node id="&quot;FLAGELLIN-RELATED PROTEINS&quot;">
