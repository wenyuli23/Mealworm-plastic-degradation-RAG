      <data key="d1">"DESeq2 identifies fungal genera such as Trichoderma and Penicillium that are significantly overrepresented in PS samples."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;BACTERIAL MICROBIOTA&quot;">
