      <data key="d2">chunk-fdb13eda4d3cf5385a0a8284c7e213b0</data>
    </node>
    <node id="&quot;FUNGAL MINIMUM MEDIUM (FMM)&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Fungal minimum medium contains nutrients like sodium phosphate monobasic, magnesium sulfate heptahydrate, monopotassium phosphate, yeast extract, L-cysteine hydrochloride, and Sarkosyl NL."</data>
      <data key="d2">chunk-fdb13eda4d3cf5385a0a8284c7e213b0</data>
    </node>
    <node id="&quot;L-CYSTEINE HYDROCHLORIDE&quot;">
      <data key="d0">"AMINO ACID"</data>
      <data key="d1">"An amino acid derivative in FMM medium reducing oxidative stress for microbes."&lt;SEP&gt;"L-cysteine hydrochloride is used as a reducing agent in FMM to enhance anaerobic conditions."</data>
      <data key="d2">chunk-fdb13eda4d3cf5385a0a8284c7e213b0&lt;SEP&gt;chunk-050a4c71685bf71165985a79f528ed58</data>
    </node>
