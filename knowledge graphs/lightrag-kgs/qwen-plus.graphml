      <data key="d2">chunk-a7cbc8be34e0de8aebc6fd547bacc627</data>
    </node>
    <node id="&quot;ENTEROBACTER SPP.&quot;">
      <data key="d0">"GENUS"</data>
      <data key="d1">"Enterobacter spp. are bacteria mainly distributed in the oxygen-limited posterior gut section of mealworms."&lt;SEP&gt;"Enterobacter spp. are facultative gut bacteria isolated from mealworms, capable of degrading PS under oxygen-limited conditions."&lt;SEP&gt;"Enterobacter spp. is a bacterial genus detected in the gut microbiota of mealworms, potentially involved in nitrogen fixation."</data>
      <data key="d2">chunk-eafea2357c59ac6712f4d9ab41ac5d14&lt;SEP&gt;chunk-89c37eb3e3a5b6ab731f5dbe280aa054&lt;SEP&gt;chunk-91523cdd8f510a966e9b301a0adb96b9</data>
    </node>
    <node id="&quot;TPX, AHPC, BCP&quot;">
      <data key="d0">"ENZYME"</data>
      <data key="d1">"These enzymes are associated with PS degradation and are upregulated in Enterobacter hormaechei LG3 during anaerobic conditions."</data>
      <data key="d2">chunk-eafea2357c59ac6712f4d9ab41ac5d14</data>
    </node>
    <node id="&quot;PS FOAMS&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"PS foams are a type of polystyrene material used in experiments to study biodegradation."</data>
      <data key="d2">chunk-eafea2357c59ac6712f4d9ab41ac5d14</data>
    </node>
    <node id="&quot;MICROSPHERES PS (MI-PS)&quot;">
