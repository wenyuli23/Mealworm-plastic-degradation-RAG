      <data key="d2">chunk-31b36e69e51416db099951b925beff9a</data>
    </node>
    <node id="&quot;MW AND MN&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"Mw (weight-average molecular weight) and Mn (number-average molecular weight) are measures used to assess PVC depolymerization."&lt;SEP&gt;"Mw (weight-average molecular weight) and Mn (number-average molecular weight) are parameters used to assess PS depolymerization."</data>
