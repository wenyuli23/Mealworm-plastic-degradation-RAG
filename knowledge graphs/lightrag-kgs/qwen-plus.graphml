      <data key="d2">chunk-b04ae62930e9961f964284418f1848b3</data>
    </node>
    <node id="&quot;GENETIC ALGORITHM&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"An optimization algorithm used to calibrate kinetic parameters in the digestive biofragmentation model."</data>
      <data key="d2">chunk-cb1740bb657b0f90c48ee5e6d75945ce</data>
