      <data key="d1">"Mealworm strains, such as T. molitor, possess the ability to degrade polystyrene effectively."</data>
      <data key="d2">chunk-5b7c2ef16f6809388c0c1a87c26bd5c7</data>
    </node>
    <node id="&quot;SELECTIVE BREEDING&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
