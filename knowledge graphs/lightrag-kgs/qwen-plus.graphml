      <data key="d1">"Titanium alloy exhibits superplastic behavior under certain conditions, which involves mechanisms-based constitutive equations for modeling."</data>
      <data key="d2">chunk-05fb1b56e288f49324a636e1365b5406</data>
    </node>
    <node id="&quot;SUPERPLASTIC MATERIALS&quot;">
      <data key="d0">"MATERIAL"</data>
      <data key="d1">"Superplastic materials possess the ability to deform extensively without fracturing, characterized by specific hardening characteristics."</data>
      <data key="d2">chunk-05fb1b56e288f49324a636e1365b5406</data>
    </node>
    <node id="&quot;GRAIN SIZE&quot;">
      <data key="d0">"PHYSICAL CHARACTERISTIC"</data>
      <data key="d1">"Grain size in processes of intense plastic deformation is governed by kinetic equations, affecting material properties."</data>
      <data key="d2">chunk-05fb1b56e288f49324a636e1365b5406</data>
    </node>
    <node id="&quot;BIODEGRADATION OF PLASTICS IN SOIL&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Biodegradation of plastics in soil refers to the breakdown of plastics facilitated by biological organisms, affected by environmental factors like temperature."</data>
      <data key="d2">chunk-05fb1b56e288f49324a636e1365b5406</data>
    </node>
    <node id="&quot;CONTROLLED COMPOSTING CONDITIONS&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Controlled composting conditions provide a regulated environment for studying the biodegradable kinetics of plastics."</data>
      <data key="d2">chunk-05fb1b56e288f49324a636e1365b5406</data>
    </node>
    <node id="&quot;REACTIVE NITROGEN SPECIES&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"Reactive nitrogen species contribute to the transformation of sulfonamide antibiotics during reactions with peracetic acid, leading to disinfection byproduct formation."</data>
      <data key="d2">chunk-05fb1b56e288f49324a636e1365b5406</data>
    </node>
    <node id="&quot;FENTON REACTIONS&quot;">
      <data key="d0">"CHEMICAL REACTION"</data>
      <data key="d1">"Fenton reactions involve iron cycles tuned by thiosulfate, with kinetic modeling used to understand reaction mechanisms."</data>
      <data key="d2">chunk-05fb1b56e288f49324a636e1365b5406</data>
    </node>
    <node id="&quot;EARTHWORMS'">
      <data key="d0">"ORGANISM"</data>
      <data key="d1">"Earthworms are capable of degrading bioplastic diets such as polylactic acid, breaking them down but excreting slowly."</data>
      <data key="d2">chunk-05fb1b56e288f49324a636e1365b5406</data>
    </node>
    <node id="&quot;CATERPILLARS OF THE WAX MOTH GALLERIA MELLONELLA&quot;">
      <data key="d0">"ORGANISM"</data>
      <data key="d1">"Caterpillars of the wax moth Galleria mellonella demonstrate the ability to bio-degrade polyethylene."</data>
      <data key="d2">chunk-05fb1b56e288f49324a636e1365b5406</data>
    </node>
    <node id="&quot;PERACETIC ACID&quot;">
      <data key="d0">"CHEMICAL COMPOUND"</data>
      <data key="d1">"Peracetic acid is a powerful oxidizing agent used in the transformation of sulfonamide antibiotics, generating reactive nitrogen species."</data>
      <data key="d2">chunk-05fb1b56e288f49324a636e1365b5406</data>
    </node>
    <node id="&quot;SULFONAMIDE ANTIBIOTICS&quot;">
      <data key="d0">"ANTIBIOTIC"</data>
      <data key="d1">"Sulfonamide antibiotics are transformed by peracetic acid, leading to the formation of harmful disinfection byproducts."</data>
      <data key="d2">chunk-05fb1b56e288f49324a636e1365b5406</data>
    </node>
    <node id="&quot;DISINFECTION BYPRODUCT FORMATION&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Disinfection byproduct formation occurs during the reaction of peracetic acid with sulfonamide antibiotics, posing potential health risks."</data>
      <data key="d2">chunk-05fb1b56e288f49324a636e1365b5406</data>
    </node>
    <node id="&quot;THIOSULFATE&quot;">
      <data key="d0">"CHEMICAL COMPOUND"</data>
      <data key="d1">"Thiosulfate plays a role in tuning the iron cycle within Fenton reactions, affecting kinetic modeling and mechanisms."</data>
      <data key="d2">chunk-05fb1b56e288f49324a636e1365b5406</data>
    </node>
    <node id="&quot;FRASS OF YELLOW MEALWORMS&quot;">
      <data key="d0">"BIOLOGICAL PRODUCT"</data>
      <data key="d1">"Frass of yellow mealworms is a biological waste product that can be converted into biochar for environmental applications."</data>
      <data key="d2">chunk-05fb1b56e288f49324a636e1365b5406</data>
    </node>
    <node id="&quot;DYE ADSORPTION&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Dye adsorption refers to the ability of biochar generated from frass to remove dyes from water."</data>
      <data key="d2">chunk-05fb1b56e288f49324a636e1365b5406</data>
    </node>
    <node id="&quot;ANTARCTIC KRILL (EUPHAUSIA SUPERBA)&quot;">
      <data key="d2">chunk-84a8f1c256b1141b6bd2b404e817dfb7</data>
      <data key="d1">"Antarctic krill fragment polyethylene microplastics into nanoparticles within their digestive glands."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;EARTHWORMS (EISENIA ANDREI)&quot;">
      <data key="d2">chunk-84a8f1c256b1141b6bd2b404e817dfb7</data>
      <data key="d1">"Earthworms fragment polyethylene microplastics into smaller sizes during digestion."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;PE MPS&quot;">
      <data key="d2">chunk-02e6f7bbb2c1ef92c57b423020b0cc5c</data>
      <data key="d1">"Gammarus duebeni rapidly fragments PE MPs into smaller sizes, including nanoparticles, in its digestive system."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;CRUCIBLE&quot;">
      <data key="d2">chunk-b04ae62930e9961f964284418f1848b3</data>
      <data key="d1">"The crucible is used to isolate nanoplastics from the filtrate for further analysis."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;CONTAMINATION PREVENTION&quot;">
      <data key="d2">chunk-cb1740bb657b0f90c48ee5e6d75945ce</data>
      <data key="d1">"Milli-Q ultrapure water is used to clean equipment to minimize contamination from micro- or nanoplastics."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;PLASTIC PARTICLES&quot;">
      <data key="d2">chunk-beb3c133fa4d5851f0feff55507c6874</data>
      <data key="d1">"SEM images reveal the surface morphology of original and residual plastic particles, showcasing physical changes due to digestion."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;BURROWING INVERTEBRATES&quot;">
      <data key="d2">chunk-d642e5476221b3ea202c68d7e6070b96</data>
      <data key="d1">"Burrowing invertebrates cause the fragmentation of Styrofoam floats, leading to the formation of microplastics in marine environments."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;STYROFOAM FLOATS&quot;">
      <data key="d2">chunk-d642e5476221b3ea202c68d7e6070b96</data>
      <data key="d1">"Burrowing invertebrates cause the fragmentation of Styrofoam floats, leading to the formation of microplastics in marine environments."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;MICROPLASTIC DEPOLYMERIZATION&quot;">
      <data key="d2">chunk-d642e5476221b3ea202c68d7e6070b96</data>
      <data key="d1">"The earthworm gut facilitates the depolymerization of microplastics, indicating its potential for bioremediation."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;ADVANCED OXIDATION PROCESSES&quot;">
      <data key="d2">chunk-54215690a971d0637c3a6fa61d10f685</data>
      <data key="d1">"Advanced Oxidation Processes play a role in accelerating the aging behavior of microplastics, indicating a causal relationship."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;ENVIRONMENTAL ANALYSIS&quot;">
      <data key="d2">chunk-54215690a971d0637c3a6fa61d10f685</data>
      <data key="d1">"Nanomaterials require advanced methods for their characterization and analysis in environmental studies."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;CHEMICAL ANALYSIS&quot;">
      <data key="d2">chunk-54215690a971d0637c3a6fa61d10f685</data>
      <data key="d1">"Chemical analysis is critical for understanding the challenges posed by microplastics and nanoplastics."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;POLYELEFIN MICROPLASTICS&quot;">
      <data key="d2">chunk-54215690a971d0637c3a6fa61d10f685</data>
      <data key="d1">"Gel-permeation chromatography is employed to characterize polyelefin microplastics in personal-care products."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;OXIDATIVE STRESS RESPONSES&quot;">
      <data key="d0">"BIOLOGICAL RESPONSE"</data>
      <data key="d1">"Oxidative stress responses in mealworms include reactive oxygen species, antioxidant enzyme activities, and lipid peroxidation, observed particularly in PVC-fed mealworms."</data>
      <data key="d2">chunk-59879670a8110deb87c1843ffdb71c75</data>
    </node>
    <node id="&quot;SUB-MICRON MICROPLASTICS&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Sub-micron microplastics are tiny plastic particles found in the frass of mealworms, resulting from incomplete digestion of microplastics."&lt;SEP&gt;"Sub-micron microplastics are very small plastic particles with sizes below one micron."</data>
      <data key="d2">chunk-59879670a8110deb87c1843ffdb71c75&lt;SEP&gt;chunk-17052974ec1c317689bf07f0684f130f</data>
    </node>
    <node id="&quot;SMALL MICROPLASTICS&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Small microplastics are plastic particles sized between 20–999 μm, detected in the frass of mealworms after ingestion."</data>
      <data key="d2">chunk-59879670a8110deb87c1843ffdb71c75</data>
    </node>
    <node id="&quot;LIPID PEROOXIDATION&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"Lipid peroxidation is a biochemical measure of oxidative damage caused by microplastic ingestion in mealworms."</data>
      <data key="d2">chunk-59879670a8110deb87c1843ffdb71c75</data>
    </node>
    <node id="&quot;LASER DIRECT INFRARED SPECTROMETRY&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Laser direct infrared spectrometry is a technology used to analyze residual PVC microplastic particles in mealworms."</data>
      <data key="d2">chunk-59879670a8110deb87c1843ffdb71c75</data>
    </node>
    <node id="&quot;WASTE PLASTICS&quot;">
      <data key="d0">"ENVIRONMENTAL CONCEPT"</data>
      <data key="d1">"Waste plastics include discarded plastic materials that contribute significantly to environmental pollution and ecological harm."</data>
      <data key="d2">chunk-59879670a8110deb87c1843ffdb71c75</data>
    </node>
    <node id="&quot;RECYCLING INDUSTRIES&quot;">
      <data key="d0">"ECONOMIC CONCEPT"</data>
      <data key="d1">"Recycling industries deal with the processing of waste materials into new products, playing a crucial role in waste management."</data>
      <data key="d2">chunk-59879670a8110deb87c1843ffdb71c75</data>
    </node>
    <node id="&quot;WEATHERING&quot;">
      <data key="d0">"ECOLOGICAL CONCEPT"</data>
      <data key="d1">"Weathering refers to natural processes that break down plastic waste into smaller fragments like microplastics."</data>
      <data key="d2">chunk-59879670a8110deb87c1843ffdb71c75</data>
    </node>
    <node id="&quot;CRACKING&quot;">
      <data key="d0">"CHEMICAL REACTION"</data>
      <data key="d1">"Cracking is a process involving the breaking of large hydrocarbon molecules into smaller ones during plastic degradation."</data>
      <data key="d2">chunk-59879670a8110deb87c1843ffdb71c75</data>
    </node>
    <node id="&quot;MICROBIAL DECOMPOSITION&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Microbial decomposition involves microorganisms breaking down organic matter, including plastics, into simpler substances."</data>
      <data key="d2">chunk-59879670a8110deb87c1843ffdb71c75</data>
    </node>
    <node id="&quot;LARGE MICROPLASTICS&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Large microplastics range from 1–5 mm in size and are part of the spectrum of plastic particles found in the environment."</data>
      <data key="d2">chunk-59879670a8110deb87c1843ffdb71c75</data>
    </node>
    <node id="&quot;BIOSPHERE&quot;">
      <data key="d0">"ECOLOGICAL CONCEPT"</data>
      <data key="d1">"The biosphere encompasses all regions of Earth where life exists, including areas affected by microplastic pollution."</data>
      <data key="d2">chunk-59879670a8110deb87c1843ffdb71c75</data>
    </node>
    <node id="&quot;ATMOSPHERE&quot;">
      <data key="d0">"PHYSICAL FEATURE"</data>
      <data key="d1">"The atmosphere is the layer of gases surrounding Earth, where microplastics have been detected."</data>
      <data key="d2">chunk-59879670a8110deb87c1843ffdb71c75</data>
    </node>
    <node id="&quot;HYDROSPHERE&quot;">
      <data key="d0">"PHYSICAL FEATURE"</data>
      <data key="d1">"The hydrosphere includes all water on Earth, where microplastics have also been found."</data>
      <data key="d2">chunk-59879670a8110deb87c1843ffdb71c75</data>
    </node>
    <node id="&quot;LASER DIRECT INFRARED SPECTROMETRY (LDIR)&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"LDIR is a method employed to determine the number of microplastics in the intestines of mealworms and assess depuration time."&lt;SEP&gt;"LDIR is a technique applied to identify residual microplastics in mealworm intestines."</data>
      <data key="d2">chunk-fe381daaa91bbff20758798e5baf82b5&lt;SEP&gt;chunk-f267b48449a40d614a2f325799752dea</data>
    </node>
    <node id="&quot;LASER LIGHT SCATTERING&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Laser light scattering is a highly sensitive method used to measure the size distribution of residual microplastics in frass."&lt;SEP&gt;"Laser light scattering is a highly sensitive technique used to explore residual plastic particles in the frass of mealworms after biodegradation."&lt;SEP&gt;"Laser light scattering was employed to measure the size distribution of plastic particles in frass."</data>
      <data key="d2">chunk-9a27dff473ed210517e6461ad3e5d783&lt;SEP&gt;chunk-17052974ec1c317689bf07f0684f130f&lt;SEP&gt;chunk-fe381daaa91bbff20758798e5baf82b5</data>
    </node>
    <node id="&quot;GUT DYSBIOSIS&quot;">
      <data key="d0">"BIOLOGICAL RESPONSE"</data>
      <data key="d1">"Gut dysbiosis refers to changes in gut microbial communities caused by the ingestion of microplastics."</data>
      <data key="d2">chunk-fe381daaa91bbff20758798e5baf82b5</data>
    </node>
    <node id="&quot;30% H2O2&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"30% hydrogen peroxide solution is used to digest organic matter in frass samples."</data>
      <data key="d2">chunk-f267b48449a40d614a2f325799752dea</data>
    </node>
    <node id="&quot;INTESTINE TISSUES&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"Intestine tissues of mealworms were dissected to analyze residual plastics after biodegradation."</data>
      <data key="d2">chunk-f267b48449a40d614a2f325799752dea</data>
    </node>
    <node id="&quot;STERILE SCALPEL&quot;">
      <data key="d0">"TOOL"</data>
      <data key="d1">"A sterile scalpel was used to remove the heads of mealworm larvae during dissection."</data>
      <data key="d2">chunk-f267b48449a40d614a2f325799752dea</data>
    </node>
    <node id="&quot;KOH DIGESTION&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"KOH digestion was performed on mealworm intestine samples to isolate residual plastic particles."</data>
      <data key="d2">chunk-f267b48449a40d614a2f325799752dea</data>
    </node>
    <node id="&quot;CELLULASE DIGESTION&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Cellulase digestion was applied to break down biological materials in mealworm intestine samples."</data>
      <data key="d2">chunk-f267b48449a40d614a2f325799752dea</data>
    </node>
    <node id="&quot;METAL MEMBRANE FILTER&quot;">
      <data key="d0">"DEVICE"</data>
      <data key="d1">"A metal membrane filter with a pore size of 10 μm was used to collect residual microplastics from digestion solutions."</data>
      <data key="d2">chunk-f267b48449a40d614a2f325799752dea</data>
    </node>
    <node id="&quot;LDIR SPECTROMETRY&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"LDIR spectrometry identified residual small microplastics in mealworm intestines using infrared analysis."</data>
      <data key="d2">chunk-f267b48449a40d614a2f325799752dea</data>
    </node>
    <node id="&quot;CUSTOMIZED SPECTRUM LIBRARY&quot;">
      <data key="d0">"DATABASE"</data>
      <data key="d1">"A customized spectrum library was used to match detected plastic materials against standard spectra."</data>
      <data key="d2">chunk-f267b48449a40d614a2f325799752dea</data>
    </node>
    <node id="&quot;H2O2&quot;">
      <data key="d0">"CHEMICAL COMPOUND"</data>
      <data key="d1">"Hydrogen peroxide (H2O2) solution was used to digest organic matter in frass samples."</data>
      <data key="d2">chunk-9a27dff473ed210517e6461ad3e5d783</data>
    </node>
    <node id="&quot;DHE&quot;">
      <data key="d0">"ASSAY KIT"</data>
      <data key="d1">"Dihydroethidium (DHE) assay kit was used to analyze ROS levels in mealworms."</data>
      <data key="d2">chunk-9a27dff473ed210517e6461ad3e5d783</data>
    </node>
    <node id="&quot;BCA&quot;">
      <data key="d0">"ASSAY METHOD"</data>
      <data key="d1">"Bicinchoninic acid (BCA) protein quantification was conducted as part of ROS analysis."</data>
      <data key="d2">chunk-9a27dff473ed210517e6461ad3e5d783</data>
    </node>
    <node id="&quot;PA FILTER&quot;">
      <data key="d0">"INSTRUMENT"</data>
      <data key="d1">"A polyamide (PA) filter with a pore size of 100 nm was used to filter plastic particles after digestion."</data>
      <data key="d2">chunk-9a27dff473ed210517e6461ad3e5d783</data>
    </node>
    <node id="&quot;MALVERN MASTERSIZER 3000&quot;">
      <data key="d0">"INSTRUMENT"</data>
      <data key="d1">"The Malvern Mastersizer 3000 was used for particle size analysis of plastics in frass samples."</data>
      <data key="d2">chunk-9a27dff473ed210517e6461ad3e5d783</data>
    </node>
    <node id="&quot;TRANSPORTERS&quot;">
      <data key="d0">"PROTEIN"</data>
      <data key="d1">"Transporters are specialized proteins involved in the movement of molecules across cell membranes."&lt;SEP&gt;"Transporters facilitate nutrient uptake and were impacted by the lack of trace elements in a plastic diet."</data>
      <data key="d2">chunk-9a27dff473ed210517e6461ad3e5d783&lt;SEP&gt;chunk-77a9d70651c9f13362e4c1e3ce10eab0</data>
    </node>
    <node id="&quot;TERNARY DIAGRAM&quot;">
      <data key="d0">"VISUALIZATION TOOL"</data>
      <data key="d1">"A ternary diagram was used to present the physiological stress responses and antioxidant performance of mealworms."</data>
      <data key="d2">chunk-9a27dff473ed210517e6461ad3e5d783</data>
    </node>
    <node id="&quot;PLASTIC DIET&quot;">
      <data key="d0">"DIET"</data>
      <data key="d1">"A plastic diet refers to a food source composed primarily of plastics like PE, PS, and PVC, which can provide limited energy but lacks essential nutrients."</data>
      <data key="d2">chunk-77a9d70651c9f13362e4c1e3ce10eab0</data>
    </node>
    <node id="&quot;NUTRIENT EXHAUSTION&quot;">
      <data key="d0">"BIOLOGICAL RESPONSE"</data>
      <data key="d1">"Nutrient exhaustion occurs when an organism lacks essential nutrients, leading to reduced growth and survival."</data>
      <data key="d2">chunk-77a9d70651c9f13362e4c1e3ce10eab0</data>
    </node>
    <node id="&quot;PE-FED MEALWORMS&quot;">
      <data key="d0">"LIFE STAGE"</data>
      <data key="d1">"Mealworms fed with polyethylene (PE) microplastics exhibit specific survival and physiological responses."</data>
      <data key="d2">chunk-77a9d70651c9f13362e4c1e3ce10eab0</data>
    </node>
    <node id="&quot;PS-FED MEALWORMS&quot;">
      <data key="d0">"LIFE STAGE"</data>
      <data key="d1">"Mealworms fed with polystyrene (PS) microplastics show distinct survival rates compared to those fed with PVC."</data>
      <data key="d2">chunk-77a9d70651c9f13362e4c1e3ce10eab0</data>
    </node>
    <node id="&quot;PVC-FED MEALWORMS&quot;">
      <data key="d0">"LIFE STAGE"</data>
      <data key="d1">"Mealworms fed with polyvinyl chloride (PVC) microplastics experience poor survival and physiological responses due to toxic intermediates."</data>
      <data key="d2">chunk-77a9d70651c9f13362e4c1e3ce10eab0</data>
    </node>
    <node id="&quot;INTESTINAL EPITHELIUM&quot;">
      <data key="d0">"PHYSICAL FEATURE"</data>
      <data key="d1">"The intestinal epithelium is the lining of the digestive tract, which can be damaged by toxic substances."</data>
      <data key="d2">chunk-77a9d70651c9f13362e4c1e3ce10eab0</data>
    </node>
    <node id="&quot;RANDOM INTERNAL SCISSION&quot;">
      <data key="d0">"CHEMICAL REACTION"</data>
      <data key="d1">"Random internal scission refers to the breaking of polymer chains at random points, leading to heterogeneous molecular weight distributions."</data>
      <data key="d2">chunk-77a9d70651c9f13362e4c1e3ce10eab0</data>
    </node>
    <node id="&quot;GUT BACTERIAL CONSORTIUMS&quot;">
      <data key="d0">"MICROORGANISMS"</data>
      <data key="d1">"Gut bacterial consortiums are microbial communities in the gut that assist in breaking down complex materials."</data>
      <data key="d2">chunk-77a9d70651c9f13362e4c1e3ce10eab0</data>
    </node>
    <node id="&quot;MATERIAL CRYSTALLINITY&quot;">
      <data key="d0">"PHYSICAL PROPERTY"</data>
      <data key="d1">"Material crystallinity describes the degree of structural order in a material, influencing its susceptibility to degradation."</data>
      <data key="d2">chunk-77a9d70651c9f13362e4c1e3ce10eab0</data>
    </node>
    <node id="&quot;SURVIVAL CURVES&quot;">
      <data key="d0">"BIOLOGICAL MEASURE"</data>
      <data key="d1">"Survival curves are graphical representations of the proportion of organisms surviving over time."</data>
      <data key="d2">chunk-77a9d70651c9f13362e4c1e3ce10eab0</data>
    </node>
    <node id="&quot;PVC MINERALIZATION&quot;">
      <data key="d0">"CHEMICAL REACTION"</data>
      <data key="d1">"PVC mineralization is the process of converting PVC into simpler chemical compounds, providing limited energy."</data>
      <data key="d2">chunk-77a9d70651c9f13362e4c1e3ce10eab0</data>
    </node>
    <node id="&quot;AVAILABLE ENERGY&quot;">
      <data key="d0">"METABOLIC MEASURE"</data>
      <data key="d1">"Available energy refers to the usable energy derived from food sources for metabolic processes."</data>
      <data key="d2">chunk-77a9d70651c9f13362e4c1e3ce10eab0</data>
    </node>
    <node id="&quot;CARBON SOURCES&quot;">
      <data key="d0">"NUTRIENT"</data>
      <data key="d1">"Carbon sources are organic compounds that provide carbon for metabolic and biosynthetic processes."</data>
      <data key="d2">chunk-77a9d70651c9f13362e4c1e3ce10eab0</data>
    </node>
    <node id="&quot;MINERALIZATION PRODUCTS&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Mineralization products are the final breakdown products resulting from the complete degradation of materials."</data>
      <data key="d2">chunk-77a9d70651c9f13362e4c1e3ce10eab0</data>
    </node>
    <node id="&quot;INVERTEBRATE&quot;">
      <data key="d0">"LIFE STAGE"</data>
      <data key="d1">"Invertebrates are animals without a backbone, including mealworms, which play roles in biodegradation."</data>
      <data key="d2">chunk-77a9d70651c9f13362e4c1e3ce10eab0</data>
    </node>
    <node id="&quot;ATACTIC STRUCTURE&quot;">
      <data key="d0">"PHYSICAL PROPERTY"</data>
      <data key="d1">"Atactic structure refers to the random arrangement of polymer chains, affecting crystallinity and degradability."</data>
      <data key="d2">chunk-77a9d70651c9f13362e4c1e3ce10eab0</data>
    </node>
    <node id="&quot;CRYSTALLINE PLASTICS&quot;">
      <data key="d0">"PHYSICAL PROPERTY"</data>
      <data key="d1">"Crystalline plastics have ordered molecular structures, making them less susceptible to depolymerization."</data>
      <data key="d2">chunk-77a9d70651c9f13362e4c1e3ce10eab0</data>
    </node>
    <node id="&quot;AMORPHOUS FRACTIONS&quot;">
      <data key="d0">"PHYSICAL PROPERTY"</data>
      <data key="d1">"Amorphous fractions refer to non-crystalline regions in polymers, more susceptible to enzymatic attack."</data>
      <data key="d2">chunk-77a9d70651c9f13362e4c1e3ce10eab0</data>
    </node>
    <node id="&quot;REACTION ORDER&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"Reaction order describes the relationship between reactant concentrations and reaction rates."</data>
      <data key="d2">chunk-77a9d70651c9f13362e4c1e3ce10eab0</data>
    </node>
    <node id="&quot;PVC POLYMER&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"PVC polymer is an amorphous plastic that is more likely to be attacked and depolymerized in the gut microenvironment of mealworms."</data>
      <data key="d2">chunk-1536c14bdcd58ae9dabf3a49f6724cd8</data>
    </node>
    <node id="&quot;ENDO-TYPE DEPOLYMERIZATION&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Endo-type depolymerization involves random internal scission of polymer chains, generating oligomeric products and mid-chain polymers."&lt;SEP&gt;"Endo-type depolymerization refers to the breakdown of polymers starting from within their structure, occurring more readily in amorphous fractions than crystalline ones."</data>
      <data key="d2">chunk-67028993c2650049216602d03fb3f786&lt;SEP&gt;chunk-1536c14bdcd58ae9dabf3a49f6724cd8</data>
    </node>
    <node id="&quot;LDIR TECHNIQUE&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"LDIR (Laser Direct Infrared Spectrometry) is used to quantify residual microplastics in the mealworm intestine after depuration."</data>
      <data key="d2">chunk-1536c14bdcd58ae9dabf3a49f6724cd8</data>
    </node>
    <node id="&quot;STRAW POWDER&quot;">
      <data key="d0">"NUTRIENT"</data>
      <data key="d1">"Straw powder serves as another typical feedstock for mealworms, aiding in their digestion."</data>
      <data key="d2">chunk-1536c14bdcd58ae9dabf3a49f6724cd8</data>
    </node>
    <node id="&quot;GREAT WAX MOTH (GALLERIA MELLONELLA LARVAE)&quot;">
      <data key="d0">"MICROORGANISM"</data>
      <data key="d1">"Great wax moth larvae belong to the family Pyralidae and have been observed to digest PS microplastics effectively."</data>
      <data key="d2">chunk-1536c14bdcd58ae9dabf3a49f6724cd8</data>
    </node>
    <node id="&quot;TECHNO-ECONOMIC ANALYSIS&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Techno-economic analysis evaluates the economic feasibility and sustainability of biodegradation processes."</data>
      <data key="d2">chunk-1536c14bdcd58ae9dabf3a49f6724cd8</data>
    </node>
    <node id="&quot;DEPURATION&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Depuration is the process by which organisms eliminate undigested materials from their bodies."</data>
      <data key="d2">chunk-1536c14bdcd58ae9dabf3a49f6724cd8</data>
    </node>
    <node id="&quot;DIGESTIVE MODEL&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"Digestive model describes the mechanisms and pathways through which organisms digest and process ingested materials."</data>
      <data key="d2">chunk-1536c14bdcd58ae9dabf3a49f6724cd8</data>
    </node>
    <node id="&quot;PHYSICOCHEMICAL PROPERTIES&quot;">
      <data key="d0">"PHYSICAL PROPERTY"</data>
      <data key="d1">"Physicochemical properties include characteristics like solubility, melting point, and molecular weight, influencing polymer behavior."</data>
      <data key="d2">chunk-1536c14bdcd58ae9dabf3a49f6724cd8</data>
    </node>
    <node id="&quot;PLASTIC-DEGRADING INVERTEBRATES&quot;">
      <data key="d0">"MICROORGANISMS"</data>
      <data key="d1">"These organisms are capable of breaking down ingested plastics, including polymers like polypropylene (PP), polyethylene terephthalate (PET), and others. Their digestive processes involve biofragmentation and biodegradation of microplastics."</data>
      <data key="d2">chunk-7f44f9d05edb3efaf7fdb8f0f1517549</data>
    </node>
    <node id="&quot;SUPEROXIDE ANION (\(O_2^-\))&quot;">
