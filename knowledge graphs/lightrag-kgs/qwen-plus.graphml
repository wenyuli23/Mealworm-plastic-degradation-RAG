    <node id="&quot;OXIDATIVE STRESS PARAMETERS&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"Indicators of oxidative damage caused by reactive oxygen species within biological systems."&lt;SEP&gt;"Measures related to oxidative stress, evaluated in edible insects consuming polystyrene."&lt;SEP&gt;"Oxidative stress parameters are measures used to assess the level of oxidative stress in biological systems."</data>
      <data key="d2">chunk-276c82b9935756a3e668c788458ff922&lt;SEP&gt;chunk-b77d05458a2050e3057c427cf81e24ef&lt;SEP&gt;chunk-5279ebea7d4d5e22eebe3106de3ba1c3</data>
    </node>
