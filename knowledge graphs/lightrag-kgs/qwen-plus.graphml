    </node>
    <node id="&quot;CASSONE ET AL.&quot;">
      <data key="d0">"RESEARCH STUDY"</data>
      <data key="d1">"This research identified Acinetobacter genus microorganisms involved in polyethylene biodegradation."</data>
      <data key="d2">chunk-b08485bef3ee3db21e59e159ad4c3e20</data>
    </node>
