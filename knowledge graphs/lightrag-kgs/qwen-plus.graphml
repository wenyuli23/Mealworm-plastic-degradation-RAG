      <data key="d2">chunk-02f21478b87845df31740b3dab37d197</data>
    </node>
    <node id="&quot;TOTAL BIOMASS OF LIVE LARVAE&quot;">
      <data key="d0">"BIOLOGICAL MEASURE"</data>
      <data key="d1">"Total biomass of live larvae quantifies the overall mass of all surviving larvae after 45 days."</data>
      <data key="d2">chunk-02f21478b87845df31740b3dab37d197</data>
    </node>
    <node id="&quot;BIOMETRICAL PARAMETERS&quot;">
      <data key="d0">"BIOLOGICAL MEASURE"</data>
      <data key="d1">"Biometrical parameters include metrics such as proportion of live individuals, pupa counts, and imago counts, which are analyzed for Tenebrio molitor larvae."</data>
      <data key="d2">chunk-02f21478b87845df31740b3dab37d197</data>
    </node>
    <node id="&quot;PROPORTION OF LIVE INDIVIDUALS&quot;">
