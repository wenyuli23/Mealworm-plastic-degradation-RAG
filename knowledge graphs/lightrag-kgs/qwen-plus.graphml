    </node>
    <node id="&quot;GUT SYSTEM&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"The gut system of superworms is responsible for processing ingested Styrofoam and may involve microbial symbionts that aid in its degradation."</data>
      <data key="d2">chunk-d1498160e7767dd16008724d09b2ac64</data>
