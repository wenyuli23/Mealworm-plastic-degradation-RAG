      <data key="d1">"World plastic production refers to the global manufacturing of plastics, contributing to environmental pollution issues."</data>
      <data key="d2">chunk-a11793261251544a542146bc9bf0c5dd</data>
    </node>
    <node id="&quot;SINGLE-USE DISPOSABLE APPLICATIONS&quot;">
