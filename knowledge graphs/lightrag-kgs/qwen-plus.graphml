      <data key="d2">chunk-5338aa2127367c868a3e7331e1f66225</data>
    </node>
    <node id="&quot;J. W. PANG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"J. W. Pang contributed to the experimental design of the study."</data>
      <data key="d2">chunk-5338aa2127367c868a3e7331e1f66225</data>
    </node>
    <node id="&quot;J. DING&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"J. Ding contributed to the experimental design and funding acquisition for the study."</data>
      <data key="d2">chunk-5338aa2127367c868a3e7331e1f66225</data>
    </node>
    <node id="&quot;D. F. XING&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"D. F. Xing contributed to the experimental design of the study."</data>
      <data key="d2">chunk-5338aa2127367c868a3e7331e1f66225</data>
    </node>
    <node id="&quot;N. Q. REN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"N. Q. Ren contributed to the experimental design of the study."</data>
      <data key="d2">chunk-5338aa2127367c868a3e7331e1f66225</data>
    </node>
    <node id="&quot;W. M. WU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"W. M. Wu contributed to the conceptualization, methodology, supervision, data validation, writing, and funding acquisition for the study."</data>
      <data key="d2">chunk-5338aa2127367c868a3e7331e1f66225</data>
    </node>
    <node id="&quot;CRAIG S. CRIDDLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Craig S. Criddle provided suggestions during the study and contributed to its development."</data>
      <data key="d2">chunk-5338aa2127367c868a3e7331e1f66225</data>
    </node>
    <node id="&quot;ANJA M. G. BRANDON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Anja M. G. Brandon contributed to research on the biodegradation of plastics and reviewed the manuscript."</data>
      <data key="d2">chunk-5338aa2127367c868a3e7331e1f66225</data>
    </node>
    <node id="&quot;LOW-DENSITY POLYETHYLENES&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Low-density polyethylenes are a type of plastic product that undergoes biodegradation through microbial action."</data>
      <data key="d2">chunk-648afbc8ee82935d4026f5915152491c</data>
    </node>
    <node id="&quot;CARNITINE&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Carnitine is a metabolite involved in the transport of fatty acids into mitochondria for energy production."</data>
      <data key="d2">chunk-648afbc8ee82935d4026f5915152491c</data>
    </node>
    <node id="&quot;FUMED SILICA&quot;">
      <data key="d0">"PRODUCT"</data>
