      <data key="d1">"PCA is a technique used to determine the particle count and size variations of nanoplastics using digital image processing."</data>
      <data key="d2">chunk-262d7fa1c8f2581943a41cf4897fa253</data>
    </node>
    <node id="&quot;NANOSIZER&quot;">
      <data key="d0">"INSTRUMENT"</data>
      <data key="d1">"The Nanosizer is an instrument used to measure the mean diameter and degree of size variation of nanoparticles."</data>
      <data key="d2">chunk-262d7fa1c8f2581943a41cf4897fa253</data>
    </node>
    <node id="&quot;MODEL 500 ULTRASONIC DISMEMBRATOR&quot;">
      <data key="d0">"INSTRUMENT"</data>
