      <data key="d2">chunk-5b30daa90b5c91314e1d65e87f191166</data>
    </node>
    <node id="&quot;NITRATE RESPIRATION&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"A respiratory process in which nitrate is used as the terminal electron acceptor instead of oxygen."</data>
      <data key="d2">chunk-5b30daa90b5c91314e1d65e87f191166</data>
    </node>
    <node id="&quot;NITRITE RESPIRATION&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"A biological process involving the reduction of nitrite to nitric oxide or other nitrogenous compounds."</data>
      <data key="d2">chunk-5b30daa90b5c91314e1d65e87f191166</data>
    </node>
    <node id="&quot;NITROUS OXIDE DENITRIFICATION&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
