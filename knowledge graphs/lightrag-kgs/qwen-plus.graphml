      <data key="d2">chunk-5318125e74217718b470b7721d1d6365</data>
    </node>
    <node id="&quot;YANG ET AL., 2018&quot;">
      <data key="d0">"RESEARCH STUDY"</data>
      <data key="d1">"A research study observing the effects of polystyrene consumption on T. molitor larvae survival and biomass."</data>
      <data key="d2">chunk-5318125e74217718b470b7721d1d6365</data>
    </node>
    <node id="&quot;YANG ET AL., 2015B&quot;">
      <data key="d0">"STUDY"</data>
      <data key="d1">"A research study identifying bacteria in the digestive tract of T. molitor larvae involved in polystyrene degradation."&lt;SEP&gt;"This study demonstrated that gut microflora are essential for PS degradation in mealworms, as antibiotic treatment inhibited this ability."</data>
      <data key="d2">chunk-5318125e74217718b470b7721d1d6365&lt;SEP&gt;chunk-6e05bc34fccfca5e177064daf8346866</data>
    </node>
    <node id="&quot;WILSON, 1971&quot;">
