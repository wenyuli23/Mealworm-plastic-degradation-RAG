      <data key="d0">"PERSON"</data>
      <data key="d1">"S. S. Yang contributed to the conceptualization, methodology, supervision, data validation, writing, and funding acquisition for the study."</data>
      <data key="d2">chunk-5338aa2127367c868a3e7331e1f66225</data>
    </node>
    <node id="&quot;M.Q. DING&quot;">
      <data key="d0">"PERSON"</data>
