      <data key="d1">"Sigma-Aldrich supplies reagents such as 17-β estradiol and MTT used in the experiment."</data>
      <data key="d2">chunk-5911f995d46a77458be83382b8c67f9b</data>
    </node>
    <node id="&quot;INC. MCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Inc. MCE supports the preparation of Tenebrio molitor larvae powder (TMlp)."</data>
      <data key="d2">chunk-5911f995d46a77458be83382b8c67f9b</data>
    </node>
    <node id="&quot;KEIL&quot;">
      <data key="d0">"ORGANIZATION"</data>
