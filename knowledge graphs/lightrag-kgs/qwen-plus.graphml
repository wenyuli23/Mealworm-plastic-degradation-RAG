    </node>
    <node id="&quot;WATER-EXTRACTED FRACTION&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"The water-extracted fraction represents hydrophilic soluble substances in frass, indicating efficient plastic degradation."</data>
      <data key="d2">chunk-490fdb90ad8a65d35f3c2cd42a8c4c8e</data>
    </node>
    <node id="&quot;ORGANIC SOLVENT-EXTRACTED FRACTION&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"The organic solvent-extracted fraction denotes residual plastic content in frass, decreasing as biodegradation progresses."</data>
      <data key="d2">chunk-490fdb90ad8a65d35f3c2cd42a8c4c8e</data>
    </node>
    <node id="&quot;PLASTIC REMOVAL&quot;">
