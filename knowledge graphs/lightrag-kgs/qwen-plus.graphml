    <node id="&quot;2,4-DIPHENYL-1-BUTENE&quot;">
      <data key="d0">"CHEMICAL COMPOUND"</data>
      <data key="d1">"A compound derived from plastic packaging identified in the biomass."&lt;SEP&gt;"An oligomer detected in the frass resulting from polystyrene degradation."</data>
      <data key="d2">chunk-c095cc3175666d5093fe411f9a39cb66&lt;SEP&gt;chunk-de9904e6f38706256e15c7957f8f0527</data>
