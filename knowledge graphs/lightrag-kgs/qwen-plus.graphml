      <data key="d2">chunk-fdb13eda4d3cf5385a0a8284c7e213b0</data>
    </node>
    <node id="&quot;HYDROGEN GAS&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"Hydrogen gas is supplied through the pre-mixed gas line in the anaerobic chamber to remove oxygen traces via palladium catalysts."</data>
      <data key="d2">chunk-fdb13eda4d3cf5385a0a8284c7e213b0</data>
    </node>
    <node id="&quot;PALLADIUM CATALYST&quot;">
