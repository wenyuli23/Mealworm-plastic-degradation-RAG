      <data key="d2">chunk-a221e0c62ecd5a2502ec0a4473ab0999</data>
    </node>
    <node id="&quot;ENERGY FLUX&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Energy flux represents the flow of energy from reserves into the reproduction buffer and subsequently into eggs."&lt;SEP&gt;"Energy flux represents the flow of energy through an organism, including assimilation, mobilization, and allocation for various physiological processes."</data>
      <data key="d2">chunk-998b63e5349034d477c2087c139669ed&lt;SEP&gt;chunk-eee7e44e4c15567a057d7d295d240211</data>
    </node>
    <node id="&quot;HOLOMETABOLOUS INSECTS&quot;">
