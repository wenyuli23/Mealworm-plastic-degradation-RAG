      <data key="d1">"Yang, H. is one of the researchers working on the study related to ultraviolet spectrum conversion for bioenergy production."</data>
      <data key="d2">chunk-352650a946ab941cec3f7b9813faeee1</data>
    </node>
    <node id="&quot;2022&quot;">
      <data key="d0">"LIFE STAGE"</data>
      <data key="d1">"2022 represents the year when the study on enhancing bioenergy production with carbon capture of microalgae was published."</data>
      <data key="d2">chunk-352650a946ab941cec3f7b9813faeee1</data>
    </node>
    <node id="&quot;BIOLOGICAL SYSTEMS&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"Biological systems refer to the natural processes and structures that are impacted by techniques like ultraviolet spectrum conversion in microalgae."</data>
      <data key="d2">chunk-352650a946ab941cec3f7b9813faeee1</data>
    </node>
    <node id="&quot;LDIR&quot;">
      <data key="d2">chunk-fe381daaa91bbff20758798e5baf82b5</data>
      <data key="d1">"LDIR determines the quantity of microplastics in mealworm intestines and evaluates depuration time."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;DISSECTION&quot;">
      <data key="d2">chunk-f267b48449a40d614a2f325799752dea</data>
      <data key="d1">"A sterile scalpel was essential for removing mealworm heads during the dissection process."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;BIOLOGICAL MATERIALS&quot;">
      <data key="d2">chunk-f267b48449a40d614a2f325799752dea</data>
      <data key="d1">"Cellulase digestion broke down biological materials in mealworm intestine samples, facilitating plastic particle identification."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;MATERIAL COMPOSITION&quot;">
      <data key="d2">chunk-f267b48449a40d614a2f325799752dea</data>
      <data key="d1">"Infrared spectroscopy determined the material composition of residual plastics by comparing them with standard spectra."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;TOXIC SUBSTANCES&quot;">
      <data key="d2">chunk-77a9d70651c9f13362e4c1e3ce10eab0&lt;SEP&gt;chunk-a221e0c62ecd5a2502ec0a4473ab0999</data>
      <data key="d1">"Degradation intermediates, such as chlorinated compounds, can act as toxic substances harmful to mealworms."&lt;SEP&gt;"Toxic substances can negatively affect the survival and biodegradation efficiency of mealworms."</data>
      <data key="d0">"CHEMICAL PROPERTY"</data>
    </node>
    <node id="&quot;BIO-BASED POLYACTIC ACID MICROPLASTICS&quot;">
      <data key="d2">chunk-9fb491e686c96e54f8ea43a9f1ba97eb</data>
      <data key="d1">"Danio rerio exhibits diet preference for bio-based polyactic acid microplastics, causing intestinal damage and microbiota dysbiosis."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;AIRBORNE MICROPLASTICS&quot;">
      <data key="d2">chunk-825c2784fa66ce67114e4173ed0702f9</data>
      <data key="d1">"Airborne microplastics contribute to direct radiative effects, influencing climate through radiation absorption and scattering."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;INTESTINAL DYSBIOSIS&quot;">
      <data key="d0">"HEALTH MEASURE"</data>
      <data key="d1">"Intestinal dysbiosis refers to an imbalance in the gut microbiome caused by the biodegradation of polystyrene, depending on its molecular weight."</data>
      <data key="d2">chunk-2a00d67f63d22d1959c8a565b6a86d22</data>
    </node>
    <node id="&quot;ATACTIC POLYSTYRENE&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"Atactic polystyrene has randomly distributed phenyl groups on both sides of the polymer chain, preventing crystallinity."</data>
      <data key="d2">chunk-2a00d67f63d22d1959c8a565b6a86d22</data>
    </node>
    <node id="&quot;SYNDIOTACTIC POLYSTYRENE (SPS)&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"Syndiotactic polystyrene is produced with additives to achieve specific commercial applications, though it is used less frequently."</data>
      <data key="d2">chunk-2a00d67f63d22d1959c8a565b6a86d22</data>
    </node>
    <node id="&quot;PLASTIC ADDITIVES&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"Plastic additives are substances added to polymers to enhance their properties but can affect biodegradability."</data>
      <data key="d2">chunk-2a00d67f63d22d1959c8a565b6a86d22</data>
    </node>
    <node id="&quot;POLY(VINYL CHLORIDE) (PVC)&quot;">
      <data key="d0">"CHEMICAL REACTION"</data>
      <data key="d1">"PVC is widely used but contributes significantly to plastic pollution."</data>
      <data key="d2">chunk-2a00d67f63d22d1959c8a565b6a86d22</data>
    </node>
    <node id="&quot;POLYSTYRENE (PS) MICROPLASTICS&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Polystyrene microplastics are synthetic polymers that undergo degradation in the larval intestinal tract of mealworms, leading to changes in molecular weight."</data>
      <data key="d2">chunk-e136b8a35c0d60811b9daf0cbd5729f5</data>
    </node>
    <node id="&quot;SIZE-AVERAGE MOLECULAR WEIGHT (MC)&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"Size-average molecular weight provides an intermediate value between Mn and Mw, reflecting the size of polymer chains."</data>
      <data key="d2">chunk-e136b8a35c0d60811b9daf0cbd5729f5</data>
    </node>
    <node id="&quot;SPECIFIC PS CONSUMPTION RATES (SPCRS)&quot;">
      <data key="d0">"METABOLIC MEASURE"</data>
      <data key="d1">"Specific PS consumption rates quantify the rate at which mealworms consume polystyrene microplastics under different experimental conditions."</data>
      <data key="d2">chunk-e136b8a35c0d60811b9daf0cbd5729f5</data>
    </node>
    <node id="&quot;INITIAL WEIGHT OF MEALWORMS&quot;">
      <data key="d0">"HEALTH MEASURE"</data>
      <data key="d1">"The initial weight of mealworms is recorded as \(91.8 \pm 2.0 \mathrm{mg}\), serving as a baseline for evaluating physiological changes."</data>
      <data key="d2">chunk-e136b8a35c0d60811b9daf0cbd5729f5</data>
    </node>
    <node id="&quot;FINAL WEIGHT OF MEALWORMS&quot;">
      <data key="d0">"HEALTH MEASURE"</data>
      <data key="d1">"The final weight of mealworms after 24 days of feeding indicates their growth or decline under different dietary conditions."</data>
      <data key="d2">chunk-e136b8a35c0d60811b9daf0cbd5729f5</data>
    </node>
    <node id="&quot;PS REMOVAL&quot;">
      <data key="d0">"METABOLIC MEASURE"</data>
      <data key="d1">"PS removal measures the percentage of polystyrene microplastics removed from the system, indicating the efficiency of degradation."</data>
      <data key="d2">chunk-e136b8a35c0d60811b9daf0cbd5729f5</data>
    </node>
    <node id="&quot;STARVATION (ST)&quot;">
      <data key="d0">"DIET"</data>
      <data key="d1">"Starvation refers to the absence of food, used as a control condition to compare the effects of polystyrene microplastics on mealworms."</data>
      <data key="d2">chunk-e136b8a35c0d60811b9daf0cbd5729f5</data>
    </node>
    <node id="&quot;WATER-EXTRACTED FRACTION \(C_W\)&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"Water-extracted fraction estimates residual PS content after water extraction from frass."</data>
      <data key="d2">chunk-c9af0d95fd5f52d02b9cb33387951963</data>
    </node>
    <node id="&quot;ETHANOL-EXTRACTED FRACTION \(C_E\)&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"Ethanol-extracted fraction estimates residual PS content after ethanol extraction from frass."</data>
      <data key="d2">chunk-c9af0d95fd5f52d02b9cb33387951963</data>
    </node>
    <node id="&quot;THF-EXTRACTED FRACTION \(C_T\)&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"THF-extracted fraction estimates residual PS content after THF extraction from frass."</data>
      <data key="d2">chunk-c9af0d95fd5f52d02b9cb33387951963</data>
    </node>
    <node id="&quot;MOLECULAR WEIGHT (MW, MN, MP)&quot;">
      <data key="d0">"PHYSICAL PROPERTY"</data>
      <data key="d1">"Molecular weight measures properties like weight-average, number-average, and peak molecular weights of PS."</data>
      <data key="d2">chunk-c9af0d95fd5f52d02b9cb33387951963</data>
    </node>
    <node id="&quot;POPULATION DENSITY&quot;">
      <data key="d0">"ECOLOGICAL CONCEPT"</data>
      <data key="d1">"Population density affects competition and resource availability for mealworms."&lt;SEP&gt;"Population density was maintained at 0.4 mealworms \(\mathrm{cm}^{-2}\) to study effects on biodegradation."</data>
      <data key="d2">chunk-c9af0d95fd5f52d02b9cb33387951963&lt;SEP&gt;chunk-a221e0c62ecd5a2502ec0a4473ab0999</data>
    </node>
    <node id="&quot;CARBON AND ENERGY SOURCES&quot;">
      <data key="d0">"NUTRITIONAL COMPONENT"</data>
      <data key="d1">"Carbon and energy sources refer to the nutrients provided by PS MPs to support mealworm life activities."</data>
      <data key="d2">chunk-c9af0d95fd5f52d02b9cb33387951963</data>
    </node>
    <node id="&quot;RESIDUAL PS CONTENT&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"Residual PS content measures the amount of PS remaining after biodegradation."</data>
      <data key="d2">chunk-c9af0d95fd5f52d02b9cb33387951963</data>
    </node>
    <node id="&quot;ORIGINAL PS MPS&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Original PS MPs represent the initial polystyrene microplastics used in the experiment."</data>
      <data key="d2">chunk-c9af0d95fd5f52d02b9cb33387951963</data>
    </node>
    <node id="&quot;PS-L&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"PS-L represents low molecular weight PS MPs (\(M_w\) of 6.70 kDa)."</data>
      <data key="d2">chunk-c9af0d95fd5f52d02b9cb33387951963</data>
    </node>
    <node id="&quot;PS-M&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"PS-M represents medium molecular weight PS MPs (\(M_w\) of 192.9 kDa)."</data>
      <data key="d2">chunk-c9af0d95fd5f52d02b9cb33387951963</data>
    </node>
    <node id="&quot;PS-H&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"PS-H represents high molecular weight PS MPs (\(M_w\) of 1346 kDa)."</data>
      <data key="d2">chunk-c9af0d95fd5f52d02b9cb33387951963</data>
    </node>
    <node id="&quot;CW&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"Cw indicates the fraction of hydrophilic, digested organic components and salts in the frass."</data>
      <data key="d2">chunk-c29fa50fac7d523f43c540627750c823</data>
    </node>
    <node id="&quot;CE&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"Ce indicates the fraction of lipophilic substances in the frass."</data>
      <data key="d2">chunk-c29fa50fac7d523f43c540627750c823</data>
    </node>
    <node id="&quot;CC&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"Cc indicates the residual and modified PS content in the frass."</data>
      <data key="d2">chunk-c29fa50fac7d523f43c540627750c823</data>
    </node>
    <node id="&quot;HYDROPHILIC COMPONENTS&quot;">
      <data key="d0">"NUTRITIONAL COMPONENT"</data>
      <data key="d1">"Hydrophilic components are water-attracting substances found in the frass, indicating digested organic matter."</data>
      <data key="d2">chunk-c29fa50fac7d523f43c540627750c823</data>
    </node>
    <node id="&quot;LIPOPHILIC SUBSTANCES&quot;">
      <data key="d0">"LIPID"</data>
      <data key="d1">"Lipophilic substances are fat-soluble components found in the frass, representing undigested or partially digested materials."</data>
      <data key="d2">chunk-c29fa50fac7d523f43c540627750c823</data>
    </node>
    <node id="&quot;BROAD DEPOLYMERIZATION (BD)&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Broad depolymerization refers to the efficient degradation of PS polymers with molecular weights below 612.2 kDa."&lt;SEP&gt;"Broad depolymerization refers to the extensive breakdown of PS MPs with low to high molecular weights, leading to significant reductions in \(M_{w}\), \(M_{n}\), and \(M_{d}\)."</data>
      <data key="d2">chunk-67028993c2650049216602d03fb3f786&lt;SEP&gt;chunk-70eb294c60e73338ed59a2eddf057c1e</data>
    </node>
    <node id="&quot;LIMITED-EXTENT DEPOLYMERIZATION (LD)&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Limited-extent depolymerization occurs when the degradation of ultrahigh molecular weight PS MPs results in an increase in \(M_{w}\), \(M_{n}\), and \(M_{d}\) due to selective degradation of shorter polymer chains."</data>
      <data key="d2">chunk-67028993c2650049216602d03fb3f786</data>
    </node>
    <node id="&quot;MOLECULAR WEIGHT (\(M_{W}\))&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"\(M_{w}\) represents the weight-average molecular weight of polymers, which significantly decreases during the biodegradation of PS MPs."</data>
      <data key="d2">chunk-67028993c2650049216602d03fb3f786</data>
    </node>
    <node id="&quot;NUMBER-AVERAGE MOLECULAR WEIGHT (\(M_{N}\))&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"\(M_{n}\) is the number-average molecular weight of polymers, showing a decline during the biodegradation of PS MPs."</data>
      <data key="d2">chunk-67028993c2650049216602d03fb3f786</data>
    </node>
    <node id="&quot;MEDIAN MOLECULAR WEIGHT (\(M_{D}\))&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"\(M_{d}\) denotes the median molecular weight of polymers, which also decreases during the biodegradation process."</data>
      <data key="d2">chunk-67028993c2650049216602d03fb3f786</data>
    </node>
    <node id="&quot;LOW-MW POLYMERS&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Low-molecular-weight polymers are more susceptible to degradation by mealworm enzymes and gut bacteria compared to high-MW polymers."</data>
      <data key="d2">chunk-67028993c2650049216602d03fb3f786</data>
    </node>
    <node id="&quot;HIGH-MW POLYMERS&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"High-molecular-weight polymers are challenging for degradation, leading to limited-extent depolymerization during biodegradation."</data>
      <data key="d2">chunk-67028993c2650049216602d03fb3f786</data>
    </node>
    <node id="&quot;ULTRAHIGH MW POLYMERS&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Ultrahigh molecular weight polymers exhibit limited-extent depolymerization due to slower enzymatic and microbial activity."</data>
      <data key="d2">chunk-67028993c2650049216602d03fb3f786</data>
    </node>
    <node id="&quot;SELECTIVE DEPOLYMERIZATION&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Selective depolymerization refers to the preferential breakdown of shorter polymer chains over longer ones during biodegradation."</data>
      <data key="d2">chunk-67028993c2650049216602d03fb3f786</data>
    </node>
    <node id="&quot;ZOPHOBAS ATRATUS (SUPERWORMS)&quot;">
      <data key="d0">"MICROORGANISMS"</data>
      <data key="d1">"Superworms are insects similar to mealworms that also participate in the biodegradation of PS polymers."</data>
      <data key="d2">chunk-67028993c2650049216602d03fb3f786</data>
    </node>
    <node id="&quot;GALLERIA MELLONELLA (GREATER WAXWORMS)&quot;">
      <data key="d0">"MICROORGANISMS"</data>
      <data key="d1">"Greater waxworms are another species capable of degrading PS polymers through their gut microbiome."</data>
      <data key="d2">chunk-67028993c2650049216602d03fb3f786</data>
    </node>
    <node id="&quot;ACHATINA FULICA (LAND SNAILS)&quot;">
      <data key="d0">"MICROORGANISMS"</data>
      <data key="d1">"Land snails contribute to the digestion of PS foam through their digestive processes."</data>
      <data key="d2">chunk-67028993c2650049216602d03fb3f786</data>
    </node>
    <node id="&quot;COMMERCIAL PS FOAMS&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Commercial polystyrene foams are degraded by mealworms, demonstrating the effectiveness of their biodegradation mechanisms."</data>
      <data key="d2">chunk-67028993c2650049216602d03fb3f786</data>
    </node>
    <node id="&quot;LOW MW POLYSTYRENE (PS-L)&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Polystyrene with a low molecular weight (6.70 kDa</data>
      <data key="d2">chunk-9f7a93f0b3dbebad30b6aeabec429a40</data>
    </node>
    <node id="&quot;MEDIUM MW POLYSTYRENE (PS-M)&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Polystyrene with a medium molecular weight (192.9 kDa</data>
      <data key="d2">chunk-9f7a93f0b3dbebad30b6aeabec429a40</data>
    </node>
    <node id="&quot;ULTRAHIGH MW POLYSTYRENE (PS-H)&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Polystyrene with an ultrahigh molecular weight (1346 kDa</data>
      <data key="d2">chunk-9f7a93f0b3dbebad30b6aeabec429a40</data>
    </node>
    <node id="&quot;RIBOFLAVIN METABOLISM&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Riboflavin metabolism is significantly perturbed under all three PS feeding conditions, facilitating extracellular electron transfer."</data>
      <data key="d2">chunk-2ee6535da22915c7094098e016b19d80</data>
    </node>
    <node id="&quot;HISTIDINE METABOLISM&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Histidine metabolism is associated with various metabolic pathways such as pentose phosphate pathway, alanine metabolism, and glutamate metabolism."</data>
      <data key="d2">chunk-2ee6535da22915c7094098e016b19d80</data>
    </node>
    <node id="&quot;ASCORBATE AND ALDARATE METABOLISM&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Ascorbate and aldarate metabolism maintains internal redox balance and defends against oxidative stress, being significantly perturbed in all mealworm groups."</data>
      <data key="d2">chunk-2ee6535da22915c7094098e016b19d80</data>
    </node>
    <node id="&quot;GLYOXYLATE AND DICARBOXYLATE METABOLISM&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Glyoxylate and dicarboxylate metabolism belongs to key energy metabolism pathways and is significantly perturbed in low and medium MW PS polymer-fed mealworms."</data>
      <data key="d2">chunk-2ee6535da22915c7094098e016b19d80</data>
    </node>
    <node id="&quot;LINOLEIC ACID METABOLISM&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Linoleic acid metabolism is associated with membrane integrity repairment and active substance composition on the membrane surface, observed in ultrahigh MW PS-fed mealworms."</data>
      <data key="d2">chunk-2ee6535da22915c7094098e016b19d80</data>
    </node>
    <node id="&quot;PS-L, PS-M, PS-H&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"PS-L, PS-M, and PS-H represent low, medium, and ultrahigh molecular weight polystyrene polymers used in the study."</data>
      <data key="d2">chunk-2ee6535da22915c7094098e016b19d80</data>
    </node>
    <node id="&quot;METABOLOMIC PROFILES&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"Metabolomic profiles refer to the comprehensive set of metabolites within mealworms under different diet conditions."</data>
      <data key="d2">chunk-2ee6535da22915c7094098e016b19d80</data>
    </node>
    <node id="&quot;VOLCANO MAP ANALYSIS&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Volcano map analysis is a method used to identify differentially expressed metabolites in mealworms fed with various PS polymers."</data>
      <data key="d2">chunk-2ee6535da22915c7094098e016b19d80</data>
    </node>
    <node id="&quot;TOPOLOGICAL ANALYSIS (TA)&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Topological analysis is used to screen differentially expressed metabolites and analyze related metabolic pathways."</data>
      <data key="d2">chunk-2ee6535da22915c7094098e016b19d80</data>
    </node>
    <node id="&quot;BUBBLE DIAGRAMS&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Bubble diagrams visually display the results of pathway analysis in the study."</data>
      <data key="d2">chunk-2ee6535da22915c7094098e016b19d80</data>
    </node>
    <node id="&quot;REDOX CAPABILITY&quot;">
      <data key="d0">"BIOLOGICAL FUNCTION"</data>
      <data key="d1">"Redox capability refers to the balance between oxidation and reduction reactions within mealworm intestines."</data>
      <data key="d2">chunk-2ee6535da22915c7094098e016b19d80</data>
    </node>
    <node id="&quot;PUTATIVE PS DEGRADING ENZYMES&quot;">
      <data key="d0">"ENZYME"</data>
      <data key="d1">"Putative PS degrading enzymes are hypothesized enzymes involved in the biodegradation of polystyrene polymers."</data>
      <data key="d2">chunk-2ee6535da22915c7094098e016b19d80</data>
    </node>
    <node id="&quot;CATALYTIC MECHANISMS&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Catalytic mechanisms describe the processes by which enzymes facilitate chemical reactions during PS biodegradation."</data>
      <data key="d2">chunk-2ee6535da22915c7094098e016b19d80</data>
    </node>
    <node id="&quot;OXIDATIVE STRESS DEFENSE&quot;">
      <data key="d0">"BIOLOGICAL RESPONSE"</data>
      <data key="d1">"Oxidative stress defense mechanisms protect mealworms from potential damage caused by oxidative stress."</data>
      <data key="d2">chunk-2ee6535da22915c7094098e016b19d80</data>
    </node>
    <node id="&quot;IMMUNE SYSTEM RESPONSE&quot;">
      <data key="d0">"IMMUNE RESPONSE"</data>
      <data key="d1">"Immune system response refers to the reaction of the immune system in mealworms to microplastic ingestion."</data>
      <data key="d2">chunk-2ee6535da22915c7094098e016b19d80</data>
    </node>
    <node id="&quot;MP-INDUCED DAMAGE&quot;">
      <data key="d0">"HEALTH MEASURE"</data>
      <data key="d1">"MP-induced damage describes the harm caused by microplastic ingestion on the gut epithelium of mealworms."</data>
      <data key="d2">chunk-2ee6535da22915c7094098e016b19d80</data>
