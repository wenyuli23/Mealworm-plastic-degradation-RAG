    </node>
    <node id="&quot;STOCHASTIC PROCESSES&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"Stochastic processes describe random events influencing gut microbiome succession during feeding patterns."&lt;SEP&gt;"Stochastic processes involve random events and are often used to describe unpredictable changes in microbial communities."</data>
