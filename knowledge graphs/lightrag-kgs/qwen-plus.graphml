    </node>
    <node id="&quot;WYNANTS ET AL., 2017&quot;">
      <data key="d0">"RESEARCH STUDY"</data>
      <data key="d1">"A research study examining changes in intestinal microbiota composition across different life stages of T. molitor."</data>
      <data key="d2">chunk-5318125e74217718b470b7721d1d6365</data>
    </node>
    <node id="&quot;BACILLUS ANTHRACIS&quot;">
      <data key="d0">"SPECIES"</data>
      <data key="d1">"Bacillus anthracis is a bacterium capable of forming tunnels, cracks, and cellular aggregates on PS sheets, contributing to the degradation of polystyrene."&lt;SEP&gt;"Bacillus anthracis is a specific bacterial species isolated from T. molitor, showing strong PS degradation capabilities."</data>
      <data key="d2">chunk-7c4804d2c00d1d5fff2b89eaf6da26da&lt;SEP&gt;chunk-2665d67f816d2da20a065d708c370210</data>
    </node>
    <node id="&quot;ERWINIA PERSICINA&quot;">
      <data key="d0">"BACTERIUM"</data>
      <data key="d1">"Erwinia persicina is a bacterial species isolated from T. molitor larvae, characterized by its biochemical properties."&lt;SEP&gt;"Erwinia persicina is a bacterium identified by the strain LMG 11254* and associated with specific gene sequences."</data>
      <data key="d2">chunk-2665d67f816d2da20a065d708c370210&lt;SEP&gt;chunk-014b72d0a2657cbc89c4dee5f2b32bba</data>
    </node>
    <node id="&quot;GRAM-POSITIVE BACTERIUM&quot;">
      <data key="d0">"PHYSICAL CHARACTERISTIC"</data>
      <data key="d1">"Gram-positive bacteria are characterized by their cell wall composition and staining properties."</data>
      <data key="d2">chunk-2665d67f816d2da20a065d708c370210</data>
    </node>
    <node id="&quot;GRAM-NEGATIVE BACTERIUM&quot;">
      <data key="d0">"PHYSICAL CHARACTERISTIC"</data>
      <data key="d1">"Gram-negative bacteria have an outer membrane and different staining properties compared to Gram-positive bacteria."</data>
      <data key="d2">chunk-2665d67f816d2da20a065d708c370210</data>
    </node>
    <node id="&quot;LACTOSE FERMENTER&quot;">
      <data key="d0">"BIOLOGICAL FUNCTION"</data>
      <data key="d1">"Lactose fermenters are bacteria capable of breaking down lactose into simpler molecules, often producing gas."</data>
      <data key="d2">chunk-2665d67f816d2da20a065d708c370210</data>
    </node>
    <node id="&quot;SUCROSE FERMENTER&quot;">
      <data key="d0">"BIOLOGICAL FUNCTION"</data>
      <data key="d1">"Sucrose fermenters are bacteria that metabolize sucrose, potentially producing gas as a byproduct."</data>
      <data key="d2">chunk-2665d67f816d2da20a065d708c370210</data>
    </node>
    <node id="&quot;GLUCOSE FERMENTER&quot;">
      <data key="d0">"BIOLOGICAL FUNCTION"</data>
