      <data key="d1">"A type of white blood cell involved in immune response, measured in the experiment."</data>
      <data key="d2">chunk-81a3bc3c202af119c80775d5bf23d8b2</data>
    </node>
    <node id="&quot;EOSINOPHILS&quot;">
