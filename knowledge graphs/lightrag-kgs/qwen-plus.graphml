      <data key="d0">"FATTY ACID"</data>
      <data key="d1">"A saturated fatty acid found in higher proportions in OAT-fed larvae compared to other groups."&lt;SEP&gt;"Stearic acid is another saturated fatty acid present in mealworm fatty acid profiles."&lt;SEP&gt;"An emulsifier and saturated long-chain fatty acid with the chemical formula C18H36O2."</data>
      <data key="d2">chunk-ee46611b24ea3848df979ded841f06b8&lt;SEP&gt;chunk-1ead6f17ad517015b638608c5bfe6852&lt;SEP&gt;chunk-939f85d52d9301668deab282264e5fd9</data>
    </node>
    <node id="&quot;MARGARIC ACID&quot;">
      <data key="d0">"FATTY ACID"</data>
      <data key="d1">"A saturated fatty acid with slightly higher content in OAT-fed larvae."</data>
      <data key="d2">chunk-1ead6f17ad517015b638608c5bfe6852</data>
    </node>
    <node id="&quot;ARACHIDIC ACID&quot;">
      <data key="d0">"FATTY ACID"</data>
      <data key="d1">"A saturated fatty acid with slightly higher content in OAT-fed larvae."&lt;SEP&gt;"Arachidic acid is a long-chain saturated fatty acid found in mealworm fatty acid profiles."</data>
      <data key="d2">chunk-ee46611b24ea3848df979ded841f06b8&lt;SEP&gt;chunk-1ead6f17ad517015b638608c5bfe6852</data>
    </node>
