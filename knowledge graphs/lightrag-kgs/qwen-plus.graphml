      <data key="d2">chunk-b759b81206d0e33e320f2d61e540ae47</data>
    </node>
    <node id="&quot;PREDOMINANT BACTERIA&quot;">
      <data key="d0">"BACTERIUM"</data>
      <data key="d1">"Predominant bacteria are responsible for biodegrading PP with specific molecular weights, providing targeted microbial solutions."</data>
      <data key="d2">chunk-b759b81206d0e33e320f2d61e540ae47</data>
    </node>
    <node id="&quot;PLASTIC-EATING INSECTS&quot;">
