      <data key="d0">"CHEMICAL COMPOUND"</data>
      <data key="d1">"Non-intentionally added substances derived from plastic packaging."</data>
      <data key="d2">chunk-de9904e6f38706256e15c7957f8f0527</data>
    </node>
    <node id="&quot;2,4-DI-TERT BUTYL PHENOL&quot;">
      <data key="d0">"CHEMICAL COMPOUND"</data>
      <data key="d1">"A compound identified in the insect frass."&lt;SEP&gt;"A degradation product derived from an additive known as Irgafos 168."</data>
      <data key="d2">chunk-f2122660fcfebecf752000198a16f222&lt;SEP&gt;chunk-de9904e6f38706256e15c7957f8f0527</data>
