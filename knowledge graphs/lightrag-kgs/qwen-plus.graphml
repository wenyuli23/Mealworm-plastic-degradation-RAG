      <data key="d2">chunk-3815960770483b9c0a1579ca8442e3a6</data>
    </node>
    <node id="&quot;PHENYLACETIC ACID&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"A metabolite negatively correlated with the lignocellulose diet and the first ordination axis."&lt;SEP&gt;"A product of the enzymatic activity of PAD, eventually introduced into the TCA cycle."&lt;SEP&gt;"Phenylacetic acid is a metabolite involved in various biochemical pathways."&lt;SEP&gt;"Phenylacetic acid is an aromatic organic acid detected in mealworm metabolic studies."</data>
      <data key="d2">chunk-ee46611b24ea3848df979ded841f06b8&lt;SEP&gt;chunk-4a4712059883b356b4aea23cb7ef1514&lt;SEP&gt;chunk-6f65bf081bdd3c6718fa0310993bfc0d&lt;SEP&gt;chunk-3815960770483b9c0a1579ca8442e3a6</data>
    </node>
    <node id="&quot;PHENYLACETALDEHYDE REDUCTASE (PAR)&quot;">
      <data key="d0">"ENZYME"</data>
      <data key="d1">"An enzyme involved in maintaining an equilibrium between phenylethanol and phenylacetaldehyde."</data>
      <data key="d2">chunk-3815960770483b9c0a1579ca8442e3a6</data>
    </node>
    <node id="&quot;EPOXIDE HYDROLASE (EH)&quot;">
      <data key="d0">"ENZYME"</data>
      <data key="d1">"An enzyme hydrolyzing styrene oxide into phenylethanol-1,2-diol."</data>
      <data key="d2">chunk-3815960770483b9c0a1579ca8442e3a6</data>
    </node>
    <node id="&quot;MANDELIC ACID&quot;">
