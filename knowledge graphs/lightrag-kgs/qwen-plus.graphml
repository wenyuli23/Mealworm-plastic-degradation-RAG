      <data key="d1">"The late instar larva group provides gut and frass samples for enrichment culture experiments."</data>
      <data key="d2">chunk-fdb13eda4d3cf5385a0a8284c7e213b0</data>
    </node>
    <node id="&quot;ANAEROBIC CHAMBER&quot;">
      <data key="d0">"TECHNOLOGY"</data>
