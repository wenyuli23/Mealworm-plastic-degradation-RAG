      <data key="d2">chunk-b759b81206d0e33e320f2d61e540ae47</data>
    </node>
    <node id="&quot;TARGETED MICROBES&quot;">
      <data key="d0">"MICROBE"</data>
      <data key="d1">"Targeted microbes are specific bacteria selected for their ability to degrade particular types of plastic waste."</data>
