      <data key="d0">"PRODUCT"</data>
      <data key="d1">"PE polymers refer to polyethylene plastics ingested by mealworm larvae, leading to oxidative stress."</data>
      <data key="d2">chunk-1175f4bdc5e5c267806fa6c0ff19fcc4</data>
    </node>
    <node id="&quot;ANTIOXIDANT ENZYMES&quot;">
      <data key="d0">"ENZYME"</data>
      <data key="d1">"Antioxidant enzymes are biological molecules found in insects that protect cells from oxidative damage."&lt;SEP&gt;"Antioxidant enzymes collectively help protect against oxidative damage caused by ROS."</data>
      <data key="d2">chunk-7e67971bdf45c447f2409fddb80e0d8a&lt;SEP&gt;chunk-1175f4bdc5e5c267806fa6c0ff19fcc4</data>
    </node>
