      <data key="d0">"BACTERIUM"</data>
      <data key="d1">"Escherichia coli K12 is a bacterial strain used as a control in experiments to rule out microbial contamination as the source of observed chemical modifications in plastics."</data>
      <data key="d2">chunk-05b7bf66b11c66f02e73a07fb823b8fa</data>
    </node>
