      <data key="d2">chunk-fccc204d8a48c645da49bd7b3175c262</data>
    </node>
    <node id="&quot;INVERTEBRATES&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"Invertebrates, such as mealworm larvae, play a role in assessing physiological performance under environmental exposure to microplastics."</data>
      <data key="d2">chunk-fccc204d8a48c645da49bd7b3175c262</data>
