    <node id="&quot;THE FOAM FACTORY&quot;">
      <data key="d0">"SUPPLIER"</data>
      <data key="d1">"The Foam Factory is a supplier of low-density polyethylene foam used as test material in the study."</data>
      <data key="d2">chunk-89ff8edff56325c22cfed3871f4fbf48</data>
    </node>
    <node id="&quot;EXPANDED POLYSTYRENE INSULATION MATERIAL&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Expanded polystyrene insulation material is a product used as control material in the experiment, characterized by its molecular weight and density."</data>
      <data key="d2">chunk-ada834fc8d4bea41c0ce1770d6f57e4b</data>
    </node>
