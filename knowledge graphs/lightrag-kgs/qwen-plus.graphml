      <data key="d1">"C20:1 is a monounsaturated fatty acid with potential roles in cellular signaling and metabolism."</data>
      <data key="d2">chunk-b8a706f2bd66291a3ef925114ffd9300</data>
    </node>
    <node id="&quot;C18:2&quot;">
