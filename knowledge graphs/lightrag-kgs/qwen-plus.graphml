      <data key="d2">chunk-12ceb4368e146509caa737d9534ce3c2</data>
    </node>
    <node id="&quot;BENZYL GROUPS&quot;">
      <data key="d0">"FUNCTIONAL GROUP"</data>
      <data key="d1">"Benzyl groups are functional groups detected in positive controls but not significantly in worm frass samples."</data>
      <data key="d2">chunk-12ceb4368e146509caa737d9534ce3c2</data>
    </node>
    <node id="&quot;HEPTACOSANE&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"Heptacosane is a short-chain alkene semiochemical detected in GC-MS analysis, potentially promoting plant growth."&lt;SEP&gt;"Heptacosane is a short-chain alkene semiochemical detected in superworm frass that may promote plant growth."</data>
      <data key="d2">chunk-44565f26e7290c5eb0f26935608a5f16&lt;SEP&gt;chunk-078b6698be699eb7105b7cffadf709af</data>
    </node>
