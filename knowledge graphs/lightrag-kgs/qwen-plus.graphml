      <data key="d2">chunk-cb1740bb657b0f90c48ee5e6d75945ce</data>
    </node>
    <node id="&quot;METHANOL (HPLC GRADE)&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"A solvent used for cleaning equipment to ensure no background micro- or nanoplastics remain."</data>
      <data key="d2">chunk-cb1740bb657b0f90c48ee5e6d75945ce</data>
    </node>
    <node id="&quot;ALUMINUM FOIL&quot;">
