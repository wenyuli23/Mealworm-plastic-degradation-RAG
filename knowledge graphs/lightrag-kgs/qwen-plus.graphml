      <data key="d2">chunk-b759b81206d0e33e320f2d61e540ae47</data>
    </node>
    <node id="&quot;SYNERGISTIC PP DEGRADATION&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Synergistic PP degradation involves multiple biological functions working together to efficiently break down polypropylene."</data>
      <data key="d2">chunk-b759b81206d0e33e320f2d61e540ae47</data>
    </node>
    <node id="&quot;OMICS ANALYSIS&quot;">
