      <data key="d2">chunk-0014171c7ef07a60c6be3b57e791688c</data>
    </node>
    <node id="&quot;PU SPONGE&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"A flexible polyurethane foam tested for its consumption and degradation by larvae."</data>
      <data key="d2">chunk-0014171c7ef07a60c6be3b57e791688c</data>
    </node>
    <node id="&quot;BIODEGRADATION CAPACITY&quot;">
