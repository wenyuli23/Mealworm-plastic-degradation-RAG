      <data key="d2">chunk-bc744f6fa5a9ea876a0423d37eedfc87</data>
    </node>
    <node id="&quot;QIIME&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"QIIME (Quantitative Insights Into Microbial Ecology) is a software platform used for analyzing microbial community data."&lt;SEP&gt;"QIIME is a software package that allows for the analysis of high-throughput microbial community sequencing data."&lt;SEP&gt;"QIIME is a software platform used for analyzing high-throughput community sequencing data related to microbial communities."&lt;SEP&gt;"QIIME is a software package used for analyzing microbial community data, including alpha and beta diversity."&lt;SEP&gt;"Software platform used for performing OTU-level alpha diversity analysis and microbial community composition analysis."</data>
      <data key="d2">chunk-d7f79551ab9793788cd662ab66bca5ed&lt;SEP&gt;chunk-bc744f6fa5a9ea876a0423d37eedfc87&lt;SEP&gt;chunk-c6f28f1c36076d1f249dbc4cd67b16f1&lt;SEP&gt;chunk-41af774fc28352c7dd95d8c3cb43f855&lt;SEP&gt;chunk-d76cb64e0aa4e4039b70799a0df8943d</data>
    </node>
