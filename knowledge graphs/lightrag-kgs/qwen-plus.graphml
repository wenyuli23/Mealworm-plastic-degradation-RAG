      <data key="d2">chunk-1d39fc863538a777920c4eafb37bcf8a</data>
    </node>
    <node id="&quot;STYROFOAM (PS)&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Styrofoam, also known as PS, is a type of plastic used as feedstock for larvae in experiments."</data>
      <data key="d2">chunk-c84ac252cb9ce906354bda2ad1113aba</data>
    </node>
    <node id="&quot;CORN STRAW (CS)&quot;">
      <data key="d0">"PRODUCT"</data>
