      <data key="d2">chunk-3e34d58a20a707b35e8fcd5658ba2924</data>
    </node>
    <node id="&quot;MOLECULAR MECHANISMS&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"The underlying processes involved in the biodegradation of plastics by gut microorganisms."</data>
      <data key="d2">chunk-3e34d58a20a707b35e8fcd5658ba2924</data>
    </node>
    <node id="&quot;COCULTURES&quot;">
      <data key="d0">"ECOLOGICAL CONCEPT"</data>
