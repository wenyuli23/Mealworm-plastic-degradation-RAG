      <data key="d2">chunk-d1498160e7767dd16008724d09b2ac64</data>
      <data key="d1">"SINOPEC manufactures the Styrofoam used in the experiments."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;CARBON CONTENT&quot;">
