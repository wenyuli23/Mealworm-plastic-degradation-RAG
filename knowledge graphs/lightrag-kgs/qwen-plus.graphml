      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Cyclic poly(ethylene terephthalate) trimers are intermediate products formed during the degradation of PET plastics."</data>
      <data key="d2">chunk-81610bdb5fdb95d9a333b42668532b9f</data>
    </node>
    <node id="&quot;GUT MICROBIAL COMMUNITIES&quot;">
      <data key="d0">"MICROBIAL COMMUNITY"</data>
      <data key="d1">"Gut microbial communities consist of microorganisms residing in the digestive tract, playing roles in digestion and degradation processes."</data>
      <data key="d2">chunk-81610bdb5fdb95d9a333b42668532b9f</data>
    </node>
    <node id="&quot;INDIANMEAL MOTH LARVAE&quot;">
      <data key="d0">"MICROORGANISMS"</data>
