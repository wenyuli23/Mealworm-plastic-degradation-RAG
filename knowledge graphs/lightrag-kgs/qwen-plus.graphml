      <data key="d2">chunk-a7cbc8be34e0de8aebc6fd547bacc627</data>
    </node>
    <node id="&quot;DERIVATIVE PRODUCTION&quot;">
      <data key="d0">"METABOLIC MEASURE"</data>
      <data key="d1">"Derivative production refers to the formation of new compounds as a result of polystyrene biodegradation."</data>
      <data key="d2">chunk-a7cbc8be34e0de8aebc6fd547bacc627</data>
    </node>
    <node id="&quot;GENE EXPRESSION PATTERNS&quot;">
