      <data key="d1">"\(\beta\)-Galactosidase was among the most active enzymes and did not show significant differences across experimental variants."&lt;SEP&gt;"\(\beta\)-galactosidase is one of the most active enzymes studied, involved in carbohydrate metabolism."</data>
      <data key="d2">chunk-2aeb4d96b02258056c16688ea13a9e90&lt;SEP&gt;chunk-b1c9087e78bc6ba94c2b63fd88d2ca66</data>
    </node>
