      <data key="d0">"HORMONE"</data>
      <data key="d1">"This hormone regulates molting and metamorphosis in insects, potentially disrupted by nutrient deficiencies."</data>
      <data key="d2">chunk-84558838faaf585c61e883356c52c0e0</data>
    </node>
    <node id="&quot;MOLTING HORMONE&quot;">
      <data key="d0">"HORMONE"</data>
      <data key="d1">"Molting hormone controls the shedding of exoskeleton during insect development, possibly affected by microplastics."</data>
      <data key="d2">chunk-84558838faaf585c61e883356c52c0e0</data>
    </node>
