    <node id="&quot;ENTEROBACTER HORMAECHEI LG3&quot;">
      <data key="d0">"BACTERIUM"</data>
      <data key="d1">"Enterobacter hormaechei LG3 exhibits PS degradation activity under both aerobic and anaerobic conditions, showing physiological changes such as biofilm formation."&lt;SEP&gt;"Enterobacter hormaechei LG3 is a facultative anaerobic bacterial strain isolated from the gut of mealworms, capable of biodegrading polystyrene under anaerobic conditions."</data>
      <data key="d2">chunk-eafea2357c59ac6712f4d9ab41ac5d14&lt;SEP&gt;chunk-a7cbc8be34e0de8aebc6fd547bacc627</data>
