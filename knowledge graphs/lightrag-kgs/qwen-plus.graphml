      <data key="d0">"BACTERIUM"</data>
      <data key="d1">"Pseudomonas sp. Strain Y2 possesses a styrene catabolic cluster enabling the degradation of styrene."</data>
      <data key="d2">chunk-37f447b9d6a8b38f80be0854c9c294af</data>
    </node>
