    <node id="&quot;EUROPEAN FOOD SAFETY AUTHORITY (EFSA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"EFSA is responsible for ensuring food safety across Europe through scientific advice and risk assessment."&lt;SEP&gt;"The European Food Safety Authority is a scientific body responsible for assessing food safety risks in the European Union, validating mealworms as edible insects."</data>
      <data key="d2">chunk-302543e7a2fdb3596cc8a10e7072ec01&lt;SEP&gt;chunk-56f83fc7c1ea25f2ead74aceccfe4cf2</data>
    </node>
    <node id="&quot;FOOD AND AGRICULTURE ORGANIZATION (FAO)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Food and Agriculture Organization of the United Nations promotes food security and sustainable agricultural practices globally."&lt;SEP&gt;"The Food and Agriculture Organization provides nutritional recommendations regarding fatty acid ratios for human health."</data>
      <data key="d2">chunk-a660790845c6a68ed38b428a7756fc84&lt;SEP&gt;chunk-302543e7a2fdb3596cc8a10e7072ec01</data>
    </node>
    <node id="&quot;SPRAGUE DAWLEY (SD) RATS&quot;">
      <data key="d0">"GENUS"</data>
      <data key="d1">"Sprague Dawley rats are used in toxicity studies due to their well-characterized physiological responses."&lt;SEP&gt;"Sprague Dawley rats were used in experiments to assess the safety of Tenebrio molitor L. powder as food."</data>
      <data key="d2">chunk-302543e7a2fdb3596cc8a10e7072ec01&lt;SEP&gt;chunk-2934b88523093a8bba74cc29a0c775e3</data>
    </node>
    <node id="&quot;ESTROGEN RESPONSE&quot;">
      <data key="d0">"BIOLOGICAL RESPONSE"</data>
      <data key="d1">"Estrogen response involves the activation of estrogen receptors, investigated in this study to evaluate potential hormonal effects of Tenebrio molitor larval powder."</data>
      <data key="d2">chunk-302543e7a2fdb3596cc8a10e7072ec01</data>
    </node>
    <node id="&quot;HEMATOXYLIN AND EOSIN STAINING&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Hematoxylin and eosin staining is a histological technique used to visualize tissue structures under a microscope during toxicological assessments."</data>
      <data key="d2">chunk-302543e7a2fdb3596cc8a10e7072ec01</data>
    </node>
    <node id="&quot;CLINICAL SIGNS&quot;">
      <data key="d0">"HEALTH MEASURE"</data>
      <data key="d1">"Clinical signs include observable symptoms or behaviors indicating health status, monitored in Sprague-Dawley rats during the study."</data>
      <data key="d2">chunk-302543e7a2fdb3596cc8a10e7072ec01</data>
    </node>
    <node id="&quot;FOOD CONSUMPTION&quot;">
      <data key="d0">"PHYSIOLOGICAL RESPONSE"</data>
      <data key="d1">"Food consumption measures the intake of food by experimental animals, assessed to evaluate the impact of Tenebrio molitor larval powder on appetite and metabolism."&lt;SEP&gt;"Food consumption represents the amount of feed consumed by experimental animals, monitored to evaluate dietary intake and health status."</data>
      <data key="d2">chunk-302543e7a2fdb3596cc8a10e7072ec01&lt;SEP&gt;chunk-bae14ee5ac26fe661b539bccaa825fb4</data>
    </node>
    <node id="&quot;BODY AND ORGAN WEIGHTS&quot;">
      <data key="d0">"PHYSICAL CHARACTERISTIC"</data>
      <data key="d1">"Body and organ weights are physical characteristics measured in toxicological studies to assess growth and organ health."</data>
      <data key="d2">chunk-302543e7a2fdb3596cc8a10e7072ec01</data>
    </node>
    <node id="&quot;LIVER&quot;">
      <data key="d0">"ORGAN"</data>
      <data key="d1">"An organ analyzed for weight changes to assess the effects of TMlp administration."&lt;SEP&gt;"The liver is an organ examined for potential toxicity effects from W/ eps TMlp administration using H\&amp;E staining."&lt;SEP&gt;"The liver is an organ whose absolute and relative weights were measured in rats as part of the study."&lt;SEP&gt;"The liver plays a critical role in metabolism and detoxification processes, evaluated in this study through histological examination."&lt;SEP&gt;"The liver was examined through H&amp;E staining and showed no histopathological abnormalities."</data>
      <data key="d2">chunk-9e88a3caade44f7fbc493dfc1c3ca8f0&lt;SEP&gt;chunk-302543e7a2fdb3596cc8a10e7072ec01&lt;SEP&gt;chunk-fb1c38c1c6dc6fea84d8f51b9f706cd2&lt;SEP&gt;chunk-4c1e1694d44433fcf53dc8120c479ca4&lt;SEP&gt;chunk-81a3bc3c202af119c80775d5bf23d8b2</data>
    </node>
    <node id="&quot;KIDNEY&quot;">
      <data key="d0">"ORGAN"</data>
      <data key="d1">"An organ analyzed for weight changes to assess the effects of TMlp administration."&lt;SEP&gt;"The kidney is an organ whose absolute and relative weights were measured in rats as part of the study."&lt;SEP&gt;"The kidney is essential for waste excretion and maintaining water balance, examined histologically in this study for signs of toxicity."</data>
      <data key="d2">chunk-9e88a3caade44f7fbc493dfc1c3ca8f0&lt;SEP&gt;chunk-302543e7a2fdb3596cc8a10e7072ec01&lt;SEP&gt;chunk-fb1c38c1c6dc6fea84d8f51b9f706cd2</data>
    </node>
    <node id="&quot;THREONINE&quot;">
      <data key="d0">"AMINO ACID"</data>
      <data key="d1">"Threonine is an essential amino acid found abundantly in the given context, contributing to nutritional value."</data>
      <data key="d2">chunk-2934b88523093a8bba74cc29a0c775e3</data>
    </node>
    <node id="&quot;VALINE&quot;">
      <data key="d0">"AMINO ACID"</data>
      <data key="d1">"Valine is an essential amino acid mentioned as being abundant, contributing to protein quality and nutrition."</data>
      <data key="d2">chunk-2934b88523093a8bba74cc29a0c775e3</data>
    </node>
    <node id="&quot;HISTIDINE&quot;">
      <data key="d0">"AMINO ACID"</data>
      <data key="d1">"Histidine is an essential amino acid highlighted for its presence, playing a role in metabolic processes."</data>
      <data key="d2">chunk-2934b88523093a8bba74cc29a0c775e3</data>
    </node>
    <node id="&quot;LYSINE&quot;">
      <data key="d0">"AMINO ACID"</data>
      <data key="d1">"Lysine is an essential amino acid noted for its abundance, important for protein synthesis."</data>
      <data key="d2">chunk-2934b88523093a8bba74cc29a0c775e3</data>
    </node>
    <node id="&quot;CALCIUM&quot;">
      <data key="d0">"NUTRIENT"</data>
      <data key="d1">"A cation determined and quantified using commercial standards."&lt;SEP&gt;"Calcium is a cation measured in frass from Tenebrio molitor, involved in biochemical processes."&lt;SEP&gt;"Calcium is a mineral essential for bone health and various physiological functions."&lt;SEP&gt;"Calcium is a mineral necessary for the growth and development of waxworm larvae."&lt;SEP&gt;"Calcium is an essential mineral required for the growth and development of lesser waxworms."</data>
      <data key="d2">chunk-92b1e432ea4bee0f332d7303188e6de7&lt;SEP&gt;chunk-ab6b219720db5a6e3384c884c280984c&lt;SEP&gt;chunk-2934b88523093a8bba74cc29a0c775e3&lt;SEP&gt;chunk-5922f60fcd06ac6ffa27018026871346&lt;SEP&gt;chunk-b25215becbc007a60f24b86a2d6aaf26</data>
    </node>
    <node id="&quot;MAGNESIUM&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"A cation determined and quantified using commercial standards."&lt;SEP&gt;"Magnesium is a cation measured in frass from Tenebrio molitor, involved in biochemical processes."&lt;SEP&gt;"Magnesium is a mineral crucial for enzyme function and overall health."</data>
      <data key="d2">chunk-92b1e432ea4bee0f332d7303188e6de7&lt;SEP&gt;chunk-5922f60fcd06ac6ffa27018026871346&lt;SEP&gt;chunk-2934b88523093a8bba74cc29a0c775e3</data>
    </node>
    <node id="&quot;TENEBRIO MOLITOR L.&quot;">
      <data key="d0">"GENUS"</data>
      <data key="d1">"Tenebrio molitor L. is a species of beetle whose larvae, known as mealworms, have been found to degrade plastic waste."&lt;SEP&gt;"Tenebrio molitor L. is a species of mealworms studied for its ability to degrade plastic and perform nitrogen fixation."&lt;SEP&gt;"Tenebrio molitor L. is a specific strain of mealworm beetle, often studied for its ecological and biological responses."&lt;SEP&gt;"Tenebrio molitor L. is the species of mealworm studied for its ability to biodegrade EPS."&lt;SEP&gt;"Tenebrio molitor L., also known as yellow mealworm, is used for preparing TMlp powder."&lt;SEP&gt;"Tenebrio molitor L., commonly known as mealworms, are used as a dietary supplement in animal feed without adverse effects on growth performance."&lt;SEP&gt;"Tenebrio molitor L., commonly known as yellow mealworm, is a protein-rich edible insect with great nutritional value. It contains abundant essential amino acids, minerals, and unsaturated fatty acids."&lt;SEP&gt;"Tenebrio molitor L., commonly known as yellow mealworm, is used for biodegradation of polystyrene and serves as a protein source in animal feed."&lt;SEP&gt;"This beetle's growth rate and development depend on environmental moisture conditions."&lt;SEP&gt;"Tenebrio molitor L., commonly known as mealworms, was studied for the effects of microplastics on its feeding and metabolism."&lt;SEP&gt;"Tenebrio molitor L., also known as yellow mealworms, consume PVC and facilitate its degradation through their gut microbiota."&lt;SEP&gt;"Tenebrio molitor L., commonly known as mealworms, harbor gut microbiota capable of nitrogen fixation and plastic degradation."&lt;SEP&gt;"Tenebrio molitor L., commonly known as mealworms, are insects whose gut microbiota contribute significantly to plastic degradation."&lt;SEP&gt;"Tenebrio molitor L., also known as yellow mealworm, is considered as a potential source of animal protein for humans in bioregenerative life support systems."</data>
      <data key="d2">chunk-81a3bc3c202af119c80775d5bf23d8b2&lt;SEP&gt;chunk-2934b88523093a8bba74cc29a0c775e3&lt;SEP&gt;chunk-b5cbd81fc528c18f42514a2a74d4921e&lt;SEP&gt;chunk-81610bdb5fdb95d9a333b42668532b9f&lt;SEP&gt;chunk-20a69982e6abe36c2a0d4a70b78720ec&lt;SEP&gt;chunk-9424d3ce58d3ff2e0adc795d24fe84f4&lt;SEP&gt;chunk-813b71242f366f10218c10631cd7dee8&lt;SEP&gt;chunk-5d8f385513fcff2125529486530ad5a7&lt;SEP&gt;chunk-5911f995d46a77458be83382b8c67f9b&lt;SEP&gt;chunk-bae14ee5ac26fe661b539bccaa825fb4&lt;SEP&gt;chunk-4c1e1694d44433fcf53dc8120c479ca4&lt;SEP&gt;chunk-bf8041a3cdcd6091f6c96b8b67229df2&lt;SEP&gt;chunk-c038f908eb10a4a5715fb9cff3e05527&lt;SEP&gt;chunk-9a81144d30653377d6d90e26c4497eb0</data>
    </node>
    <node id="&quot;DIOXINS&quot;">
      <data key="d0">"TOXIN"</data>
      <data key="d1">"Dioxins are toxic byproducts produced during the traditional disposal of EPS."&lt;SEP&gt;"Dioxins are toxic compounds generated during thermal decomposition processes of plastics, posing environmental and health risks."&lt;SEP&gt;"Dioxins are toxic substances produced during the incineration of polystyrene, posing health risks."</data>
      <data key="d2">chunk-2934b88523093a8bba74cc29a0c775e3&lt;SEP&gt;chunk-c1d76ad321e1c68d5f139cdb94d5bf42&lt;SEP&gt;chunk-2a54f7d9e0a43fb94e2fc35f93656fc9</data>
    </node>
    <node id="&quot;ESTROGEN&quot;">
      <data key="d0">"HORMONE"</data>
      <data key="d1">"Estrogen is a female hormone whose activity can be mimicked by endocrine-disrupting chemicals released from plastics."</data>
      <data key="d2">chunk-2934b88523093a8bba74cc29a0c775e3</data>
    </node>
    <node id="&quot;ZOPHOBAS MORIO L.&quot;">
      <data key="d0">"BACTERIUM"</data>
      <data key="d1">"Zophobas morio L., or superworm larvae, is utilized for environmentally friendly degradation of plastics."</data>
      <data key="d2">chunk-2934b88523093a8bba74cc29a0c775e3</data>
    </node>
    <node id="&quot;TENEBRIO OBSCURUS L.&quot;">
      <data key="d0">"BACTERIUM"</data>
      <data key="d1">"Tenebrio obscurus L., or dark mealworm larvae, contributes to biodegradation efforts alongside related species."</data>
      <data key="d2">chunk-2934b88523093a8bba74cc29a0c775e3</data>
    </node>
    <node id="&quot;MEALWORM FRASS&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Mealworm Frass is the waste material produced by mealworms, often used as organic fertilizer in agriculture."&lt;SEP&gt;"Mealworm frass can be used as fertilizer impacting crop growth and soil properties."&lt;SEP&gt;"Mealworm frass provides less support for plant growth compared to superworm frass, possibly due to its poorer moisture retention."&lt;SEP&gt;"Mealworm frass refers to insect excrement containing low-molecular-weight residues and functional groups indicative of oxidative transformation."&lt;SEP&gt;"Mealworm frass refers to the waste material produced by mealworms, which can be used as fertilizer."&lt;SEP&gt;"Mealworm frass refers to the excrement of mealworms, which contains residual PS material."&lt;SEP&gt;"Waste material produced by mealworms after ingesting polymers, used for analyzing biodegradation products."</data>
      <data key="d2">chunk-457d054c08a16428ed81526fc2ddce41&lt;SEP&gt;chunk-1d40b7debb6497167fa1aec874ebce45&lt;SEP&gt;chunk-2934b88523093a8bba74cc29a0c775e3&lt;SEP&gt;chunk-3d6c72a17160a2bc126220798c799a6b&lt;SEP&gt;chunk-078b6698be699eb7105b7cffadf709af&lt;SEP&gt;chunk-2c3165b5b483903ac54f813f43b4076d&lt;SEP&gt;chunk-b04ae62930e9961f964284418f1848b3</data>
    </node>
    <node id="&quot;MCF-7&quot;">
      <data key="d0">"CELL"</data>
      <data key="d1">"MCF-7 cells are a human breast cancer cell line often used in research to study estrogen receptor activity."&lt;SEP&gt;"MCF-7 is a breast cancer cell line used in experiments for toxicological evaluations."&lt;SEP&gt;"MCF-7 is a breast cancer cell line used in the experiment for culturing and studying cell viability."</data>
      <data key="d2">chunk-7e755eeac14110dcfdcfc32e51f30b89&lt;SEP&gt;chunk-2934b88523093a8bba74cc29a0c775e3&lt;SEP&gt;chunk-5911f995d46a77458be83382b8c67f9b</data>
    </node>
    <node id="&quot;RPMI 1640&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"RPMI 1640 is a cell culture medium used for growing MCF-7 cells in laboratory settings."&lt;SEP&gt;"RPMI 1640 is a cell culture medium used for growing MCF-7 cells, provided by Welgene."</data>
      <data key="d2">chunk-2934b88523093a8bba74cc29a0c775e3&lt;SEP&gt;chunk-5911f995d46a77458be83382b8c67f9b</data>
    </node>
    <node id="&quot;MONOGASTRIC ANIMALS&quot;">
      <data key="d0">"CLASS"</data>
      <data key="d1">"Monogastric animals, such as poultry and pigs, benefit from Tenebrio molitor L. as a protein source in their feed."</data>
      <data key="d2">chunk-2934b88523093a8bba74cc29a0c775e3</data>
    </node>
    <node id="&quot;ENDOCRINE-DISRUPTING CHEMICALS&quot;">
      <data key="d0">"TOXIN"</data>
      <data key="d1">"Endocrine-disrupting chemicals interfere with hormone systems, causing developmental, reproductive, neurological, and immune effects."&lt;SEP&gt;"These chemicals released from plastics mimic hormones like estrogen and disrupt biological processes."</data>
      <data key="d2">chunk-65434948dabde813d99972f40a04d8de&lt;SEP&gt;chunk-2934b88523093a8bba74cc29a0c775e3</data>
    </node>
    <node id="&quot;IN VITRO TOXICOLOGICAL SAFETY EVALUATION&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"In vitro evaluation involves testing substances in a controlled laboratory environment to assess toxicity."</data>
      <data key="d2">chunk-2934b88523093a8bba74cc29a0c775e3</data>
    </node>
    <node id="&quot;IN VIVO TOXICOLOGICAL SAFETY EVALUATION&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"In vivo evaluation involves testing substances within living organisms to assess safety and toxicity."</data>
      <data key="d2">chunk-2934b88523093a8bba74cc29a0c775e3</data>
    </node>
