      <data key="d2">chunk-a7cbc8be34e0de8aebc6fd547bacc627</data>
    </node>
    <node id="&quot;EXIGUOBACTERIUM YT2&quot;">
      <data key="d0">"BACTERIUM"</data>
      <data key="d1">"Exiguobacterium YT2 is a bacterium previously isolated for its ability to degrade polystyrene under aerobic conditions."</data>
      <data key="d2">chunk-a7cbc8be34e0de8aebc6fd547bacc627</data>
    </node>
    <node id="&quot;PSEUDOMONAS STRAIN DSM 50071&quot;">
      <data key="d0">"BACTERIUM"</data>
