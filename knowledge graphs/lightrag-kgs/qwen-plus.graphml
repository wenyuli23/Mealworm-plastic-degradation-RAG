      <data key="d2">chunk-c9578db0f9ed0398705827be5d4ee450&lt;SEP&gt;chunk-92ea4ca7a83af5c086ae157fb801b326</data>
    </node>
    <node id="&quot;VORTEX&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Mechanical agitation process used to mix gut tissue with saline solution."&lt;SEP&gt;"Vortex refers to the process of vibrating gut tissue to separate it from the suspension."&lt;SEP&gt;"Vortexing is a process used to mix and suspend bacterial cells in solution."</data>
      <data key="d2">chunk-e81a4fde1bdef8287df342fc27193de6&lt;SEP&gt;chunk-2c6dfb08bb454e8ff642e7975ba7af10&lt;SEP&gt;chunk-92ea4ca7a83af5c086ae157fb801b326</data>
    </node>
    <node id="&quot;PUPARIATION RATE (PR)&quot;">
      <data key="d0">"LIFE STAGE"</data>
      <data key="d1">"Pupariation rate measures the percentage of larvae transitioning to the pupal stage."</data>
      <data key="d2">chunk-92ea4ca7a83af5c086ae157fb801b326</data>
    </node>
