      <data key="d2">chunk-db672d5836dfe372ee7c47ee4dd6fbd3</data>
    </node>
    <node id="&quot;DIMETHYL SULFOXIDE (DMSO)&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"DMSO is a solvent used to dissolve formazan crystals in the MTT assay."&lt;SEP&gt;"Dimethyl sulfoxide is a solvent used to dissolve formazan crystals in the assay process."</data>
      <data key="d2">chunk-6cbb8ccec16f4756fa7a1fb365886d9c&lt;SEP&gt;chunk-db672d5836dfe372ee7c47ee4dd6fbd3</data>
