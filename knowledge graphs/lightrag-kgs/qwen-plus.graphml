      <data key="d1">"Niche width describes the range of resources or conditions that an organism can utilize, reflecting its adaptability."</data>
      <data key="d2">chunk-6ac1b1db6ffab6f4cfea7a525785a2fc</data>
    </node>
    <node id="&quot;FUNCTIONAL REDUNDANCY&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
