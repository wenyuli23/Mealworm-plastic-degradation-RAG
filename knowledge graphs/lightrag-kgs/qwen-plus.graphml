      <data key="d2">chunk-b759b81206d0e33e320f2d61e540ae47</data>
    </node>
    <node id="&quot;\(\DELTA \DELTA^{13} \MATHRM{C}\)&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"The change in carbon isotope ratio (\(\Delta \delta^{13} \mathrm{C}\)) measures the effectiveness of biodegradation."</data>
      <data key="d2">chunk-b759b81206d0e33e320f2d61e540ae47</data>
    </node>
    <node id="&quot;SIGNAL TRANSDUCTION FUNCTIONS&quot;">
