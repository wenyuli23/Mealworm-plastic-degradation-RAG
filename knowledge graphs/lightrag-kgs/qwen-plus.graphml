      <data key="d1">"Endotoxins are toxic substances released by certain bacteria, potentially affecting the health of the host."</data>
      <data key="d2">chunk-eafea2357c59ac6712f4d9ab41ac5d14</data>
    </node>
    <node id="&quot;WHOLE GENOME AND TRANSCRIPTOMES SEQUENCING&quot;">
      <data key="d0">"PROCESS"</data>
