    <node id="&quot;POUR PLATE METHOD&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"The pour plate method involves pouring molten agar containing inoculum onto a petri dish to create colonies."&lt;SEP&gt;"This method is used to culture homogenized gut suspensions on agar media."</data>
      <data key="d2">chunk-d3235cc6102d988875f1dda974a56038</data>
    </node>
    <node id="&quot;PRIMARY SCREENING&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Primary screening identifies NPS-degrading bacteria based on clear zone formation."</data>
      <data key="d2">chunk-d3235cc6102d988875f1dda974a56038</data>
    </node>
    <node id="&quot;STANDARD PLATE COUNT&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Plate count assay determines viable bacterial cell numbers in samples."&lt;SEP&gt;"The standard plate count is a method used to estimate the number of viable bacterial cells in a sample."</data>
      <data key="d2">chunk-d3235cc6102d988875f1dda974a56038</data>
    </node>
    <node id="&quot;TURBIDITY ASSAY&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"The turbidity assay measures the reduction in cloudiness caused by bacterial degradation of Nano-polystyrene."&lt;SEP&gt;"Turbidity measurement differentiates bacterial growth from NPS-induced cloudiness."</data>
      <data key="d2">chunk-d3235cc6102d988875f1dda974a56038&lt;SEP&gt;chunk-01bf9080cbf55e62c0b26d0e054bd1fa</data>
    </node>
