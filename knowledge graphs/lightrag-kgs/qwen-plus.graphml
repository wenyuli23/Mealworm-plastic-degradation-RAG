      <data key="d0">"METABOLIC MEASURE"</data>
      <data key="d1">"Mn value represents the number-average molecular weight of polymers in frass produced by mealworms."</data>
      <data key="d2">chunk-236f4db8df75799fa6a0a07921158cf0</data>
    </node>
    <node id="&quot;MW VALUE&quot;">
