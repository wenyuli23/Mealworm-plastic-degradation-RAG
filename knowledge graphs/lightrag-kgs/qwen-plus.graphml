    <node id="&quot;DEBARYOMYCES&quot;">
      <data key="d0">"GENUS"</data>
      <data key="d1">"Debaryomyces is a fungal genus predominant in bran-fed yellow mealworms."&lt;SEP&gt;"Debaryomyces is a fungal genus that was predominant in the guts of bran-fed superworms and yellow mealworms but decreased or disappeared in plastic-fed groups."&lt;SEP&gt;"Debaryomyces is a genus of fungi predominant in bran-fed superworms and yellow mealworms."</data>
      <data key="d2">chunk-dbb6f13dbe3de759712fa3a0c9780470&lt;SEP&gt;chunk-7a91a3c11281861b559c31c3107c72e7&lt;SEP&gt;chunk-93d5b1c190fdca6b5e456b1513515be4</data>
    </node>
