      <data key="d2">chunk-d5238515b2316265fb5cb6c6295c54e8</data>
    </node>
    <node id="&quot;TEREPHTHALIC ACID&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"A metabolite produced during PET degradation, metabolized into protocatechuic acid by dioxygenase."&lt;SEP&gt;"Terephthalic acid is a compound produced during the hydrolysis of PET plastics by certain enzymes."&lt;SEP&gt;"Terephthalic acid is a product of PET hydrolysis and is further metabolized into protocatechuic acid."</data>
      <data key="d2">chunk-b19ac5bdc755bb8e9deb8e317ce365dd&lt;SEP&gt;chunk-d5238515b2316265fb5cb6c6295c54e8&lt;SEP&gt;chunk-81610bdb5fdb95d9a333b42668532b9f</data>
    </node>
    <node id="&quot;ETHYLENE GLYCOL (EG)&quot;">
      <data key="d0">"METABOLITE"</data>
