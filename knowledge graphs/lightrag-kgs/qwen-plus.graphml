      <data key="d2">chunk-3815960770483b9c0a1579ca8442e3a6</data>
    </node>
    <node id="&quot;2-ETHYLPHENOL&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"A product of anaerobic degradation pathways involving hydroxylation and reduction of styrene."</data>
      <data key="d2">chunk-3815960770483b9c0a1579ca8442e3a6</data>
    </node>
    <node id="&quot;2-HYDROXYPHENYLACETIC ACID&quot;">
      <data key="d0">"METABOLITE"</data>
