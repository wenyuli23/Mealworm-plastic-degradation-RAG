      <data key="d2">chunk-cb1740bb657b0f90c48ee5e6d75945ce</data>
    </node>
    <node id="&quot;MILLI-Q ULTRAPURE WATER&quot;">
      <data key="d0">"CHEMICAL COMPOUND"</data>
      <data key="d1">"High-purity water used for cleaning equipment to prevent contamination."&lt;SEP&gt;"High-purity water used for rinsing equipment to prevent contamination with micro- or nanoplastics."&lt;SEP&gt;"Milli-Q ultrapure water was used to rinse containers and remove potential microplastic backgrounds."</data>
      <data key="d2">chunk-cb1740bb657b0f90c48ee5e6d75945ce&lt;SEP&gt;chunk-9a27dff473ed210517e6461ad3e5d783</data>
    </node>
    <node id="&quot;BIODEGRADATION RATE CONSTANT (K₁)&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"A parameter in the digestive biofragmentation model representing the rate at which plastics are biodegraded."</data>
      <data key="d2">chunk-cb1740bb657b0f90c48ee5e6d75945ce</data>
    </node>
    <node id="&quot;GRINDING RATE CONSTANT (K₂)&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"A parameter in the digestive biofragmentation model representing the rate at which plastics are mechanically ground down."</data>
      <data key="d2">chunk-cb1740bb657b0f90c48ee5e6d75945ce</data>
    </node>
    <node id="&quot;INSTANT SPECIFIC SURFACE AREA (Aᵢ)&quot;">
      <data key="d0">"PHYSICAL PROPERTY"</data>
      <data key="d1">"The specific surface area of plastic particles at a given time, inversely proportional to particle diameter."</data>
      <data key="d2">chunk-cb1740bb657b0f90c48ee5e6d75945ce</data>
    </node>
    <node id="&quot;PARTICLE DIAMETER (Rᵢ)&quot;">
      <data key="d0">"PHYSICAL PROPERTY"</data>
      <data key="d1">"The diameter of plastic particles, used to calculate their specific surface area."</data>
      <data key="d2">chunk-cb1740bb657b0f90c48ee5e6d75945ce</data>
    </node>
    <node id="&quot;CORRECTION COEFFICIENTS (Α, Β)&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"Coefficients used to adjust the influence of specific surface area on biodegradation and grinding rates."</data>
      <data key="d2">chunk-cb1740bb657b0f90c48ee5e6d75945ce</data>
    </node>
    <node id="&quot;VOLUME REDUCTION RATE (\( \FRAC{DΓ_I}{DT} \))&quot;">
      <data key="d0">"BIOLOGICAL MEASURE"</data>
