      <data key="d1">"Intestinal symbiotic microbes are microorganisms living in symbiosis within the host's intestine, contributing to digestion and degradation processes."</data>
      <data key="d2">chunk-7734a37a076c4f934de059042daf10cf</data>
    </node>
