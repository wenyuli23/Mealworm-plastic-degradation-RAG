    <node id="&quot;DNA ANALYSIS&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"DNA analysis is used to study the gut microbes involved in the biodegradation process."</data>
      <data key="d2">chunk-7cbedc06292e5cf07fbca1958d8587e6</data>
    </node>
    <node id="&quot;EU REGULATION 2017/89&quot;">
      <data key="d0">"REGULATION"</data>
      <data key="d1">"EU Regulation 2017/89 authorizes the use of certain practices or products for cattle, farmed fish, and human consumption."</data>
      <data key="d2">chunk-7cbedc06292e5cf07fbca1958d8587e6</data>
    </node>
    <node id="&quot;DRIED TREE LEAVES&quot;">
      <data key="d0">"NUTRITIONAL COMPONENT"</data>
      <data key="d1">"Dried tree leaves are part of the diet for T. molitor and T. obscurus larvae."</data>
      <data key="d2">chunk-7cbedc06292e5cf07fbca1958d8587e6</data>
    </node>
    <node id="&quot;LIFE BEHAVIOR&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"Life behavior refers to the lifestyle and habits of organisms, such as dietary preferences and survival strategies."</data>
      <data key="d2">chunk-7cbedc06292e5cf07fbca1958d8587e6</data>
    </node>
    <node id="&quot;CO2 AND H2O&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"CO2 and H2O are the final products of the mineralization process during the biodegradation of plastics."</data>
      <data key="d2">chunk-7cbedc06292e5cf07fbca1958d8587e6</data>
    </node>
    <node id="&quot;SIZE-AVERAGE WEIGHT (MZ)&quot;">
      <data key="d0">"BIOCHEMICAL MEASURE"</data>
      <data key="d1">"Mz provides information about the size distribution of polymer chains during depolymerization."</data>
      <data key="d2">chunk-7cbedc06292e5cf07fbca1958d8587e6</data>
    </node>
    <node id="&quot;1,2,4-TRICHLOROBENZENE (1,2,4 TCB)&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"1,2,4 TCB is a solvent used to dissolve polymers for analysis in techniques like HT-GPC."</data>
      <data key="d2">chunk-7cbedc06292e5cf07fbca1958d8587e6</data>
    </node>
    <node id="&quot;\({ }^{1} \MATHRM{H}\) NMR&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Nuclear Magnetic Resonance spectroscopy technique used to analyze hydrogen atoms and detect oxidized functional groups in polymers."</data>
      <data key="d2">chunk-3e6ccf223c8c62d59ba994731f546ad9</data>
    </node>
    <node id="&quot;PE-1 AND PE-2 FOAMS&quot;">
      <data key="d0">"POLYMER"</data>
      <data key="d1">"Commercial polyethylene foam samples used as control LDPE materials in the study."</data>
      <data key="d2">chunk-3e6ccf223c8c62d59ba994731f546ad9</data>
    </node>
    <node id="&quot;SPECTRAL REGION&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"The range of wavelengths (400-4000 cm\({ }^{-1}\)) used in FTIR analysis to detect functional groups."</data>
      <data key="d2">chunk-3e6ccf223c8c62d59ba994731f546ad9</data>
    </node>
    <node id="&quot;RESOLUTION&quot;">
      <data key="d0">"PHYSICAL PROPERTY"</data>
      <data key="d1">"The precision level (0.6329 cm\({ }^{-1}\)) of FTIR scanning used to obtain detailed spectra of samples."</data>
      <data key="d2">chunk-3e6ccf223c8c62d59ba994731f546ad9</data>
    </node>
    <node id="&quot;SCANS&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"The number of times (minimum 16 scans) a sample is analyzed during FTIR spectroscopy to improve data accuracy."</data>
      <data key="d2">chunk-3e6ccf223c8c62d59ba994731f546ad9</data>
    </node>
    <node id="&quot;ABSORBANCE MODE&quot;">
      <data key="d0">"CHEMICAL PROPERTY"</data>
      <data key="d1">"A measurement mode in FTIR spectroscopy that quantifies how much infrared light is absorbed by a sample."</data>
      <data key="d2">chunk-3e6ccf223c8c62d59ba994731f546ad9</data>
    </node>
    <node id="&quot;MESTRENOVA SOFTWARE&quot;">
      <data key="d0">"SOFTWARE"</data>
      <data key="d1">"Software used for analyzing NMR spectra data."</data>
      <data key="d2">chunk-f3099f2d6fd3abc2f73550f579999b13</data>
    </node>
    <node id="&quot;TGA/SDTA851E&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Thermal analysis equipment used to analyze LDPE foams and residual polymer samples through thermogravimetric analysis."</data>
      <data key="d2">chunk-f3099f2d6fd3abc2f73550f579999b13</data>
    </node>
    <node id="&quot;CO2 TRAPPING SYSTEM&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"A multi-stage system used to trap and quantify carbon dioxide released during biodegradation."</data>
      <data key="d2">chunk-f3099f2d6fd3abc2f73550f579999b13</data>
    </node>
    <node id="&quot;CARBON MASS BALANCE ANALYSIS&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"A method to measure the carbon mass balance in ingested LDPE, assessing digestibility and carbon conversion rates."</data>
      <data key="d2">chunk-f3099f2d6fd3abc2f73550f579999b13</data>
    </node>
    <node id="&quot;2 M NAOH SOLUTION&quot;">
      <data key="d0">"CHEMICAL SOLUTION"</data>
      <data key="d1">"A solution used to trap released CO2 during carbon mass balance analysis."</data>
      <data key="d2">chunk-f3099f2d6fd3abc2f73550f579999b13</data>
    </node>
    <node id="&quot;CACO3 PRECIPITATE&quot;">
      <data key="d0">"CHEMICAL COMPOUND"</data>
      <data key="d1">"A compound formed by adding CaCl2 to the trapped CO2, used for carbon recovery."</data>
      <data key="d2">chunk-f3099f2d6fd3abc2f73550f579999b13</data>
    </node>
    <node id="&quot;OLIVE OIL-BASED METHOD&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"A method developed for extracting LDPE from frass samples."</data>
      <data key="d2">chunk-f3099f2d6fd3abc2f73550f579999b13</data>
    </node>
    <node id="&quot;INHIBITION HALO TEST&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"A method used to evaluate the effectiveness of antibiotics against bacteria."&lt;SEP&gt;"A test used to measure the effectiveness of antibiotics against gut bacteria."</data>
      <data key="d2">chunk-3ab754d1dc0a02ee3f869d2b082a710e&lt;SEP&gt;chunk-f3099f2d6fd3abc2f73550f579999b13</data>
    </node>
    <node id="&quot;CALCIUM CHLORIDE (CACL2)&quot;">
      <data key="d0">"CHEMICAL COMPOUND"</data>
      <data key="d1">"A reagent used to precipitate CaCO3 from trapped CO2 during carbon analysis."</data>
      <data key="d2">chunk-f3099f2d6fd3abc2f73550f579999b13</data>
    </node>
    <node id="&quot;STERILE SALINE WATER&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Water sterilized for use in diluting gut content samples."</data>
      <data key="d2">chunk-c6f28f1c36076d1f249dbc4cd67b16f1</data>
    </node>
    <node id="&quot;DNA EXTRACTION KITS&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Kits used for extracting total bacterial genomic DNA from larval guts."</data>
      <data key="d2">chunk-c6f28f1c36076d1f249dbc4cd67b16f1</data>
    </node>
    <node id="&quot;V3 — V4 REGION&quot;">
      <data key="d0">"GENE"</data>
      <data key="d1">"A specific region of the 16S rRNA gene sequenced for microbial community analysis."</data>
      <data key="d2">chunk-c6f28f1c36076d1f249dbc4cd67b16f1</data>
    </node>
    <node id="&quot;SR&quot;">
      <data key="d0">"METABOLIC MEASURE"</data>
      <data key="d1">"Survival rate (SR) refers to the percentage of larvae that survived during the feeding experiments, significantly higher for PE-fed larvae compared to unfed groups."</data>
      <data key="d2">chunk-639bb2429f20c4fe3994c4a0d15f3295</data>
    </node>
    <node id="&quot;SPCR-W&quot;">
      <data key="d0">"METABOLIC MEASURE"</data>
      <data key="d1">"Specific LDPE consumption rate on larval weight basis (SPCR-W) measures LDPE consumption relative to larval weight, showing much lower values for T. obscurus compared to T. molitor."</data>
      <data key="d2">chunk-639bb2429f20c4fe3994c4a0d15f3295</data>
    </node>
    <node id="&quot;GUT MICROBIAL CONSORTIA&quot;">
      <data key="d0">"MICROORGANISMS"</data>
      <data key="d1">"Gut microbial consortia are microorganisms present in the larval gut that play a critical role in the biodegradation of LDPE through enzymatic activity."</data>
      <data key="d2">chunk-639bb2429f20c4fe3994c4a0d15f3295</data>
    </node>
    <node id="&quot;HINDGUT&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"The hindgut is the final section of the insect's alimentary tract, responsible for waste processing and egestion."</data>
      <data key="d2">chunk-639bb2429f20c4fe3994c4a0d15f3295</data>
    </node>
    <node id="&quot;ALIMENTARY CANAL&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"The alimentary canal is the entire digestive tract of an organism, functioning as an efficient bioreactor for LDPE degradation in the larvae."</data>
      <data key="d2">chunk-639bb2429f20c4fe3994c4a0d15f3295</data>
    </node>
    <node id="&quot;EGESTION&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Egestion is the process of expelling undigested materials from the gut, observed as frass in this context."</data>
      <data key="d2">chunk-639bb2429f20c4fe3994c4a0d15f3295</data>
    </node>
    <node id="&quot;BODY WALL&quot;">
      <data key="d0">"PHYSICAL FEATURE"</data>
      <data key="d1">"The body wall of larvae may influence their eating habits and LDPE consumption rates."</data>
      <data key="d2">chunk-639bb2429f20c4fe3994c4a0d15f3295</data>
    </node>
    <node id="&quot;STRETCH RECEPTORS&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"Stretch receptors are sensory structures that detect stretching in the gut, potentially influencing feeding behavior in larvae."</data>
      <data key="d2">chunk-639bb2429f20c4fe3994c4a0d15f3295</data>
    </node>
    <node id="&quot;INSECT MOUTH FEEDERS&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"Insect mouth feeders refer to insects that consume food through chewing, impacting their LDPE ingestion and processing."</data>
      <data key="d2">chunk-639bb2429f20c4fe3994c4a0d15f3295</data>
    </node>
    <node id="&quot;LDPE POLYMERS&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Low-density polyethylene polymers that undergo partial digestion and egestion in the frass of larvae, indicating depolymerization and biodegradation."</data>
      <data key="d2">chunk-22d348f5320f96e129128362b6e0407c</data>
    </node>
    <node id="&quot;PRO-OXIDANT PRETREATMENT&quot;">
      <data key="d0">"CHEMICAL REACTION"</data>
      <data key="d1">"A thermo-oxidative pretreatment method used to reduce average molecular weight of polymers below 5.0 kDa for enhanced biodegradation."</data>
      <data key="d2">chunk-22d348f5320f96e129128362b6e0407c</data>
    </node>
    <node id="&quot;SMALL SIZED POLYMER (&lt;2.0 KDA)&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Polymer fragments with molecular weights less than 2.0 kDa, which are more easily decomposed and potentially metabolized by microorganisms."</data>
      <data key="d2">chunk-22d348f5320f96e129128362b6e0407c</data>
    </node>
    <node id="&quot;HIGHER MOLECULAR FRACTIONS (&gt;1000 KDA)&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Polymer fractions with molecular weights greater than 1000 kDa, which are reduced during the biodegradation process in larvae."</data>
      <data key="d2">chunk-22d348f5320f96e129128362b6e0407c</data>
    </node>
    <node id="&quot;THERMO-OXIDATIVE PE DEGRADATION&quot;">
      <data key="d0">"CHEMICAL REACTION"</data>
      <data key="d1">"A pretreatment method involving heat and oxidation to reduce the average molecular weight of polyethylene, enhancing its biodegradability."</data>
      <data key="d2">chunk-22d348f5320f96e129128362b6e0407c</data>
    </node>
    <node id="&quot;MICROBIAL CONTRIBUTION&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"The role of microorganisms in breaking down low molecular weight polymer fractions, contributing to rapid biodegradation."</data>
      <data key="d2">chunk-22d348f5320f96e129128362b6e0407c</data>
    </node>
    <node id="&quot;CARBON CONVERSION&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Carbon conversion describes how ingested carbon from LDPE is processed, with around 40% converted to \(\mathrm{CO}_2\) and some assimilated as biomass."</data>
      <data key="d2">chunk-b95a108327e39d37d20bdd99db541164</data>
    </node>
    <node id="&quot;GENTAMICIN TREATMENT&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Gentamicin treatment involves administering antibiotics to larvae to observe its effects on LDPE digestion."</data>
      <data key="d2">chunk-b95a108327e39d37d20bdd99db541164</data>
    </node>
    <node id="&quot;BIOMASS ASSIMILATION&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"Biomass assimilation refers to the small fraction of ingested LDPE that larvae incorporate into their bodies."</data>
      <data key="d2">chunk-b95a108327e39d37d20bdd99db541164</data>
    </node>
    <node id="&quot;C—H STRETCH BONDS&quot;">
      <data key="d0">"CHEMICAL BOND"</data>
      <data key="d1">"C—H stretch bonds are chemical bonds identified in LDPE materials, with their intensities weakening during the biodegradation process."</data>
      <data key="d2">chunk-f5a94048d4a1499a73a50e74a59245e6</data>
    </node>
    <node id="&quot;¹H NMR&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Proton nuclear magnetic resonance spectroscopy employed to detect specific functional groups formed during LDPE degradation."&lt;SEP&gt;"¹H NMR (Proton Nuclear Magnetic Resonance) is a spectroscopic technique used to analyze the structure of extracted polymers from frass samples."</data>
      <data key="d2">chunk-3ab754d1dc0a02ee3f869d2b082a710e&lt;SEP&gt;chunk-f5a94048d4a1499a73a50e74a59245e6</data>
    </node>
    <node id="&quot;CH₃ MOIETY&quot;">
      <data key="d0">"FUNCTIONAL GROUP"</data>
      <data key="d1">"CH₃ moiety forms due to the breakdown of long-chain polymers after biodegradation."</data>
      <data key="d2">chunk-f5a94048d4a1499a73a50e74a59245e6</data>
    </node>
    <node id="&quot;CH₂ GROUPS&quot;">
      <data key="d0">"FUNCTIONAL GROUP"</data>
      <data key="d1">"CH₂ groups are identified in regions between 2.9 and 3.9 ppm, attributed to nitrogen atoms and carbonyl groups."</data>
      <data key="d2">chunk-f5a94048d4a1499a73a50e74a59245e6</data>
    </node>
    <node id="&quot;A. GRISELLA&quot;">
      <data key="d0">"BACTERIUM"</data>
      <data key="d1">"A species of lesser waxworms that contributes to the biodegradation of plastics."&lt;SEP&gt;"A. grisella, also known as lesser waxworms, participates in HDPE biodegradation."</data>
      <data key="d2">chunk-3ab754d1dc0a02ee3f869d2b082a710e&lt;SEP&gt;chunk-f5a94048d4a1499a73a50e74a59245e6</data>
    </node>
    <node id="&quot;ALDEHYDE MOIETY&quot;">
      <data key="d0">"FUNCTIONAL GROUP"</data>
      <data key="d1">"Aldehyde moieties are functional groups identified in frass samples between 3.5 and 4.0 ppm, absent in original LDPE foams."&lt;SEP&gt;"Chemical structure identified by peaks between 3.5 and 4.0 ppm in NMR spectra, indicating oxygen incorporation."</data>
      <data key="d2">chunk-3ab754d1dc0a02ee3f869d2b082a710e&lt;SEP&gt;chunk-f5a94048d4a1499a73a50e74a59245e6</data>
    </node>
    <node id="&quot;SMALL SIZED POLYMERS (&lt;2.0 KDA)&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Small sized polymers (&lt;2.0 kDa) are breakdown products of larger polymers, analyzed in the frass samples."</data>
      <data key="d2">chunk-843d5746868067bce1a2f15dfc1571e2</data>
    </node>
    <node id="&quot;POLYMERS WITH MOLECULAR WEIGHT BETWEEN 10.0 AND 100 KDA&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"These polymers represent an intermediate size range in the depolymerization process."</data>
      <data key="d2">chunk-843d5746868067bce1a2f15dfc1571e2</data>
    </node>
    <node id="&quot;LARGER POLYMERS (&gt;100 KDA)&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Larger polymers (&gt;100 kDa) are high-molecular-weight polymers that show reduced depolymerization rates under antibiotic conditions."</data>
      <data key="d2">chunk-843d5746868067bce1a2f15dfc1571e2</data>
    </node>
    <node id="&quot;SYNERGISTIC EFFORTS OF GUT MICROBES AND DIGESTIVE ENZYMES&quot;">
      <data key="d0">"BIOLOGICAL CONCEPT"</data>
      <data key="d1">"This concept refers to the combined action of gut microbes and digestive enzymes in the depolymerization process."</data>
      <data key="d2">chunk-843d5746868067bce1a2f15dfc1571e2</data>
    </node>
    <node id="&quot;CARBON BALANCE ANALYSIS&quot;">
      <data key="d0">"BIOLOGICAL PROCESS"</data>
      <data key="d1">"This analysis confirms the conversion/oxidation of digested LDPE into CO2, indicating successful biodegradation."</data>
      <data key="d2">chunk-89a76f613b36454134940f78fba1c0f6</data>
    </node>
    <node id="&quot;FTIR, 1H NMR, TGA&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Analytical techniques confirming oxidized intermediates and chemical/physical modifications during LDPE biodegradation."</data>
      <data key="d2">chunk-89a76f613b36454134940f78fba1c0f6</data>
    </node>
    <node id="&quot;PVC, PP, PET&quot;">
      <data key="d0">"METABOLITE"</data>
      <data key="d1">"Other types of plastics mentioned for potential future studies on biodegradation by T. obscurus."</data>
      <data key="d2">chunk-89a76f613b36454134940f78fba1c0f6</data>
    </node>
