      <data key="d0">"LIFE STAGE"</data>
      <data key="d1">"The early instar larva group provides gut and frass samples for enrichment culture experiments."</data>
      <data key="d2">chunk-fdb13eda4d3cf5385a0a8284c7e213b0</data>
    </node>
    <node id="&quot;LATE INSTAR LARVA GROUP&quot;">
