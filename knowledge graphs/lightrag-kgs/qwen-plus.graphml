      <data key="d2">chunk-f0e30f29e9016acae216566f53e60cea&lt;SEP&gt;chunk-6e356bad5f8c2dd9188b38c0d9462b9c</data>
    </node>
    <node id="&quot;PE-OXO DIET&quot;">
      <data key="d0">"DIET"</data>
      <data key="d1">"An oxo-degradable polyethylene-based diet that was not suitable for larval growth."&lt;SEP&gt;"PE-oxo Diet is a dietary variant affecting bacterial orders such as Lactobacillales and Entomoplasmatales."</data>
      <data key="d2">chunk-6f65bf081bdd3c6718fa0310993bfc0d&lt;SEP&gt;chunk-f0e30f29e9016acae216566f53e60cea</data>
