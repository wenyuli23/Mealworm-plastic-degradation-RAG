      <data key="d2">chunk-e557113f1cfd2472fa9c51d1cdc3069a</data>
    </node>
    <node id="&quot;D.H2O&quot;">
      <data key="d0">"SOLVENT"</data>
      <data key="d1">"D.H2O (deionized water) is used to resuspend the extracted material before spectrophotometric analysis."</data>
      <data key="d2">chunk-e557113f1cfd2472fa9c51d1cdc3069a</data>
    </node>
    <node id="&quot;SPECTROPHOTOMETER&quot;">
      <data key="d0">"INSTRUMENT"</data>
