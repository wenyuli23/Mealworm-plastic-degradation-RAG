      <data key="d2">chunk-b759b81206d0e33e320f2d61e540ae47</data>
    </node>
    <node id="&quot;DEFENSIVE FUNCTIONS&quot;">
      <data key="d0">"BIOLOGICAL FUNCTION"</data>
