      <data key="d0">"NUTRIENT"</data>
      <data key="d1">"Additives are substances incorporated into plastics, influencing microbial community composition and activity."&lt;SEP&gt;"Additives such as antioxidants are components detected in control spectra of polymer beads, influencing degradation processes."</data>
      <data key="d2">chunk-582f48080aab075de76c9c590558639f&lt;SEP&gt;chunk-262bed73e929944e03b9f72769b8196c</data>
    </node>
