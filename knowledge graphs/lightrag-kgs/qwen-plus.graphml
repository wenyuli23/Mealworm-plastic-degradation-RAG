      <data key="d1">"The bacterial microbiota in PS samples is significantly impoverished compared to CT samples, likely due to reliance on a single carbon source."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;FUNGAL MICROBIOTA&quot;">
      <data key="d2">chunk-b6ddf9dd30d7258964408f9a915d3478</data>
      <data key="d1">"The fungal microbiota in PS samples displays higher richness compared to CT samples, possibly associated with the presence of Basidiomycota in PS samples."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
