    <edge source="NITROGENASE" target="TRACE ELEMENTS">
      <data key="d3">9.0</data>
      <data key="d4">Nitrogenase activity depends on trace elements such as iron, sulfur, vanadium, and manganese.</data>
      <data key="d5">9</data>
      <data key="d6">chunk-d47c76e5149ac059b1960b533c9e99a5</data>
    </edge>
    <edge source="NITROGENASE" target="IRON">
      <data key="d3">8.0</data>
      <data key="d4">Iron is a trace element required for the activity of nitrogenase, an enzyme involved in nitrogen fixation.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-0855091c2b50520d68971a532789a9a2</data>
    </edge>
    <edge source="NITROGENASE" target="SULFUR">
      <data key="d3">8.0</data>
      <data key="d4">Sulfur is a trace element necessary for the activity of nitrogenase, an enzyme involved in nitrogen fixation.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-0855091c2b50520d68971a532789a9a2</data>
    </edge>
    <edge source="NITROGENASE" target="VANADIUM">
      <data key="d3">8.0</data>
      <data key="d4">Vanadium is a trace element required for the activity of nitrogenase, an enzyme involved in nitrogen fixation.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-0855091c2b50520d68971a532789a9a2</data>
    </edge>
    <edge source="NITROGENASE" target="MANGANESE">
      <data key="d3">8.0</data>
      <data key="d4">Manganese is a trace element necessary for the activity of nitrogenase, an enzyme involved in nitrogen fixation.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-0855091c2b50520d68971a532789a9a2</data>
    </edge>
    <edge source="HYDROLYTIC ENZYMES" target="POLYMER WASTE">
      <data key="d3">8.0</data>
      <data key="d4">Hydrolytic enzymes in the digestive tract of Tenebrio molitor larvae degrade polymer waste, such as polyethylene and polystyrene.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-0855091c2b50520d68971a532789a9a2</data>
    </edge>
    <edge source="ESTERASE" target="PSEUDOMONAS AERUGINOSA M2">
      <data key="d3">8.0</data>
      <data key="d4">Pseudomonas aeruginosa M2 produces esterase, an enzyme that contributes to its ability to degrade polystyrene.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-55bdcf1b4859e82ab15050837ab539dc</data>
    </edge>
    <edge source="TERMITE GROUP 1 BACTERIA" target="NITROGEN-FIXING COMMUNITY">
      <data key="d3">16.0</data>
      <data key="d4">Termite Group 1 bacteria contribute to the nitrogen-fixing community in termite guts, aiding in nutrient cycling.&lt;SEP&gt;Termite Group 1 bacteria contribute to the nitrogen-fixing community in termites, aiding in nutrient conversion.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-f7a49f1c1e76d6e987e0aa499923d3f3&lt;SEP&gt;chunk-412d934721b214c2cd0565531172171c</data>
    </edge>
    <edge source="STYROFOAM" target="PLASTIC DEBRIS">
      <data key="d3">9.0</data>
      <data key="d4">Styrofoam is a significant component of plastic debris, contributing to environmental pollution.</data>
