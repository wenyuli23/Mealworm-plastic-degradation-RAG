      <data key="d5">7</data>
      <data key="d6">chunk-827853316f7304c444884dc82f757802</data>
    </edge>
    <edge source="ENTEROBACTER HORMAECHEI LG3" target="DEGRADATIVE ENZYMES">
      <data key="d3">8.0</data>
      <data key="d4">Degradative enzymes such as tpx, ahpC, and bcp are upregulated in Enterobacter hormaechei LG3 during polystyrene biodegradation.</data>
