      <data key="d3">8.0</data>
      <data key="d4">Enzymes produced by microorganisms like Pseudomonas sp. transform styrene into phenylacetate during plastic degradation.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-2a54f7d9e0a43fb94e2fc35f93656fc9</data>
    </edge>
