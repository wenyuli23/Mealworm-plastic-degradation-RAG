      <data key="d6">chunk-065b846c5f5f23f64023995cdb21c3db</data>
    </edge>
    <edge source="POLYURETHANE (PU1)" target="SULFUR (S)">
      <data key="d3">6.0</data>
      <data key="d4">Polyurethane (PU1) contains trace amounts of sulfur (S), which may affect its environmental and chemical behavior.</data>
      <data key="d5">6</data>
      <data key="d6">chunk-065b846c5f5f23f64023995cdb21c3db</data>
    </edge>
    <edge source="POLYURETHANE (PU2)" target="ELEMENTS CONTENT ANALYSIS">
      <data key="d3">8.0</data>
      <data key="d4">Polyurethane (PU2) was analyzed for its elemental composition, revealing high levels of Cl and P, which are significant for its environmental and industrial applications.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-065b846c5f5f23f64023995cdb21c3db</data>
    </edge>
    <edge source="POLYURETHANE (PU2)" target="CHLORINE (CL)">
      <data key="d3">8.0</data>
      <data key="d4">Polyurethane (PU2) has a high concentration of chlorine (Cl), which may influence its degradation and toxicity.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-065b846c5f5f23f64023995cdb21c3db</data>
    </edge>
    <edge source="PU1" target="SCANNING ELECTRON MICROPHOTOGRAPHY">
      <data key="d3">8.0</data>
      <data key="d4">Scanning electron microphotography is used to analyze the surface structure of PU1 before and after degradation by mealworms.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-f4b03ca32b0efbf0ca6a3c8761c0d03d</data>
    </edge>
    <edge source="PU2" target="SCANNING ELECTRON MICROPHOTOGRAPHY">
      <data key="d3">8.0</data>
