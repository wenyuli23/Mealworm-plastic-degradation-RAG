      <data key="d5">9</data>
      <data key="d6">chunk-e37da2fbe64f85c50c36da45006f4c23</data>
    </edge>
    <edge source="STYROFOAM-EATING MEALWORMS" target="BRAN-FEEDING MEALWORMS">
      <data key="d3">7.0</data>
