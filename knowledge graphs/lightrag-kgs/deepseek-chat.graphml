      <data key="d5">8</data>
      <data key="d6">chunk-ed48dc66abf9c27721101b1adac15e7a</data>
    </edge>
    <edge source="TENEBRIO MOLITOR" target="NPS">
      <data key="d3">8.0</data>
      <data key="d4">Tenebrio molitor larvae are capable of biodegrading polystyrene nanoparticles (NPS) through their gut microbiota.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-b9fcb421212175a148a0a1858582cfb2</data>
    </edge>
