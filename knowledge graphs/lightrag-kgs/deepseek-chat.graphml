      <data key="d5">8</data>
      <data key="d6">chunk-d4af956dbe737dee68ab6b9834fe2fcc</data>
    </edge>
    <edge source="NITRATE REDUCERS" target="IRON CYCLING">
      <data key="d3">8.0</data>
