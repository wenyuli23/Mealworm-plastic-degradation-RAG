      <data key="d4">The gut microbial ecological niche adapts to polyethylene exposure, altering microbial diversity and contributing to the biodegradation process.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-acbe3a2cb3a17985d07d15bed638bd90</data>
    </edge>
