      <data key="d3">7.0</data>
      <data key="d4">Corn stover is used as a diet for Tenebrio molitor larvae to study its degradation compared to synthetic plastics.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-effe1e87d51e126ff4ec5cf9e49d6524</data>
    </edge>
