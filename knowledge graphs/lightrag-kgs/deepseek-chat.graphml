      <data key="d4">The nitrogen-fixing isolate from mealworm gut microbiota plays a role in nitrogen fixation.</data>
      <data key="d5">9</data>
      <data key="d6">chunk-53ab7dd83bf51674598c6a5bdd146b90</data>
    </edge>
    <edge source="NITROGEN FIXATION" target="NITROGENASE">
      <data key="d3">9.0</data>
