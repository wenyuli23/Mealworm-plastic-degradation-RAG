      <data key="d3">7.0</data>
      <data key="d4">Superworm frass contains Heptacosane, a compound that may contribute to its growth-promoting properties.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-078b6698be699eb7105b7cffadf709af</data>
    </edge>
    <edge source="SUPERWORM FRASS" target="NONADECANE">
      <data key="d3">7.0</data>
