      <data key="d5">8</data>
      <data key="d6">chunk-71372e333b39cee7eea0c53f89bec5c4</data>
    </edge>
    <edge source="BIODEGRADABLE POLYMERS" target="ARCTIC MICROORGANISMS">
      <data key="d3">16.0</data>
