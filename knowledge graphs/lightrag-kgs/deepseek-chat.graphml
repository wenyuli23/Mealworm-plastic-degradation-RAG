    </edge>
    <edge source="BOMBELLI ET AL." target="WEBER ET AL.">
      <data key="d3">8.0</data>
      <data key="d4">Weber et al. raised methodological concerns about the results of Bombelli et al., questioning the presence of ethylene glycol and mass loss.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-b08485bef3ee3db21e59e159ad4c3e20</data>
    </edge>
