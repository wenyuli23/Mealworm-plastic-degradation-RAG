    </edge>
    <edge source="MEALWORM LARVAE" target="WASTE MANAGEMENT">
      <data key="d3">9.0</data>
      <data key="d4">Mealworm larvae play a role in waste management by biodegrading plastic waste.</data>
      <data key="d5">9</data>
      <data key="d6">chunk-0e3058d086d89f1ce9baa29cbc29bb48</data>
