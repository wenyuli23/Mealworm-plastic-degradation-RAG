      <data key="d0">TOXICOLOGICAL ASSESSMENT</data>
      <data key="d1">Organ weight analysis is a method used in toxicological studies to assess the effects of chemical exposures on the health of organisms.</data>
      <data key="d2">chunk-6464a2f3ca18442f70e254b9341a3e1c</data>
    </node>
    <node id="ACORN MOOK">
