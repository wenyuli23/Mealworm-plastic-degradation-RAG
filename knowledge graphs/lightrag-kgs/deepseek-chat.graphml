      <data key="d3">7.0</data>
      <data key="d4">Diet 1 shows comparable PS consumption rates to Diet 2 by the end of the experiment.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-7c810740a381d4d9e829e28c01e62564</data>
    </edge>
    <edge source="MEALWORM LARVAE" target="DIET 3 (PS/BARLEY 20:1)">
