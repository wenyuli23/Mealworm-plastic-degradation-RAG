    </edge>
    <edge source="POLYSTYRENE (PS)" target="FTIR SPECTROMETER">
      <data key="d3">8.0</data>
      <data key="d4">The FTIR spectrometer is used to analyze changes in the functional groups of PS after biodegradation by mealworms.</data>
