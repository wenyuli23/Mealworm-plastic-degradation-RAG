    </edge>
    <edge source="MEALWORMS" target="DEGS">
      <data key="d3">8.0</data>
      <data key="d4">Differentially expressed genes (DEGs) in mealworms fed on plastics showed significant changes, indicating the molecular response to plastic degradation.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-f38f2f3673b813b3a817c014229c9565</data>
    </edge>
