      <data key="d5">7</data>
      <data key="d6">chunk-df4c8c66bfbbfc37ed842f53d2b8796c</data>
    </edge>
    <edge source="EXTRACELLULAR ENZYMES" target="PU (POLYURETHANE)">
      <data key="d3">8.0</data>
      <data key="d4">Extracellular enzymes produced by gut fungi and bacteria are crucial for the biodegradation of complex plastics like polyurethane (PU).</data>
      <data key="d5">8</data>
      <data key="d6">chunk-3e34d58a20a707b35e8fcd5658ba2924</data>
    </edge>
