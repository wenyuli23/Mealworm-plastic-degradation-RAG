    </node>
    <node id="YERSINIACEAE">
      <data key="d0">ORGANISM</data>
      <data key="d1">Yersiniaceae is a family of bacteria within the Gammaproteobacteria class, identified as one of the groups capable of degrading polystyrene.</data>
      <data key="d2">chunk-10f59d5d10f08e8107f36bff5a4c93ae</data>
    </node>
    <node id="AEROMONADACEAE">
