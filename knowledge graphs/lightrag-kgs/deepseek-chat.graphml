      <data key="d1">Nutritional supplements, including plant and animal-based components, are used to enhance the feed quality and growth of Tenebrio molitor larvae.</data>
      <data key="d2">chunk-531058c4540bd4e6a50d141db01d4d11</data>
    </node>
    <node id="DEAD INDIVIDUALS">
      <data key="d0">ORGANISM</data>
