      <data key="d3">7.0</data>
      <data key="d4">Black soldier fly frass improves soil properties, enhancing fertility and crop growth.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-d0627e3f1b0fb440795f73c4fa33093c</data>
    </edge>
