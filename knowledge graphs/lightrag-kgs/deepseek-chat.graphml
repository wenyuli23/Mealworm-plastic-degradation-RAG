    </edge>
    <edge source="SYMBIOTIC BACTERIA" target="NITROGEN">
      <data key="d3">9.0</data>
      <data key="d4">Symbiotic bacteria help insects assimilate nitrogen, particularly in nitrogen-deficient environments.</data>
      <data key="d5">9</data>
