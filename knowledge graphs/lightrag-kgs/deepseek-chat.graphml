    </edge>
    <edge source="POLYSTYRENE" target="COLEOPTERA">
      <data key="d3">8.0</data>
      <data key="d4">Insects from the Coleoptera order, such as mealworms, have been shown to degrade polystyrene through the action of their gut microorganisms.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-cbf098ec253f99187f3c98d5d0589f7d</data>
    </edge>
    <edge source="POLYSTYRENE" target="LEPIDOPTERA">
      <data key="d3">7.0</data>
