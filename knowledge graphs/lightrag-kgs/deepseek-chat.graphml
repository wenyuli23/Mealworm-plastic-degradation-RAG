      <data key="d6">chunk-effe1e87d51e126ff4ec5cf9e49d6524</data>
    </edge>
    <edge source="TENEBRIO MOLITOR" target="METATRANSCRIPTOMIC SEQUENCING">
      <data key="d3">8.0</data>
      <data key="d4">Metatranscriptomic sequencing is used to analyze metabolic pathways and enzymes involved in the degradation of plastics and natural polymers in mealworms.</data>
