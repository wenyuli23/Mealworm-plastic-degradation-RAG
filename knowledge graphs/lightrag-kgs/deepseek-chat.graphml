      <data key="d5">8</data>
      <data key="d6">chunk-6ce341034979daadf1f9dc7037397d1b</data>
    </edge>
    <edge source="BLACK SOLDIER FLY" target="PLASTIC">
      <data key="d3">7.0</data>
      <data key="d4">Black Soldier Fly larvae are studied for their potential to biodegrade plastics, focusing on enzymatic degradation rather than mechanical chewing.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-8c8dab62f56f2bfabf08bfe99049386a</data>
    </edge>
    <edge source="LIFE CYCLE" target="LESSER WAXWORMS">
      <data key="d3">8.0</data>
      <data key="d4">The life cycle of lesser waxworms is studied to understand their growth and development when fed polyethylene (PE) compared to waxcomb.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-ab6b219720db5a6e3384c884c280984c</data>
    </edge>
    <edge source="PLASTIC-DEGRADING MICROORGANISMS" target="PCL">
      <data key="d3">7.0</data>
      <data key="d4">Plastic-degrading microorganisms can break down PCL, a biodegradable polymer, into simpler compounds.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-326aabc25dd967951a7845ea221532ac</data>
    </edge>
    <edge source="PLASTIC-DEGRADING MICROORGANISMS" target="PBSA">
      <data key="d3">7.0</data>
      <data key="d4">Plastic-degrading microorganisms are involved in the biodegradation of PBSA, a biodegradable polymer.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-326aabc25dd967951a7845ea221532ac</data>
    </edge>
    <edge source="PLASTIC-DEGRADING MICROORGANISMS" target="PBS">
      <data key="d3">7.0</data>
      <data key="d4">Plastic-degrading microorganisms play a role in the biodegradation of PBS, a biodegradable polymer.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-326aabc25dd967951a7845ea221532ac</data>
    </edge>
    <edge source="PLASTIC-DEGRADING MICROORGANISMS" target="PCA">
      <data key="d3">7.0</data>
      <data key="d4">PCA is used for the aerobic incubation of plastic-degrading microorganisms to assess total viable counts.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-326aabc25dd967951a7845ea221532ac</data>
    </edge>
    <edge source="PLASTIC-DEGRADING MICROORGANISMS" target="NA MEDIUM">
      <data key="d3">7.0</data>
      <data key="d4">NA medium is used for the cultivation and isolation of plastic-degrading microorganisms.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-326aabc25dd967951a7845ea221532ac</data>
    </edge>
    <edge source="PLASTIC-DEGRADING MICROORGANISMS" target="FMM PLATES">
      <data key="d3">8.0</data>
      <data key="d4">FMM plates are used to isolate plastic-degrading microorganisms by providing a carbon source from emulsified plastics.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-326aabc25dd967951a7845ea221532ac</data>
    </edge>
    <edge source="ENVIRONMENTAL IMPACT" target="CHEMICAL ADDITIVES">
      <data key="d3">8.0</data>
