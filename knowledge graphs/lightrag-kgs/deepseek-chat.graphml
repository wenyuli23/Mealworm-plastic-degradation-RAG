      <data key="d3">7.0</data>
      <data key="d4">Hexabromocyclododecane (HBCD) is a flame retardant found in polystyrene, and its fate is studied in mealworms during the biodegradation process.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-91831340731171413dc4c412a325e034</data>
    </edge>
