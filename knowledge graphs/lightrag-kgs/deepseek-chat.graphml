      <data key="d4">Cabbage is used as a control diet for Tenebrio molitor larvae to compare its effects with polystyrene and corn straw</data>
      <data key="d5">7</data>
      <data key="d6">chunk-1d39fc863538a777920c4eafb37bcf8a</data>
