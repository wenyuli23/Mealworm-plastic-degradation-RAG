      <data key="d5">7</data>
      <data key="d6">chunk-90367ecb21e0f14b2e548acf307a2628</data>
    </edge>
    <edge source="OXIDATIVE STRESS" target="RESIDUAL MP PARTICLES">
      <data key="d3">8.0</data>
      <data key="d4">Residual microplastic particles cause oxidative stress and negative physiological responses in Tenebrio larvae.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-90367ecb21e0f14b2e548acf307a2628</data>
    </edge>
