      <data key="d3">7.0</data>
      <data key="d4">Mealworms were tested on polystyrene materials with known melt flow ratios to understand their biodegradation capabilities.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-36b964b1825429cad2c7d13c1ea8827e</data>
    </edge>
