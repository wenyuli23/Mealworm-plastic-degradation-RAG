    <edge source="TENEBRIO MOLITOR" target="BIOMERGER PROJECT">
      <data key="d3">8.0</data>
      <data key="d4">The Biomerger Project funds research on the biodegradation of polyurethane by Tenebrio molitor larvae and their gut microbiome.</data>
      <data key="d5">8</data>
