      <data key="d5">7</data>
      <data key="d6">chunk-e37da2fbe64f85c50c36da45006f4c23</data>
    </edge>
    <edge source="ZERO-WASTE CIRCULAR ECONOMY" target="ZERO WASTE INTERNATIONAL ALLIANCE">
      <data key="d3">8.0</data>
      <data key="d4">The Zero Waste International Alliance defines the goal of zero waste, which aligns with the study's methodology.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-32e10966ec80ea585746639b6be7e04e</data>
    </edge>
