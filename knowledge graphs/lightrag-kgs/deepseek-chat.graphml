      <data key="d5">7</data>
      <data key="d6">chunk-e5a7fb8d6a76ecfbfc810f952bfba090</data>
    </edge>
    <edge source="TENEBRIO MOLITOR" target="PET_{63500}">
      <data key="d3">14.0</data>
      <data key="d4">PET_{63500} is a high molecular weight PET polymer used in biodegradation studies with mealworms.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-e5a7fb8d6a76ecfbfc810f952bfba090</data>
    </edge>
