      <data key="d3">7.0</data>
      <data key="d4">Aerated compost tea promotes the growth of plants like lettuce, soybean, and sweet corn in organic farming.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-b79a227bc8e127f6b71fd2edb0e650a0</data>
    </edge>
