      <data key="d5">7</data>
      <data key="d6">chunk-902ed6a67c601276c5dbf43c35dd824f</data>
    </edge>
    <edge source="BIOSURFACTANTS" target="HYDROCARBON DEGRADATION">
      <data key="d3">8.0</data>
      <data key="d4">Biosurfactants, such as rhamnolipid, enhance hydrocarbon degradation, including the breakdown of polystyrene.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-eda80cb027c8107defa00011d491b002</data>
    </edge>
    <edge source="HYDROCARBON DEGRADATION" target="PETROLEUM-CONTAMINATED ENVIRONMENTS">
      <data key="d3">8.0</data>
      <data key="d4">Hydrocarbon degradation is studied in the context of petroleum-contaminated environments, where microorganisms break down hydrocarbons.</data>
      <data key="d5">8</data>
