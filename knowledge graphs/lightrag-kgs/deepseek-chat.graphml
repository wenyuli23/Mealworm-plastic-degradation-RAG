    </edge>
    <edge source="BIODEGRADATION" target="LIPID BIOMASS">
      <data key="d3">8.0</data>
      <data key="d4">Lipid biomass is a byproduct of polystyrene mineralization during biodegradation.</data>
      <data key="d5">8</data>
