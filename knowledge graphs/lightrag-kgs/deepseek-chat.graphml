      <data key="d6">chunk-566afea8a2a89bd188f68d0afa1bb173</data>
    </edge>
    <edge source="TENEBRIO MOLITOR" target="PLASTIC DEGRADATION-RELATED BACTERIAL ENZYMES">
      <data key="d3">9.0</data>
