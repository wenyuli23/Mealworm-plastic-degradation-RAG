      <data key="d5">8</data>
      <data key="d6">chunk-f8ee8f544a1849c80a5a1524c4f2674c</data>
    </edge>
    <edge source="PETROLEUM" target="COASTAL WATERS">
      <data key="d3">8.0</data>
      <data key="d4">Petroleum-degrading bacteria have been isolated from coastal waters, demonstrating their role in the bioremediation of petroleum pollution.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-827853316f7304c444884dc82f757802</data>
