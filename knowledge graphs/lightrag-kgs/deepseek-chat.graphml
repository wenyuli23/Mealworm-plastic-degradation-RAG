      <data key="d3">8.0</data>
      <data key="d4">The northern South China Sea is a region where marine debris, including plastics, has been extensively studied.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-a72a9944bcd114b6a3be55ad9b596c77</data>
    </edge>
