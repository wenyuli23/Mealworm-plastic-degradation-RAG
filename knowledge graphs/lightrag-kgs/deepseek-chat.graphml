      <data key="d5">9</data>
      <data key="d6">chunk-1c31fc195067eeb8acb7f98417bd6744</data>
    </edge>
    <edge source="ENZYMES" target="PU FOAM">
      <data key="d3">9.0</data>
      <data key="d4">Enzymes such as lipases, esterases, proteases, and laccases are involved in the hydrolysis of polyurethane (PU) in the mealworm gut.</data>
      <data key="d5">9</data>
      <data key="d6">chunk-d2c62bcfb28547d6b2336f142d27a326</data>
    </edge>
