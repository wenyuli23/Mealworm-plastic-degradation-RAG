      <data key="d4">Gut microbiome changes in superworms are associated with the biodegradation of plastics, influencing their degradation efficiency.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-0014171c7ef07a60c6be3b57e791688c</data>
    </edge>
    <edge source="SUPERWORMS" target="PLASTIC CONSUMPTION RATE">
