      <data key="d5">8</data>
      <data key="d6">chunk-e98fb757cb68ae45626058d9c3a15cb4</data>
    </edge>
    <edge source="OXIDATIVE STRESS" target="TENEBRIO MOLITOR LARVAE">
      <data key="d3">8.0</data>
      <data key="d4">Ingestion of microplastics by Tenebrio molitor larvae induces oxidative stress, leading to physiological damage.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-22ae90a77be18cbac99e5441d47ce2d7</data>
    </edge>
    <edge source="OXIDATIVE STRESS" target="PVC">
      <data key="d3">8.0</data>
      <data key="d4">PVC microplastics cause the highest levels of oxidative stress in Tenebrio molitor larvae compared to PS and PLA.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-22ae90a77be18cbac99e5441d47ce2d7</data>
    </edge>
    <edge source="OXIDATIVE STRESS" target="PS">
      <data key="d3">7.0</data>
      <data key="d4">PS microplastics cause oxidative stress in Tenebrio molitor larvae, though less severe than PVC.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-22ae90a77be18cbac99e5441d47ce2d7</data>
    </edge>
    <edge source="OXIDATIVE STRESS" target="PLA">
      <data key="d3">8.0</data>
      <data key="d4">PLA microplastics cause the least oxidative stress in Tenebrio molitor larvae compared to PVC and PS.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-22ae90a77be18cbac99e5441d47ce2d7</data>
    </edge>
    <edge source="OXIDATIVE STRESS" target="ROS">
      <data key="d3">8.0</data>
      <data key="d4">Reactive oxygen species (ROS) are key indicators of oxidative stress in Tenebrio molitor larvae caused by microplastic ingestion.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-22ae90a77be18cbac99e5441d47ce2d7</data>
    </edge>
    <edge source="OXIDATIVE STRESS" target="SUPEROXIDE DISMUTASE (SOD)">
      <data key="d3">15.0</data>
      <data key="d4">Superoxide dismutase (SOD) activity is measured to assess the antioxidant response in Tenebrio molitor larvae exposed to microplastics.&lt;SEP&gt;Superoxide dismutase (SOD) helps organisms mitigate oxidative stress caused by microplastics.</data>
      <data key="d5">7&lt;SEP&gt;8</data>
      <data key="d6">chunk-fe381daaa91bbff20758798e5baf82b5&lt;SEP&gt;chunk-22ae90a77be18cbac99e5441d47ce2d7</data>
    </edge>
    <edge source="OXIDATIVE STRESS" target="GLUTATHIONE-S-TRANSFERASE (GST)">
      <data key="d3">7.0</data>
      <data key="d4">Glutathione-S-transferase (GST) activity is used to evaluate detoxification processes in Tenebrio molitor larvae under oxidative stress from microplastics.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-22ae90a77be18cbac99e5441d47ce2d7</data>
    </edge>
    <edge source="OXIDATIVE STRESS" target="CATALASE (CAT)">
      <data key="d3">7.0</data>
      <data key="d4">Catalase (CAT) activity is measured to determine the reduction of oxidative stress in Tenebrio molitor larvae exposed to microplastics.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-22ae90a77be18cbac99e5441d47ce2d7</data>
    </edge>
    <edge source="OXIDATIVE STRESS" target="MALONDIALDEHYDE (MDA)">
      <data key="d3">16.0</data>
      <data key="d4">Malondialdehyde (MDA) is a biomarker indicating oxidative damage in organisms exposed to microplastics.&lt;SEP&gt;Malondialdehyde (MDA) levels indicate lipid peroxidation and oxidative damage in Tenebrio molitor larvae due to microplastic ingestion.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-fe381daaa91bbff20758798e5baf82b5&lt;SEP&gt;chunk-22ae90a77be18cbac99e5441d47ce2d7</data>
    </edge>
    <edge source="OXIDATIVE STRESS" target="PET">
      <data key="d3">14.0</data>
      <data key="d4">Oxidative stress is observed in Tenebrio molitor larvae during PET biodegradation, likely due to the ingestion of PET microplastics</data>
      <data key="d5">7</data>
      <data key="d6">chunk-d5f4bda412174e8b173f180d9b4311ae</data>
    </edge>
    <edge source="OXIDATIVE STRESS" target="BENZOQUINONE">
      <data key="d3">8.0</data>
      <data key="d4">Increased benzoquinone concentrations in larvae fed polyethylene indicate elevated oxidative stress and potential physiological damage.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-acbe3a2cb3a17985d07d15bed638bd90</data>
    </edge>
    <edge source="OXIDATIVE STRESS" target="PHYSIOLOGY RESPONSES">
      <data key="d3">8.0</data>
      <data key="d4">Oxidative stress is a key physiological response in Tenebrio molitor and Tenebrio obscurus larvae fed polyethylene, leading to adverse effects such as tissue damage.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-acbe3a2cb3a17985d07d15bed638bd90</data>
    </edge>
    <edge source="OXIDATIVE STRESS" target="POLYETHYLENE MICROPLASTICS (PE-MPS)">
      <data key="d3">8.0</data>
      <data key="d4">Exposure to polyethylene microplastics induces oxidative stress and damage in Tenebrio molitor larvae.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-9b693d867918f89c9b28997fe94fc830</data>
    </edge>
    <edge source="OXIDATIVE STRESS" target="PE-MPS">
      <data key="d3">6.0</data>
      <data key="d4">Oxidative stress may occur in mealworms consuming polyethylene (PE) diets, though this was not fully assessed in the study.</data>
      <data key="d5">6</data>
      <data key="d6">chunk-6ac1b1db6ffab6f4cfea7a525785a2fc</data>
    </edge>
    <edge source="OXIDATIVE STRESS" target="TENEBRIO LARVAE">
      <data key="d3">16.0</data>
      <data key="d4">Oxidative stress is investigated in Tenebrio larvae after continuous feeding with PE-MPs, indicating potential ecotoxicity.&lt;SEP&gt;Tenebrio larvae exhibit oxidative stress responses when exposed to microplastics, leading to tissue damage and physiological impairments.</data>
      <data key="d5">7&lt;SEP&gt;9</data>
