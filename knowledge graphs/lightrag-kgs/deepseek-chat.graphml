      <data key="d3">8.0</data>
      <data key="d4">Differentially expressed genes (DEGs) were identified in mealworms to understand the metabolic pathways involved in plastic degradation.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-566d464a7713ef7ca266f3d5f24a1a59</data>
    </edge>
