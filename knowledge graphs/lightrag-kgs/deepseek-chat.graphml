    </edge>
    <edge source="AERATED COMPOST TEA" target="ZEA MAYS (SWEET CORN)">
      <data key="d3">7.0</data>
      <data key="d4">Zea mays (sweet corn) benefits from the application of aerated compost tea in organic cultivation.</data>
