      <data key="d3">8.0</data>
      <data key="d4">Crassostrea gigas exhibits oxidative stress biomarkers and physiological responses when exposed to microplastics.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-74e2601f950d62c093ceb86612b2374f</data>
    </edge>
    <edge source="OXIDATIVE STRESS" target="LARVAE">
      <data key="d3">7.0</data>
      <data key="d4">Larvae exposed to microplastics exhibit increased oxidative stress, which can impact their physiological health.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-cf697c73d05470fb4a143aa0e4700787</data>
    </edge>
    <edge source="OXIDATIVE STRESS" target="CHLORINATED INTERMEDIATES">
      <data key="d3">8.0</data>
      <data key="d4">Chlorinated intermediates released during PVC biodegradation contribute to oxidative stress in organisms.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-e98fb757cb68ae45626058d9c3a15cb4</data>
    </edge>
    <edge source="OXIDATIVE STRESS" target="HYDROGEN CHLORIDE">
      <data key="d3">8.0</data>
