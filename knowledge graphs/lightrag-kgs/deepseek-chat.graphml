    </edge>
    <edge source="YELLOW MEALWORM LARVAE" target="BRANDON ET AL.">
      <data key="d3">9.0</data>
      <data key="d4">Brandon et al. demonstrated that yellow mealworm larvae can convert ingested polyethylene (PE) into CO2, highlighting their role in plastic biodegradation.</data>
      <data key="d5">9</data>
      <data key="d6">chunk-b42ef7860e1f056d47955d0d13a15cd8</data>
