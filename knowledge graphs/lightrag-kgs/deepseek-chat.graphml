    <edge source="EISENIA FETIDA" target="PS MPS">
      <data key="d3">8.0</data>
      <data key="d4">Eisenia fetida was exposed to PS MPs, resulting in a remarkable increase in ROS levels, indicating oxidative stress.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-dcf2bd0dbdce4d7299bfc35487eaf0f5</data>
    </edge>
