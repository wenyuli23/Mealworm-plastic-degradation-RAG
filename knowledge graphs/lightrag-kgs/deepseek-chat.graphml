    </edge>
    <edge source="OXIDATIVE STRESS" target="T-AOC">
      <data key="d3">7.0</data>
      <data key="d4">T-AOC reflects the overall antioxidant capacity of Tenebrio larvae, protecting against oxidative stress induced by PE-MPs.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-90367ecb21e0f14b2e548acf307a2628</data>
    </edge>
    <edge source="OXIDATIVE STRESS" target="MDA">
      <data key="d3">7.0</data>
