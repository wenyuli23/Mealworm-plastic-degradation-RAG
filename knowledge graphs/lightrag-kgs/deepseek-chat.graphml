      <data key="d1">The Laurentian Great Lakes are a major freshwater system affected by microplastic pollution, highlighting the widespread nature of this environmental issue.</data>
      <data key="d2">chunk-9d9491734042920c5911740665415835</data>
    </node>
    <node id="MARINE ECOSYSTEM">
      <data key="d0">ENVIRONMENTAL POLLUTANT</data>
