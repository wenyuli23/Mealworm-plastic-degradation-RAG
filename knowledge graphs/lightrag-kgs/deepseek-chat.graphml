      <data key="d5">8</data>
      <data key="d6">chunk-32e10966ec80ea585746639b6be7e04e</data>
    </edge>
    <edge source="HYLOCEREUS UNDATUS" target="WORM FRASS">
      <data key="d3">8.0</data>
      <data key="d4">Worm frass is used as a medium to study its effects on the growth of Hylocereus undatus.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-671dc96f9c648fdc6d21397c515d171d</data>
    </edge>
    <edge source="HYLOCEREUS UNDATUS" target="TEA LEAVES">
      <data key="d3">8.0</data>
      <data key="d4">Tea leaves are used as a positive control to study their effects on the growth of Hylocereus undatus compared to worm frass.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-671dc96f9c648fdc6d21397c515d171d</data>
    </edge>
    <edge source="HYLOCEREUS UNDATUS" target="SUPERWORM FRASS">
      <data key="d3">8.0</data>
      <data key="d4">Superworm frass is used as a medium to study its effects on the growth of Hylocereus undatus.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-671dc96f9c648fdc6d21397c515d171d</data>
    </edge>
