    <edge source="GUT MICROBIOME" target="PHOSPHATE BUFFERED WATER">
      <data key="d3">7.0</data>
      <data key="d4">Phosphate buffered water is used to rinse gut tissue for DNA extraction in gut microbiome studies.</data>
