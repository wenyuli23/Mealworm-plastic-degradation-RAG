      <data key="d5">8</data>
      <data key="d6">chunk-e69c793c3b67aed7a68bf864c2c7a309</data>
    </edge>
    <edge source="TENEBRIO MOLITOR" target="PET DEGRADATION PATHWAY">
      <data key="d3">18.0</data>
      <data key="d4">The PET degradation pathway is studied in Tenebrio molitor to understand the biodegradation of PET.</data>
