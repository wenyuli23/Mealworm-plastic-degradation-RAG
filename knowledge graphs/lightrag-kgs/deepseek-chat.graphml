    </edge>
    <edge source="BIODEGRADATION" target="ENTEROBACTER ASBURIAE">
      <data key="d3">8.0</data>
      <data key="d4">Enterobacter asburiae is involved in biodegradation processes, particularly in environmental contexts.</data>
      <data key="d5">8</data>
