      <data key="d3">8.0</data>
      <data key="d4">Tenebrio species are studied for their ability to degrade polyethylene microplastics through their gut microbiomes, influenced by host-specificity and physicochemical properties.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-2e1faf524e6fabeb512a07b13f37e51e</data>
    </edge>
