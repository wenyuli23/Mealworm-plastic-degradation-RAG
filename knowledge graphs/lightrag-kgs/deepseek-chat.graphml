    </edge>
    <edge source="POLYSTYRENE (PS)" target="LG3">
      <data key="d3">9.0</data>
      <data key="d4">LG3 is capable of degrading polystyrene under anaerobic conditions through oxidation and depolymerization processes.</data>
      <data key="d5">9</data>
