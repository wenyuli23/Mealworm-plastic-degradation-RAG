      <data key="d6">chunk-fdb13eda4d3cf5385a0a8284c7e213b0</data>
    </edge>
    <edge source="GC-MS ANALYSIS" target="SUPERWORM FRASS">
      <data key="d3">8.0</data>
      <data key="d4">GC-MS analysis was used to detect growth-promoting compounds like Heptacosane, Nonadecane, and Octadecane in superworm frass.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-078b6698be699eb7105b7cffadf709af</data>
    </edge>
