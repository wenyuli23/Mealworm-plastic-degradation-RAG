      <data key="d3">7.0</data>
      <data key="d4">Mealworms help mitigate the environmental impact of plastic waste by consuming and degrading certain types of plastics.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-918d0788c95399a6714bd40c688594de</data>
    </edge>
    <edge source="MEALWORMS" target="CONSUMPTION RATES">
      <data key="d3">8.0</data>
      <data key="d4">Consumption rates are used to measure the amount of plastic consumed by mealworms, providing insights into their biodegradation capabilities.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-918d0788c95399a6714bd40c688594de</data>
    </edge>
    <edge source="MEALWORMS" target="PLASTIC WASTE REDUCTION">
      <data key="d3">8.0</data>
      <data key="d4">Mealworms contribute to plastic waste reduction by consuming and degrading various types of plastics.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-918d0788c95399a6714bd40c688594de</data>
    </edge>
