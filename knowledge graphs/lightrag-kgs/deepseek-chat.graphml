      <data key="d3">9.0</data>
      <data key="d4">GC-MS is used to analyze the presence of polystyrene and its by-products in worm frass.</data>
      <data key="d5">9</data>
      <data key="d6">chunk-671dc96f9c648fdc6d21397c515d171d</data>
    </edge>
    <edge source="WORM FRASS" target="CACTI ROOTING FREQUENCY">
