      <data key="d6">chunk-02761f0aee6116a25ce05444f6ce8242</data>
    </edge>
    <edge source="WATER CONTACT ANGLE (WCA)" target="POLYSTYRENE FILM">
      <data key="d3">14.0</data>
      <data key="d4">Water contact angle (WCA) measurements show changes in hydrophobicity of polystyrene films after degradation by bacterial strains.&lt;SEP&gt;Water contact angle measurement is used to assess changes in the hydrophobicity of polystyrene films after bacterial degradation.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-70735757eafccc0f762f21f5d3ac8556&lt;SEP&gt;chunk-06ba9ca61fb4f42582bbf7bd00ff0005</data>
    </edge>
