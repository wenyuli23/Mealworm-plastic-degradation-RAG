      <data key="d5">9</data>
      <data key="d6">chunk-78830eb6f2457838fda4728b21c17bed</data>
    </edge>
    <edge source="STRAIN NYZ450" target="CARBON SOURCE">
      <data key="d3">8.0</data>
      <data key="d4">Strain NyZ450 utilizes polyethylene as a carbon source during the biodegradation process.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-78830eb6f2457838fda4728b21c17bed</data>
    </edge>
    <edge source="STRAIN NYZ451" target="COLLABORATION">
      <data key="d3">8.0</data>
      <data key="d4">Strain NyZ451 collaborates with strain NyZ450 to improve the biodegradation of polyethylene.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-78830eb6f2457838fda4728b21c17bed</data>
    </edge>
    <edge source="MEALWORMS (TENEBRIO MOLITOR)" target="BIO-REMEDIATION">
      <data key="d3">8.0</data>
      <data key="d4">Mealworms are being studied for their potential role in bio-remediation of plastic waste through biodegradation</data>
      <data key="d5">8</data>
      <data key="d6">chunk-ff933f404b1e6da13d6c1319bc7432c7</data>
    </edge>
