    </edge>
    <edge source="POLYETHYLENE (PE)" target="TRAMETES VERSICOLOR">
      <data key="d3">7.0</data>
      <data key="d4">Trametes versicolor produces enzymes that can degrade lignin, which may also be effective in degrading polyethylene due to structural similarities.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-effe1e87d51e126ff4ec5cf9e49d6524</data>
    </edge>
