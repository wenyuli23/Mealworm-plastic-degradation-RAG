      <data key="d3">7.0</data>
      <data key="d4">NPS is synthesized and characterized to study its interaction with mealworms and its potential degradation.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-ed48dc66abf9c27721101b1adac15e7a</data>
    </edge>
    <edge source="TENEBRIO MOLITOR" target="INCUBATOR">
      <data key="d3">8.0</data>
