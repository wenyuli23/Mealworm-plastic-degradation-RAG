    </edge>
    <edge source="BIODEGRADATION" target="GAS CHROMATOGRAPHY AND MASS SPECTROMETRY (GC-MS)">
      <data key="d3">8.0</data>
      <data key="d4">Gas chromatography and mass spectrometry (GC-MS) is used to identify metabolic intermediates produced during the biodegradation of microplastics by Tenebrio molitor larvae.</data>
      <data key="d5">8</data>
