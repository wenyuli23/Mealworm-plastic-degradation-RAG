      <data key="d6">chunk-a7a14229bceb339a4ca1baf0772b47ec</data>
    </edge>
    <edge source="POLYPROPYLENE" target="KLUYVERA SP.">
      <data key="d3">8.0</data>
      <data key="d4">Kluyvera sp. is associated with the degradation of high molecular weight polypropylene by Tenebrio molitor</data>
      <data key="d5">8</data>
      <data key="d6">chunk-566afea8a2a89bd188f68d0afa1bb173</data>
    </edge>
