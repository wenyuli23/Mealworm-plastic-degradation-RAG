      <data key="d5">8</data>
      <data key="d6">chunk-fca6acde6809ed3c727d7bffdbfd1ada</data>
    </edge>
    <edge source="SODIUM DODECYL SULFATE (SDS)" target="WEIGHT LOSS MEASUREMENT">
      <data key="d3">7.0</data>
