    </edge>
    <edge source="PE MULCHING FILMS" target="STERILE WATER">
      <data key="d3">7.0</data>
      <data key="d4">Sterile water is used to wash PE mulching films to prepare them for biodegradation experiments.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-2c6dfb08bb454e8ff642e7975ba7af10</data>
