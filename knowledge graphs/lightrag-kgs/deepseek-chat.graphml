      <data key="d5">8</data>
      <data key="d6">chunk-e6d515521d6d2b72e82154cc544d26cc</data>
    </edge>
    <edge source="MIXED PLASTIC WASTE" target="FUGITIVE GAS">
      <data key="d3">8.0</data>
      <data key="d4">Fugitive gas emissions are released during the digestion of mixed plastic waste by mealworms, contributing to greenhouse gas emissions.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-e6d515521d6d2b72e82154cc544d26cc</data>
    </edge>
