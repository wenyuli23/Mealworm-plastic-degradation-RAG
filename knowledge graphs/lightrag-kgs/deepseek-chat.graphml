    </node>
    <node id="ENTEROCOCCUS ASBURIAE VT1">
      <data key="d0">ORGANISM</data>
      <data key="d1">Enterococcus asburiae VT1 is a polyethylene-degrading bacterial strain isolated from waxworm guts, mentioned as a reference for plastic-degrading bacteria.</data>
