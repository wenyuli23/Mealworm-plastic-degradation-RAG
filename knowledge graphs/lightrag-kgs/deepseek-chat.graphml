      <data key="d4">Serratia marcescens is a gut bacterium of Tenebrio molitor that contributes to the biodegradation of polystyrene emulsion.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-b9fcb421212175a148a0a1858582cfb2</data>
    </edge>
