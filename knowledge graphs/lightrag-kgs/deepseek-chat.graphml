      <data key="d3">7.0</data>
      <data key="d4">Strain SCGB1 causes weight reduction in polystyrene films under aerobic conditions, demonstrating its biodegradation potential.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-d80979bb7e58b10bb558705b5d96fa99</data>
    </edge>
    <edge source="STRAIN SCGB1" target="CFU CONCENTRATION">
      <data key="d3">7.0</data>
      <data key="d4">Strain SCGB1 shows high CFU concentrations under aerobic conditions when degrading polystyrene.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-d80979bb7e58b10bb558705b5d96fa99</data>
    </edge>
