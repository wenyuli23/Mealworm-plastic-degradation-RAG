      <data key="d4">Oxygen functional groups influence the adsorption properties of microplastics, such as their ability to adsorb levofloxacin hydrochloride.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-5050676818c53a0ef6d691d3049e923c</data>
    </edge>
    <edge source="MICROPLASTICS" target="LANDFILLS">
      <data key="d3">8.0</data>
