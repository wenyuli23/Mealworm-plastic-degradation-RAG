      <data key="d5">8</data>
      <data key="d6">chunk-c9578db0f9ed0398705827be5d4ee450</data>
    </edge>
    <edge source="SYMBIOTIC BACTERIA" target="LB AGAR">
      <data key="d3">9.0</data>
      <data key="d4">LB agar is used to isolate and culture bacterial strains from the gut of mealworms.</data>
      <data key="d5">9</data>
      <data key="d6">chunk-c9578db0f9ed0398705827be5d4ee450</data>
    </edge>
