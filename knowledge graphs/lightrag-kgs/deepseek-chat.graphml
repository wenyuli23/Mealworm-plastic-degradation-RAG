      <data key="d5">8</data>
      <data key="d6">chunk-44e006d8af33633a06dac6789334329d</data>
    </edge>
    <edge source="MICROPLASTICS" target="LOW-DENSITY POLYETHYLENE">
      <data key="d3">8.0</data>
      <data key="d4">Low-density polyethylene (LDPE) is fragmented into microplastics (MPs) during biodegradation by mealworms.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-84a8f1c256b1141b6bd2b404e817dfb7</data>
