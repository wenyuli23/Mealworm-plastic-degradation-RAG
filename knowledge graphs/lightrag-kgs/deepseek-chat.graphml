    </edge>
    <edge source="TENEBRIO MOLITOR" target="LIGNOCELLULOSE (CS)">
      <data key="d3">17.0</data>
      <data key="d4">Mealworms (Tenebrio molitor) can degrade lignocellulose (CS) through metabolic pathways, demonstrating their role in the biodegradation of complex organic compounds.&lt;SEP&gt;Tenebrio molitor larvae metabolize lignocellulose (CS), contributing to its degradation and producing energy for growth.</data>
      <data key="d5">8&lt;SEP&gt;9</data>
