      <data key="d5">7</data>
      <data key="d6">chunk-16700b183fc641abfa74ad7fbb0917fe</data>
    </edge>
    <edge source="HOMOGENATE PASTE" target="LDPE FILM">
      <data key="d3">6.0</data>
      <data key="d4">Homogenate paste derived from greater wax moth larvae was used in experiments to study the degradation of LDPE films, although no significant mass loss was observed.</data>
      <data key="d5">6</data>
      <data key="d6">chunk-2a214d2b1c90aeb78e6e8562679d4963</data>
