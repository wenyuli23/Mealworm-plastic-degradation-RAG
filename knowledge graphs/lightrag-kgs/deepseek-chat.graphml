      <data key="d4">The transcriptome of Tenebrio molitor has been studied to understand the gene expression changes during plastic biodegradation</data>
      <data key="d5">8</data>
      <data key="d6">chunk-566afea8a2a89bd188f68d0afa1bb173</data>
    </edge>
    <edge source="TENEBRIO MOLITOR" target="DIGESTIVE ENZYMES">
