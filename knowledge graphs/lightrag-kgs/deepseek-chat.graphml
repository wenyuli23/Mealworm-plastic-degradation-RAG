      <data key="d2">chunk-a32ea55d79e87933e26b4165db47b1fc</data>
    </node>
    <node id="IRON SULFATE (FESO4·7H2O)">
      <data key="d0">CHEMICAL</data>
      <data key="d1">Iron sulfate is a trace element source used in mineral medium, necessary for various metabolic processes in microorganisms.</data>
