      <data key="d5">6</data>
      <data key="d6">chunk-af801199dfd68205bddcbe0bcda26eef</data>
    </edge>
    <edge source="MEALWORMS" target="MELTING POINTS">
      <data key="d3">6.0</data>
      <data key="d4">Melting points of plastics affect mealworm consumption ability, particularly for different types of polyethylene.</data>
      <data key="d5">6</data>
