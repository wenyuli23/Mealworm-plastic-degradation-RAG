      <data key="d5">8</data>
      <data key="d6">chunk-e37da2fbe64f85c50c36da45006f4c23</data>
    </edge>
    <edge source="ACETYLENE" target="ETHYLENE">
      <data key="d3">9.0</data>
      <data key="d4">Acetylene is converted to ethylene in the acetylene reduction assay, indicating nitrogen-fixing activity in mealworms.</data>
