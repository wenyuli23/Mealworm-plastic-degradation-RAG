      <data key="d3">8.0</data>
      <data key="d4">Mealworms were tested on materials that underwent physico-mechanical characterisation to assess biodegradation potential.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-36b964b1825429cad2c7d13c1ea8827e</data>
    </edge>
