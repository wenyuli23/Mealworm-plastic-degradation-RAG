      <data key="d3">9.0</data>
      <data key="d4">Nitrogen (N&lt;sub&gt;2&lt;/sub&gt;) is analyzed using an isotopic ratio mass spectrometer to determine its isotopic composition.</data>
      <data key="d5">9</data>
      <data key="d6">chunk-e37da2fbe64f85c50c36da45006f4c23</data>
    </edge>
    <edge source="ISOTOPIC RATIO MASS SPECTROMETER" target="IAEA N1 AND N3">
      <data key="d3">8.0</data>
