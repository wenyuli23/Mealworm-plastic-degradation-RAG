      <data key="d6">chunk-fcc545cfe4d6e8e04c3698a149d4101a</data>
    </edge>
    <edge source="BIODEGRADATION" target="ANAEROBIC PLASTIC-DEGRADING BACTERIA">
      <data key="d3">8.0</data>
      <data key="d4">Anaerobic plastic-degrading bacteria play a crucial role in the biodegradation of plastics, including polystyrene, under anaerobic conditions.</data>
