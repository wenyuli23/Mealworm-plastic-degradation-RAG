    </edge>
    <edge source="SUPERWORMS" target="FUNCTIONAL GROUPS">
      <data key="d3">7.0</data>
      <data key="d4">Functional groups derived from oxidation and biodegradation are observed in the guts of superworms during plastic degradation.</data>
