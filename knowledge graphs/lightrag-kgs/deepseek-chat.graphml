      <data key="d3">8.0</data>
      <data key="d4">Sugar content decreased by 10.69% in mealworms fed with polystyrene, indicating metabolic stress.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-a11793261251544a542146bc9bf0c5dd</data>
    </edge>
