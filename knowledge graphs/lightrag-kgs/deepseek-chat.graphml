      <data key="d5">7</data>
      <data key="d6">chunk-5af82472112cbc9e76b1fd1ac6e8c54e</data>
    </edge>
    <edge source="SCANNING ELECTRON MICROSCOPY (SEM)" target="PE MULCHING FILMS">
      <data key="d3">7.0</data>
      <data key="d4">SEM is used to observe biofilm formation on PE mulching films by bacterial strains.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-af682f78e3e8970d7d70b027a8f79116</data>
    </edge>
    <edge source="SCANNING ELECTRON MICROSCOPY (SEM)" target="HDPE FILM">
      <data key="d3">7.0</data>
