      <data key="d4">Tenebrio molitor larvae can degrade polystyrene (PS) film, contributing to the reduction of environmental plastic pollution.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-b9fcb421212175a148a0a1858582cfb2</data>
    </edge>
