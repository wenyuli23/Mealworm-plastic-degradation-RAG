    </edge>
    <edge source="PS" target="PM S1">
      <data key="d3">24.0</data>
      <data key="d4">PM S1 colonized PS beads, contributing to their degradation&lt;SEP&gt;PM S1 degrades PS, with evidence of weight loss and surface breakdown, confirming its role in biodegradation.&lt;SEP&gt;PS is degraded by PM S1 bacteria, which utilize it as a carbon source.</data>
      <data key="d5">7&lt;SEP&gt;8&lt;SEP&gt;9</data>
      <data key="d6">chunk-262bed73e929944e03b9f72769b8196c&lt;SEP&gt;chunk-2fd075a78abe1dca64ddea928d3f94b7&lt;SEP&gt;chunk-3646a65acc7cbdc1d20742888b17613a</data>
    </edge>
    <edge source="PS" target="PM">
      <data key="d3">8.0</data>
      <data key="d4">PM (microbial isolates) colonized and degraded PS beads, contributing to their biodegradation</data>
      <data key="d5">8</data>
      <data key="d6">chunk-3646a65acc7cbdc1d20742888b17613a</data>
    </edge>
    <edge source="PS" target="MEALWORM GUT BACTERIA">
      <data key="d3">8.0</data>
      <data key="d4">Mealworm gut bacteria, including the S1 isolate, are involved in the biodegradation of polystyrene (PS), breaking it down into simpler compounds.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-939fc2ea222a49f84f9bdc11f9801367</data>
    </edge>
    <edge source="PS" target="ELEMENTAL ANALYSIS">
      <data key="d3">7.0</data>
      <data key="d4">Elemental analysis is used to measure the degradation of PS by PM S1 bacteria.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-2fd075a78abe1dca64ddea928d3f94b7</data>
    </edge>
    <edge source="PS" target="CARBON DIOXIDE">
      <data key="d3">8.0</data>
      <data key="d4">PS degradation by PM S1 leads to carbon dioxide evolution, showing mineralization of the plastic.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-262bed73e929944e03b9f72769b8196c</data>
    </edge>
    <edge source="PS" target="PRIESTIA MEGATERIUM S1">
      <data key="d3">9.0</data>
      <data key="d4">Priestia megaterium S1 degrades PS, with evidence of weight loss and surface breakdown, confirming its role in biodegradation.</data>
      <data key="d5">9</data>
      <data key="d6">chunk-262bed73e929944e03b9f72769b8196c</data>
    </edge>
    <edge source="PS" target="FTIR SPECTROSCOPY">
      <data key="d3">8.0</data>
      <data key="d4">FTIR spectroscopy is used to analyze the degradation of PS beads by PM S1, identifying changes in functional groups.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-262bed73e929944e03b9f72769b8196c</data>
    </edge>
    <edge source="PS" target="SEM ANALYSIS">
      <data key="d3">8.0</data>
      <data key="d4">SEM analysis confirms structural changes on the surface of PS beads after treatment with PM S1, indicating biodegradation.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-262bed73e929944e03b9f72769b8196c</data>
    </edge>
    <edge source="PS" target="CARBON AND HYDROGEN ANALYSIS">
      <data key="d3">8.0</data>
      <data key="d4">Elemental analysis of carbon and hydrogen shows the percentage loss in PS beads after degradation by PM S1.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-262bed73e929944e03b9f72769b8196c</data>
    </edge>
    <edge source="PS" target="BIOLOGICAL OXYGEN DEMAND">
      <data key="d3">8.0</data>
      <data key="d4">Biological Oxygen Demand studies support the significant weight loss of PS beads after biodegradation by PM S1.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-262bed73e929944e03b9f72769b8196c</data>
    </edge>
