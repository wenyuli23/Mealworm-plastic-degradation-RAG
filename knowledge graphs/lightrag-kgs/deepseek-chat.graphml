    <edge source="PET" target="STABLE CARBON ISOTOPE ANALYSIS">
      <data key="d3">16.0</data>
      <data key="d4">Stable carbon isotope analysis confirms the biodegradation of PET by measuring 13C enrichment in residual polymers.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-a88f3ed3eec20cee61421cc094dde89f</data>
