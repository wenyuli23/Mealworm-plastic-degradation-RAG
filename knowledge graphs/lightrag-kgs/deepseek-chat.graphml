      <data key="d5">7</data>
      <data key="d6">chunk-e6d515521d6d2b72e82154cc544d26cc</data>
    </edge>
    <edge source="INFRARED SPECTROSCOPY" target="HDPE FILM">
      <data key="d3">7.0</data>
      <data key="d4">Infrared spectroscopy is used to analyze changes in the chemical structure of HDPE during biodegradation by PELW2042.</data>
