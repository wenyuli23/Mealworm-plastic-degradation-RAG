      <data key="d5">7</data>
      <data key="d6">chunk-d4af956dbe737dee68ab6b9834fe2fcc</data>
    </edge>
    <edge source="ENTEROBACTER STRAIN" target="IRON CYCLING">
      <data key="d3">8.0</data>
      <data key="d4">Enterobacter strain contributes to iron cycling through nitrate reduction, indicating its role in environmental processes.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-d4af956dbe737dee68ab6b9834fe2fcc</data>
    </edge>
    <edge source="ENTEROBACTER LUDWIGII" target="IMMUNE TOLERANCE">
      <data key="d3">8.0</data>
