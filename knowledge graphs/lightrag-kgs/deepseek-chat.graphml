      <data key="d4">The Bruker Avance NEO 600 spectrometer is used to analyze residual LDPE in biodegradation studies</data>
      <data key="d5">8</data>
      <data key="d6">chunk-f3099f2d6fd3abc2f73550f579999b13</data>
    </edge>
    <edge source="LDPE" target="TGA/SDTA851E">
      <data key="d3">8.0</data>
      <data key="d4">The TGA/SDTA851e is used to measure the stability and degradation of LDPE foams and residual polymers</data>
      <data key="d5">8</data>
      <data key="d6">chunk-f3099f2d6fd3abc2f73550f579999b13</data>
    </edge>
