    </edge>
    <edge source="STRAIN NYZ450" target="STRAIN NYZ451">
      <data key="d3">9.0</data>
      <data key="d4">Strains NyZ450 and NyZ451 work together in a consortium to degrade polyethylene mulching films, with complementary catabolic pathways.</data>
      <data key="d5">9</data>
      <data key="d6">chunk-78830eb6f2457838fda4728b21c17bed</data>
    </edge>
