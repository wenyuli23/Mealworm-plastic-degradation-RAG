      <data key="d3">7.0</data>
      <data key="d4">Enterococcus sp. is a gut bacterium of Tenebrio molitor involved in the biodegradation of plastics.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-b9fcb421212175a148a0a1858582cfb2</data>
    </edge>
    <edge source="TENEBRIO MOLITOR" target="PSEUDOMONAS AERUGINOSA">
      <data key="d3">8.0</data>
      <data key="d4">Pseudomonas aeruginosa is a gut bacterium of Tenebrio molitor involved in the biodegradation of various forms of polystyrene.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-b9fcb421212175a148a0a1858582cfb2</data>
    </edge>
