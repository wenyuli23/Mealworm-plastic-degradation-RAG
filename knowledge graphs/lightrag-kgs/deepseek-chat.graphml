      <data key="d4">Cacti rooting frequency is analyzed to study the effects of worm frass on plant growth.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-671dc96f9c648fdc6d21397c515d171d</data>
    </edge>
    <edge source="TEA LEAVES" target="CACTI">
      <data key="d3">7.0</data>
      <data key="d4">Tea leaves are used as a control medium in experiments comparing the effects of worm frass on cacti growth.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-12ceb4368e146509caa737d9534ce3c2</data>
    </edge>
