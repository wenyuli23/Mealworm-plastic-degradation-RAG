      <data key="d6">chunk-165679126b891785de849b020c1548f4</data>
    </edge>
    <edge source="MICROPLASTIC" target="EISENIA FETIDA">
      <data key="d3">7.0</data>
      <data key="d4">Eisenia fetida is used to study the toxicological effects of microplastics, including oxidative stress and gene expression changes.</data>
