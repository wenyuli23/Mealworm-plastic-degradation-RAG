      <data key="d3">7.0</data>
      <data key="d4">Colony counting quantifies the growth of strains NyZ450 and NyZ451 on PE mulching films.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-af682f78e3e8970d7d70b027a8f79116</data>
    </edge>
    <edge source="HT-GPC" target="MOLECULAR WEIGHT ANALYSIS">
