      <data key="d3">8.0</data>
      <data key="d4">Environmental Science &amp; Technology published studies on the biodegradation of polyethylene by plastic-eating waxworms.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-d97be338c51b4c4354e2d0f8de9c9dc8</data>
    </edge>
    <edge source="WAXWORMS" target="RUBBER">
      <data key="d3">7.0</data>
