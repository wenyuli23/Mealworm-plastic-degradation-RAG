      <data key="d3">8.0</data>
      <data key="d4">Plastic bio-oxidation involves enzymatic degradation, where enzymes facilitate the breakdown of plastics through oxidative reactions.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-9a31a12c930b59b872c94dda484d0db4</data>
    </edge>
