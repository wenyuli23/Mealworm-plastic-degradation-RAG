      <data key="d1">The Kruskal–Wallis test is a nonparametric statistical method used when ANOVA assumptions are not met.</data>
      <data key="d2">chunk-cbf28f07f3e46b29e447aae784667c29</data>
    </node>
    <node id="MANN–WHITNEY U TEST">
