    </edge>
    <edge source="BIODEGRADATION" target="LINEAR STRUCTURE OF PE">
      <data key="d3">7.0</data>
      <data key="d4">The linear structure of polyethylene (PE) polymers may influence the digestibility and biodegradation efficiency of PE microplastics by mealworm larvae.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-fa1a88a43b40afd043514c5f6898ee71</data>
    </edge>
    <edge source="BIODEGRADATION" target="CRYSTALLINITY OF PE">
      <data key="d3">7.0</data>
      <data key="d4">The crystallinity of polyethylene (PE) polymers may affect the biodegradation efficiency of PE microplastics by mealworm larvae.</data>
      <data key="d5">7</data>
      <data key="d6">chunk-fa1a88a43b40afd043514c5f6898ee71</data>
