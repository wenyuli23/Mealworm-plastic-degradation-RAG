      <data key="d3">8.0</data>
      <data key="d4">The Journal of Bioresources and Bioproducts publishes research on molded fiber and pulp products as sustainable alternatives to plastics.</data>
      <data key="d5">8</data>
      <data key="d6">chunk-5a7768b61a3d166f2cd01d4e87ac88cd</data>
    </edge>
